@* FF.WebBlazor/Shared/PlayerCardDialog.razor *@
@using System.Net.Http.Json
@inject IHttpClientFactory HttpFactory
@inject ISnackbar Snackbar

<MudDialog Style="background:#0f1923; border:1px solid rgba(99,179,237,0.25); border-radius:12px;">
    <TitleContent>
        <div class="d-flex align-center gap-3">
            @if (!string.IsNullOrEmpty(Player.HeadshotUrl))
            {
                <img src="@Player.HeadshotUrl"
                     alt="@Player.FullName"
                     style="width:56px;height:56px;border-radius:8px;object-fit:cover;"
                     onerror="this.style.display='none'" />
            }
            else
            {
                <MudAvatar Style="width:56px;height:56px;border-radius:8px;">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Large" />
                </MudAvatar>
            }
            <div>
                <div class="d-flex align-center gap-2">
                    <MudText Typo="Typo.h6" Style="font-weight:700;line-height:1.2;">
                        @Player.FullName
                    </MudText>
                    @* ── PLAYER-CARD-003: Roster availability badge ── *@
                    @if (!string.IsNullOrEmpty(Player.RosteredByTeamName))
                    {
                        <MudChip T="string" Size="Size.Small"
                                 Style="background:#2a1a00; color:#F59E0B; font-size:.7rem; height:20px;">
                            Rostered · @Player.RosteredByTeamName
                        </MudChip>
                    }
                    else if (Player.LeagueContextAvailable)
                    {
                        <MudChip T="string" Size="Size.Small"
                                 Style="background:#0f2a1a; color:#34D399; font-size:.7rem; height:20px;">
                            Available
                        </MudChip>
                    }
                </div>
                <div class="d-flex align-center gap-2 mt-1">
                    <MudChip T="string" Size="Size.Small"
                             Color="@GetPositionColor(Player.Position)"
                             Variant="Variant.Filled">
                        @Player.Position
                    </MudChip>
                    @if (!string.IsNullOrEmpty(Player.NflTeam))
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            @Player.NflTeam
                        </MudText>
                    }
                    @if (Player.Age.HasValue)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            Age @Player.Age
                        </MudText>
                        @if (Player.Age >= 23)
                        {
                            <MudTooltip Text="Age 23+ prospects carry additional dynasty risk">
                                <MudIcon Icon="@Icons.Material.Filled.Warning"
                                         Style="color:#F59E0B; font-size:1rem; vertical-align:middle;" />
                            </MudTooltip>
                        }
                    }
                </div>
            </div>
        </div>
    </TitleContent>

    <DialogContent>
        <MudTabs ActivePanelIndex="_activeTab"
                 ActivePanelIndexChanged="OnTabChanged"
                 Elevation="0" Rounded="true" Class="mt-1" PanelClass="pt-3">

            @* ══════════════════════════════════════════════════════════
               TAB 0 — OVERVIEW
               ════════════════════════════════════════════════════════ *@
            <MudTabPanel Text="Overview">

                @* ── Bio strip ─────────────────────────────────────── *@
                <div class="d-flex flex-wrap mb-4" style="gap:24px 32px;">
                    @if (!string.IsNullOrEmpty(Player.CollegeTeam))
                    {
                        <div style="min-width:80px;">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary"
                                     Style="letter-spacing:.06em; text-transform:uppercase; font-size:.65rem;">College</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight:600; margin-top:2px;">@Player.CollegeTeam</MudText>
                        </div>
                    }
                    @if (Player.DraftRound.HasValue && Player.DraftPick.HasValue)
                    {
                        <div style="min-width:80px;">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary"
                                     Style="letter-spacing:.06em; text-transform:uppercase; font-size:.65rem;">NFL Draft</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight:600; margin-top:2px;">R@(Player.DraftRound) P@(Player.DraftPick)</MudText>
                        </div>
                    }
                    @if (Player.FantasyProsRank.HasValue)
                    {
                        <div style="min-width:80px;">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary"
                                     Style="letter-spacing:.06em; text-transform:uppercase; font-size:.65rem;">FP Rank</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight:600; margin-top:2px;">#@Player.FantasyProsRank</MudText>
                        </div>
                    }
                    @if (Player.PffGrade.HasValue)
                    {
                        <div style="min-width:80px;">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary"
                                     Style="letter-spacing:.06em; text-transform:uppercase; font-size:.65rem;">PFF Grade</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight:600; margin-top:2px;">@Player.PffGrade.Value.ToString("F1")</MudText>
                        </div>
                    }
                    @if (Player.ConsensusAdp.HasValue)
                    {
                        <div style="min-width:80px;">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary"
                                     Style="letter-spacing:.06em; text-transform:uppercase; font-size:.65rem;">Consensus ADP</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight:600; margin-top:2px;">@Player.ConsensusAdp.Value.ToString("F1")</MudText>
                        </div>
                    }
                    @if (Player.FortyYard.HasValue)
                    {
                        <div style="min-width:80px;">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary"
                                     Style="letter-spacing:.06em; text-transform:uppercase; font-size:.65rem;">40-Yard</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight:600; margin-top:2px;">@Player.FortyYard.Value.ToString("F2")s</MudText>
                        </div>
                    }
                    @if (Player.AthleticismScore.HasValue)
                    {
                        <div style="min-width:80px;">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary"
                                     Style="letter-spacing:.06em; text-transform:uppercase; font-size:.65rem;">Athleticism</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight:600; margin-top:2px;">@Player.AthleticismScore.Value.ToString("F1")</MudText>
                        </div>
                    }
                    @if (Player.SpeedScore.HasValue && Player.Position == "RB")
                    {
                        <div style="min-width:80px;">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary"
                                     Style="letter-spacing:.06em; text-transform:uppercase; font-size:.65rem;">Speed Score</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight:600; margin-top:2px;">@Player.SpeedScore.Value.ToString("F1")</MudText>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Player.FantasyProsTier))
                    {
                        <div style="min-width:80px;">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary"
                                     Style="letter-spacing:.06em; text-transform:uppercase; font-size:.65rem;">Tier</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight:600; margin-top:2px;">@Player.FantasyProsTier</MudText>
                        </div>
                    }
                </div>

                <MudDivider Class="mb-4" />

                @* ── Score breakdown ────────────────────────────────── *@
                <MudText Typo="Typo.subtitle2" Class="mb-3"
                         Style="font-weight:700;letter-spacing:.04em;text-transform:uppercase;font-size:.7rem;color:var(--fc-cyan);">
                    Dynasty Score Breakdown
                </MudText>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px 32px;">
                    @ScoreRow("Dynasty Score", Player.DynastyScore, "Signal-normalized composite — active signals fill 90% of the pool; positional value is a 10% additive floor")
                    @ScoreRow("Draft Capital", Player.DraftCapitalScore, "Log-scaled NFL pick slot — earlier picks score higher; max weight 25%")
                    @ScoreRow("FP Score", Player.FantasyProsScore, "FantasyPros dynasty rookie rank — rank 1 = 100, rank 100+ = 0; max weight 20%")
                    @ScoreRow("PFF Grade", Player.PffGradeScore, "PFF pre-draft grade (0–100); max weight 20%")
                    @ScoreRow("Consensus ADP", Player.ConsensusAdpScore, "Consensus ADP pick number — earlier ADP scores higher; max weight 15%")
                    @ScoreRow("Positional Value", Player.PositionalScore, "Dynasty positional scarcity floor — WR 90, QB 85, TE 75, RB 55; always 10% of composite")
                    @ScoreRow("Valuation Blend", Player.ValuationBlendScore, "Blend of Career Value, Trade Value, and DFV — available Week 1 in-season; max weight 10%")
                    @if (Player.AgeMultiplier != 0)
                    {
                        @AgeRow()
                    }
                </div>

                <MudDivider Class="my-4" />

                @* ── AI Scout Report ────────────────────────────────── *@
                <div class="d-flex align-center justify-space-between mb-2">
                    <MudText Typo="Typo.subtitle2"
                             Style="font-weight:700;letter-spacing:.04em;text-transform:uppercase;font-size:.7rem;color:var(--fc-cyan);">
                        🤖 AI Scout Report
                    </MudText>
                    @if (!_narrativeLoaded)
                    {
                        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                   Color="Color.Primary" OnClick="GenerateNarrative"
                                   Disabled="@_narrativeLoading">
                            @if (_narrativeLoading)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                                <span>Generating...</span>
                            }
                            else
                            {
                                <span>Generate</span>
                            }
                        </MudButton>
                    }
                </div>
                @if (_narrativeLoaded)
                {
                    <MudPaper Class="pa-3" Elevation="0"
                              Style="background:rgba(99,179,237,.06);border:1px solid rgba(99,179,237,.15);border-radius:8px;">
                        <MudText Typo="Typo.body2" Style="line-height:1.7;white-space:pre-wrap;">
                            @_narrative
                        </MudText>
                    </MudPaper>
                }
                else if (!_narrativeLoading)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Click Generate for an AI-powered scouting summary.
                    </MudText>
                }
            </MudTabPanel>

            @* ══════════════════════════════════════════════════════════
               TAB 1 — STATS
               ════════════════════════════════════════════════════════ *@
            <MudTabPanel Text="Stats">
                <MudAlert Severity="Severity.Info" Class="mb-4">
                    In-season stats and weekly projections are available once Week 1 projections are calculated.
                    Check back during the 2026 season.
                </MudAlert>

                @* Bio strip repeated for quick reference *@
                <div class="d-flex flex-wrap gap-4">
                    @if (Player.FantasyProsRank.HasValue)
                    {
                        <MudPaper Class="pa-3" Elevation="0"
                                  Style="background:rgba(99,179,237,.06);border:1px solid rgba(99,179,237,.15);border-radius:8px;min-width:120px;text-align:center;">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary"
                                     Style="text-transform:uppercase; letter-spacing:.06em; font-size:.65rem;">FP Rank</MudText>
                            <MudText Typo="Typo.h5" Style="font-weight:700; color:var(--fc-cyan);">#@Player.FantasyProsRank</MudText>
                        </MudPaper>
                    }
                    @if (Player.ConsensusAdp.HasValue)
                    {
                        <MudPaper Class="pa-3" Elevation="0"
                                  Style="background:rgba(99,179,237,.06);border:1px solid rgba(99,179,237,.15);border-radius:8px;min-width:120px;text-align:center;">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary"
                                     Style="text-transform:uppercase; letter-spacing:.06em; font-size:.65rem;">Consensus ADP</MudText>
                            <MudText Typo="Typo.h5" Style="font-weight:700; color:var(--fc-cyan);">@Player.ConsensusAdp.Value.ToString("F1")</MudText>
                        </MudPaper>
                    }
                    @if (!string.IsNullOrEmpty(Player.FantasyProsTier))
                    {
                        <MudPaper Class="pa-3" Elevation="0"
                                  Style="background:rgba(99,179,237,.06);border:1px solid rgba(99,179,237,.15);border-radius:8px;min-width:120px;text-align:center;">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary"
                                     Style="text-transform:uppercase; letter-spacing:.06em; font-size:.65rem;">Tier</MudText>
                            <MudText Typo="Typo.h5" Style="font-weight:700; color:var(--fc-cyan);">@Player.FantasyProsTier</MudText>
                        </MudPaper>
                    }
                </div>
            </MudTabPanel>

            @* ══════════════════════════════════════════════════════════
               TAB 2 — DYNASTY
               ════════════════════════════════════════════════════════ *@
            <MudTabPanel Text="Dynasty">

                @* ── Career phase pill ─────────────────────────────── *@
                @if (!string.IsNullOrEmpty(Player.CareerPhase))
                {
                    <div class="d-flex align-center gap-3 mb-4">
                        <MudText Typo="Typo.subtitle2"
                                 Style="font-weight:700;letter-spacing:.04em;text-transform:uppercase;font-size:.7rem;color:var(--fc-cyan);">
                            Career Phase
                        </MudText>
                        <MudChip T="string" Size="Size.Small"
                                 Style="@GetPhaseStyle(Player.CareerPhase)">
                            @Player.CareerPhase
                        </MudChip>
                    </div>
                }

                @* ── Dynasty value cards ────────────────────────────── *@
                <div class="d-flex flex-wrap gap-3 mb-4">
                    <MudPaper Class="pa-3" Elevation="0"
                              Style="background:rgba(99,179,237,.06);border:1px solid rgba(99,179,237,.15);border-radius:8px;min-width:130px;text-align:center;">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary"
                                 Style="text-transform:uppercase; letter-spacing:.06em; font-size:.65rem;">Dynasty Score</MudText>
                        <MudText Typo="Typo.h5" Style="font-weight:700; color:var(--fc-cyan);">
                            @Player.DynastyScore.ToString("F1")
                        </MudText>
                    </MudPaper>

                    @if (Player.DynastyTradeValue.HasValue)
                    {
                        <MudPaper Class="pa-3" Elevation="0"
                                  Style="background:rgba(99,179,237,.06);border:1px solid rgba(99,179,237,.15);border-radius:8px;min-width:130px;text-align:center;">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary"
                                     Style="text-transform:uppercase; letter-spacing:.06em; font-size:.65rem;">Trade Value</MudText>
                            <MudText Typo="Typo.h5" Style="font-weight:700; color:var(--fc-cyan);">
                                @Player.DynastyTradeValue.Value.ToString("F1")
                            </MudText>
                        </MudPaper>
                    }

                    @if (Player.CareerValueScore.HasValue)
                    {
                        <MudPaper Class="pa-3" Elevation="0"
                                  Style="background:rgba(99,179,237,.06);border:1px solid rgba(99,179,237,.15);border-radius:8px;min-width:130px;text-align:center;">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary"
                                     Style="text-transform:uppercase; letter-spacing:.06em; font-size:.65rem;">Career Value</MudText>
                            <MudText Typo="Typo.h5" Style="font-weight:700; color:var(--fc-cyan);">
                                @Player.CareerValueScore.Value.ToString("F0")
                            </MudText>
                        </MudPaper>
                    }

                    @if (Player.YearsOfPrimeRemaining.HasValue)
                    {
                        <MudPaper Class="pa-3" Elevation="0"
                                  Style="background:rgba(99,179,237,.06);border:1px solid rgba(99,179,237,.15);border-radius:8px;min-width:130px;text-align:center;">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary"
                                     Style="text-transform:uppercase; letter-spacing:.06em; font-size:.65rem;">Prime Yrs Left</MudText>
                            <MudText Typo="Typo.h5" Style="font-weight:700; color:var(--fc-cyan);">
                                @Player.YearsOfPrimeRemaining.Value.ToString("F0")
                            </MudText>
                        </MudPaper>
                    }
                </div>

                <MudDivider Class="mb-4" />

                @* ── Score breakdown (dynasty-relevant signals) ─────── *@
                <MudText Typo="Typo.subtitle2" Class="mb-3"
                         Style="font-weight:700;letter-spacing:.04em;text-transform:uppercase;font-size:.7rem;color:var(--fc-cyan);">
                    Signal Breakdown
                </MudText>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px 32px;">
                    @ScoreRow("Valuation Blend", Player.ValuationBlendScore, "Blend of Career Value, Trade Value, and DFV — available Week 1 in-season; max weight 10%")
                    @ScoreRow("Positional Value", Player.PositionalScore, "Dynasty positional scarcity floor — WR 90, QB 85, TE 75, RB 55")
                    @if (Player.AgeMultiplier != 0)
                    {
                        @AgeRow()
                    }
                </div>

                @if (!Player.DynastyTradeValue.HasValue && !Player.CareerValueScore.HasValue)
                {
                    <MudAlert Severity="Severity.Info" Class="mt-4">
                        Full dynasty valuations (DFV, career sim curve) are available once in-season 2026
                        weekly simulation jobs run. Values self-correct at Week 1.
                    </MudAlert>
                }
            </MudTabPanel>

            @* ══════════════════════════════════════════════════════════
               TAB 3 — DEPTH CHART
               ════════════════════════════════════════════════════════ *@
<MudTabPanel Text="Depth Chart">
    @if (_depthLoading)
    {
        <div class="d-flex justify-center pa-6">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        </div>
    }
    else if (_depthData is null)
    {
        <MudAlert Severity="Severity.Info">
            Depth chart data is populated weekly on Wednesdays. Check back after the first sync runs,
            or trigger it manually from the admin panel.
        </MudAlert>
        @if (!string.IsNullOrEmpty(Player.NflTeam))
        {
            <div class="d-flex align-center gap-3 mt-3">
                <MudIcon Icon="@Icons.Material.Filled.Groups"
                         Style="color:var(--fc-cyan); font-size:2rem;" />
                <div>
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700;">@Player.NflTeam</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        @Player.Position depth chart — pending sync
                    </MudText>
                </div>
            </div>
        }
    }
    else if (!_depthData.Available)
    {
        <MudAlert Severity="Severity.Info">@_depthData.Message</MudAlert>
    }
    else
    {
        <div class="d-flex flex-wrap gap-3 mb-4">
            <MudPaper Class="pa-3" Elevation="0"
                      Style="background:rgba(99,179,237,.06);border:1px solid rgba(99,179,237,.15);border-radius:8px;min-width:130px;text-align:center;">
                <MudText Typo="Typo.caption" Class="mud-text-secondary"
                         Style="text-transform:uppercase; letter-spacing:.06em; font-size:.65rem;">
                    Depth Position
                </MudText>
                <MudText Typo="Typo.h5" Style="font-weight:700; color:var(--fc-cyan);">
                    @_depthData.DepthPosition
                </MudText>
            </MudPaper>
            <MudPaper Class="pa-3" Elevation="0"
                      Style="background:rgba(99,179,237,.06);border:1px solid rgba(99,179,237,.15);border-radius:8px;min-width:130px;text-align:center;">
                <MudText Typo="Typo.caption" Class="mud-text-secondary"
                         Style="text-transform:uppercase; letter-spacing:.06em; font-size:.65rem;">
                    Depth
                </MudText>
                            <MudText Typo="Typo.h5" Style="@($"font-weight:700; color:{GetDepthColor(_depthData.DepthTeam)};")">
                    @GetDepthLabel(_depthData.DepthTeam)
                </MudText>
            </MudPaper>
            <MudPaper Class="pa-3" Elevation="0"
                      Style="background:rgba(99,179,237,.06);border:1px solid rgba(99,179,237,.15);border-radius:8px;min-width:130px;text-align:center;">
                <MudText Typo="Typo.caption" Class="mud-text-secondary"
                         Style="text-transform:uppercase; letter-spacing:.06em; font-size:.65rem;">
                    NFL Team
                </MudText>
                <MudText Typo="Typo.h5" Style="font-weight:700; color:var(--fc-cyan);">
                    @_depthData.NflTeam
                </MudText>
            </MudPaper>
            @if (!string.IsNullOrEmpty(_depthData.FormationPosition))
            {
                <MudPaper Class="pa-3" Elevation="0"
                          Style="background:rgba(99,179,237,.06);border:1px solid rgba(99,179,237,.15);border-radius:8px;min-width:130px;text-align:center;">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary"
                             Style="text-transform:uppercase; letter-spacing:.06em; font-size:.65rem;">
                        Formation
                    </MudText>
                    <MudText Typo="Typo.h5" Style="font-weight:700; color:var(--fc-cyan);">
                        @_depthData.FormationPosition
                    </MudText>
                </MudPaper>
            }
        </div>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            Week @_depthData.Week · Updated via nflverse
        </MudText>
    }
</MudTabPanel>

            @* ══════════════════════════════════════════════════════════
               TAB 4 — TRADE
               ════════════════════════════════════════════════════════ *@
            <MudTabPanel Text="Trade">

                @* ── Quick value reference ─────────────────────────── *@
                <MudText Typo="Typo.subtitle2" Class="mb-3"
                         Style="font-weight:700;letter-spacing:.04em;text-transform:uppercase;font-size:.7rem;color:var(--fc-cyan);">
                    Trade Value Reference
                </MudText>

                <div class="d-flex flex-wrap gap-3 mb-4">
                    <MudPaper Class="pa-3" Elevation="0"
                              Style="background:rgba(99,179,237,.06);border:1px solid rgba(99,179,237,.15);border-radius:8px;min-width:130px;text-align:center;">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary"
                                 Style="text-transform:uppercase; letter-spacing:.06em; font-size:.65rem;">Dynasty Score</MudText>
                        <MudText Typo="Typo.h5" Style="font-weight:700; color:var(--fc-cyan);">
                            @Player.DynastyScore.ToString("F1")
                        </MudText>
                    </MudPaper>

                    @if (Player.DynastyTradeValue.HasValue)
                    {
                        <MudPaper Class="pa-3" Elevation="0"
                                  Style="background:rgba(99,179,237,.06);border:1px solid rgba(99,179,237,.15);border-radius:8px;min-width:130px;text-align:center;">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary"
                                     Style="text-transform:uppercase; letter-spacing:.06em; font-size:.65rem;">Trade Value</MudText>
                            <MudText Typo="Typo.h5" Style="font-weight:700; color:var(--fc-cyan);">
                                @Player.DynastyTradeValue.Value.ToString("F1")
                            </MudText>
                        </MudPaper>
                    }

                    @if (Player.ConsensusAdp.HasValue)
                    {
                        <MudPaper Class="pa-3" Elevation="0"
                                  Style="background:rgba(99,179,237,.06);border:1px solid rgba(99,179,237,.15);border-radius:8px;min-width:130px;text-align:center;">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary"
                                     Style="text-transform:uppercase; letter-spacing:.06em; font-size:.65rem;">Consensus ADP</MudText>
                            <MudText Typo="Typo.h5" Style="font-weight:700; color:var(--fc-cyan);">
                                @Player.ConsensusAdp.Value.ToString("F1")
                            </MudText>
                        </MudPaper>
                    }
                </div>

                <MudAlert Severity="Severity.Info">
                    Navigate to the <strong>Trade Analyzer</strong> for full side-by-side trade evaluation,
                    draft pick values, and fairness scoring.
                    <MudLink Href="/trade" Style="color:var(--fc-cyan); margin-left:6px;">Open Trade Analyzer →</MudLink>
                </MudAlert>
            </MudTabPanel>

        </MudTabs>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Close())">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public PlayerCardData Player { get; set; } = default!;

    /// <summary>
    /// Which tab opens by default. Callers pass this based on their context.
    /// Overview=0, Stats=1, Dynasty=2, DepthChart=3, Trade=4
    /// </summary>
    [Parameter] public PlayerCardTab DefaultTab { get; set; } = PlayerCardTab.Overview;

    private int _activeTab;
    private string? _narrative;
    private bool _narrativeLoading;
    private bool _narrativeLoaded;
    private DepthChartResponse? _depthData;
    private bool _depthLoading;

    protected override async Task OnParametersSetAsync()
    {
        _activeTab = (int)DefaultTab;
        if (DefaultTab == PlayerCardTab.DepthChart)
            await LoadDepthChartAsync();
    }

    // Call this when user clicks the Depth Chart tab
    // Wire: <MudTabs ... ActivePanelIndexChanged="OnTabChanged">
    private async Task OnTabChanged(int index)
    {
        _activeTab = index;
        if (index == (int)PlayerCardTab.DepthChart && _depthData is null && !_depthLoading)
            await LoadDepthChartAsync();
    }

    private async Task LoadDepthChartAsync()
    {
        _depthLoading = true;
        StateHasChanged();
        try
        {
            var http = HttpFactory.CreateClient("AuthAPI");
            var response = await http.GetAsync(
                $"api/v1/players/{Player.SleeperPlayerId}/depth-chart");
            if (response.IsSuccessStatusCode)
                _depthData = await response.Content.ReadFromJsonAsync<DepthChartResponse>();
        }
        catch { /* non-fatal — shows null state */ }
        finally
        {
            _depthLoading = false;
            StateHasChanged();
        }
    }

    private static string GetDepthLabel(int depthTeam) => depthTeam switch
    {
        1 => "Starter",
        2 => "Backup",
        3 => "3rd String",
        _ => $"Depth {depthTeam}"
    };

    private static string GetDepthColor(int depthTeam) => depthTeam switch
    {
        1 => "#34D399",
        2 => "#F59E0B",
        _ => "#94a3b8"
    };

    private record DepthChartResponse(
        bool Available,
        string? Message,
        int Week,
        string? NflTeam,
        string? Position,
        string? DepthPosition,
        int DepthTeam,
        string? FormationPosition);

    private async Task GenerateNarrative()
    {
        _narrativeLoading = true;
        StateHasChanged();
        try
        {
            var http = HttpFactory.CreateClient("AuthAPI");
            var response = await http.GetAsync(
                $"api/v1/players/{Player.SleeperPlayerId}/narrative");
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<NarrativeResponse>();
                _narrative = result?.Narrative;
                _narrativeLoaded = true;
            }
            else
            {
                Snackbar.Add("Could not generate scout report.", Severity.Warning);
            }
        }
        catch
        {
            Snackbar.Add("Could not generate scout report.", Severity.Warning);
        }
        finally
        {
            _narrativeLoading = false;
            StateHasChanged();
        }
    }

    private RenderFragment ScoreRow(string label, double value, string tooltip) => __builder =>
    {
        <MudTooltip Text="@tooltip" Placement="Placement.Left">
            <div class="d-flex align-center gap-2 mb-1">
                <MudText Typo="Typo.body2" Style="min-width:110px; font-size:.8rem;">@label</MudText>
                <MudProgressLinear Value="@value" Max="100"
                                   Color="@GetScoreColor(value)"
                                   Style="flex:1;height:5px;border-radius:3px;" />
                <MudText Typo="Typo.body2" Style="font-weight:600;min-width:36px;text-align:right;font-size:.8rem;">
                    @value.ToString("F1")
                </MudText>
            </div>
        </MudTooltip>
    };

    // Age multiplier row — no progress bar; shows signed % adjustment instead
    private RenderFragment AgeRow() => __builder =>
    {
        var multiplier = Player.AgeMultiplier;
        var label = multiplier switch
        {
            > 0 => $"+{multiplier:F1}%",
            < 0 => $"{multiplier:F1}%",
            _ => "—"
        };
        var color = multiplier switch
        {
            > 0 => "color:#34D399;",
            < 0 => "color:#F59E0B;",
            _ => "color:var(--mud-palette-text-secondary);"
        };
        var tooltip = Player.Age.HasValue
            ? $"Age {Player.Age} — post-composite adjustment. RBs have steepest curve; QBs flattest."
            : "Age unknown — no adjustment applied.";

        <MudTooltip Text="@tooltip" Placement="Placement.Left">
            <div class="d-flex align-center gap-2 mb-1">
                <MudText Typo="Typo.body2" Style="min-width:110px; font-size:.8rem;">Age Adjustment</MudText>
                <MudText Typo="Typo.body2" Style="@("font-weight:600; font-size:.8rem; " + color)">@label</MudText>
            </div>
        </MudTooltip>
    };

    private static Color GetPositionColor(string pos) => pos switch
    {
        "QB" => Color.Warning,
        "WR" => Color.Primary,
        "TE" => Color.Secondary,
        "RB" => Color.Success,
        _ => Color.Default
    };

    private static Color GetScoreColor(double score) => score switch
    {
        >= 75 => Color.Success,
        >= 50 => Color.Primary,
        >= 25 => Color.Warning,
        _ => Color.Default
    };

    private static string GetPhaseStyle(string phase) => phase switch
    {
        "Ascending" => "background:#0f2a1a; color:#34D399;",
        "Prime" => "background:#1a2a0f; color:#a3e635;",
        "Declining" => "background:#2a1a00; color:#F59E0B;",
        _ => "background:#1a1a2a; color:#94a3b8;"
    };

    // ── Enum ──────────────────────────────────────────────────────────────
    public enum PlayerCardTab { Overview = 0, Stats = 1, Dynasty = 2, DepthChart = 3, Trade = 4 }

    // ── Shared DTO passed from calling pages ──────────────────────────────
    public record PlayerCardData(
        string SleeperPlayerId,
        string FullName,
        string Position,
        string? NflTeam,
        int? Age,
        int? DraftRound,
        int? DraftPick,
        string? CollegeTeam,
        string? HeadshotUrl,
        int? FantasyProsRank,
        string? FantasyProsTier,
        double? PffGrade,
        int? PffRank,
        double? ConsensusAdp,
        double DynastyScore,
        double DraftCapitalScore,
        double PositionalScore,
        double ValuationBlendScore,
        double FantasyProsScore,
        double PffGradeScore,
        double ConsensusAdpScore,
        double AgeMultiplier,
        double AthleticismSignalScore,
        double? AthleticismScore,
        double? SpeedScore,
        double? FortyYard,
        // ── PLAYER-CARD-002 additions ──
        double? DynastyTradeValue = null,
        double? CareerValueScore = null,
        string? CareerPhase = null,
        double? YearsOfPrimeRemaining = null,
        // ── PLAYER-CARD-003 additions ──
        string? RosteredByTeamName = null,
        bool LeagueContextAvailable = false);

    private record NarrativeResponse(string Narrative);
}
