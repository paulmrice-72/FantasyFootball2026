@page "/optimizer"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@using FF.WebBlazor.Services
@inject IHttpClientFactory HttpFactory
@inject ISnackbar Snackbar
@inject LeagueStateService LeagueState
@inject NflContextClientService NflContext
@implements IDisposable

<PageTitle>Lineup Optimizer — FantasyCombine.AI</PageTitle>

<div class="fc-page-header mb-4">
    <MudText Typo="Typo.h5" Class="fc-page-title">
        <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Class="mr-2" Style="vertical-align:middle;" />
        Lineup Optimizer
    </MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary">
        Season @_season · Week @_week · @(string.IsNullOrEmpty(_riskProfile) ? "No" : _riskProfile) risk profile
    </MudText>
</div>

<MudTabs Elevation="0" Rounded="false" Class="mb-2"
         @bind-ActivePanelIndex="_activeTab"
         @bind-ActivePanelIndex:after="OnTabChanged">

    @* ── TAB 0: MY ROSTER ──────────────────────────────────── *@
    <MudTabPanel Text="My Roster" Icon="@Icons.Material.Filled.Groups">
        @if (string.IsNullOrEmpty(LeagueState.ActiveLeagueId))
        {
            <MudAlert Severity="Severity.Warning" Class="mt-4">
                Select a league from the top bar to optimize your roster.
            </MudAlert>
        }
        else
        {
            <MudGrid Spacing="3">
                <MudItem xs="12" md="4" lg="3">
                    <MudPaper Class="fc-card mb-3 pa-4" Elevation="0">
                        <MudText Typo="Typo.subtitle2" Class="fc-section-label mb-3">SETTINGS</MudText>
                        <MudGrid Spacing="2">
                            <MudItem xs="6">
                                <MudNumericField @bind-Value="_season" Label="Season"
                                                 Variant="Variant.Outlined" Margin="Margin.Dense" Min="2022" Max="2030" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudNumericField @bind-Value="_week" Label="Week"
                                                 Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="18" />
                            </MudItem>
                        </MudGrid>
                        <MudSelect T="string" @bind-Value="_mode" Label="Score Mode"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2">
                            <MudSelectItem Value="@("Mean")">Expected (Mean)</MudSelectItem>
                            <MudSelectItem Value="@("Median")">Typical (Median)</MudSelectItem>
                            <MudSelectItem Value="@("Floor")">Floor</MudSelectItem>
                            <MudSelectItem Value="@("Ceiling")">Ceiling</MudSelectItem>
                        </MudSelect>
                        <MudSelect T="string" @bind-Value="_riskProfile" Label="Risk Profile"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" Clearable="true">
                            <MudSelectItem T="string" Value="@("Safe")">Safe — high floor</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Ceiling")">Ceiling — max upside</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Contrarian")">Contrarian — low owned</MudSelectItem>
                        </MudSelect>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.AutoAwesome"
                                   FullWidth="true"
                                   Disabled="@(_rosterOptimizing || _rosterPool.Count == 0)"
                                   OnClick="RunRosterOptimizer"
                                   Class="mt-3" Style="height:44px;">
                            @if (_rosterOptimizing)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" Color="Color.Surface" />
                                <span>Optimizing...</span>
                            }
                            else
                            {

                                <span>Optimize My Lineup</span>
                            }
                        </MudButton>
                    </MudPaper>

                    <MudPaper Class="fc-card pa-4" Elevation="0">
                        <MudText Typo="Typo.subtitle2" Class="fc-section-label mb-2">MY PLAYERS</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary mb-3">
                            Click to lock 🔒 or exclude ❌
                        </MudText>
                        @if (_rosterLoading)
                        {
                            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                        }
                        else if (_rosterPool.Count == 0)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true">
                                No simulation data for your rostered players this week.
                                Make sure the weekly sim job has run.
                            </MudAlert>
                        }
                        else
                        {
                            <div class="fc-pool-list">
                                @foreach (var p in _rosterPool.OrderByDescending(p => p.Proj))
                                {
                                    <div class="fc-pool-row @PoolRowClass(p)" @onclick="() => CyclePlayerState(p)">
                                        <div class="fc-pool-row-left">
                                            <MudText Typo="Typo.body2" Style="font-weight:600; line-height:1.2;">
                                                @p.PlayerName
                                            </MudText>
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                                @p.Position · @p.NflTeam
                                            </MudText>
                                        </div>
                                        <div class="fc-pool-row-right">
                                            <MudText Typo="Typo.body2" Class="fc-stat fc-cyan">
                                                @p.Proj.ToString("F1")
                                            </MudText>
                                            <span class="fc-pool-badge">@PoolBadge(p)</span>
                                        </div>
                                    </div>
                                }
                            </div>
                            <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                                       OnClick="@(() => { foreach (var p in _rosterPool) p.State = PlayerState.Normal; })"
                                       Class="mt-2">
                                Clear All Locks / Excludes
                            </MudButton>
                        }
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="8" lg="9">
                    <MudPaper Class="fc-card pa-4" Elevation="0">
                        <div class="d-flex align-center mb-4">
                            <MudText Typo="Typo.subtitle2" Class="fc-section-label">OPTIMIZED LINEUP</MudText>
                            <MudSpacer />
                            @if (_rosterResult is not null)
                            {
                                <MudChip T="string" Color="Color.Primary" Size="Size.Small" Class="fc-stat">
                                    @_rosterResult.TotalProjectedPoints.ToString("F1") pts projected
                                </MudChip>
                            }
                        </div>
                        @if (_rosterError is not null)
                        {
                            <MudAlert Severity="Severity.Error" Class="mb-3">@_rosterError</MudAlert>
                        }
                        @if (_rosterResult is null && _rosterError is null)
                        {
                            <div class="fc-empty-state">
                                <MudIcon Icon="@Icons.Material.Filled.Groups"
                                Style="font-size:3rem; color: var(--fc-cyan); opacity:0.3;" />
                                <MudText Typo="Typo.body1" Class="mud-text-secondary mt-2">
                                    Click Optimize My Lineup to find your best starting lineup from your rostered players.
                                </MudText>
                            </div>
                        }
                        else if (_rosterResult is not null)
                        {
                            @if (_rosterResult.Lineup is null || !_rosterResult.Lineup.Any())
                            {
                                <MudAlert Severity="Severity.Warning" Class="mb-3">
                                    The optimizer could not build a valid lineup with the current locks.
                                    Try reducing locked players — max 1 QB, 2 RB, 3 WR, 2 TE.
                                </MudAlert>
                            }
                            else
                            {
                                @foreach (var slotType in new[] { "QB", "RB", "WR", "TE", "FLEX" })
                                {
                                    var slots = _rosterResult.Lineup.Where(s => s.SlotType == slotType).ToList();
                                    if (!slots.Any()) continue;
                                    <div class="fc-slot-group mb-3">
                                        <MudText Typo="Typo.overline" Class="fc-slot-label">@slotType</MudText>
                                        @foreach (var slot in slots)
                                        {
                                            <div class="fc-lineup-slot">
                                                <div class="fc-slot-pos-badge @PositionClass(slot.Position)">@slot.Position</div>
                                                <div class="fc-slot-info">
                                                    <MudText Typo="Typo.body1" Style="font-weight:700;">@slot.PlayerName</MudText>
                                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@slot.Position</MudText>
                                                </div>
                                                <div class="fc-slot-pts">
                                                    <MudText Typo="Typo.h6" Class="fc-stat fc-cyan">
                                                        @slot.ProjectedPoints.ToString("F1")
                                                    </MudText>
                                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">proj</MudText>
                                                </div>
                                                @if (slot.RiskScore.HasValue)
                                                {
                                                    <div class="fc-slot-risk">
                                                        <MudText Typo="Typo.body2" Class="fc-stat fc-ceiling">
                                                            @slot.RiskScore.Value.ToString("F1")
                                                        </MudText>
                                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">risk</MudText>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                <MudDivider Class="my-3" />
                                <div class="d-flex justify-space-between align-center">
                                    <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">TOTAL PROJECTED</MudText>
                                    <MudText Typo="Typo.h5" Class="fc-stat fc-cyan">
                                        @_rosterResult.TotalProjectedPoints.ToString("F1")
                                    </MudText>
                                </div>
                            }
                        }
                    </MudPaper>
                </MudItem>
            </MudGrid>
        }
    </MudTabPanel>

    @* ── TAB 1: FULL PLAYER POOL ────────────────────────────── *@
    <MudTabPanel Text="Full Player Pool" Icon="@Icons.Material.Filled.People">
        <MudGrid Spacing="3">
            <MudItem xs="12" md="4" lg="3">
                <MudPaper Class="fc-card mb-3 pa-4" Elevation="0">
                    <MudText Typo="Typo.subtitle2" Class="fc-section-label mb-3">SETTINGS</MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="6">
                            <MudNumericField @bind-Value="_season" Label="Season"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" Min="2022" Max="2030" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudNumericField @bind-Value="_week" Label="Week"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="18" />
                        </MudItem>
                    </MudGrid>
                    <MudSelect T="string" @bind-Value="_mode" Label="Score Mode"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" Clearable="true">
                        <MudSelectItem Value="@("Mean")">Expected (Mean)</MudSelectItem>
                            <MudSelectItem Value="@("Median")">Typical (Median)</MudSelectItem>
                        <MudSelectItem Value="@("Floor")">Floor</MudSelectItem>
                        <MudSelectItem Value="@("Ceiling")">Ceiling</MudSelectItem>
                    </MudSelect>
                    <MudSelect T="string" @bind-Value="_riskProfile" Label="Risk Profile"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" Clearable="true">
                        <MudSelectItem T="string" Value="@("Safe")">Safe — high floor</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Ceiling")">Ceiling — max upside</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Contrarian")">Contrarian — low owned</MudSelectItem>
                    </MudSelect>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.AutoAwesome"
                               FullWidth="true"
                               Disabled="_optimizing || _pool.Count == 0"
                               OnClick="RunOptimizer"
                               Class="mt-3" Style="height:44px;">
                        @if (_optimizing)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" Color="Color.Surface" />
                            <span>Optimizing...</span>
                        }
                        else
                        {

                            <span>Optimize Lineup</span>
                        }
                    </MudButton>
                </MudPaper>

                <MudPaper Class="fc-card pa-4" Elevation="0">
                    <MudText Typo="Typo.subtitle2" Class="fc-section-label mb-2">PLAYER POOL</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary mb-3">
                        Click to lock 🔒 or exclude ❌
                    </MudText>
                    @if (_poolLoading)
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                    }
                    else if (_pool.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">
                            Load pool to begin. Run simulate first.
                        </MudAlert>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                   FullWidth="true" StartIcon="@Icons.Material.Filled.Download"
                                   OnClick="LoadPool" Class="mt-2">
                            Load Player Pool
                        </MudButton>
                    }
                    else
                    {
                        <MudTextField @bind-Value="_poolSearch" Placeholder="Filter players..."
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Class="mb-2" />
                        <div class="d-flex gap-1 flex-wrap mb-2">
                            @foreach (var pos in new[] { "ALL", "QB", "RB", "WR", "TE" })
                            {
                                <MudChip T="string" Size="Size.Small"
                                         Color="@(_poolPosition == pos ? Color.Primary : Color.Default)"
                                         OnClick="@(() => { _poolPosition = pos; })"
                                         Class="fc-pos-chip">
                                    @pos
                                </MudChip>
                            }
                        </div>
                        <div class="fc-pool-list">
                            @foreach (var p in FilteredPool)
                            {
                                <div class="fc-pool-row @PoolRowClass(p)" @onclick="() => CyclePlayerState(p)">
                                    <div class="fc-pool-row-left">
                                        <MudText Typo="Typo.body2" Style="font-weight:600; line-height:1.2;">
                                            @p.PlayerName
                                        </MudText>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                            @p.Position · @p.NflTeam
                                        </MudText>
                                    </div>
                                    <div class="fc-pool-row-right">
                                        <MudText Typo="Typo.body2" Class="fc-stat fc-cyan">
                                            @p.Proj.ToString("F1")
                                        </MudText>
                                        <span class="fc-pool-badge">@PoolBadge(p)</span>
                                    </div>
                                </div>
                            }
                        </div>
                        <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                                   OnClick="ClearLocks" Class="mt-2">
                            Clear All Locks / Excludes
                        </MudButton>
                    }
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="8" lg="9">
                <MudPaper Class="fc-card pa-4" Elevation="0">
                    <div class="d-flex align-center mb-4">
                        <MudText Typo="Typo.subtitle2" Class="fc-section-label">OPTIMIZED LINEUP</MudText>
                        <MudSpacer />
                        @if (_result is not null)
                        {
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small" Class="fc-stat">
                                @_result.TotalProjectedPoints.ToString("F1") pts projected
                            </MudChip>
                            @if (_result.RiskProfile is not null)
                            {
                                <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Class="ml-2">
                                    @_result.RiskProfile
                                </MudChip>
                            }
                        }
                    </div>
                    @if (_optimizerError is not null)
                    {
                        <MudAlert Severity="Severity.Error" Class="mb-3">@_optimizerError</MudAlert>
                    }
                    @if (_result is null && _optimizerError is null)
                    {
                        <div class="fc-empty-state">
                            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome"
                            Style="font-size:3rem; color: var(--fc-cyan); opacity:0.3;" />
                            <MudText Typo="Typo.body1" Class="mud-text-secondary mt-2">
                                Load your player pool, set your risk profile, and click Optimize.
                            </MudText>
                        </div>
                    }
                    else if (_result is not null)
                    {
                        @if (_result.Lineup is null || !_result.Lineup.Any())
                        {
                            <MudAlert Severity="Severity.Warning" Class="mb-3">
                                The optimizer could not build a valid lineup with the current locks.
                                Try reducing locked players — max 1 QB, 2 RB, 3 WR, 2 TE.
                            </MudAlert>
                        }
                        else
                        {
                            @foreach (var slotType in new[] { "QB", "RB", "WR", "TE", "FLEX" })
                            {
                                var slots = _result.Lineup.Where(s => s.SlotType == slotType).ToList();
                                if (!slots.Any()) continue;
                                <div class="fc-slot-group mb-3">
                                    <MudText Typo="Typo.overline" Class="fc-slot-label">@slotType</MudText>
                                    @foreach (var slot in slots)
                                    {
                                        <div class="fc-lineup-slot">
                                            <div class="fc-slot-pos-badge @PositionClass(slot.Position)">
                                                @slot.Position
                                            </div>
                                            <div class="fc-slot-info">
                                                <MudText Typo="Typo.body1" Style="font-weight:700;">@slot.PlayerName</MudText>
                                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@slot.Position</MudText>
                                            </div>
                                            <div class="fc-slot-pts">
                                                <MudText Typo="Typo.h6" Class="fc-stat fc-cyan">
                                                    @slot.ProjectedPoints.ToString("F1")
                                                </MudText>
                                                <MudText Typo="Typo.caption" Class="mud-text-secondary">proj</MudText>
                                            </div>
                                            @if (slot.RiskScore.HasValue)
                                            {
                                                <div class="fc-slot-risk">
                                                    <MudText Typo="Typo.body2" Class="fc-stat fc-ceiling">
                                                        @slot.RiskScore.Value.ToString("F1")
                                                    </MudText>
                                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">risk</MudText>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            <MudDivider Class="my-3" />
                            <div class="d-flex justify-space-between align-center">
                                <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">TOTAL PROJECTED</MudText>
                                <MudText Typo="Typo.h5" Class="fc-stat fc-cyan">
                                    @_result.TotalProjectedPoints.ToString("F1")
                                </MudText>
                            </div>
                        }
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudTabPanel>                
</MudTabs>

@code {
    // ── Tab state ────────────────────────────────────────────
    private int _activeTab = 0;

    // ── Shared settings ──────────────────────────────────────
    private int _season;
    private int _week;
    // Mean, not Median: the optimiser maximises a SUM, and expectations add.
    private string _mode = "Mean";
    private string _riskProfile = "";

    // ── Full pool tab state ──────────────────────────────────
    private string _poolSearch = "";
    private string _poolPosition = "ALL";
    private bool _poolLoading;
    private bool _optimizing;
    private string? _optimizerError;
    private List<PoolPlayer> _pool = [];
    private OptimizerResult? _result;

    // ── My Roster tab state ──────────────────────────────────
    private List<PoolPlayer> _rosterPool = [];
    private bool _rosterLoading;
    private bool _rosterOptimizing;
    private string? _rosterError;
    private OptimizerResult? _rosterResult;

    private HttpClient Http => HttpFactory.CreateClient("AuthAPI");

    private IEnumerable<PoolPlayer> FilteredPool => _pool
        .Where(p => _poolPosition == "ALL" || p.Position == _poolPosition)
        .Where(p => string.IsNullOrEmpty(_poolSearch) ||
            p.PlayerName.Contains(_poolSearch, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(p => p.Proj);

    protected override async Task OnInitializedAsync()
    {
        (_season, _week) = await NflContext.GetContextAsync();  // ← must complete first
        LeagueState.OnLeagueChanged += OnLeagueChanged;
        await Task.WhenAll(LoadPool(), LoadRosterPool());       // ← then both in parallel
    }

    public void Dispose() => LeagueState.OnLeagueChanged -= OnLeagueChanged;

    private void OnLeagueChanged()
    {
        _ = InvokeAsync(async () =>
        {
            _rosterPool = [];
            _rosterResult = null;
            await LoadRosterPool();
            StateHasChanged();
        });
    }

    private async Task OnTabChanged()
    {
        if (_activeTab == 0 && _rosterPool.Count == 0 && !_rosterLoading
            && !string.IsNullOrEmpty(LeagueState.ActiveLeagueId))
        {
            await LoadRosterPool();
        }
    }

    // ── Full Pool Loading ────────────────────────────────────
    private async Task LoadPool()
    {
        _poolLoading = true;
        _pool = [];
        StateHasChanged();
        try
        {
            var sims = await Http.GetFromJsonAsync<List<PoolPlayer>>(
                $"api/v1/projections/simulations?season={_season}&week={_week}");
            _pool = sims ?? [];
            if (_pool.Count == 0)
                Snackbar.Add($"No simulation data for {_season} Week {_week}. Run simulate first.", Severity.Warning);
            else
                Snackbar.Add($"Loaded {_pool.Count} players.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load pool: {ex.Message}", Severity.Error);
        }
        finally { _poolLoading = false; }
    }

    private async Task LoadRosterPool()
    {
        var leagueId = LeagueState.ActiveLeagueId;
        if (string.IsNullOrEmpty(leagueId)) return;

        _rosterLoading = true;
        _rosterPool = [];
        StateHasChanged();
        try
        {
            var roster = await Http.GetFromJsonAsync<MyRosterDto>(
                $"api/v1/team/roster?sleeperLeagueId={leagueId}");

            if (roster is null || roster.Players.Count == 0) return;

            var sims = await Http.GetFromJsonAsync<List<PoolPlayer>>(
                $"api/v1/projections/simulations?season={_season}&week={_week}");

            if (sims is null) return;

            var rosteredIds = roster.Players
                .Select(p => p.SleeperPlayerId)
                .ToHashSet();

            // Join on SleeperPlayerId. This used to compare rosteredIds (Sleeper ids
            // like "96") against PoolPlayer.PlayerId, which is the nflverse GSIS id
            // ("00-0023459"). Those cannot be equal for any player, so the roster pool
            // was ALWAYS empty and the tab silently bounced to Full Player Pool.
            _rosterPool = sims
                .Where(p => !string.IsNullOrEmpty(p.SleeperPlayerId)
                            && rosteredIds.Contains(p.SleeperPlayerId!))
                .ToList();

            // Deliberately no tab switch. An empty roster pool is a condition worth
            // seeing, not hiding — the auto-switch is exactly what kept the id
            // mismatch above invisible for as long as it existed.
            if (_rosterPool.Count == 0)
                Snackbar.Add(
                    $"No {_season} Week {_week} simulations matched your roster.",
                    Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load roster: {ex.Message}", Severity.Error);
        }
        finally { _rosterLoading = false; }
    }

    // ── Player State Cycling ─────────────────────────────────
    private void CyclePlayerState(PoolPlayer p)
    {
        p.State = p.State switch
        {
            PlayerState.Normal => PlayerState.Locked,
            PlayerState.Locked => PlayerState.Excluded,
            PlayerState.Excluded => PlayerState.Normal,
            _ => PlayerState.Normal
        };
    }

    private void ClearLocks()
    {
        foreach (var p in _pool) p.State = PlayerState.Normal;
    }

    // ── Full Pool Optimizer ──────────────────────────────────
    private async Task RunOptimizer()
    {
        var lockedByPos = _pool.Where(p => p.State == PlayerState.Locked)
            .GroupBy(p => p.Position).ToDictionary(g => g.Key, g => g.Count());
        if (lockedByPos.TryGetValue("QB", out var qb) && qb > 1)
        { _optimizerError = "Max 1 QB can be locked."; return; }
        if (lockedByPos.TryGetValue("TE", out var te) && te > 2)
        { _optimizerError = "Max 2 TEs can be locked (1 starter + 1 FLEX)."; return; }
        if (lockedByPos.TryGetValue("RB", out var rb) && rb > 3)
        { _optimizerError = "Max 3 RBs can be locked (2 starters + 1 FLEX)."; return; }
        if (lockedByPos.TryGetValue("WR", out var wr) && wr > 4)
        { _optimizerError = "Max 4 WRs can be locked (3 starters + 1 FLEX)."; return; }

        _optimizing = true;
        _optimizerError = null;
        _result = null;
        StateHasChanged();
        try
        {
            var lockedIds = _pool.Where(p => p.State == PlayerState.Locked)
                .Select(p => p.PlayerId).ToList();
            var excludedIds = _pool.Where(p => p.State == PlayerState.Excluded)
                .Select(p => p.PlayerId).ToList();
            var riskParam = string.IsNullOrEmpty(_riskProfile) ? "" : $"&riskProfile={_riskProfile}";
            var url = $"api/v1/projections/optimize?season={_season}&week={_week}&mode={_mode}{riskParam}";
            var response = await Http.PostAsJsonAsync(url,
                new { LockedPlayerIds = lockedIds, ExcludedPlayerIds = excludedIds });
            if (!response.IsSuccessStatusCode)
            {
                _optimizerError = $"Optimizer error: {await response.Content.ReadAsStringAsync()}";
                return;
            }
            _result = await response.Content.ReadFromJsonAsync<OptimizerResult>();
            if (_result is not null)
                Snackbar.Add($"Lineup optimized — {_result.TotalProjectedPoints:F1} pts projected.", Severity.Success);
        }
        catch (Exception ex) { _optimizerError = $"Failed to run optimizer: {ex.Message}"; }
        finally { _optimizing = false; }
    }

    // ── Roster Optimizer ─────────────────────────────────────
    private async Task RunRosterOptimizer()
    {
        var leagueId = LeagueState.ActiveLeagueId;
        if (string.IsNullOrEmpty(leagueId)) return;

        var lockedByPos = _rosterPool.Where(p => p.State == PlayerState.Locked)
            .GroupBy(p => p.Position).ToDictionary(g => g.Key, g => g.Count());
        if (lockedByPos.TryGetValue("QB", out var qb) && qb > 1)
        { _rosterError = "Max 1 QB can be locked."; return; }
        if (lockedByPos.TryGetValue("TE", out var te) && te > 2)
        { _rosterError = "Max 2 TEs can be locked (1 starter + 1 FLEX)."; return; }
        if (lockedByPos.TryGetValue("RB", out var rb) && rb > 3)
        { _rosterError = "Max 3 RBs can be locked (2 starters + 1 FLEX)."; return; }
        if (lockedByPos.TryGetValue("WR", out var wr) && wr > 4)
        { _rosterError = "Max 4 WRs can be locked (3 starters + 1 FLEX)."; return; }

        _rosterOptimizing = true;
        _rosterError = null;
        _rosterResult = null;

        StateHasChanged();
        try
        {
            var lockedIds = _rosterPool.Where(p => p.State == PlayerState.Locked)
                .Select(p => p.PlayerId).ToList();
            var excludedIds = _rosterPool.Where(p => p.State == PlayerState.Excluded)
                .Select(p => p.PlayerId).ToList();
            var riskParam = string.IsNullOrEmpty(_riskProfile) ? "" : $"&riskProfile={_riskProfile}";
            var url = $"api/v1/team/optimize-lineup?sleeperLeagueId={leagueId}&season={_season}&week={_week}&mode={_mode}{riskParam}";
            var response = await Http.PostAsJsonAsync(url,
                new { LockedPlayerIds = lockedIds, ExcludedPlayerIds = excludedIds });
            if (!response.IsSuccessStatusCode)
            {
                _rosterError = $"Optimizer error: {await response.Content.ReadAsStringAsync()}";
                return;
            }

            _rosterResult = await response.Content.ReadFromJsonAsync<OptimizerResult>();
            if (_rosterResult is not null)
                Snackbar.Add($"Lineup optimized — {_rosterResult.TotalProjectedPoints:F1} pts.", Severity.Success);
        }
        catch (Exception ex) { _rosterError = $"Error: {ex.Message}"; }
        finally { _rosterOptimizing = false; }
    }


    private static string PositionClass(string pos) => pos switch
    {
        "QB" => "fc-chip-qb",
        "RB" => "fc-chip-rb",
        "WR" => "fc-chip-wr",
        "TE" => "fc-chip-te",
        _ => ""
    };

    private static string PoolRowClass(PoolPlayer p) => p.State switch
    {
        PlayerState.Locked => "fc-pool-row--locked",
        PlayerState.Excluded => "fc-pool-row--excluded",
        _ => ""
    };

    private static string PoolBadge(PoolPlayer p) => p.State switch
    {
        PlayerState.Locked => "🔒",
        PlayerState.Excluded => "❌",
        _ => ""
    };

    // ── DTOs ─────────────────────────────────────────────────
    private enum PlayerState { Normal, Locked, Excluded }

    private class PoolPlayer
    {
        /// <summary>nflverse GSIS id, e.g. "00-0023459" — NOT the Sleeper id.</summary>
        public string PlayerId { get; set; } = "";
        /// <summary>Sleeper id, e.g. "96" — the only key a Sleeper roster joins on.</summary>
        public string? SleeperPlayerId { get; set; }
        public string PlayerName { get; set; } = "";
        public string Position { get; set; } = "";
        public string NflTeam { get; set; } = "";
        public decimal Median { get; set; }
        public decimal Mean { get; set; }

        /// <summary>
        /// Expected points — what the optimiser maximises and what every other page
        /// now shows. Falls back to Median for legacy rows written before Mean.
        /// </summary>
        public decimal Proj => Mean > 0m ? Mean : Median;

        public decimal Floor { get; set; }
        public decimal Ceiling { get; set; }
        public decimal BoomProbability { get; set; }
        public decimal BustProbability { get; set; }
        public PlayerState State { get; set; } = PlayerState.Normal;
    }

    private record OptimizerResult(
        bool Success,
        List<OptimizedSlot> Lineup,
        decimal TotalProjectedPoints,
        string Mode,
        string? RiskProfile);

    private record OptimizedSlot(
        string PlayerId,
        string PlayerName,
        string Position,
        string SlotType,
        decimal ProjectedPoints,
        decimal? RiskScore);

    private record MyRosterDto(
        string TeamName, string OwnerName, string LeagueId,
        int Wins, int Losses, int WaiverPosition,
        List<RosterPlayerRef> Players);

    private record RosterPlayerRef(
        string SleeperPlayerId, string PlayerName,
        string Position, string NflTeam);
}