@page "/players/{PlayerId}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>@(_sim?.PlayerName ?? "Player") — FantasyCombine.AI</PageTitle>

@* ── BACK BUTTON ─────────────────────────────────────────── *@
<MudButton StartIcon="@Icons.Material.Filled.ArrowBack"
           Variant="Variant.Text"
           Color="Color.Default"
           OnClick='@(() => Nav.NavigateTo("/projections"))'
           Class="mb-3">
    Back to Projections
</MudButton>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else if (_sim is null)
{
    <MudAlert Severity="Severity.Warning">
        No data found for this player. Try a different season or week.
    </MudAlert>
}
else
{
    @* ── PLAYER HEADER ───────────────────────────────────────── *@
    <div class="fc-player-header mb-4">
        <div class="fc-player-header-left">
            <div class="fc-slot-pos-badge @PositionClass(_sim.Position) fc-player-pos-badge">
                @_sim.Position
            </div>
            <div>
                <MudText Typo="Typo.h4" Class="fc-page-title">@_sim.PlayerName</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    @_sim.NflTeam
                    @if (!string.IsNullOrEmpty(_sim.OpponentTeam) && _sim.OpponentTeam != "UNK")
                    {
                        <span> vs @_sim.OpponentTeam</span>
                    }
                    · Season @_season · Week @_week
                </MudText>
            </div>
        </div>
        <div class="fc-player-header-right">
            <MudChip T="string" Class="@ScriptClass(_sim.GameScript)" Size="Size.Medium">
                @ScriptLabel(_sim.GameScript)
            </MudChip>
            @if (_sim.Spread != 0)
            {
                <MudChip T="string"
                         Class="@(_sim.Spread > 0 ? "fc-chip-favoured-lg" : "fc-chip-dog-lg")"
                         Size="Size.Medium">
                    @(_sim.Spread > 0 ? $"+{_sim.Spread:F1}" : $"{_sim.Spread:F1}")
                </MudChip>
            }
        </div>
    </div>

    @* ── WEEK / SEASON CONTROLS ──────────────────────────────── *@
    <MudPaper Class="fc-controls-bar mb-4 pa-3" Elevation="0">
        <MudGrid Spacing="2">
            <MudItem xs="6" sm="3" md="2">
                <MudNumericField @bind-Value="_season"
                                 Label="Season"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Min="2022" Max="2030" />
            </MudItem>
            <MudItem xs="6" sm="3" md="2">
                <MudNumericField @bind-Value="_week"
                                 Label="Week"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Min="1" Max="18" />
            </MudItem>
            <MudItem xs="12" sm="3" md="2" Class="d-flex align-end">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Style="height:56px;"
                           OnClick="LoadData">
                    Load
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudGrid Spacing="3">

        @* ── SIMULATION CARD ─────────────────────────────────── *@
        <MudItem xs="12" md="6">
            <MudPaper Class="fc-card pa-4" Elevation="0">
                <MudText Typo="Typo.subtitle2" Class="fc-section-label mb-3">
                    MONTE CARLO SIMULATION
                </MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary mb-3 d-block">
                    @_sim.Iterations.ToString("N0") iterations · @_sim.ScoringFormat
                </MudText>

                @* Distribution bar *@
                <div class="fc-dist-bar mb-4">
                    <div class="fc-dist-label">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">FLOOR</MudText>
                        <MudText Typo="Typo.h6" Class="fc-stat">@_sim.Floor.ToString("F1")</MudText>
                    </div>
                    <div class="fc-dist-track">
                        <div class="fc-dist-fill" style="width: @FloorPct%"></div>
                        <div class="fc-dist-median" style="left: @MedianPct%">
                            <MudText Typo="Typo.caption" Class="fc-cyan" Style="white-space:nowrap;">
                                @_sim.Median.ToString("F1")
                            </MudText>
                        </div>
                    </div>
                    <div class="fc-dist-label fc-dist-label--right">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">CEILING</MudText>
                        <MudText Typo="Typo.h6" Class="fc-ceiling fc-stat">@_sim.Ceiling.ToString("F1")</MudText>
                    </div>
                </div>

                @* Stat grid *@
                <MudGrid Spacing="2">
                    <MudItem xs="6">
                        <div class="fc-stat-mini">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Median</MudText>
                            <MudText Typo="Typo.h5" Class="fc-stat fc-cyan">@_sim.Median.ToString("F1")</MudText>
                        </div>
                    </MudItem>
                    <MudItem xs="6">
                        <div class="fc-stat-mini">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Mean</MudText>
                            <MudText Typo="Typo.h5" Class="fc-stat">@_sim.Mean.ToString("F1")</MudText>
                        </div>
                    </MudItem>
                    <MudItem xs="6">
                        <div class="fc-stat-mini">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Boom% (≥2x)</MudText>
                            <MudText Typo="Typo.h5" Class="@(_sim.BoomProbability >= 0.3m ? "fc-stat fc-boom" : "fc-stat")">
                                @((_sim.BoomProbability * 100).ToString("F0"))%
                            </MudText>
                        </div>
                    </MudItem>
                    <MudItem xs="6">
                        <div class="fc-stat-mini">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Bust% (≤0.5x)</MudText>
                            <MudText Typo="Typo.h5" Class="@(_sim.BustProbability >= 0.3m ? "fc-stat fc-bust" : "fc-stat")">
                                @((_sim.BustProbability * 100).ToString("F0"))%
                            </MudText>
                        </div>
                    </MudItem>
                    <MudItem xs="6">
                        <div class="fc-stat-mini">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Std Dev</MudText>
                            <MudText Typo="Typo.body1" Class="fc-stat">±@_sim.StandardDeviation.ToString("F1")</MudText>
                        </div>
                    </MudItem>
                    <MudItem xs="6">
                        <div class="fc-stat-mini">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Role</MudText>
                            <MudText Typo="Typo.body1" Class="fc-stat">@FormatRole(_sim.PlayerRole)</MudText>
                        </div>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>

        @* ── PROJECTION MODEL CARD ───────────────────────────── *@
        <MudItem xs="12" md="6">
            <MudPaper Class="fc-card pa-4" Elevation="0">
                <MudText Typo="Typo.subtitle2" Class="fc-section-label mb-3">
                    PROJECTION MODEL
                </MudText>

                @if (_proj is not null)
                {
                    <MudGrid Spacing="2">
                        <MudItem xs="6">
                            <div class="fc-stat-mini">
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Half PPR</MudText>
                                <MudText Typo="Typo.h5" Class="fc-stat fc-cyan">@_proj.ProjectedPointsHalfPpr.ToString("F1")</MudText>
                            </div>
                        </MudItem>
                        <MudItem xs="6">
                            <div class="fc-stat-mini">
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Full PPR</MudText>
                                <MudText Typo="Typo.h5" Class="fc-stat">@_proj.ProjectedPointsPpr.ToString("F1")</MudText>
                            </div>
                        </MudItem>
                        <MudItem xs="6">
                            <div class="fc-stat-mini">
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Standard</MudText>
                                <MudText Typo="Typo.body1" Class="fc-stat">@_proj.ProjectedPoints.ToString("F1")</MudText>
                            </div>
                        </MudItem>
                        <MudItem xs="6">
                            <div class="fc-stat-mini">
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Weighted Avg</MudText>
                                <MudText Typo="Typo.body1" Class="fc-stat">@_proj.WeightedAvgPoints.ToString("F1")</MudText>
                            </div>
                        </MudItem>
                        <MudItem xs="12">
                            <MudDivider Class="my-1" />
                        </MudItem>
                        <MudItem xs="6">
                            <div class="fc-stat-mini">
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Matchup Factor</MudText>
                                @{
                                    var matchupClass = MatchupClass(_proj.MatchupAdjustmentFactor) + " fc-stat";
                                }
                                <MudText Typo="Typo.body1" Class="@matchupClass">
                                    @_proj.MatchupAdjustmentFactor.ToString("F3")
                                </MudText>
                            </div>
                        </MudItem>
                        <MudItem xs="6">
                            <div class="fc-stat-mini">
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">R²</MudText>
                                <MudText Typo="Typo.body1" Class="fc-stat">@_proj.RSquared.ToString("F3")</MudText>
                            </div>
                        </MudItem>
                        <MudItem xs="6">
                            <div class="fc-stat-mini">
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Snap %</MudText>
                                <MudText Typo="Typo.body1" Class="fc-stat">@((_proj.SnapPctInput * 100).ToString("F0"))%</MudText>
                            </div>
                        </MudItem>
                        <MudItem xs="6">
                            <div class="fc-stat-mini">
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Target Share</MudText>
                                <MudText Typo="Typo.body1" Class="fc-stat">@((_proj.TargetShareInput * 100).ToString("F0"))%</MudText>
                            </div>
                        </MudItem>
                        <MudItem xs="6">
                            <div class="fc-stat-mini">
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Sample (games)</MudText>
                                <MudText Typo="Typo.body1" Class="fc-stat">@_proj.GameSampleSize</MudText>
                            </div>
                        </MudItem>
                        <MudItem xs="6">
                            <div class="fc-stat-mini">
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Game Script</MudText>
                                <MudText Typo="Typo.body1" Class="fc-stat">@ScriptLabel(_proj.GameScript)</MudText>
                            </div>
                        </MudItem>
                    </MudGrid>
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        No projection model data for this week.
                    </MudAlert>
                }
            </MudPaper>
        </MudItem>

        @* ── USAGE METRICS CARD ──────────────────────────────── *@
        @if (_usage is not null)
        {
            <MudItem xs="12">
                <MudPaper Class="fc-card pa-4" Elevation="0">
                    <MudText Typo="Typo.subtitle2" Class="fc-section-label mb-3">
                        USAGE METRICS — @_usage.Season SEASON
                    </MudText>

                    <MudGrid Spacing="3">
                        @* Snap % *@
                        <MudItem xs="12" sm="6" md="4">
                            <MudText Typo="Typo.caption" Class="fc-metric-label">SNAP %</MudText>
                            @UsageRow("3wk",    (_usage.SnapPct3Wk * 100).ToString("F0") + "%")
                            @UsageRow("5wk",    (_usage.SnapPct5Wk * 100).ToString("F0") + "%")
                            @UsageRow("Season", (_usage.SnapPctSeason * 100).ToString("F0") + "%")
                        </MudItem>

                        @* Target Share (WR/TE/QB only) *@
                        @if (_usage.Position is "WR" or "TE" or "QB")
                        {
                            <MudItem xs="12" sm="6" md="4">
                                <MudText Typo="Typo.caption" Class="fc-metric-label">TARGET SHARE</MudText>
                                @UsageRow("3wk",    (_usage.TargetShare3Wk * 100).ToString("F0") + "%")
                                @UsageRow("5wk",    (_usage.TargetShare5Wk * 100).ToString("F0") + "%")
                                @UsageRow("Season", (_usage.TargetShareSeason * 100).ToString("F0") + "%")
                            </MudItem>

                            <MudItem xs="12" sm="6" md="4">
                                <MudText Typo="Typo.caption" Class="fc-metric-label">aDOT</MudText>
                                @UsageRow("3wk",    _usage.ADot3Wk.ToString("F1") + " yds")
                                @UsageRow("5wk",    _usage.ADot5Wk.ToString("F1") + " yds")
                                @UsageRow("Season", _usage.ADotSeason.ToString("F1") + " yds")
                            </MudItem>

                            <MudItem xs="12" sm="6" md="4">
                                <MudText Typo="Typo.caption" Class="fc-metric-label">TPRR</MudText>
                                @UsageRow("3wk",    _usage.Tprr3Wk.ToString("F3"))
                                @UsageRow("5wk",    _usage.Tprr5Wk.ToString("F3"))
                                @UsageRow("Season", _usage.TprrSeason.ToString("F3"))
                            </MudItem>

                            <MudItem xs="12" sm="6" md="4">
                                <MudText Typo="Typo.caption" Class="fc-metric-label">WOPR</MudText>
                                @UsageRow("3wk",    _usage.Wopr3Wk.ToString("F3"))
                                @UsageRow("5wk",    _usage.Wopr5Wk.ToString("F3"))
                                @UsageRow("Season", _usage.WoprSeason.ToString("F3"))
                            </MudItem>

                            <MudItem xs="12" sm="6" md="4">
                                <MudText Typo="Typo.caption" Class="fc-metric-label">AIR YARDS SHARE</MudText>
                                @UsageRow("3wk",    (_usage.AirYardsShare3Wk * 100).ToString("F0") + "%")
                                @UsageRow("5wk",    (_usage.AirYardsShare5Wk * 100).ToString("F0") + "%")
                                @UsageRow("Season", (_usage.AirYardsShareSeason * 100).ToString("F0") + "%")
                            </MudItem>
                        }

                        @* Carry Share (RB only) *@
                        @if (_usage.Position == "RB")
                        {
                            <MudItem xs="12" sm="6" md="4">
                                <MudText Typo="Typo.caption" Class="fc-metric-label">CARRY SHARE</MudText>
                                @UsageRow("3wk",    (_usage.CarryShare3Wk * 100).ToString("F0") + "%")
                                @UsageRow("5wk",    (_usage.CarryShare5Wk * 100).ToString("F0") + "%")
                                @UsageRow("Season", (_usage.CarryShareSeason * 100).ToString("F0") + "%")
                            </MudItem>
                        }
                    </MudGrid>
                </MudPaper>
            </MudItem>
        }

    </MudGrid>
}

@code {
        [Parameter] public string PlayerId { get; set; } = string.Empty;

    //private int _season = DateTime.UtcNow.Month >= 3 ? DateTime.UtcNow.Year : DateTime.UtcNow.Year - 1;
        //    private int _week;
    private int _season = 2024;
    private int _week = 18;


    private bool _loading;

    private SimDetail? _sim;
    private ProjDetail? _proj;
    private UsageDetail? _usage;

    // Distribution bar percentages
    private double FloorPct   => _sim is null ? 0 : Math.Min(100, (double)(_sim.Floor   / (_sim.Ceiling == 0 ? 1 : _sim.Ceiling)) * 100);
    private double MedianPct  => _sim is null ? 50 : Math.Min(95, (double)(_sim.Median  / (_sim.Ceiling == 0 ? 1 : _sim.Ceiling)) * 100);

    protected override async Task OnInitializedAsync()
    {
        _week = GetCurrentNflWeek();
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        _sim = null;
        _proj = null;
        _usage = null;
        StateHasChanged();

        try
        {
            _sim = await Http.GetFromJsonAsync<SimDetail>(
                $"api/v1/players/{PlayerId}/simulation?season={_season}&week={_week}");
        }
        catch { /* 404 = no sim data for this week */ }

        try
        {
            _proj = await Http.GetFromJsonAsync<ProjDetail>(
                $"api/v1/players/{PlayerId}/projection?season={_season}&week={_week}");
        }
        catch { /* 404 = no projection data for this week */ }

        try
        {
            _usage = await Http.GetFromJsonAsync<UsageDetail>(
                $"api/v1/usage-metrics/{PlayerId}?season={_season}");
        }
        catch { /* 404 = no usage metrics for this season */ }

        _loading = false;
    }

    // ── Helpers ──────────────────────────────────────────────
    private static int GetCurrentNflWeek()
    {
        var now    = DateTime.UtcNow;
        var season = now.Month >= 3 ? now.Year : now.Year - 1;
        var sept1  = new DateTime(season, 9, 1, 0, 0, 0, DateTimeKind.Utc);
        var daysUntilThursday = ((int)DayOfWeek.Thursday - (int)sept1.DayOfWeek + 7) % 7;
        var seasonStart = sept1.AddDays(daysUntilThursday);
        if (now < seasonStart) return 18;
        var week = (int)((now - seasonStart).TotalDays / 7) + 1;
        return Math.Clamp(week, 1, 18);
    }

    private static string PositionClass(string pos) => pos switch
    {
        "QB" => "fc-chip-qb", "RB" => "fc-chip-rb",
        "WR" => "fc-chip-wr", "TE" => "fc-chip-te", _ => ""
    };

    private static string ScriptClass(string script) => script switch
    {
        "BlowoutWin"  => "fc-chip-blowout",
        "Trailing"    => "fc-chip-trailing",
        "Competitive" => "fc-chip-competitive",
        _             => "fc-chip-neutral"
    };

    private static string ScriptLabel(string script) => script switch
    {
        "BlowoutWin"  => "Blowout",
        "Trailing"    => "Chase",
        "Competitive" => "Even",
        _             => "—"
    };

    private static string MatchupClass(decimal factor) =>
        factor >= 1.05m ? "fc-favoured" : factor <= 0.95m ? "fc-bust" : "";

    private static string FormatRole(string role) => role switch
    {
        "WR1Alpha"       => "WR1 Alpha",
        "SlotPossession" => "Slot",
        "DeepThreat"     => "Deep Threat",
        "BellCow"        => "Bell Cow",
        "PassCatcher"    => "Pass Catcher",
        "Handcuff"       => "Handcuff",
        "SeamReceiver"   => "Seam",
        "BlockerSpot"    => "Blocker",
        "StartingQB"     => "Starter",
        "BackupQB"       => "Backup",
        _                => role
    };

    private static RenderFragment UsageRow(string label, string value) => __builder =>
    {
        <div class="fc-usage-row">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@label</MudText>
            <MudText Typo="Typo.body2" Class="fc-stat">@value</MudText>
        </div>
    };

    // ── DTOs ─────────────────────────────────────────────────
    private record SimDetail(
        string PlayerId, string PlayerName, string Position,
        string NflTeam, string OpponentTeam,
        int Iterations, decimal BaseProjection, decimal StandardDeviation,
        decimal Floor, decimal Median, decimal Ceiling, decimal Mean,
        decimal BoomProbability, decimal BustProbability,
        string PlayerRole, string ScoringFormat,
        decimal Spread, string GameScript);

    private record ProjDetail(
        string PlayerId, string PlayerName, string Position,
        string NflTeam, string OpponentTeam,
        decimal ProjectedPoints, decimal ProjectedPointsPpr, decimal ProjectedPointsHalfPpr,
        decimal WeightedAvgPoints, decimal MatchupAdjustmentFactor,
        decimal SnapPctInput, decimal TargetShareInput,
        int GameSampleSize, decimal RSquared,
        string GameScript, decimal SpreadInput,
        decimal RbVolumeMultiplier, decimal WrTeVolumeMultiplier);

    private record UsageDetail(
        string PlayerId, string PlayerName, string Position, string NflTeam, int Season,
        decimal SnapPct3Wk, decimal SnapPct5Wk, decimal SnapPctSeason,
        decimal TargetShare3Wk, decimal TargetShare5Wk, decimal TargetShareSeason,
        decimal AirYardsShare3Wk, decimal AirYardsShare5Wk, decimal AirYardsShareSeason,
        decimal Wopr3Wk, decimal Wopr5Wk, decimal WoprSeason,
        decimal CarryShare3Wk, decimal CarryShare5Wk, decimal CarryShareSeason,
        decimal ADot3Wk, decimal ADot5Wk, decimal ADotSeason,
        decimal Tprr3Wk, decimal Tprr5Wk, decimal TprrSeason,
        string Role);
}