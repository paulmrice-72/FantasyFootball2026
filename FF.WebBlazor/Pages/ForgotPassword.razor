@page "/forgot-password"
@using System.Net.Http.Json
@layout LoginLayout
@inject HttpClient Http
@inject NavigationManager Navigation

<style>
    .login-bg {
        min-height: 100vh; width: 100%;
        background-image: url('/images/ff_bg_wide.jpg');
        background-size: cover; background-position: center top;
        background-repeat: no-repeat;
        display: flex; align-items: center; justify-content: flex-end;
        position: relative; margin: 0; padding: 0;
    }
    .login-bg::before {
        content: ''; position: absolute; inset: 0;
        background: linear-gradient(135deg, rgba(0,20,60,0.75) 0%, rgba(0,10,40,0.60) 100%);
        z-index: 0;
    }
    .login-card-wrapper {
        position: relative; z-index: 1; width: 100%;
        max-width: 420px; padding: 16px; margin-right: 8%;
    }
    .login-card { background: rgba(255,255,255,0.97) !important; border-radius: 16px !important; box-shadow: 0 24px 64px rgba(0,0,0,0.5) !important; padding: 40px 36px !important; }
    .login-title { font-size: 1.6rem; font-weight: 800; color: #1a237e; text-align: center; margin-bottom: 4px; }
    .login-subtitle { font-size: 0.85rem; color: #607d8b; text-align: center; margin-bottom: 28px; }
    .login-badge { display: inline-block; background: linear-gradient(90deg,#1a237e,#00b0ff); color: white; font-size: 0.7rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; padding: 4px 14px; border-radius: 20px; margin-bottom: 20px; }
    @@media (max-width: 768px) { .login-bg { justify-content: center; } .login-card-wrapper { margin-right: 0; } }
</style>

<div class="login-bg">
    <div class="login-card-wrapper">
        <MudPaper Class="login-card" Elevation="0">
            <div style="text-align:center; margin-bottom: 8px;">
                <span class="login-badge">&#127944; FantasyCombine.AI</span>
            </div>
            <div class="login-title">Reset Password</div>
            <div class="login-subtitle">Enter your email and we'll send a reset link</div>

            @if (_submitted)
            {
                <MudAlert Severity="Severity.Success" Class="mb-4">
                    If that email exists, a reset link has been sent. Check your inbox.
                </MudAlert>
                <MudButton Variant="Variant.Text" FullWidth="true" Href="/login" Style="color:#1565c0;font-weight:700;">
                    Back to Sign In
                </MudButton>
            }
            else
            {
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true">@_errorMessage</MudAlert>
                }

                <MudTextField @bind-Value="_email"
                              Label="Email Address"
                              InputType="InputType.Email"
                              Variant="Variant.Outlined"
                              Class="mb-5"
                              FullWidth="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Email"
                              AdornmentColor="Color.Primary" />

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           Disabled="_isLoading"
                           OnClick="HandleSubmit"
                           Style="background: linear-gradient(90deg, #1a237e, #1565c0); border-radius: 8px; font-weight: 700; letter-spacing: 1px; padding: 12px;">
                    @if (_isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" Color="Color.Surface" />
                        <span>Sending...</span>
                    }
                    else
                    {
                        <span>Send Reset Link</span>
                    }
                </MudButton>

                <MudDivider Class="my-4" />
                <MudText Align="Align.Center" Typo="Typo.body2" Style="color:#607d8b;">
                    Remember your password?
                    <MudLink Href="/login" Style="font-weight:700;color:#1565c0;">Sign In</MudLink>
                </MudText>
            }
        </MudPaper>
    </div>
</div>

@code {
    private string _email = string.Empty;
    private string _errorMessage = string.Empty;
    private bool _isLoading = false;
    private bool _submitted = false;

    private async Task HandleSubmit()
    {
        _errorMessage = string.Empty;
        _isLoading = true;

        try
        {
            var response = await Http.PostAsJsonAsync(
                "api/v1/auth/forgot-password",
                new { Email = _email });

            _submitted = true;
        }
        catch
        {
            _errorMessage = "Something went wrong. Please try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }
}