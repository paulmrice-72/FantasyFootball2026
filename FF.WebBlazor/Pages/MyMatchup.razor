@page "/my-matchup"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject LeagueStateService LeagueState
@inject NflContextClientService NflContext
@implements IDisposable

<PageTitle>My Matchup — FantasyCombine.AI</PageTitle>

<div class="fc-page-header mb-4">
    <MudText Typo="Typo.h5" Class="fc-page-title">
        <MudIcon Icon="@Icons.Material.Filled.SportsMma" Class="mr-2" Style="vertical-align:middle;" />
        My Matchup
    </MudText>

    @* ── WEEK NAVIGATION ─────────────────────────────────────────────────────── *@
    <div class="d-flex align-center gap-2 mt-1">
        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                       Size="Size.Small"
                       Disabled="@(_week <= 1)"
                       OnClick="@(() => ChangeWeek(_week - 1))" />
        <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="min-width:60px; text-align:center;">
            Week @_week · @_season
        </MudText>
        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                       Size="Size.Small"
                       Disabled="@(_week >= 18)"
                       OnClick="@(() => ChangeWeek(_week + 1))" />
        @if (_week != _currentWeek)
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                     OnClick="@(() => ChangeWeek(_currentWeek))"
                     Style="cursor:pointer; height:22px; font-size:0.7rem;">
                Current week
            </MudChip>
        }
    </div>
</div>

@* ── FUTURE WEEK DISCLAIMER ──────────────────────────────────────────────────── *@
@if (_week > _currentWeek)
{
    <MudAlert Severity="Severity.Info" Class="mb-3" Dense="true">
        Week @_week projections shown. Sleeper opponent matchups are not published beyond the current week — opponent may differ when the schedule is released.
    </MudAlert>
}

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else if (_noSleeper)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        No Sleeper account linked. <MudLink Href="/settings/sleeper">Link your Sleeper account</MudLink>.
    </MudAlert>
}
else if (_noLeague)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">
        No active league found. Import a league from <MudLink Href="/settings/sleeper">Sleeper settings</MudLink>.
    </MudAlert>
}
else if (_matchup is null)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">
        No matchup data found for Week @_week. Sleeper may not have published matchups yet, or this is the off-season.
    </MudAlert>
}
else
{
    @* ── WIN PROBABILITY BANNER ──────────────────────────────────────────────── *@
    <MudPaper Class="fc-card pa-4 mb-4" Elevation="0">
        <MudGrid Spacing="0" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">

            @* My side *@
            <MudItem xs="5" Class="text-center">
                <MudText Typo="Typo.h6" Style="font-weight:700;">@_matchup.MyTeam.TeamName</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@_matchup.MyTeam.OwnerName</MudText>
                @if (_matchup.MyActualPoints.HasValue)
                {
                    <div class="d-flex align-center gap-2 mt-1">
                        @if (_matchup.MyActualPoints.Value > (_matchup.OpponentActualPoints ?? 0))
                        {
                            <MudIcon Icon="@Icons.Material.Filled.EmojiEvents"
                                     Style="color:#FFD700; font-size:2rem;" Title="WIN" />
                        }
                        <MudText Typo="Typo.h3" Class="fc-stat fc-cyan">
                            @_matchup.MyActualPoints.Value.ToString("F2")
                        </MudText>
                    </div>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        actual · proj @_matchup.MyTeam.TotalProjectedPoints.ToString("F1")
                    </MudText>
                }
                else
                {
                    <MudText Typo="Typo.h3" Class="fc-stat fc-cyan mt-1">
                        @_matchup.MyTeam.TotalProjectedPoints.ToString("F1")
                    </MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">projected</MudText>
                }

                <div class="mt-2">
                    <MudChip T="string" Color="@WinProbColor(_matchup.MyWinProbability)" Size="Size.Medium" Variant="Variant.Filled">
                        @((_matchup.MyWinProbability * 100).ToString("F0"))% win prob
                    </MudChip>
                </div>
            </MudItem>

            @* Centre column *@
            <MudItem xs="2" Class="text-center">
                <MudText Typo="Typo.h5" Class="mud-text-secondary" Style="font-weight:300;">vs</MudText>
                <MudDivider Vertical="true" Class="my-1" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Wk @_matchup.Week</MudText>
            </MudItem>

            @* Opponent side *@
            <MudItem xs="5" Class="text-center">
                <MudLink Href="@($"league/teams?rosterId={_matchup.Opponent.SleeperRosterId}")" Style="text-decoration:none; color:inherit;">
                    <MudText Typo="Typo.h6" Style="font-weight:700; cursor:pointer;">
                        @_matchup.Opponent.TeamName
                    </MudText>
                </MudLink>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@_matchup.Opponent.OwnerName</MudText>

                @if (_matchup.OpponentActualPoints.HasValue)
                {
                    <MudText Typo="Typo.h3" Class="fc-stat fc-ceiling mt-1">
                        @_matchup.OpponentActualPoints.Value.ToString("F2")
                    </MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        actual · proj @_matchup.Opponent.TotalProjectedPoints.ToString("F1")
                    </MudText>
                }
                else
                {
                    <MudText Typo="Typo.h3" Class="fc-stat fc-ceiling mt-1">
                        @_matchup.Opponent.TotalProjectedPoints.ToString("F1")
                    </MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">projected</MudText>
                }

                <div class="mt-2">
                    <MudChip T="string" Color="@WinProbColor(_matchup.OpponentWinProbability)" Size="Size.Medium" Variant="Variant.Filled">
                        @((_matchup.OpponentWinProbability * 100).ToString("F0"))% win prob
                    </MudChip>
                </div>
            </MudItem>
        </MudGrid>

        @* Floor / Ceiling range *@
        <MudDivider Class="my-3" />
        <MudGrid Spacing="0">
            <MudItem xs="5" Class="text-center">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Floor @_matchup.MyTeam.ProjectedFloor.ToString("F1") — Ceiling @_matchup.MyTeam.ProjectedCeiling.ToString("F1")
                </MudText>
            </MudItem>
            <MudItem xs="2" />
            <MudItem xs="5" Class="text-center">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Floor @_matchup.Opponent.ProjectedFloor.ToString("F1") — Ceiling @_matchup.Opponent.ProjectedCeiling.ToString("F1")
                </MudText>
            </MudItem>
        </MudGrid>

        @* ── INTELLIGENCE SUMMARIES ───────────────────────────────────────────── *@
        @{
            var myStarters = _matchup.MyTeam.Players.Where(p => p.IsStarter).ToList();
            var gameScriptSummary = BuildGameScriptSummary(myStarters);
            var boomBustSummary = BuildBoomBustSummary(myStarters);
        }
        @if (gameScriptSummary is not null || boomBustSummary is not null)
        {
            <MudDivider Class="my-3" />
            <MudGrid Spacing="1">
                @if (gameScriptSummary is not null)
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            <MudIcon Icon="@Icons.Material.Filled.SportsFootball" Size="Size.Small" Class="mr-1" Style="vertical-align:middle;" />
                            @gameScriptSummary
                        </MudText>
                    </MudItem>
                }
                @if (boomBustSummary is not null)
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            <MudIcon Icon="@Icons.Material.Filled.Insights" Size="Size.Small" Class="mr-1" Style="vertical-align:middle;" />
                            @boomBustSummary
                        </MudText>
                    </MudItem>
                }
            </MudGrid>
        }

        @* ── OPTIMIZE MY LINEUP BUTTON ────────────────────────────────────────── *@
        <MudDivider Class="my-3" />
        <div class="d-flex justify-center">
            <MudButton Href="/my-team"
                       Variant="Variant.Outlined"
                       Color="Color.Primary"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.AutoFixHigh">
                Optimize My Lineup
            </MudButton>
        </div>
    </MudPaper>

    @* Scoring format label *@
    @if (!string.IsNullOrEmpty(_matchup.ScoringFormat))
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary mb-3 d-block">
            Scoring: @_matchup.ScoringFormat
        </MudText>
    }

    @* ── SIDE-BY-SIDE PLAYER TABLES ──────────────────────────────────────────── *@
    <MudGrid Spacing="3">

        @* ── MY SIDE ── *@
        <MudItem xs="12" md="6">
            <MudText Typo="Typo.subtitle2" Class="fc-section-label mb-2">MY STARTERS</MudText>
            <MudPaper Elevation="0" Class="fc-table-paper">
                <MudTable Items="@_matchup.MyTeam.Players.Where(p => p.IsStarter).ToList()"
                          Dense="true" Hover="true" Class="fc-table">
                    <HeaderContent>
                        <MudTh>Player</MudTh>
                        <MudTh>Pos</MudTh>
                        <MudTh>Proj</MudTh>
                        <MudTh>Status</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <MudText Typo="Typo.body2" Style="font-weight:600;">@context.PlayerName</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                @context.NflTeam
                                @if (!string.IsNullOrEmpty(context.OpponentTeam))
                                {
                                    <span> vs @context.OpponentTeam</span>
                                }
                            </MudText>
                        </MudTd>
                        <MudTd>
                            <MudChip T="string" Size="Size.Small" Class="@PositionClass(context.Position)" Variant="Variant.Filled">
                                @context.Position
                            </MudChip>
                        </MudTd>
                        <MudTd>
                            @RenderProjectedPoints(context, true)
                            @RenderBoomBust(context)
                            @RenderGameScript(context)
                        </MudTd>
                        <MudTd>
                            @if (!string.IsNullOrEmpty(context.InjuryDesignation))
                            {
                                <MudChip T="string" Size="Size.Small" Color="@InjuryColor(context.InjuryDesignation)" Variant="Variant.Filled">
                                    @context.InjuryDesignation
                                </MudChip>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>

            @* My bench *@
            @if (_matchup.MyTeam.Players.Any(p => !p.IsStarter))
            {
                <MudText Typo="Typo.subtitle2" Class="fc-section-label mb-2 mt-4">MY BENCH</MudText>
                <MudPaper Elevation="0" Class="fc-table-paper">
                    <MudTable Items="@_matchup.MyTeam.Players.Where(p => !p.IsStarter).ToList()"
                              Dense="true" Hover="true" Class="fc-table">
                        <HeaderContent>
                            <MudTh>Player</MudTh>
                            <MudTh>Pos</MudTh>
                            <MudTh>Proj</MudTh>
                            <MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <MudText Typo="Typo.body2" Style="font-weight:600;">@context.PlayerName</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.NflTeam</MudText>
                            </MudTd>
                            <MudTd>
                                <MudChip T="string" Size="Size.Small" Class="@PositionClass(context.Position)" Variant="Variant.Filled">
                                    @context.Position
                                </MudChip>
                            </MudTd>
                            <MudTd>
                                @RenderProjectedPoints(context, false)
                                @RenderBoomBust(context)
                            </MudTd>
                            <MudTd>
                                @if (ShouldConsiderStarting(context, _matchup.MyTeam.Players))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">
                                        Consider Starting
                                    </MudChip>
                                }
                                @if (!string.IsNullOrEmpty(context.InjuryDesignation))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="@InjuryColor(context.InjuryDesignation)" Variant="Variant.Filled">
                                        @context.InjuryDesignation
                                    </MudChip>
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            }
        </MudItem>

        @* ── OPPONENT SIDE ── *@
        <MudItem xs="12" md="6">
            <div class="d-flex align-center gap-3 mb-2">
                <MudText Typo="Typo.subtitle2" Class="fc-section-label">OPPONENT STARTERS</MudText>
                <MudLink Href="@($"league/teams?rosterId={_matchup.Opponent.SleeperRosterId}")"
                         Typo="Typo.caption" Style="color: var(--fc-amber);">
                    Scout full roster →
                </MudLink>
            </div>
            <MudPaper Elevation="0" Class="fc-table-paper">
                <MudTable Items="@_matchup.Opponent.Players.Where(p => p.IsStarter).ToList()"
                          Dense="true" Hover="true" Class="fc-table">
                    <HeaderContent>
                        <MudTh>Player</MudTh>
                        <MudTh>Pos</MudTh>
                        <MudTh>Proj</MudTh>
                        <MudTh>Status</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <MudText Typo="Typo.body2" Style="font-weight:600;">@context.PlayerName</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                @context.NflTeam
                                @if (!string.IsNullOrEmpty(context.OpponentTeam))
                                {
                                    <span> vs @context.OpponentTeam</span>
                                }
                            </MudText>
                        </MudTd>
                        <MudTd>
                            <MudChip T="string" Size="Size.Small" Class="@PositionClass(context.Position)" Variant="Variant.Filled">
                                @context.Position
                            </MudChip>
                        </MudTd>
                        <MudTd>
                            @RenderProjectedPoints(context, false)
                            @RenderBoomBust(context)
                            @RenderGameScript(context)
                        </MudTd>
                        <MudTd>
                            @if (!string.IsNullOrEmpty(context.InjuryDesignation))
                            {
                                <MudChip T="string" Size="Size.Small" Color="@InjuryColor(context.InjuryDesignation)" Variant="Variant.Filled">
                                    @context.InjuryDesignation
                                </MudChip>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>

            @* Collapsible opponent bench *@
            @if (_matchup.Opponent.Players.Any(p => !p.IsStarter))
            {
                <MudExpansionPanels Class="mt-3" Elevation="0">
                    <MudExpansionPanel Text="View opponent bench" Dense="true">
                        <MudTable Items="@_matchup.Opponent.Players.Where(p => !p.IsStarter).ToList()"
                                  Dense="true" Hover="true" Class="fc-table">
                            <HeaderContent>
                                <MudTh>Player</MudTh>
                                <MudTh>Pos</MudTh>
                                <MudTh>Proj</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>
                                    <MudText Typo="Typo.body2" Style="font-weight:600;">@context.PlayerName</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.NflTeam</MudText>
                                </MudTd>
                                <MudTd>
                                    <MudChip T="string" Size="Size.Small" Class="@PositionClass(context.Position)" Variant="Variant.Filled">
                                        @context.Position
                                    </MudChip>
                                </MudTd>
                                <MudTd>
                                    @RenderProjectedPoints(context, false)
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }
        </MudItem>
    </MudGrid>
}

@* ── PROJECTION BREAKDOWN POPOVERS ──────────────────────────────────────────── *@
@if (_matchup is not null)
{
    foreach (var player in _matchup.MyTeam.Players.Concat(_matchup.Opponent.Players))
    {
        if (player.ProjectionBreakdown is not null)
        {
            var p = player;
            <MudPopover Open="@IsPopoverOpen(p.SleeperPlayerId)"
                        AnchorOrigin="Origin.BottomLeft"
                        TransformOrigin="Origin.TopLeft"
                        Paper="true"
                        Class="fc-proj-popover pa-0">
                <MudPaper Class="pa-3" Elevation="2" Style="min-width:240px; max-width:300px;">
                    <div class="d-flex justify-space-between align-center mb-2">
                        <MudText Typo="Typo.subtitle2" Style="font-weight:700;">@p.PlayerName</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                       OnClick="@(() => ClosePopover())" />
                    </div>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2 d-block">
                        Projection Model — @p.ProjectionBreakdown.ScoringFormat · Wk @p.ProjectionBreakdown.Week
                    </MudText>
                    <MudDivider Class="mb-2" />
                    <div class="d-flex justify-space-between mb-1">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Projected Pts</MudText>
                        <MudText Typo="Typo.caption" Style="font-weight:600; color:var(--fc-cyan);">
                            @p.ProjectionBreakdown.ProjectedPoints.ToString("F1")
                        </MudText>
                    </div>
                    <div class="d-flex justify-space-between mb-1">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Wtd Avg Baseline</MudText>
                        <MudText Typo="Typo.caption">@p.ProjectionBreakdown.WeightedAvgPoints.ToString("F1")</MudText>
                    </div>
                    <div class="d-flex justify-space-between mb-1">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Matchup Factor</MudText>
                        <MudText Typo="Typo.caption" Style="@FactorStyle(p.ProjectionBreakdown.MatchupAdjustmentFactor)">
                            @(p.ProjectionBreakdown.MatchupAdjustmentFactor >= 1
                                ? $"+{((p.ProjectionBreakdown.MatchupAdjustmentFactor - 1) * 100):F0}%"
                                : $"{((p.ProjectionBreakdown.MatchupAdjustmentFactor - 1) * 100):F0}%")
                        </MudText>
                    </div>
                    @if (p.ProjectionBreakdown.SnapPctInput > 0)
                    {
                        <div class="d-flex justify-space-between mb-1">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Snap %</MudText>
                            <MudText Typo="Typo.caption">@((p.ProjectionBreakdown.SnapPctInput * 100).ToString("F0"))%</MudText>
                        </div>
                    }
                    @if (p.ProjectionBreakdown.TargetShareInput > 0)
                    {
                        <div class="d-flex justify-space-between mb-1">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Target Share</MudText>
                            <MudText Typo="Typo.caption">@((p.ProjectionBreakdown.TargetShareInput * 100).ToString("F0"))%</MudText>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(p.ProjectionBreakdown.GameScript) && p.ProjectionBreakdown.GameScript != "Unknown")
                    {
                        <div class="d-flex justify-space-between mb-1">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Game Script</MudText>
                            <MudText Typo="Typo.caption" Style="@GameScriptStyle(p.ProjectionBreakdown.GameScript)">
                                @p.ProjectionBreakdown.GameScript
                            </MudText>
                        </div>
                    }
                    @if (p.ProjectionBreakdown.SpreadInput != 0)
                    {
                        <div class="d-flex justify-space-between mb-1">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Vegas Spread</MudText>
                            <MudText Typo="Typo.caption">
                                @(p.ProjectionBreakdown.SpreadInput > 0
                                    ? $"+{p.ProjectionBreakdown.SpreadInput:F1}"
                                    : $"{p.ProjectionBreakdown.SpreadInput:F1}")
                            </MudText>
                        </div>
                    }
                    @if (p.FloorProjectedPoints.HasValue && p.CeilingProjectedPoints.HasValue)
                    {
                        <MudDivider Class="my-2" />
                        <div class="d-flex justify-space-between">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Sim Range</MudText>
                            <MudText Typo="Typo.caption">
                                @p.FloorProjectedPoints.Value.ToString("F1") – @p.CeilingProjectedPoints.Value.ToString("F1")
                            </MudText>
                        </div>
                    }
                    @if (p.BoomProbability.HasValue || p.BustProbability.HasValue)
                    {
                        <div class="d-flex justify-space-between mt-1">
                            @if (p.BoomProbability.HasValue)
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    Boom: @((p.BoomProbability.Value * 100).ToString("F0"))%
                                </MudText>
                            }
                            @if (p.BustProbability.HasValue)
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    Bust: @((p.BustProbability.Value * 100).ToString("F0"))%
                                </MudText>
                            }
                        </div>
                    }
                </MudPaper>
            </MudPopover>
        }
    }
}

@code {
    private bool _loading = true;
    private bool _noSleeper;
    private bool _noLeague;
    private MyMatchupDto? _matchup;
    private int _week;
    private int _currentWeek;
    private int _season;
    private string? _openPopoverId;

    private HttpClient Http => HttpClientFactory.CreateClient("AuthAPI");

    protected override async Task OnInitializedAsync()
    {
        (_season, _currentWeek) = await NflContext.GetContextAsync();
        _week = _currentWeek;
        LeagueState.OnLeagueChanged += OnLeagueChangedHandler;
        await LoadMatchupAsync();
    }

    private async Task ChangeWeek(int week)
    {
        _week = Math.Clamp(week, 1, 18);
        await LoadMatchupAsync();
    }

    private async Task LoadMatchupAsync()
    {
        _loading = true;
        _noSleeper = false;
        _noLeague = false;
        _matchup = null;
        _openPopoverId = null;

        try
        {
            var leagueId = LeagueState.ActiveLeagueId;
            if (string.IsNullOrEmpty(leagueId))
            {
                var context = await Http.GetFromJsonAsync<UserContextResponse>("api/v1/identity/context");
                if (context?.IsSleeperLinked != true)
                {
                    _noSleeper = true;
                    return;
                }
                leagueId = context.ActiveLeagueId;
                if (string.IsNullOrEmpty(leagueId))
                {
                    _noLeague = true;
                    return;
                }
                LeagueState.ActiveLeagueId = leagueId;
            }

            var response = await Http.GetAsync(
                $"api/v1/team/matchup?sleeperLeagueId={leagueId}&season={_season}&week={_week}");

            if (response.IsSuccessStatusCode)
                _matchup = await response.Content.ReadFromJsonAsync<MyMatchupDto>();
            else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
                _noSleeper = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading matchup: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    // ── Intelligence helpers ───────────────────────────────────────────────────

    private static string? BuildGameScriptSummary(List<MyMatchupPlayerDto> starters)
    {
        var scripts = starters
            .Where(p => !string.IsNullOrEmpty(p.GameScript) && p.GameScript != "Unknown" && p.GameScript != "Competitive")
            .Select(p => p.GameScript!)
            .ToList();

        if (scripts.Count == 0) return null;

        var favored  = scripts.Count(s => s is "Favored" or "Favorable" or "High Ceiling");
        var underdog = scripts.Count(s => s is "Underdog" or "Unfavorable" or "Negative");

        if (favored > 0 && underdog == 0)
            return $"Favorable game scripts across your lineup — projected positive game flow ({favored} starter{(favored == 1 ? "" : "s")})";
        if (underdog > 0 && favored == 0)
            return $"Your starters face underdog game scripts — volume risk this week ({underdog} starter{(underdog == 1 ? "" : "s")})";
        if (favored > underdog)
            return $"Mixed scripts with a favorable lean — {favored} favored, {underdog} underdog";
        if (underdog > favored)
            return "Mixed scripts with underdog lean — evaluate individual matchups below";
        return "Mixed game scripts this week — evaluate individual matchups below";
    }

    private static string? BuildBoomBustSummary(List<MyMatchupPlayerDto> starters)
    {
        var boomCount = starters.Count(p => p.BoomProbability.HasValue && p.BoomProbability.Value >= 0.25);
        var bustCount = starters.Count(p => p.BustProbability.HasValue && p.BustProbability.Value >= 0.30);

        if (boomCount == 0 && bustCount == 0) return null;

        if (boomCount > 0 && bustCount == 0)
            return $"High ceiling lineup — {boomCount} starter{(boomCount == 1 ? "" : "s")} with 25%+ boom probability";
        if (bustCount > 0 && boomCount == 0)
            return $"Bust risk — {bustCount} starter{(bustCount == 1 ? "" : "s")} flagged with 30%+ bust probability";
        return $"Boom/bust week — {boomCount} high-ceiling, {bustCount} bust-risk starter{(bustCount == 1 ? "" : "s")}";
    }

    private static bool ShouldConsiderStarting(MyMatchupPlayerDto bench, List<MyMatchupPlayerDto> allPlayers)
    {
        if (!bench.MedianProjectedPoints.HasValue || bench.MedianProjectedPoints.Value <= 0)
            return false;

        var startersAtPos = allPlayers
            .Where(p => p.IsStarter && p.Position == bench.Position && p.MedianProjectedPoints.HasValue)
            .ToList();

        if (startersAtPos.Count == 0) return false;

        return bench.MedianProjectedPoints.Value > startersAtPos.Min(p => p.MedianProjectedPoints!.Value);
    }

    // ── Render fragments ───────────────────────────────────────────────────────

    private RenderFragment RenderProjectedPoints(MyMatchupPlayerDto player, bool isMySide) =>
       @<text>
           <div>
               @if (player.ActualPoints.HasValue)
               {
                   @* Past week — actual is hero *@
                   var pid = player.SleeperPlayerId;
                   <MudText Typo="Typo.body2" Class="@(isMySide ? "fc-stat fc-cyan" : "fc-stat fc-ceiling")"
                            Style="font-size:1.1rem; font-weight:700;">
                       @player.ActualPoints.Value.ToString("F2")
                   </MudText>
                   @if (player.MedianProjectedPoints.HasValue)
                   {
                       <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="font-size:0.68rem;">
                           proj @player.MedianProjectedPoints.Value.ToString("F1")
                           @if (player.FloorProjectedPoints.HasValue && player.CeilingProjectedPoints.HasValue)
                           {
                               <span> (@player.FloorProjectedPoints.Value.ToString("F1")–@player.CeilingProjectedPoints.Value.ToString("F1"))</span>
                           }
                       </MudText>
                   }
               }
               else
               {
                   @* Current / future week — projected is hero *@
                   @if (player.ProjectionBreakdown is not null)
                   {
                       var pid = player.SleeperPlayerId;
                       <span @onclick="@(() => TogglePopover(pid))"
                             style="cursor:pointer; text-decoration:underline dotted;"
                             title="Click to see projection breakdown">
                           <MudText Typo="Typo.body2" Class="@(isMySide ? "fc-stat fc-cyan" : "fc-stat fc-ceiling")">
                               @(player.MedianProjectedPoints.HasValue ? player.MedianProjectedPoints.Value.ToString("F1") : "—")
                           </MudText>
                       </span>
                   }
                   else
                   {
                       <MudText Typo="Typo.body2" Class="@(isMySide ? "fc-stat fc-cyan" : "mud-text-secondary")">
                           @(player.MedianProjectedPoints.HasValue ? player.MedianProjectedPoints.Value.ToString("F1") : "—")
                       </MudText>
                   }
                   @if (player.FloorProjectedPoints.HasValue && player.CeilingProjectedPoints.HasValue)
                   {
                       <div>
                           <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="font-size:0.68rem;">
                               @player.FloorProjectedPoints.Value.ToString("F1") – @player.CeilingProjectedPoints.Value.ToString("F1")
                           </MudText>
                       </div>
                   }
               }
           </div>
       </text>;

    private RenderFragment RenderBoomBust(MyMatchupPlayerDto player) =>
        @<text>
            @if (player.BoomProbability.HasValue && player.BoomProbability.Value >= 0.25)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined"
                         Style="height:18px; font-size:0.65rem;"
                         title="@($"Boom prob: {player.BoomProbability.Value * 100:F0}%")">
                    🔥 Boom
                </MudChip>
            }
            @if (player.BustProbability.HasValue && player.BustProbability.Value >= 0.30)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined"
                         Style="height:18px; font-size:0.65rem;"
                         title="@($"Bust prob: {player.BustProbability.Value * 100:F0}%")">
                    ⚠️ Bust
                </MudChip>
            }
        </text>;

    private RenderFragment RenderGameScript(MyMatchupPlayerDto player) =>
        @<text>
            @if (player.GameScript is "Favored" or "Favorable" or "High Ceiling")
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined"
                         Style="height:18px; font-size:0.65rem;">
                    Favored
                </MudChip>
            }
            else if (player.GameScript is "Underdog" or "Unfavorable" or "Negative")
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined"
                         Style="height:18px; font-size:0.65rem;">
                    Dog
                </MudChip>
            }
        </text>;

    // ── Popover helpers ────────────────────────────────────────────────────────
    private bool IsPopoverOpen(string sleeperPlayerId) => _openPopoverId == sleeperPlayerId;
    private void TogglePopover(string sleeperPlayerId)
        => _openPopoverId = _openPopoverId == sleeperPlayerId ? null : sleeperPlayerId;
    private void ClosePopover() => _openPopoverId = null;

    // ── Style helpers ──────────────────────────────────────────────────────────
    private static string FactorStyle(double factor) =>
        factor >= 1.05 ? "color:var(--fc-green); font-weight:600;" :
        factor <= 0.95 ? "color:var(--mud-palette-error); font-weight:600;" : "";

    private static string GameScriptStyle(string script) => script switch
    {
        "Favorable" or "High Ceiling" or "Favored" => "color:var(--fc-green); font-weight:600;",
        "Unfavorable" or "Negative" or "Underdog"  => "color:var(--mud-palette-error); font-weight:600;",
        _ => ""
    };

    // ── League / season handlers ───────────────────────────────────────────────
    private void OnLeagueChangedHandler() => _ = InvokeAsync(async () =>
    {
        _week = _currentWeek;
        await LoadMatchupAsync();
        StateHasChanged();
    });

    public void Dispose() => LeagueState.OnLeagueChanged -= OnLeagueChangedHandler;

    private static Color WinProbColor(double prob) =>
        prob >= 0.65 ? Color.Success : prob >= 0.45 ? Color.Warning : Color.Error;

    private static Color InjuryColor(string d) => d switch
    {
        "Out" or "D" or "IR" => Color.Error,
        "Q" or "Doubtful"    => Color.Warning,
        _                    => Color.Default
    };

    private static string PositionClass(string pos) => pos switch
    {
        "QB" => "fc-chip-qb",
        "RB" => "fc-chip-rb",
        "WR" => "fc-chip-wr",
        "TE" => "fc-chip-te",
        _    => ""
    };

