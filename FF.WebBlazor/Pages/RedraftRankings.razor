@page "/redraft-rankings"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NflContextClientService NflContext

<PageTitle>Redraft Rankings — FantasyCombine.AI</PageTitle>

@* ── HEADER ──────────────────────────────────────────────────────────── *@
<div class="fc-page-header mb-4">
    <MudText Typo="Typo.h5" Class="fc-page-title">
        <MudIcon Icon="@Icons.Material.Filled.FormatListNumbered" Class="mr-2" Style="vertical-align:middle;" />
        Redraft Rankings
    </MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary">
        Scoring-adjusted projections · Floor · Median · Ceiling · Boom/Bust probability
    </MudText>
</div>

@* ── CONTROLS BAR ────────────────────────────────────────────────────── *@
<MudPaper Class="fc-controls-bar mb-4 pa-3" Elevation="0">
    <MudGrid Spacing="2" AlignItems="AlignItems.End">
        <MudItem xs="6" sm="3" md="2">
            <MudNumericField @bind-Value="_season" Label="Season" Variant="Variant.Outlined"
                             Margin="Margin.Dense" Min="2022" Max="2030" />
        </MudItem>
        <MudItem xs="6" sm="3" md="2">
            <MudNumericField @bind-Value="_week" Label="Week" Variant="Variant.Outlined"
                             Margin="Margin.Dense" Min="1" Max="18" />
        </MudItem>
        <MudItem xs="6" sm="3" md="2" Class="d-flex align-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       FullWidth="true" Disabled="_loading" OnClick="LoadRankings"
                       Style="height:40px;">
                Load
            </MudButton>
        </MudItem>
        <MudItem xs="12" sm="3" md="6" Class="d-flex align-end">
            <MudTextField @bind-Value="_search" Placeholder="Search player or team..."
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Immediate="true" DebounceInterval="200" FullWidth="true" />
        </MudItem>
    </MudGrid>
</MudPaper>

@* ── POSITION TABS ───────────────────────────────────────────────────── *@
<MudTabs @bind-ActivePanelIndex="_activeTab" Rounded="true" Border="true" Class="mb-4 fc-tabs" PanelClass="pa-0">
    <MudTabPanel Text="All" />
    <MudTabPanel Text="QB" />
    <MudTabPanel Text="RB" />
    <MudTabPanel Text="WR" />
    <MudTabPanel Text="TE" />
</MudTabs>

@* ── STATE ───────────────────────────────────────────────────────────── *@
@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" />
}
@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}
@if (!_loading && !_queried)
{
    <MudAlert Severity="Severity.Info">
        Select a season and week then click <strong>Load</strong> to see rankings.
        Rankings reflect scoring-adjusted median projections from your simulation engine.
    </MudAlert>
}
else if (!_loading && DisplayCount == 0 && _queried && _error is null)
{
    <MudAlert Severity="Severity.Info">
        No Week @_week simulation data AND no ADP data found for Season @_season.
        Run <code>POST /api/v1/admin/sync-ffc-adp</code> (and, once Week @_week is simulated,
        <code>POST /api/v1/admin/jobs/run-projections</code>) from the Admin console.
    </MudAlert>
}
else if (_isFallbackMode && _adpFiltered.Count > 0)
{
    @* FIX-PRESEASON-001 (2026-08-27): no Week N simulation data yet (preseason,
       or this week just hasn't been simulated) — showing the ADP-based fallback
       board instead. Separate table because Floor/Ceiling/Boom/Bust/Spread have
       no ADP equivalent; showing zeros there would look like real projections. *@
    <MudAlert Severity="Severity.Info" Class="mb-4" Icon="@Icons.Material.Filled.TrendingUp">
        Week @_week simulation data isn't in yet — showing live ADP rankings instead
        (2025 per-game average shown for context where available; blank for rookies).
    </MudAlert>
    <MudPaper Elevation="0" Class="fc-table-paper">
        <MudTable Items="@_adpFiltered" Dense="true" Hover="true" Striped="false"
                  FixedHeader="true" Height="calc(100vh - 420px)" SortLabel="Sort"
                  Class="fc-table"
                  OnRowClick="@((TableRowClickEventArgs<AdpRow> args) => { if (args.Item is not null) _ = OpenAdpPlayerCard(args.Item); })">
            <HeaderContent>
                <MudTh Style="width:44px;">#</MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<AdpRow, object>(x => x.PlayerName)">Player</MudTableSortLabel>
                </MudTh>
                <MudTh>Pos</MudTh>
                <MudTh>Team</MudTh>
                <MudTh Style="text-align:right;">
                    <MudTableSortLabel InitialDirection="SortDirection.Ascending" SortBy="new Func<AdpRow, object>(x => x.Adp)">ADP</MudTableSortLabel>
                </MudTh>
                <MudTh Style="text-align:right;">Rd</MudTh>
                <MudTh Style="text-align:right;">
                    <MudTableSortLabel SortBy="new Func<AdpRow, object>(x => x.SeasonAvgPoints ?? 0)">2025 Avg Pts</MudTableSortLabel>
                </MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="#">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary font-mono">
                        @(_adpFiltered.IndexOf(context) + 1)
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Player">
                    <MudText Typo="Typo.body2" Style="font-weight:600; color:var(--fc-cyan); cursor:pointer;">
                        @context.PlayerName
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Pos">
                    <MudChip T="string" Size="Size.Small" Class="@PositionClass(context.Position)">
                        @context.Position
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Team">
                    <MudText Typo="Typo.body2">@(context.NflTeam ?? "FA")</MudText>
                </MudTd>
                <MudTd DataLabel="ADP" Style="text-align:right;">
                    <MudText Typo="Typo.body2" Class="font-mono fc-cyan" Style="font-weight:600;">
                        @context.Adp.ToString("F1")
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Rd" Style="text-align:right;">
                    <MudText Typo="Typo.body2" Class="font-mono mud-text-secondary">
                        @context.AdpRound
                    </MudText>
                </MudTd>
                <MudTd DataLabel="2025 Avg Pts" Style="text-align:right;">
                    <MudText Typo="Typo.body2" Class="font-mono mud-text-secondary">
                        @(context.SeasonAvgPoints?.ToString("F1") ?? "—")
                    </MudText>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 25, 50, 100, 250 }" />
            </PagerContent>
        </MudTable>
    </MudPaper>
}
else if (!_isFallbackMode && _filtered.Count > 0)
{
    @* ── RANKINGS TABLE ──────────────────────────────────────────── *@
    <MudPaper Elevation="0" Class="fc-table-paper">
        <MudTable Items="@_filtered" Dense="true" Hover="true" Striped="false"
                  FixedHeader="true" Height="calc(100vh - 380px)" SortLabel="Sort"
                  Class="fc-table"
                  OnRowClick="@((TableRowClickEventArgs<SimRow> args) => { if (args.Item is not null) _ = OpenPlayerCard(args.Item); })">
            <HeaderContent>
                <MudTh Style="width:44px;">#</MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<SimRow, object>(x => x.PlayerName)">Player</MudTableSortLabel>
                </MudTh>
                <MudTh>Pos</MudTh>
                <MudTh>Team</MudTh>
                <MudTh>Opp</MudTh>
                <MudTh Style="text-align:right;">
                    <MudTableSortLabel SortBy="new Func<SimRow, object>(x => x.Floor)">Floor</MudTableSortLabel>
                </MudTh>
                <MudTh Style="text-align:right;">
                    <MudTableSortLabel InitialDirection="SortDirection.Descending" SortBy="new Func<SimRow, object>(x => x.Median)">Median</MudTableSortLabel>
                </MudTh>
                <MudTh Style="text-align:right;">
                    <MudTableSortLabel SortBy="new Func<SimRow, object>(x => x.Ceiling)">Ceiling</MudTableSortLabel>
                </MudTh>
                <MudTh Style="text-align:right;">
                    <MudTableSortLabel SortBy="new Func<SimRow, object>(x => x.BoomProbability)">Boom%</MudTableSortLabel>
                </MudTh>
                <MudTh Style="text-align:right;">
                    <MudTableSortLabel SortBy="new Func<SimRow, object>(x => x.BustProbability)">Bust%</MudTableSortLabel>
                </MudTh>
                <MudTh>Spread</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="#">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary font-mono">
                        @(_filtered.IndexOf(context) + 1)
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Player">
                    <MudText Typo="Typo.body2" Style="font-weight:600; color:var(--fc-cyan); cursor:pointer;">
                        @context.PlayerName
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Pos">
                    <MudChip T="string" Size="Size.Small" Class="@PositionClass(context.Position)">
                        @context.Position
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Team">
                    <MudText Typo="Typo.body2">@context.NflTeam</MudText>
                </MudTd>
                <MudTd DataLabel="Opp">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@context.OpponentTeam</MudText>
                </MudTd>
                <MudTd DataLabel="Floor" Style="text-align:right;">
                    <MudText Typo="Typo.body2" Class="font-mono mud-text-secondary">
                        @context.Floor.ToString("F1")
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Median" Style="text-align:right;">
                    <MudText Typo="Typo.body2" Class="font-mono fc-cyan" Style="font-weight:600;">
                        @context.Median.ToString("F1")
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Ceiling" Style="text-align:right;">
                    <MudText Typo="Typo.body2" Class="font-mono fc-ceiling">
                        @context.Ceiling.ToString("F1")
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Boom%" Style="text-align:right;">
                    @{ var boom = context.BoomProbability * 100; }
                    <MudText Typo="Typo.body2" Class="@($"font-mono {(boom >= 30 ? "fc-boom" : "mud-text-secondary")}")">
                        @boom.ToString("F0")%
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Bust%" Style="text-align:right;">
                    @{ var bust = context.BustProbability * 100; }
                    <MudText Typo="Typo.body2" Class="@($"font-mono {(bust >= 30 ? "fc-bust" : "mud-text-secondary")}")">
                        @bust.ToString("F0")%
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Spread">
                    <MudText Typo="Typo.body2" Class="@($"font-mono {(context.Spread > 0 ? "fc-favoured" : context.Spread < 0 ? "fc-dog" : "mud-text-secondary")}")">
                        @(context.Spread == 0 ? "—" : context.Spread > 0 ? $"+{context.Spread:F1}" : $"{context.Spread:F1}")
                    </MudText>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 25, 50, 100, 250 }" />
            </PagerContent>
        </MudTable>
    </MudPaper>
}

@code {
    // ── State ───────────────────────────────────────────────────────────
    private int _season;
    private int _week;
    private string _search = string.Empty;
    private int _activeTab = 0;
    private bool _loading = false;
    private bool _queried = false;
    private string? _error;
    private List<SimRow> _all = [];
    private List<SimRow> _filtered = [];
    private static readonly string[] Positions = ["", "QB", "RB", "WR", "TE"];

    // FIX-PRESEASON-001 (2026-08-27): preseason ADP-based fallback state —
    // see LoadRankings().
    private bool _isFallbackMode = false;
    private List<AdpRow> _adpAll = [];
    private List<AdpRow> _adpFiltered = [];
    private int DisplayCount => _isFallbackMode ? _adpFiltered.Count : _filtered.Count;

    // ── Lifecycle ────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        var (season, week) = await NflContext.GetContextAsync();
        _season = season;
        _week = week;
    }

    // ── Data loading ─────────────────────────────────────────────────────
    private async Task LoadRankings()
    {
        _loading = true;
        _queried = true;
        _error = null;
        _all = [];
        _adpAll = [];
        _isFallbackMode = false;
        StateHasChanged();

        try
        {
            var position = Positions[_activeTab];
            var posParam = string.IsNullOrEmpty(position) ? "" : $"&position={position}";

            if (_week > 0)
            {
                var rows = await Http.GetFromJsonAsync<List<SimRow>>(
                    $"api/v1/projections/simulations?season={_season}&week={_week}{posParam}");
                _all = rows ?? [];
            }

            if (_all.Count == 0)
            {
                // FIX-PRESEASON-001 (2026-08-27): no Week N simulation data yet
                // (preseason, or Week is 0, or this week just hasn't been
                // simulated) — fall back to the live-ADP redraft board. Requires
                // POST /api/v1/admin/sync-ffc-adp to have been run at least once.
                _isFallbackMode = true;
                var adpRows = await Http.GetFromJsonAsync<List<AdpRow>>(
                    $"api/v1/drafttools/redraft-board?season={_season}{posParam}");
                _adpAll = adpRows ?? [];
                if (_adpAll.Count == 0)
                    Snackbar.Add($"No simulation or ADP data found for {_season}. Run sync-ffc-adp from the Admin console first.", Severity.Warning);
                else
                    Snackbar.Add($"Week {_week} simulation data isn't available yet — showing preseason rankings from live ADP.", Severity.Info);
            }
        }
        catch (Exception ex)
        {
            _error = $"Failed to load rankings: {ex.Message}";
        }
        finally
        {
            _loading = false;
            ApplyFilters();
        }
    }

    // ── Filtering ────────────────────────────────────────────────────────
    private void ApplyFilters()
    {
        var position = Positions[_activeTab];

        if (_isFallbackMode)
        {
            _adpFiltered = _adpAll
                .Where(p => string.IsNullOrEmpty(position) || p.Position == position)
                .Where(p => string.IsNullOrEmpty(_search) ||
                            p.PlayerName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                            (p.NflTeam ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase))
                .OrderBy(p => p.Adp)
                .ToList();
        }
        else
        {
            _filtered = _all
                .Where(p => string.IsNullOrEmpty(position) || p.Position == position)
                .Where(p => string.IsNullOrEmpty(_search) ||
                            p.PlayerName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                            p.NflTeam.Contains(_search, StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(p => p.Median)
                .ToList();
        }
        StateHasChanged();
    }

    private int _prevTab = 0;
    private string _prevSearch = string.Empty;

    protected override void OnAfterRender(bool firstRender)
    {
        if (_activeTab != _prevTab || _search != _prevSearch)
        {
            _prevTab = _activeTab;
            _prevSearch = _search;
            ApplyFilters();
        }
    }

    // ── Player card ──────────────────────────────────────────────────────
    private async Task OpenPlayerCard(SimRow row)
    {
        var data = new PlayerCardDialog.PlayerCardData(
            SleeperPlayerId: row.SleeperPlayerId,
            FullName: row.PlayerName,
            Position: row.Position,
            NflTeam: row.NflTeam,
            Age: null,
            DraftRound: null,
            DraftPick: null,
            CollegeTeam: null,
            HeadshotUrl: $"https://sleepercdn.com/content/nfl/players/thumb/{row.SleeperPlayerId}.jpg",
            FantasyProsRank: null,
            FantasyProsTier: null,
            PffGrade: null,
            PffRank: null,
            ConsensusAdp: null,
            DynastyScore: 0,
            DraftCapitalScore: 0,
            PositionalScore: 0,
            ValuationBlendScore: 0,
            FantasyProsScore: 0,
            PffGradeScore: 0,
            ConsensusAdpScore: 0,
            AgeMultiplier: 0,
            AthleticismSignalScore: 0,
            AthleticismScore: null,
            SpeedScore: null,
            FortyYard: null);

        var parameters = new DialogParameters<PlayerCardDialog>
        {
            { x => x.Player, data }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<PlayerCardDialog>(row.PlayerName, parameters, options);
    }

    // FIX-PRESEASON-001 (2026-08-27): player card for the ADP fallback table —
    // mirrors OpenPlayerCard above but sourced from AdpRow instead of SimRow.
    private async Task OpenAdpPlayerCard(AdpRow row)
    {
        var data = new PlayerCardDialog.PlayerCardData(
            SleeperPlayerId: row.SleeperPlayerId,
            FullName: row.PlayerName,
            Position: row.Position,
            NflTeam: row.NflTeam,
            Age: null,
            DraftRound: null,
            DraftPick: null,
            CollegeTeam: null,
            HeadshotUrl: $"https://sleepercdn.com/content/nfl/players/thumb/{row.SleeperPlayerId}.jpg",
            FantasyProsRank: null,
            FantasyProsTier: null,
            PffGrade: null,
            PffRank: null,
            ConsensusAdp: row.Adp,
            DynastyScore: row.SeasonAvgPoints.HasValue ? (double)row.SeasonAvgPoints.Value : 0,
            DraftCapitalScore: 0,
            PositionalScore: 0,
            ValuationBlendScore: 0,
            FantasyProsScore: 0,
            PffGradeScore: 0,
            ConsensusAdpScore: 0,
            AgeMultiplier: 0,
            AthleticismSignalScore: 0,
            AthleticismScore: null,
            SpeedScore: null,
            FortyYard: null);

        var parameters = new DialogParameters<PlayerCardDialog>
        {
            { x => x.Player, data }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<PlayerCardDialog>(row.PlayerName, parameters, options);
    }

    // ── Helpers ──────────────────────────────────────────────────────────
    private static string PositionClass(string pos) => pos switch
    {
        "QB" => "fc-chip-qb",
        "RB" => "fc-chip-rb",
        "WR" => "fc-chip-wr",
        "TE" => "fc-chip-te",
        _ => ""
    };

    // ── DTO — mirrors SimRow from Projections.razor exactly ──────────────
    private record SimRow(
        string PlayerId,
        string SleeperPlayerId,
        string PlayerName,
        string Position,
        string NflTeam,
        string OpponentTeam,
        decimal Floor,
        decimal Median,
        decimal Ceiling,
        decimal BoomProbability,
        decimal BustProbability,
        string PlayerRole,
        string ScoringFormat,
        decimal Spread,
        string GameScript);

    // FIX-PRESEASON-001 (2026-08-27): mirrors RedraftBoardEntryDto from
    // GetRedraftBoardQuery (api/v1/drafttools/redraft-board).
    private record AdpRow(
        string SleeperPlayerId,
        string PlayerName,
        string Position,
        string? NflTeam,
        double Adp,
        int AdpRound,
        decimal? SeasonAvgPoints);
}
