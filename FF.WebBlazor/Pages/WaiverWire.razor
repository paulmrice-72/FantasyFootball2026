@page "/waiver-wire"
@using FF.Domain.Documents
@using System.Net.Http.Json
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject LeagueStateService LeagueState
@inject NflContextClientService NflContext

<MudText Typo="Typo.h5" Class="mb-1" Style="color: var(--fc-cyan);">
    <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Class="mr-2" />
    Waiver Wire
</MudText>
<MudText Typo="Typo.body2" Class="mb-4" Style="color: var(--mud-palette-text-secondary);">
    VORP rankings for available players and in-season emergence signals.
</MudText>

@if (_context is null && _contextLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else if (_context?.IsSleeperLinked != true)
{
    <MudAlert Severity="Severity.Warning">
        Link your Sleeper account to use waiver wire features.
    </MudAlert>
}
else
{
    <MudGrid Class="mb-3">
        <MudItem xs="6" sm="2">
            <MudNumericField @bind-Value="_week" Label="Week" Variant="Variant.Outlined" Min="1" Max="18" />
        </MudItem>
        <MudItem xs="6" sm="2" Class="d-flex align-center">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadAllAsync" Disabled="_vorpLoading" FullWidth="true">
                @(_vorpLoading ? "Loading..." : "Load")
            </MudButton>
        </MudItem>
    </MudGrid>

    <MudTabs Elevation="0"
             Rounded="true"
             Class="mb-4"
             ActivePanelIndexChanged="OnTabChangedAsync">

        <!-- ── Tab 1: VORP Recommendations ── -->
        <MudTabPanel Text="Available Players (VORP)">

            <MudChipSet T="string" @bind-SelectedValue="_vorpPosition"
                        Class="mb-3 mt-2" SelectionMode="SelectionMode.SingleSelection">
                <MudChip T="string" Value="@("")" Default="true">All</MudChip>
                <MudChip T="string" Value="@("QB")">QB</MudChip>
                <MudChip T="string" Value="@("RB")">RB</MudChip>
                <MudChip T="string" Value="@("WR")">WR</MudChip>
                <MudChip T="string" Value="@("TE")">TE</MudChip>
            </MudChipSet>

            @if (_vorpLoading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
            }
            else if (_vorpRecs.Count == 0 && _vorpQueried && !_isOffSeason)
            {
                <MudAlert Severity="Severity.Info">
                    No available players found. Ensure projections are calculated for this week.
                </MudAlert>
            }

            @if (_vorpLoading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
            }
            else if (_isOffSeason && _offSeasonRecs.Count == 0 && _vorpQueried && !_vorpLoading)
            {
                <MudAlert Severity="Severity.Info">
                    No available players found. Ensure dynasty valuations have been calculated.
                </MudAlert>
            }
            else if (_isOffSeason && _offSeasonRecs.Count > 0)
            {
                <MudAlert Severity="Severity.Info" Class="mb-3">
                    @if (_offSeasonValueLabel == "ADP")
                    {
                        <text>
                            Pre-season mode — players ranked by consensus redraft ADP (lower = drafted
                            earlier). In-season VORP available once Week 1 projections are calculated.
                        </text>
                    }
                    else
                    {
                        <text>
                            Off-season mode — players ranked by dynasty trade value. Rankings will reflect
                            real valuations after the NFL Draft (April 24–26) and post-draft simulation jobs run.
                            In-season VORP available once Week 1 projections are calculated.
                        </text>
                    }
                </MudAlert>
                <MudTable Items="@FilteredOffSeason" Dense="true" Hover="true" Striped="true"
                          Style="background: var(--fc-navy-card);">
                    <HeaderContent>
                        <MudTh>Rank</MudTh>
                        <MudTh>Player</MudTh>
                        <MudTh>Pos</MudTh>
                        <MudTh>Team</MudTh>
                        <MudTh>Age</MudTh>
                        <MudTh Style="text-align:right">@_offSeasonValueLabel</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        @{
                            var offCtx = context;
                        }
                        <MudTd>
                            <MudText Typo="Typo.body2"
                                     Style="font-family:'JetBrains Mono',monospace; color: var(--mud-palette-text-secondary);">
                                #@context.Rank
                            </MudText>
                        </MudTd>
                        <MudTd>
                            <MudButton Variant="Variant.Text"
                                       Style="font-weight:600; color: var(--fc-cyan); padding:0; min-width:0; text-transform:none;"
                                       OnClick="@(() => _ = OpenPlayerCard(offCtx.SleeperPlayerId, offCtx.PlayerName, offCtx.Position, offCtx.NflTeam, offCtx.CollegeTeam))" >
                                @context.PlayerName
                            </MudButton>
                        </MudTd>
                        <MudTd>
                            <MudChip T="string" Size="Size.Small"
                                     Style="@GetPositionStyle(context.Position)">
                                @context.Position
                            </MudChip>
                        </MudTd>
                        <MudTd>@(context.NflTeam ?? "FA")</MudTd>
                        <MudTd>
                            <MudText Typo="Typo.body2">@context.Age</MudText>
                        </MudTd>
                        <MudTd Style="text-align:right; font-family:'JetBrains Mono',monospace; color:var(--fc-cyan);">
                            @context.Value.ToString("F1")
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
            else if (!_isOffSeason && _vorpRecs.Count > 0)
            {
                @* FAN-118: rebuilt. This branch was a comment — "existing VORP table
                   unchanged" — which compiled cleanly and rendered nothing. *@

                @if (_vorpRecs.Any(r => r.ReplacementPoolExhausted))
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                        <span style="font-size:0.78rem;">
                            Projection pool is shallower than this league starts at one or more
                            positions, so replacement level fell back to the last available
                            projection. Values at those positions are understated.
                        </span>
                    </MudAlert>
                }

                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    <span style="font-size:0.78rem;">
                        <b>VORP</b> is value over the last player your league would start at the
                        position — league-aware, so superflex deepens the QB baseline.
                        <b>vs FA</b> is value over the best player still available at that
                        position, which is the number that matters for a pickup.
                    </span>
                </MudAlert>

                <MudTable Items="@FilteredVorp" Dense="true" Hover="true" Striped="true"
                          Style="background: var(--fc-navy-card);">
                    <HeaderContent>
                        <MudTh>Rank</MudTh>
                        <MudTh>Player</MudTh>
                        <MudTh>Pos</MudTh>
                        <MudTh>Team</MudTh>
                        <MudTh Style="text-align:right">Proj</MudTh>
                        <MudTh Style="text-align:right">Floor</MudTh>
                        <MudTh Style="text-align:right">Ceiling</MudTh>
                        <MudTh Style="text-align:right">Repl</MudTh>
                        <MudTh Style="text-align:right">VORP</MudTh>
                        <MudTh Style="text-align:right">vs FA</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        @{
                            var vorpCtx = context;
                        }
                        <MudTd>
                            <MudText Typo="Typo.body2"
                                     Style="font-family:'JetBrains Mono',monospace; color: var(--mud-palette-text-secondary);">
                                #@context.VorpRank
                            </MudText>
                        </MudTd>
                        <MudTd>
                            <MudButton Variant="Variant.Text"
                                       Style="font-weight:600; color: var(--fc-cyan); padding:0; min-width:0; text-transform:none;"
                                       OnClick="@(() => _ = OpenPlayerCard(vorpCtx.PlayerId, vorpCtx.PlayerName, vorpCtx.Position, vorpCtx.NflTeam, null))">
                                @context.PlayerName
                            </MudButton>
                        </MudTd>
                        <MudTd>
                            <MudChip T="string" Size="Size.Small" Style="@GetPositionStyle(context.Position)">
                                @context.Position
                            </MudChip>
                        </MudTd>
                        <MudTd>@(context.NflTeam ?? "FA")</MudTd>
                        <MudTd Style="text-align:right; font-family:'JetBrains Mono',monospace;">
                            @context.ProjectedPoints.ToString("F1")
                        </MudTd>

                        @* FAN-124: no simulation means no floor — "—", never a fabricated 0.0. *@
                        <MudTd Style="text-align:right; font-family:'JetBrains Mono',monospace; color:#9CA3AF;">
                            @(context.FloorPoints.HasValue ? context.FloorPoints.Value.ToString("F1") : "—")
                        </MudTd>
                        <MudTd Style="text-align:right; font-family:'JetBrains Mono',monospace; color:#9CA3AF;">
                            @(context.CeilingPoints.HasValue ? context.CeilingPoints.Value.ToString("F1") : "—")
                        </MudTd>

                        <MudTd Style="text-align:right; font-family:'JetBrains Mono',monospace; color:#9CA3AF;">
                            @context.ReplacementLevel.ToString("F1")
                        </MudTd>
                        <MudTd Style="@($"text-align:right; font-family:'JetBrains Mono',monospace; font-weight:700; color:{(context.Vorp >= 0 ? "var(--fc-cyan)" : "#EF5350")};")">
                            @(context.Vorp >= 0 ? "+" : "")@context.Vorp.ToString("F1")
                        </MudTd>
                        <MudTd Style="text-align:right; font-family:'JetBrains Mono',monospace;">
                            @if (context.VorpFreeAgent.HasValue)
                            {
                                <span style="@($"color:{(context.VorpFreeAgent.Value >= 0 ? "#4CAF50" : "#9CA3AF")};")">
                                    @(context.VorpFreeAgent.Value >= 0 ? "+" : "")@context.VorpFreeAgent.Value.ToString("F1")
                                </span>
                            }
                            else
                            {
                                <span style="color:#9CA3AF;">—</span>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudTabPanel>

        <!-- ── Tab 2: Roster-Aware Recommendations ── -->
        <MudTabPanel Text="My Roster Fit">

            <MudText Typo="Typo.body2" Class="mb-3 mt-2"
                     Style="color: var(--mud-palette-text-secondary);">
                VORP adjusted for your roster construction — positions where you are thin
                are boosted, positions where you are stacked are discounted.
            </MudText>

            <MudChipSet T="string" @bind-SelectedValue="_fitPosition"
                        Class="mb-3" SelectionMode="SelectionMode.SingleSelection">
                <MudChip T="string" Value="@("")" Default="true">All</MudChip>
                <MudChip T="string" Value="@("QB")">QB</MudChip>
                <MudChip T="string" Value="@("RB")">RB</MudChip>
                <MudChip T="string" Value="@("WR")">WR</MudChip>
                <MudChip T="string" Value="@("TE")">TE</MudChip>
            </MudChipSet>

            @if (_fitLoading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
            }
            else if (_isOffSeason && _offSeasonFitRecs.Count == 0 && _fitQueried)
            {
                <MudAlert Severity="Severity.Info">
                    No available players found. Ensure @(_offSeasonValueLabel == "ADP" ? "redraft ADP data" : "dynasty valuations") have been calculated.
                </MudAlert>
            }
            else if (_isOffSeason && _offSeasonFitRecs.Count > 0)
            {
                <MudAlert Severity="Severity.Info" Class="mb-3">
                    Pre-season mode — fit-adjusted @_offSeasonValueLabel (positions where you are thin are
                    boosted, positions where you are stacked are discounted). In-season VORP-based fit
                    available once Week 1 projections are calculated.
                </MudAlert>
                <MudTable Items="@FilteredOffSeasonFit" Dense="true" Hover="true" Striped="true"
                          Style="background: var(--fc-navy-card);">
                    <HeaderContent>
                        <MudTh>Fit Rank</MudTh>
                        <MudTh>Player</MudTh>
                        <MudTh>Pos</MudTh>
                        <MudTh>Team</MudTh>
                        <MudTh>Need</MudTh>
                        <MudTh Style="text-align:right">@_offSeasonValueLabel</MudTh>
                        <MudTh Style="text-align:right">Fit Score</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <MudText Typo="Typo.body2"
                                     Style="font-family:'JetBrains Mono',monospace; color: var(--mud-palette-text-secondary);">
                                #@context.FitRank
                            </MudText>
                        </MudTd>
                        @{
                            var offFitContext = context;
                        }
                        <MudTd>
                            <MudButton Variant="Variant.Text"
                                       Style="font-weight:600; color: var(--fc-cyan); padding:0; min-width:0; text-transform:none;"
                                       OnClick="@(() => _ = OpenPlayerCard(offFitContext.Base.SleeperPlayerId, offFitContext.Base.PlayerName, offFitContext.Base.Position, offFitContext.Base.NflTeam, offFitContext.Base.CollegeTeam))">
                                @context.Base.PlayerName
                            </MudButton>
                        </MudTd>
                        <MudTd>
                            <MudChip T="string" Size="Size.Small"
                                     Style="@GetPositionStyle(context.Base.Position)">
                                @context.Base.Position
                            </MudChip>
                        </MudTd>
                        <MudTd>@(context.Base.NflTeam ?? "FA")</MudTd>
                        <MudTd>
                            <MudChip T="string" Size="Size.Small"
                                     Style="@GetNeedStyle(context.PositionNeed)">
                                @context.PositionNeed
                            </MudChip>
                        </MudTd>
                        <MudTd Style="text-align:right; font-family:'JetBrains Mono',monospace; color: var(--fc-cyan);">
                            @context.Base.Value.ToString("F1")
                        </MudTd>
                        <MudTd Style="text-align:right; font-family:'JetBrains Mono',monospace; font-weight:600; color: var(--fc-cyan);">
                            @context.FitScore.ToString("F1")
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
            else if (!_isOffSeason && _fitRecs.Count == 0 && _fitQueried)
            {
                <MudAlert Severity="Severity.Info">
                    No recommendations found. Load VORP first, then switch to this tab.
                </MudAlert>
            }
            else if (!_isOffSeason && _fitRecs.Count > 0)
            {
                <MudTable Items="@FilteredFit" Dense="true" Hover="true" Striped="true"
                          Style="background: var(--fc-navy-card);">
                    <HeaderContent>
                        <MudTh>Fit Rank</MudTh>
                        <MudTh>Player</MudTh>
                        <MudTh>Pos</MudTh>
                        <MudTh>Team</MudTh>
                        <MudTh>Need</MudTh>
                        <MudTh Style="text-align:right">VORP</MudTh>
                        <MudTh Style="text-align:right">Fit Score</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <MudText Typo="Typo.body2"
                                     Style="font-family:'JetBrains Mono',monospace; color: var(--mud-palette-text-secondary);">
                                #@context.FitRank
                            </MudText>
                        </MudTd>
                        @{
                            var fitContext = context;
                        }
                        <MudTd>
                            <MudButton Variant="Variant.Text"
                                       Style="font-weight:600; color: var(--fc-cyan); padding:0; min-width:0; text-transform:none;"
                                       OnClick="@(() => _ = OpenPlayerCard(fitContext.Base.PlayerId, fitContext.Base.PlayerName, fitContext.Base.Position, fitContext.Base.NflTeam))">
                                @context.Base.PlayerName
                            </MudButton>
                        </MudTd>
                        <MudTd>
                            <MudChip T="string" Size="Size.Small"
                                     Style="@GetPositionStyle(context.Base.Position)">
                                @context.Base.Position
                            </MudChip>
                        </MudTd>
                        <MudTd>@(context.Base.NflTeam ?? "FA")</MudTd>
                        <MudTd>
                            <MudChip T="string" Size="Size.Small"
                                     Style="@GetNeedStyle(context.PositionNeed)">
                                @context.PositionNeed
                            </MudChip>
                        </MudTd>
                        <MudTd Style="text-align:right; font-family:'JetBrains Mono',monospace; color: var(--fc-cyan);">
                            +@context.Base.Vorp.ToString("F1")
                        </MudTd>
                        <MudTd Style="text-align:right; font-family:'JetBrains Mono',monospace; font-weight:600; color: var(--fc-cyan);">
                            @context.FitScore.ToString("F1")
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudTabPanel>

        <!-- ── Tab 3: Emerging Roles ── -->
        <MudTabPanel Text="Emerging Roles">

            <MudText Typo="Typo.body2" Class="mb-3 mt-2"
                     Style="color: var(--mud-palette-text-secondary);">
                Players whose last 3-week role metrics have surged above their season averages.
                Updated each Tuesday after usage metrics recalculate.
            </MudText>

            <MudChipSet T="string" @bind-SelectedValue="_emergencePosition"
                        Class="mb-3" SelectionMode="SelectionMode.SingleSelection">
                <MudChip T="string" Value="@("")" Default="true">All</MudChip>
                <MudChip T="string" Value="@("WR")">WR</MudChip>
                <MudChip T="string" Value="@("RB")">RB</MudChip>
                <MudChip T="string" Value="@("TE")">TE</MudChip>
                <MudChip T="string" Value="@("QB")">QB</MudChip>
            </MudChipSet>

            @if (_emergenceLoading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
            }
            else if (_alerts.Count == 0)
            {
                <MudAlert Severity="Severity.Info">
                    No emergence signals detected for the current week.
                    Signals populate each Tuesday after in-season data is available.
                </MudAlert>
            }
            else
            {
                <MudTable Items="@FilteredAlerts" Dense="true" Hover="true" Striped="true"
                          Style="background: var(--fc-navy-card);">
                    <HeaderContent>
                        <MudTh>Player</MudTh>
                        <MudTh>Pos</MudTh>
                        <MudTh>Team</MudTh>
                        <MudTh>Signal</MudTh>
                        <MudTh Style="text-align:right">Delta</MudTh>
                        <MudTh Style="text-align:right">Week</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        @{
                            var fitContext = context;
                        }
                        @{
                            var emergenceContext = context;
                        }
                        <MudTd>
                            <MudButton Variant="Variant.Text"
                                       Style="font-weight:600; color: var(--fc-cyan); padding:0; min-width:0; text-transform:none;"
                                       OnClick="@(() => _ = OpenPlayerCard(emergenceContext.PlayerId, emergenceContext.PlayerName, emergenceContext.Position, emergenceContext.NflTeam))">
                                @context.PlayerName
                            </MudButton>
                        </MudTd>
                        <MudTd>
                            <MudChip T="string" Size="Size.Small"
                                     Style="@GetPositionStyle(context.Position)">
                                @context.Position
                            </MudChip>
                        </MudTd>
                        <MudTd>@(context.NflTeam ?? "FA")</MudTd>
                        <MudTd>
                            <MudChip T="string" Size="Size.Small"
                                     Style="@GetSignalStyle(context.TriggerSignal)">
                                @GetSignalLabel(context.TriggerSignal)
                            </MudChip>
                        </MudTd>
                        <MudTd Style="text-align:right; font-family:'JetBrains Mono',monospace; color: var(--fc-cyan);">
                            +@context.Delta.ToString("P1")
                        </MudTd>
                        <MudTd Style="text-align:right">Wk @context.Week</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudTabPanel>

    </MudTabs>
}

@code {
    private UserContext? _context;
    private bool _contextLoading = true;

    // FAN-113 fix: the API globally serializes enums as strings
    // (FF.API/Program.cs -> AddJsonOptions -> JsonStringEnumConverter), but
    // Blazor's HttpClient.GetFromJsonAsync doesn't inherit that and expects
    // the numeric default, so any DTO carrying RosterNeed (a string like
    // "Need") throws on deserialize — silently swallowed by our catch
    // blocks, hence no error in DevTools/VS Output despite a 200 response.
    // Same pattern already fixed once in MyTeam.razor's _enumJsonOptions
    // (TEAM-005). Use this for any GetFromJsonAsync call whose payload
    // includes RosterNeed.
    private static readonly System.Text.Json.JsonSerializerOptions _enumJsonOptions = new()
    {
        PropertyNameCaseInsensitive = true,
        Converters = { new System.Text.Json.Serialization.JsonStringEnumConverter() }
    };

    // Shared controls
    private string _selectedLeagueId = string.Empty;
    private int _currentSeason;
    private int _week;

    // VORP state
    private List<VorpRecommendationDocument> _vorpRecs = [];
    private bool _vorpLoading;
    private bool _vorpQueried;
    private string _vorpPosition = string.Empty;

    // Roster fit state
    private List<RosterAwareRecommendation> _fitRecs = [];
    private bool _fitLoading;
    private bool _fitQueried;
    private string _fitPosition = string.Empty;

    // FAN-113: pre-season fit fallback (same ADP/Dynasty pool as Tab 1, need-adjusted)
    private List<OffSeasonFitDto> _offSeasonFitRecs = [];

    // Emergence state
    private List<EmergenceAlertDocument> _alerts = [];
    private bool _emergenceLoading = true;
    private string _emergencePosition = string.Empty;

    private bool _isOffSeason;
    private List<OffSeasonDto> _offSeasonRecs = [];
    // FAN-112: "Dynasty Value" for dynasty leagues, "ADP" for redraft leagues —
    // set from whatever the API actually returned, not assumed here.
    private string _offSeasonValueLabel = "Dynasty Value";

    private IEnumerable<VorpRecommendationDocument> FilteredVorp =>
        string.IsNullOrEmpty(_vorpPosition)
            ? _vorpRecs
            : _vorpRecs.Where(r => r.Position == _vorpPosition);

    private IEnumerable<RosterAwareRecommendation> FilteredFit =>
        string.IsNullOrEmpty(_fitPosition)
            ? _fitRecs
            : _fitRecs.Where(r => r.Base.Position == _fitPosition);

    private IEnumerable<EmergenceAlertDocument> FilteredAlerts =>
        string.IsNullOrEmpty(_emergencePosition)
            ? _alerts
            : _alerts.Where(a => a.Position == _emergencePosition);

    private IEnumerable<OffSeasonDto> FilteredOffSeason =>
        string.IsNullOrEmpty(_vorpPosition)
        ? _offSeasonRecs
        : _offSeasonRecs.Where(r => r.Position == _vorpPosition);

    private IEnumerable<OffSeasonFitDto> FilteredOffSeasonFit =>
        string.IsNullOrEmpty(_fitPosition)
        ? _offSeasonFitRecs
        : _offSeasonFitRecs.Where(r => r.Base.Position == _fitPosition);

    // Which tab is showing — bound to MudTabs so tab switches can trigger a
    // just-in-time load (see OnTabChangedAsync) without requiring "LOAD".
    private int _activeTabIndex;

    protected override async Task OnInitializedAsync()
    {
        // Subscribe first — event may fire during or after LoadContextAsync
        LeagueState.OnLeagueChanged += OnLeagueChangedHandler;

        await LoadContextAsync();
        await LoadAlertsAsync();

        // Paul (2026-08-31): no more requiring a manual LOAD click — load
        // both tabs' data as soon as the league/week/user context is known,
        // using whatever Week value LoadContextAsync already defaulted to
        // (current NFL week, honoring any admin override). Handler below
        // does the same if LeagueState settles after this point instead.
        if (!string.IsNullOrEmpty(_selectedLeagueId))
        {
            await LoadAllAsync();
        }
    }

    private void OnLeagueChangedHandler()
    {
        var newLeagueId = LeagueState.ActiveLeagueId ?? string.Empty;
        bool leagueChanged = newLeagueId != _selectedLeagueId;

        _selectedLeagueId = newLeagueId;

        if (leagueChanged || (_offSeasonRecs.Count == 0 && _vorpRecs.Count == 0))
        {
            _offSeasonRecs = [];
            _vorpRecs = [];
            _fitRecs = [];
            _offSeasonFitRecs = [];
            _vorpQueried = false;
            _fitQueried = false;
        }

        _ = InvokeAsync(async () =>
        {
            if (!string.IsNullOrEmpty(_selectedLeagueId) && !_vorpLoading && !_fitLoading)
            {
                await LoadAllAsync();
            }
            StateHasChanged();
        });
    }

    // Safety net for the auto-load above: if a tab is opened before its data
    // has finished loading (or a load failed and _*Queried never got set),
    // clicking the tab retries instead of leaving it stuck empty.
    private async Task OnTabChangedAsync(int index)
    {
        _activeTabIndex = index;

        if (string.IsNullOrEmpty(_selectedLeagueId)) return;

        switch (index)
        {
            case 0 when !_vorpQueried && !_vorpLoading:
                await LoadVorpAsync();
                break;
            case 1 when !_fitQueried && !_fitLoading && _context?.SleeperUserId is not null:
                await LoadFitAsync();
                break;
        }
    }

    public void Dispose()
    {
        LeagueState.OnLeagueChanged -= OnLeagueChangedHandler;
    }
    private async Task LoadContextAsync()
    {
        _contextLoading = true;
        try
        {
            _context = await Http.GetFromJsonAsync<UserContext>("api/v1/identity/context");
            _selectedLeagueId = !string.IsNullOrEmpty(LeagueState.ActiveLeagueId)
                ? LeagueState.ActiveLeagueId
                : _context?.ActiveLeagueId ?? string.Empty;
            // Honour admin override
            (_currentSeason, _week) = await NflContext.GetContextAsync();

            // Pre-season is a DATA condition, not a calendar one. Week 0 means no
            // games have been played, whatever the date says. The old month-only
            // test flipped to "in season" on 1 September while the league was still
            // 0-0 at Week 0, which sent this page down the VORP path — where there
            // is no VORP data until real games exist.
            _isOffSeason = _week <= 0 || DateTime.UtcNow.Month is >= 3 and < 9;
        }
        catch { }
        finally { _contextLoading = false; }
    }

    private async Task LoadAllAsync()
    {
        if (string.IsNullOrWhiteSpace(_selectedLeagueId)) return;
        await Task.WhenAll(LoadVorpAsync(), LoadFitAsync());
    }

    private async Task LoadVorpAsync()
    {
        if (_isOffSeason)
        {
            await LoadOffSeasonAsync();
            return;
        }

        _vorpLoading = true;
        _vorpQueried = true;
        try
        {
            // Position is filtered client-side (see FilteredVorpRecs), so the
            // request deliberately fetches the whole list rather than re-querying
            // every time the position chip changes.
            var url = $"api/v1/waiver/recommendations"
                    + $"?leagueId={_selectedLeagueId}"
                    + $"&season={_currentSeason}&week={_week}&top=30";

            var result = await Http.GetFromJsonAsync<List<VorpRecommendationDocument>>(url);
            _vorpRecs = result ?? [];
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load waiver recommendations: {ex.Message}", Severity.Error);
        }
        finally
        {
            _vorpLoading = false;
        }
    }

    private async Task LoadOffSeasonAsync()
    {
        _vorpLoading = true;
        _vorpQueried = true;
        try
        {
            var posParam = string.IsNullOrEmpty(_vorpPosition) ? "" : $"&position={_vorpPosition}";
            var url = $"api/v1/waiver/available/offseason?leagueId={_selectedLeagueId}&top=50{posParam}";
            var result = await Http.GetFromJsonAsync<List<OffSeasonDto>>(url);
            _offSeasonRecs = result ?? [];
            _offSeasonValueLabel = _offSeasonRecs.Count > 0
                ? _offSeasonRecs[0].ValueLabel
                : "Dynasty Value";
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load off-season available players: {ex.Message}", Severity.Error);
        }
        finally
        {
            _vorpLoading = false;
        }
    }

    private async Task LoadFitAsync()
    {
        if (_context?.SleeperUserId is null) return;

        if (_isOffSeason)
        {
            await LoadOffSeasonFitAsync();
            return;
        }

        _fitLoading = true;
        _fitQueried = true;
        try
        {
            var url = $"api/v1/waiver/recommendations/roster-aware"
                + $"?leagueId={_selectedLeagueId}&sleeperUserId={_context.SleeperUserId}"
                + $"&season={_currentSeason}&week={_week}&top=30";
            var result = await Http.GetFromJsonAsync<List<RosterAwareRecommendation>>(url, _enumJsonOptions);
            _fitRecs = result ?? [];
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load roster-aware recommendations: {ex.Message}", Severity.Error);
        }
        finally
        {
            _fitLoading = false;
        }
    }

    // FAN-113: pre-season counterpart to LoadFitAsync — reuses the same
    // off-season pool as Tab 1 (ADP or Dynasty Value, per league type) with
    // the Need/Neutral/Strength fit multiplier applied server-side.
    private async Task LoadOffSeasonFitAsync()
    {
        if (_context?.SleeperUserId is null) return;

        _fitLoading = true;
        _fitQueried = true;
        try
        {
            var posParam = string.IsNullOrEmpty(_fitPosition) ? "" : $"&position={_fitPosition}";
            var url = $"api/v1/waiver/recommendations/roster-aware/offseason"
                + $"?leagueId={_selectedLeagueId}&sleeperUserId={_context.SleeperUserId}&top=30{posParam}";
            var result = await Http.GetFromJsonAsync<List<OffSeasonFitDto>>(url, _enumJsonOptions);
            _offSeasonFitRecs = result ?? [];
            if (_offSeasonFitRecs.Count > 0)
                _offSeasonValueLabel = _offSeasonFitRecs[0].Base.ValueLabel;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load pre-season roster fit: {ex.Message}", Severity.Error);
        }
        finally
        {
            _fitLoading = false;
        }
    }

    private async Task LoadAlertsAsync()
    {
        _emergenceLoading = true;
        try
        {
            var result = await Http.GetFromJsonAsync<List<EmergenceAlertDocument>>(
                $"api/v1/emergence/alerts?season={_currentSeason}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load emergence alerts: {ex.Message}", Severity.Error);
        }
        finally
        {
            _emergenceLoading = false;
        }
    }
