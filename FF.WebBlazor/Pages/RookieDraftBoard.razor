    private string RowClass(RookiePlayerDto row, int _) => IsDrafted(row.SleeperPlayerId) ? "fc-row-drafted" : string.Empty;
    private string RedraftRowClass(RedraftBoardPlayerDto row, int _) => IsDrafted(row.SleeperPlayerId) ? "fc-row-drafted" : string.Empty;

    private static Color GetPositionColor(string pos) => pos switch
    {
        "QB" => Color.Warning, "WR" => Color.Primary, "TE" => Color.Secondary, "RB" => Color.Success,
        "K" => Color.Tertiary, "DEF" or "DST" => Color.Dark,
        _ => Color.Default
    };
    private static string GetPositionHex(string pos) => pos switch
    {
        "QB" => "#F59E0B", "WR" => "#6366F1", "TE" => "#A855F7", "RB" => "#22C55E",
        // 2026-09-07: K and DEF fell through to grey, which was academic while
        // neither could appear on the board at all.
        "K" => "#14B8A6", "DEF" or "DST" => "#64748B",
        _ => "#9CA3AF"
    };
    private static Color GetScoreColor(double score) => score switch
    {
        >= 75 => Color.Success, >= 50 => Color.Primary, >= 25 => Color.Warning, _ => Color.Default
    };
    private static Color GetNeedColor(string level) => level switch
    {
        "REQUIRED" => Color.Error,
        "NEED" => Color.Error,
        "THIN" => Color.Warning,
        "STRONG" => Color.Success,
        _ => Color.Default
    };
    private static string GetNeedHex(string level) => level switch
    {
        // REQUIRED is louder than NEED on purpose: NEED means the next player
        // here would start, REQUIRED means the slot is empty and the league
        // will score it as a zero.
        "REQUIRED" => "#EF4444",
        "NEED" => "#F87171",
        "THIN" => "#F59E0B",
        "STRONG" => "#22C55E",
        _ => "#9CA3AF"
    };

