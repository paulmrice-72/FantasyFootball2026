@page "/dynasty/rookie-draft"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@using FF.Domain.ValueObjects
@using FF.Domain.Enums
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject LeagueStateService LeagueState
@implements IDisposable

<style>
    /* Drafted rows: fade but keep all pointer events so player card still opens */
    .fc-row-drafted td {
        opacity: 0.45;
    }
    .fc-row-drafted td .mud-button-root {
        pointer-events: auto !important;
        opacity: 1 !important; /* name button stays full opacity — handled inline */
    }
</style>

<PageTitle>Draft Board — FantasyCombine.AI</PageTitle>

<div class="fc-page-header mb-3">
    <MudText Typo="Typo.h5" Class="fc-page-title">
        <MudIcon Icon="@Icons.Material.Filled.SportsFootball" Class="mr-2" Style="vertical-align:middle;" />
        Draft Board
    </MudText>
    @* 2026-09-07: the subtitle now states which instrument is ORDERING the
       board, because that is the thing that silently changed under us. ADP
       orders it whenever market data exists; the points column is context. The
       no-ADP state is called out explicitly rather than presented as normal —
       a board ranked on per-game points reads QB-heavy in a 1-QB league. *@
    <MudText Typo="Typo.body2" Class="mud-text-secondary">
        @(_isRedraftMode
            ? (_hasAdp
                ? $"Ordered by live ADP · {(_isPreseasonAdpFallback ? "2025 avg pts" : "our projected pts/gm")} as the value signal"
                : "⚠ No ADP data — ordered by projected pts/gm, which skews toward QBs in a 1-QB league")
            : "Dynasty composite scores · Draft capital · FantasyPros rankings")
    </MudText>
</div>

@* ── SESSION BAR ─────────────────────────────────────────────────────── *@
<MudPaper Class="fc-card pa-3 mb-3" Elevation="0">
    <div class="d-flex align-center gap-3 flex-wrap">
        <MudChip T="string" Color="@(_isRedraftMode ? Color.Warning : Color.Primary)"
                 Size="Size.Small" Variant="Variant.Filled">
            @(_isRedraftMode ? "Redraft Mode" : "Dynasty / Rookie Mode")
        </MudChip>

        @* Fix 2026-08-27: live Sleeper draft sync (StartSession/sync-sleeper) has
           never been dynasty-specific on the backend — DraftSessionDocument and
           StartDraftSessionCommandHandler work off LeagueId alone. This whole
           block was gated to dynasty in the UI only; un-gated so redraft leagues
           get the same live monitoring during the actual draft. *@
        @if (_sessionId is null)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.PlayArrow"
                       OnClick="StartSession" Size="Size.Medium"
                       Disabled="@(string.IsNullOrEmpty(_selectedLeagueId) || _startingSession)">
                @if (_startingSession) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                Start Draft Session
            </MudButton>
        }
        else
        {
            <div class="d-flex align-center gap-2 flex-wrap">
                <MudIcon Icon="@Icons.Material.Filled.FiberManualRecord" Style="color:#34D399; font-size:0.9rem;" />
                <MudText Typo="Typo.body2" Style="color:#34D399; font-weight:600;">LIVE</MudText>
                @if (_totalPicksInDraft > 0)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Pick @(_picks.Count + 1) of @_totalPicksInDraft
                    </MudText>
                    <MudProgressLinear Value="@(_picks.Count)" Max="@(_totalPicksInDraft)"
                                       Color="Color.Primary" Style="width:80px; height:4px; border-radius:2px;" />
                }
                else
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@_picks.Count picked</MudText>
                }
                @if (_autoSyncEnabled)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success"
                             Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Sync">
                        auto-refresh 30s
                    </MudChip>
                }
            </div>
        }

        @if (_sessionId is not null)
        {
            <MudCheckBox Value="_hideDrafted"
                         ValueChanged="@((bool v) => { _hideDrafted = v; if (_isRedraftMode) ApplyRedraftFilter(); else ApplyRookieFilter(); })"
                         Label="Hide Drafted" Size="Size.Small" Color="Color.Primary" Class="ml-2" />
        }

        <MudSpacer />

        <MudChipSet T="string" SelectedValueChanged="OnPositionChanged" SelectionMode="SelectionMode.SingleSelection">
            <MudChip T="string" Value="@((string?)null)" Variant="Variant.Filled" Color="@(_selectedPosition is null ? Color.Primary : Color.Default)" Size="Size.Small">All</MudChip>
            <MudChip T="string" Value="@("QB")" Variant="Variant.Filled" Color="@(_selectedPosition == "QB" ? Color.Warning : Color.Default)" Size="Size.Small">QB</MudChip>
            <MudChip T="string" Value="@("RB")" Variant="Variant.Filled" Color="@(_selectedPosition == "RB" ? Color.Success : Color.Default)" Size="Size.Small">RB</MudChip>
            <MudChip T="string" Value="@("WR")" Variant="Variant.Filled" Color="@(_selectedPosition == "WR" ? Color.Primary : Color.Default)" Size="Size.Small">WR</MudChip>
            <MudChip T="string" Value="@("TE")" Variant="Variant.Filled" Color="@(_selectedPosition == "TE" ? Color.Secondary : Color.Default)" Size="Size.Small">TE</MudChip>
            @* K and DEF only in redraft — the dynasty rookie pool genuinely has
               neither, and an always-empty filter chip is its own small lie. *@
            @if (_isRedraftMode)
            {
                <MudChip T="string" Value="@("K")" Variant="Variant.Filled" Color="@(_selectedPosition == "K" ? Color.Tertiary : Color.Default)" Size="Size.Small">K</MudChip>
                <MudChip T="string" Value="@("DEF")" Variant="Variant.Filled" Color="@(_selectedPosition == "DEF" ? Color.Dark : Color.Default)" Size="Size.Small">DEF</MudChip>
            }
        </MudChipSet>

        <MudTextField Value="@SearchText" ValueChanged="@((string v) => SearchText = v)"
                      Placeholder="Search players..."
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined" Margin="Margin.Dense"
                      Clearable="true" Immediate="true" Style="min-width:200px;" />
    </div>
</MudPaper>

@* ── UP NEXT HORIZONTAL TICKER (session active — dynasty or redraft) ──── *@
@if (_sessionId is not null)
{
    <MudPaper Class="fc-card pa-2 mb-3" Elevation="0">
        <div class="d-flex align-center gap-2" style="overflow-x:auto; white-space:nowrap; min-height:44px;">
            <MudText Typo="Typo.caption"
                     Style="font-weight:700; letter-spacing:0.08em; text-transform:uppercase; color:var(--mud-palette-text-secondary); flex-shrink:0; padding-right:4px;">
                UP NEXT →
            </MudText>

            @if (_remainingPicks.Count == 0)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="font-style:italic;">
                    @(_totalPicksInDraft > 0 && _picks.Count >= _totalPicksInDraft
                        ? "Draft complete."
                        : "Waiting for Sleeper draft order...")
                </MudText>
            }
            else
            {
                @foreach (var pick in _remainingPicks.Take(8))
                {
                    bool isMe = pick.IsMyPick;
                    <MudLink Href="@($"/league/teams?rosterId={pick.SleeperRosterId}")"
                             Style="text-decoration:none; flex-shrink:0;">
                        <div style="display:inline-flex; flex-direction:column; align-items:center;
                                    padding:4px 10px; border-radius:8px; min-width:80px;
                                    background:@(isMe ? "rgba(99,102,241,0.2)" : "rgba(255,255,255,0.05)");
                                    border:1px solid @(isMe ? "rgba(99,102,241,0.6)" : "rgba(255,255,255,0.08)");">
                            <div style="display:flex; align-items:center; gap:4px;">
                                <span style="font-family:'JetBrains Mono',monospace; font-size:0.8rem; font-weight:700;
                                             color:@(isMe ? "var(--fc-cyan)" : "var(--mud-palette-text-primary)");">
                                    @($"{pick.Round}.{pick.Slot:D2}")
                                </span>
                                @if (isMe)
                                {
                                    <span style="font-size:0.6rem; font-weight:800; color:var(--fc-cyan);
                                                 background:rgba(99,102,241,0.3); border-radius:3px; padding:1px 4px;">
                                        YOU
                                    </span>
                                }
                            </div>
                            <span style="font-size:0.7rem; color:var(--mud-palette-text-secondary);
                                         overflow:hidden; text-overflow:ellipsis; max-width:90px; text-align:center;">
                                @pick.TeamName
                            </span>
                        </div>
                    </MudLink>
                }
                @if (_remainingPicks.Count > 8)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="flex-shrink:0; padding-left:4px;">
                        +@(_remainingPicks.Count - 8) more
                    </MudText>
                }
            }
        </div>
    </MudPaper>
}

@* ── BOARD + RIGHT RAIL ───────────────────────────────────────────────── *@
<MudGrid Spacing="3">

    @* ── MAIN BOARD ──────────────────────────────────────────────────── *@
    @* Sidebar (below) now works in both modes. Roster Needs + My Picks reuse
       the same session/pick state either way. Best Available / Best Fit are
       scored off ProjectedPoints (not DynastyScore) in redraft mode — see
       RecomputeRedraftNeedsAndBestAvailable. *@
    <MudItem xs="12" md="@(_sessionId is not null ? 9 : 12)">
        <MudPaper Class="fc-card" Elevation="0">
            @if (_loading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (_isRedraftMode)
            {
                @if (_filteredRedraft.Count == 0)
                {
                    <div class="pa-6 d-flex flex-column align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Analytics" Style="color:var(--fc-cyan); font-size:3rem;" Class="mb-2" />
                        <MudText Typo="Typo.body1" Style="font-weight:600;">No players found</MudText>
                    </div>
                }
                else
                {
                    <MudTable Items="@_filteredRedraft" Hover="true" Dense="true"
                              Breakpoint="Breakpoint.Sm" Elevation="0" Class="fc-table"
                              RowClassFunc="@RedraftRowClass">
                        <HeaderContent>
                            <MudTh>Rank</MudTh>
                            <MudTh>Player</MudTh>
                            <MudTh>Pos</MudTh>
                            <MudTh>Team</MudTh>
                            <MudTh Style="text-align:right">ADP</MudTh>
                            <MudTh Style="text-align:right">
                                <MudTooltip Text="Pick value gained by taking him here instead of at his market price. Convex: falling further is worth disproportionately more, and an equal fall is worth more for a better player. Negative before the draft starts, because nothing can have fallen yet.">
                                    <span>Draft Value</span>
                                </MudTooltip>
                            </MudTh>
                            <MudTh Style="text-align:right">@(_isPreseasonAdpFallback ? "2025 Avg Pts" : "Proj. Pts/Gm")</MudTh>
                            <MudTh>Status</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Rank"><MudText Typo="Typo.body2" Style="color:#9CA3AF;">#@context.Rank</MudText></MudTd>
                            <MudTd DataLabel="Player">
                                <MudButton Variant="Variant.Text" Class="pa-0"
                                           Style="@($"font-weight:600; text-transform:none; min-width:0; color:var(--fc-cyan); {(IsDrafted(context.SleeperPlayerId) ? "opacity:0.55;" : "")}")"
                                           OnClick="@(() => OpenPlayerCard(context))">
                                    @context.PlayerName
                                </MudButton>
                                @if (IsDrafted(context.SleeperPlayerId))
                                {
                                    var detail = GetPickDetail(context.SleeperPlayerId);
                                    <MudText Typo="Typo.caption" Style="display:block; font-style:italic; opacity:0.55;">
                                        @if (detail is not null)
                                        {
                                            @(string.IsNullOrEmpty(detail.PickedByTeamName)
                                                ? $"Drafted · {detail.Round}.{detail.Slot:D2}"
                                                : $"Drafted by {detail.PickedByTeamName} · {detail.Round}.{detail.Slot:D2}")
                                        }
                                        else
                                        {
                                            @("Drafted")
                                        }
                                    </MudText>
                                }
                            </MudTd>
                            <MudTd DataLabel="Pos">
                                <MudChip T="string" Size="Size.Small" Color="@GetPositionColor(context.Position)" Variant="Variant.Filled">@context.Position</MudChip>
                            </MudTd>
                            <MudTd DataLabel="Team"><MudText Typo="Typo.body2">@(context.NflTeam ?? "FA")</MudText></MudTd>
                            <MudTd DataLabel="ADP" Style="text-align:right; font-family:'JetBrains Mono',monospace;">
                                @if (context.Adp.HasValue)
                                {
                                    <MudText Typo="Typo.body2" Style="font-family:'JetBrains Mono',monospace;">@context.Adp.Value.ToString("F1")</MudText>
                                    @if (context.AdpRound.HasValue)
                                    {
                                        <MudText Typo="Typo.caption" Style="display:block; opacity:0.5; font-size:0.62rem;">R@(context.AdpRound.Value)</MudText>
                                    }
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Style="opacity:0.35;">—</MudText>
                                }
                            </MudTd>
                            <MudTd DataLabel="Draft Value" Style="text-align:right; font-family:'JetBrains Mono',monospace;">
                                @if (context.Adp.HasValue && !IsDrafted(context.SleeperPlayerId))
                                {
                                    var dv = DraftValueFor(context);
                                    var dvLabel = DraftValueLabel(dv);
                                    <MudText Typo="Typo.body2"
                                             Style="@($"font-family:'JetBrains Mono',monospace; font-weight:700; color:{DraftValueHex(dv)};")">
                                        @(dv >= 0 ? "+" : "")@dv.ToString("F0")
                                    </MudText>
                                    @if (!string.IsNullOrEmpty(dvLabel))
                                    {
                                        <MudText Typo="Typo.caption"
                                                 Style="@($"display:block; font-size:0.6rem; font-weight:700; letter-spacing:0.04em; color:{DraftValueHex(dv)};")">
                                            @dvLabel
                                        </MudText>
                                    }
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Style="opacity:0.35;">—</MudText>
                                }
                            </MudTd>
                            <MudTd DataLabel="@(_isPreseasonAdpFallback ? "2025 Avg Pts" : "Proj. Pts/Gm")" Style="text-align:right; font-family:'JetBrains Mono',monospace; color:var(--fc-cyan);">@context.ProjectedPoints.ToString("F1")</MudTd>
                            <MudTd DataLabel="Status">
                                @if (IsDrafted(context.SleeperPlayerId))
                                {
                                    @if (IsMyPick(context.SleeperPlayerId))
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" Style="font-weight:700;">MY PICK</MudChip>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.caption" Style="opacity:0.4;">—</MudText>
                                    }
                                }
                                else if (_sessionId is not null)
                                {
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.HowToVote"
                                               OnClick="@(() => MarkDrafted(context))"
                                               Style="font-size:0.72rem; font-weight:700; height:28px;">
                                        DRAFT
                                    </MudButton>
                                }
                                else { <MudText Typo="Typo.caption" Class="mud-text-secondary">—</MudText> }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            }
            else
            {
                @if (_filtered is null || _filtered.Count == 0)
                {
                    <div class="pa-6 d-flex flex-column align-center">
                        <MudIcon Icon="@Icons.Material.Filled.SportsFootball" Style="color:var(--fc-cyan); font-size:3rem;" Class="mb-2" />
                        <MudText Typo="Typo.body1" Style="font-weight:600;">No rookies found</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            @(_allRookies.Count == 0 ? "Rookie pool loads after NFL draft." : "Try adjusting filters.")
                        </MudText>
                    </div>
                }
                else
                {
                    <MudTable Items="@_filtered" Hover="true" Dense="true"
                              Breakpoint="Breakpoint.Sm" Elevation="0" Class="fc-table"
                              RowClassFunc="@RowClass">
                        <HeaderContent>
                            <MudTh><MudTableSortLabel SortBy="new Func<RookiePlayerDto, object>(x => x.ScoreRank)">Rank</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortBy="new Func<RookiePlayerDto, object>(x => x.FullName)">Player</MudTableSortLabel></MudTh>
                            <MudTh>Pos</MudTh>
                            <MudTh>Team</MudTh>
                            <MudTh><MudTableSortLabel SortBy="new Func<RookiePlayerDto, object>(x => (object)(x.Age ?? 99))">Age</MudTableSortLabel></MudTh>
                            <MudTh>Pick</MudTh>
                            <MudTh><MudTableSortLabel SortBy="new Func<RookiePlayerDto, object>(x => x.DynastyScore)"><MudTooltip Text="Composite dynasty score.">Score ⓘ</MudTooltip></MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortBy="new Func<RookiePlayerDto, object>(x => (object)(x.FantasyProsRank ?? 999))" InitialDirection="SortDirection.Ascending">FP Rank</MudTableSortLabel></MudTh>
                            <MudTh>Status</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Rank">
                                <MudText Typo="Typo.body2" Style="font-family:'JetBrains Mono',monospace; color:#9CA3AF;">#@context.ScoreRank</MudText>
                            </MudTd>
                            <MudTd DataLabel="Player">
                                <MudButton Variant="Variant.Text" Class="pa-0"
                                           Style="@($"font-weight:600; text-transform:none; min-width:0; {(IsDrafted(context.SleeperPlayerId) ? "opacity:0.55;" : "")}")"
                                           OnClick="@(() => OpenPlayerCard(context))">
                                    @context.FullName
                                </MudButton>
                                @if (IsDrafted(context.SleeperPlayerId))
                                {
                                    var detail = GetPickDetail(context.SleeperPlayerId);
                                    <MudText Typo="Typo.caption" Style="display:block; font-style:italic; opacity:0.55;">
                                        @if (detail is not null)
                                        {
                                            @(string.IsNullOrEmpty(detail.PickedByTeamName)
                                                ? $"Drafted · {detail.Round}.{detail.Slot:D2}"
                                                : $"Drafted by {detail.PickedByTeamName} · {detail.Round}.{detail.Slot:D2}")
                                        }
                                        else
                                        {
                                            @("Drafted")
                                        }
                                    </MudText>
                                }
                                else if (!string.IsNullOrEmpty(context.CollegeTeam))
                                {
                                    <MudText Typo="Typo.caption" Style="display:block; color:#9CA3AF;">
                                        @context.CollegeTeam
                                    </MudText>
                                }
                            </MudTd>
                            <MudTd DataLabel="Pos">
                                <MudChip T="string" Size="Size.Small" Color="@GetPositionColor(context.Position)" Variant="Variant.Filled">@context.Position</MudChip>
                            </MudTd>
                            <MudTd DataLabel="Team"><MudText Typo="Typo.body2">@(context.NflTeam ?? "—")</MudText></MudTd>
                            <MudTd DataLabel="Age"><MudText Typo="Typo.body2">@(context.Age.HasValue ? context.Age.ToString() : "—")</MudText></MudTd>
                            <MudTd DataLabel="Pick">
                                @if (context.DraftRound.HasValue && context.DraftPick.HasValue)
                                {
                                    <MudText Typo="Typo.body2">R@(context.DraftRound) P@(context.DraftPick)</MudText>
                                }
                                else { <MudText Typo="Typo.body2" Class="mud-text-secondary">—</MudText> }
                            </MudTd>
                            <MudTd DataLabel="Score">
                                <div class="d-flex align-center gap-2">
                                    <MudProgressLinear Value="@context.DynastyScore" Max="100"
                                                       Color="@GetScoreColor(context.DynastyScore)"
                                                       Style="width:60px; height:6px; border-radius:3px;" />
                                    <MudText Typo="Typo.body2" Style="font-weight:600; min-width:36px;">@context.DynastyScore.ToString("F1")</MudText>
                                </div>
                            </MudTd>
                            <MudTd DataLabel="FP Rank">
                                <MudText Typo="Typo.body2">@(context.FantasyProsRank.HasValue ? $"#{context.FantasyProsRank}" : "—")</MudText>
                            </MudTd>
                            <MudTd DataLabel="Status">
                                @if (IsDrafted(context.SleeperPlayerId))
                                {
                                    @if (IsMyPick(context.SleeperPlayerId))
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" Style="font-weight:700;">MY PICK</MudChip>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.caption" Style="opacity:0.4;">—</MudText>
                                    }
                                }
                                else if (_sessionId is not null)
                                {
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.HowToVote"
                                               OnClick="@(() => MarkDrafted(context))"
                                               Style="font-size:0.72rem; font-weight:700; height:28px;">
                                        DRAFT
                                    </MudButton>
                                }
                                else { <MudText Typo="Typo.caption" Class="mud-text-secondary">—</MudText> }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            }
        </MudPaper>
    </MudItem>

    @* ── RIGHT RAIL: ROSTER NEEDS + MY PICKS + BEST PICK ─────────────── *@
    @if (_sessionId is not null)
    {
        <MudItem xs="12" md="3">
            <div style="position:sticky; top:80px; display:flex; flex-direction:column; gap:12px;">

                @* ROSTER NEEDS *@
                <MudPaper Class="fc-card pa-3" Elevation="0">
                    <div class="d-flex align-center justify-space-between mb-2">
                        <MudText Typo="Typo.subtitle2"
                                 Style="font-weight:700; letter-spacing:0.05em; text-transform:uppercase; color:var(--fc-cyan); font-size:0.7rem;">
                            ROSTER NEEDS
                        </MudText>
                        <MudTooltip Text="Current roster + picks in this draft">
                            <MudIcon Icon="@Icons.Material.Filled.Info" Style="font-size:0.85rem; color:var(--mud-palette-text-secondary);" />
                        </MudTooltip>
                    </div>
                    @if (_rosterNeeds.Count == 0)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Syncing...</MudText>
                    }
                    else
                    {
                        @foreach (var need in _rosterNeeds)
                        {
                            <div class="d-flex align-center gap-2 mb-1">
                                <MudTooltip Text="@(need.Detail ?? need.Position)">
                                    <MudText Typo="Typo.caption" Style="@($"min-width:30px; font-weight:700; cursor:help; color:{GetPositionHex(need.Position)};")">
                                        @need.Position
                                    </MudText>
                                </MudTooltip>
                                <MudProgressLinear Value="@Math.Min(need.TotalCount * 20, 100)"
                                                   Color="@GetNeedColor(need.Level)"
                                                   Style="flex:1; height:6px; border-radius:3px;" />
                                <MudText Typo="Typo.caption"
                                         Style="@($"min-width:56px; font-weight:700; font-size:0.65rem; text-align:right; color:{GetNeedHex(need.Level)};")">
                                    @need.Level
                                </MudText>
                            </div>
                        }

                        @* Starting slots — read from the league's own Sleeper
                           roster_positions (FAN-100), still editable so a stale
                           sync can be corrected at the table. *@
                        <MudDivider Class="my-2" />
                        <div class="d-flex align-center justify-space-between mb-1">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary"
                                     Style="font-size:0.62rem; letter-spacing:0.06em; text-transform:uppercase;">
                                Starting Slots
                            </MudText>
                            <div class="d-flex align-center gap-1">
                                @if (_slotsUserEdited)
                                {
                                    <MudTooltip Text="You have edited these. Click to go back to the league's own settings.">
                                        <MudButton Variant="Variant.Text" Size="Size.Small" Class="pa-0"
                                                   Style="min-width:0; height:auto; font-size:0.58rem; text-transform:none; color:#F59E0B;"
                                                   OnClick="ResetSlotsToLeague">
                                            edited · reset
                                        </MudButton>
                                    </MudTooltip>
                                }
                                else if (_slotsFromLeague)
                                {
                                    <MudTooltip Text="Read from your league's Sleeper settings.">
                                        <MudText Typo="Typo.caption"
                                                 Style="font-size:0.58rem; color:#10B981; cursor:help;">
                                            from league
                                        </MudText>
                                    </MudTooltip>
                                }
                                else
                                {
                                    <MudTooltip Text="Sleeper has not reported roster_positions for this league — re-sync it, or set these by hand.">
                                        <MudText Typo="Typo.caption"
                                                 Style="font-size:0.58rem; color:#F87171; cursor:help;">
                                            not synced
                                        </MudText>
                                    </MudTooltip>
                                }
                                <MudTooltip Text="Needs and Best Fit are measured against these.">
                                    <MudIcon Icon="@Icons.Material.Filled.Tune" Style="font-size:0.8rem; color:var(--mud-palette-text-secondary);" />
                                </MudTooltip>
                            </div>
                        </div>
                        <div class="d-flex align-center gap-1 flex-wrap">
                            @foreach (var slot in StarterPositions)
                            {
                                <div class="d-flex align-center gap-1">
                                    <MudText Typo="Typo.caption"
                                             Style="@($"font-weight:700; font-size:0.62rem; color:{GetPositionHex(slot)};")">
                                        @slot
                                    </MudText>
                                    <MudNumericField T="int" Value="@GetStarterSlot(slot)"
                                                     ValueChanged="@((int v) => SetStarterSlot(slot, v))"
                                                     Min="0" Max="6" Variant="Variant.Outlined"
                                                     Margin="Margin.Dense" HideSpinButtons="true"
                                                     Style="width:40px;" Class="fc-slot-input" />
                                </div>
                            }
                        </div>

                        @* Flex slots are typed, not one undifferentiated count. A
                           WR/RB flex and a superflex are completely different
                           questions about who is worth drafting. *@
                        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2 mb-1"
                                 Style="font-size:0.62rem; letter-spacing:0.06em; text-transform:uppercase;">
                            Flex Slots
                        </MudText>
                        <div class="d-flex align-center gap-1 flex-wrap">
                            @foreach (var flex in FlexTypes)
                            {
                                <div class="d-flex align-center gap-1">
                                    <MudTooltip Text="@flex.Detail">
                                        <MudText Typo="Typo.caption"
                                                 Style="@($"font-weight:700; font-size:0.62rem; color:{(GetFlexSlot(flex.Key) > 0 ? "var(--fc-cyan)" : "#6B7280")}; cursor:help;")">
                                            @flex.Label
                                        </MudText>
                                    </MudTooltip>
                                    <MudNumericField T="int" Value="@GetFlexSlot(flex.Key)"
                                                     ValueChanged="@((int v) => SetFlexSlot(flex.Key, v))"
                                                     Min="0" Max="4" Variant="Variant.Outlined"
                                                     Margin="Margin.Dense" HideSpinButtons="true"
                                                     Style="width:40px;" Class="fc-slot-input" />
                                </div>
                            }
                        </div>

                        @* Slots Sleeper reported that this board cannot model.
                           Named rather than dropped: a starting slot we ignore
                           makes the roster look more complete than it is. *@
                        @if (_unsupportedSlots.Count > 0)
                        {
                            <MudText Typo="Typo.caption" Class="mt-1"
                                     Style="font-size:0.62rem; color:#F59E0B;">
                                ⚠ Not modelled: @(string.Join(", ", _unsupportedSlots)) —
                                needs below exclude @(_unsupportedSlots.Count == 1 ? "this slot" : "these slots").
                            </MudText>
                        }

                        @* Deadline state. The single number that decides whether a
                           required-but-empty slot is worth anything yet. *@
                        @if (MyRemainingPicks > 0)
                        {
                            var unfillable = _unfillableStarterSlots;
                            var slack = MyRemainingPicks - unfillable;
                            var deadlineHex = unfillable > 0 && slack < RosterNeedModel.MandatoryUrgencyHorizon
                                ? "#F87171"
                                : "var(--mud-palette-text-secondary)";
                            <MudText Typo="Typo.caption" Class="mt-1"
                                     Style="@($"font-size:0.62rem; color:{deadlineHex};")">
                                @MyRemainingPicks pick@(MyRemainingPicks == 1 ? "" : "s") left
                                @if (unfillable > 0)
                                {
                                    <text> · @unfillable starting slot@(unfillable == 1 ? "" : "s") still unfilled</text>
                                }
                            </MudText>
                        }

                        @if (_rosterNeedsStale)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1" Style="font-style:italic; font-size:0.65rem;">
                                ⚠ Roster trade detected
                            </MudText>
                        }
                    }
                </MudPaper>

                @* MY PICKS *@
                <MudPaper Class="fc-card pa-3" Elevation="0">
                    <div class="d-flex align-center justify-space-between mb-2">
                        <MudText Typo="Typo.subtitle2"
                                 Style="font-weight:700; letter-spacing:0.05em; text-transform:uppercase; color:var(--fc-cyan); font-size:0.7rem;">
                            MY PICKS
                        </MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @_myPicksList.Count of @_picks.Count
                        </MudText>
                    </div>
                    @if (_myPicksList.Count == 0)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">No picks yet.</MudText>

                        @* Show upcoming MY picks from remaining queue *@
                        @if (_remainingPicks.Where(r => r.IsMyPick).Take(3).ToList() is { Count: > 0 } myUpcoming)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2 mb-1" Style="font-style:italic;">Upcoming:</MudText>
                            @foreach (var upcoming in myUpcoming)
                            {
                                <div class="d-flex align-center gap-2 mb-1">
                                    <MudText Typo="Typo.caption" Style="font-family:'JetBrains Mono',monospace; color:var(--fc-cyan); font-weight:600; min-width:36px;">
                                        @($"{upcoming.Round}.{upcoming.Slot:D2}")
                                    </MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">On the clock — pick incoming...</MudText>
                                </div>
                            }
                        }
                    }
                    else
                    {
                        @* 2026-09-07: was rendering _myPicksList in insertion order,
                           which is whatever order the session resume and the sync
                           happened to append in — 13.05 sat between 2.05 and 3.05
                           on Paul's board. Sort by round then slot. *@
                        @foreach (var pick in _myPicksList.OrderBy(p => p.Round).ThenBy(p => p.Slot))
                        {
                            <div class="d-flex align-center gap-2 mb-2">
                                <MudText Typo="Typo.caption"
                                         Style="font-family:'JetBrains Mono',monospace; color:var(--fc-cyan); min-width:36px; font-weight:600;">
                                    @($"{pick.Round}.{pick.Slot:D2}")
                                </MudText>
                                <div style="flex:1; min-width:0;">
                                    @if (_allRookies.FirstOrDefault(r => r.SleeperPlayerId == pick.SleeperPlayerId) is { } cardPlayer)
                                    {
                                        <MudButton Variant="Variant.Text" Class="pa-0"
                                                   Style="font-weight:600; text-transform:none; min-width:0; height:auto; line-height:1.2; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; display:block;"
                                                   OnClick="@(() => OpenPlayerCard(cardPlayer))">
                                            @pick.PlayerName
                                        </MudButton>
                                    }
                                    else if (_redraftPlayers.FirstOrDefault(r => r.SleeperPlayerId == pick.SleeperPlayerId) is { } redraftCardPlayer)
                                    {
                                        <MudButton Variant="Variant.Text" Class="pa-0"
                                                   Style="font-weight:600; text-transform:none; min-width:0; height:auto; line-height:1.2; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; display:block;"
                                                   OnClick="@(() => OpenPlayerCard(redraftCardPlayer))">
                                            @pick.PlayerName
                                        </MudButton>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.body2" Style="font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@pick.PlayerName</MudText>
                                    }
                                    <MudText Typo="Typo.caption" Style="color:#9CA3AF;">@(pick.NflTeam ?? "FA")</MudText>
                                </div>
                                <MudChip T="string" Size="Size.Small" Color="@GetPositionColor(pick.Position)"
                                         Variant="Variant.Filled" Style="min-width:32px; height:20px; font-size:0.65rem;">
                                    @pick.Position
                                </MudChip>
                            </div>
                        }

                        @* Show next upcoming pick slot after current picks *@
                        @if (_remainingPicks.FirstOrDefault(r => r.IsMyPick) is { } nextMyPick)
                        {
                            <div class="d-flex align-center gap-2 mb-1" style="opacity:0.6;">
                                <MudText Typo="Typo.caption" Style="font-family:'JetBrains Mono',monospace; color:var(--fc-cyan); min-width:36px; font-weight:600;">
                                    @($"{nextMyPick.Round}.{nextMyPick.Slot:D2}")
                                </MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="font-style:italic;">On the clock — pick incoming...</MudText>
                            </div>
                        }
                    }
                </MudPaper>

                @* BEST PICK AI *@
                <MudPaper Class="fc-card pa-3" Elevation="0">
                    <div class="d-flex align-center justify-space-between mb-2">
                        <MudText Typo="Typo.subtitle2"
                                 Style="font-weight:700; letter-spacing:0.05em; text-transform:uppercase; color:var(--fc-cyan); font-size:0.7rem;">
                            BEST PICK (YOU)
                        </MudText>
                        <MudTooltip Text="BPA = best value on the board, ignoring your roster. Best Fit = the same value plus roster need: a slot he would start in, a starting slot with nobody behind it, or a required slot you are running out of picks to fill. Each row says which.">
                            <MudIcon Icon="@Icons.Material.Filled.Info" Style="font-size:0.85rem; color:var(--mud-palette-text-secondary);" />
                        </MudTooltip>
                    </div>
                    @if (_isRedraftMode)
                    {
                        @if (_bestAvailableRedraft.Count == 0)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">No available players.</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary mb-1"
                                     Style="font-size:0.62rem; letter-spacing:0.06em; text-transform:uppercase;">
                                Best Player Available
                            </MudText>
                            @foreach (var rec in _bestAvailableRedraft)
                            {
                                bool isNeed = _rosterNeeds.Any(n => n.Position == rec.Position && n.Level == "NEED");
                                double bpaDv = DraftValueFor(rec);
                                <div class="d-flex align-center gap-2 mb-1">
                                    <MudChip T="string" Size="Size.Small" Color="@GetPositionColor(rec.Position)"
                                             Variant="Variant.Filled"
                                             Style="height:20px; font-size:0.65rem; min-width:32px; flex-shrink:0;">
                                        @rec.Position
                                    </MudChip>
                                    <div Style="flex:1; min-width:0; overflow:hidden;">
                                        <MudButton Variant="Variant.Text" Class="pa-0"
                                                   Style="font-size:0.75rem; font-weight:600; text-transform:none; min-width:0; height:auto; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; display:block; max-width:100%;"
                                                   OnClick="@(() => OpenPlayerCard(rec))">
                                            @rec.PlayerName
                                        </MudButton>
                                    </div>
                                    @if (isNeed)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Star"
                                                 Style="color:#F59E0B; font-size:0.75rem; flex-shrink:0;" />
                                    }
                                    @* Draft Value, not ADP — at the clock the question
                                       isn't his price, it's the gap between his price
                                       and your pick. *@
                                    <MudText Typo="Typo.caption"
                                             Style="@($"font-family:'JetBrains Mono',monospace; font-weight:700; color:{DraftValueHex(bpaDv)}; min-width:34px; text-align:right; flex-shrink:0; font-size:0.72rem;")">
                                        @(bpaDv >= 0 ? "+" : "")@bpaDv.ToString("F0")
                                    </MudText>
                                </div>
                            }

                            <MudDivider Class="my-2" />
                            @* 2026-09-07: when every need term is zero this list is
                               mathematically identical to the one above — same
                               players, same order, same numbers. It used to print
                               anyway, under a heading claiming roster need had been
                               considered. Now it says so. *@
                            @if (_unfillableNeedPositions.Count > 0)
                            {
                                @* A required slot is empty and nothing on this board can
                                   fill it. Naming the position beats a reassurance the
                                   roster does not support. *@
                                <MudText Typo="Typo.caption" Class="mb-1"
                                         Style="font-size:0.62rem; letter-spacing:0.06em; text-transform:uppercase; color:#F87171;">
                                    Best Fit — @(string.Join(" / ", _unfillableNeedPositions)) not on this board
                                </MudText>
                                <MudText Typo="Typo.caption"
                                         Style="font-size:0.68rem; color:#F87171;">
                                    You still need @(string.Join(" and ", _unfillableNeedPositions))
                                    and there @(_unfillableNeedPositions.Count == 1 ? "is none" : "are none")
                                    available here. Draft @(_unfillableNeedPositions.Count == 1 ? "one" : "them")
                                    in Sleeper directly, or check the position filter.
                                </MudText>
                            }
                            else if (_bestFitIsBpa)
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary mb-1"
                                         Style="font-size:0.62rem; letter-spacing:0.06em; text-transform:uppercase;">
                                    Best Fit
                                </MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary"
                                         Style="font-size:0.68rem; font-style:italic;">
                                    Every starting slot is filled and covered — roster need has nothing
                                    to add here, so this would just repeat the list above. Take the best
                                    player.
                                </MudText>
                            }
                            else if (_bestFitRedraft.Count > 0)
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary mb-1"
                                         Style="font-size:0.62rem; letter-spacing:0.06em; text-transform:uppercase;">
                                    Best Fit (Value + Roster Need)
                                </MudText>
                                @foreach (var fit in _bestFitRedraft)
                                {
                                    var rec = fit.Player;
                                    <div class="d-flex align-center gap-2" style="margin-bottom:2px;">
                                        <MudChip T="string" Size="Size.Small" Color="@GetPositionColor(rec.Position)"
                                                 Variant="Variant.Filled"
                                                 Style="height:20px; font-size:0.65rem; min-width:32px; flex-shrink:0;">
                                            @rec.Position
                                        </MudChip>
                                        <div Style="flex:1; min-width:0; overflow:hidden;">
                                            <MudButton Variant="Variant.Text" Class="pa-0"
                                                       Style="font-size:0.75rem; font-weight:600; text-transform:none; min-width:0; height:auto; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; display:block; max-width:100%;"
                                                       OnClick="@(() => OpenPlayerCard(rec))">
                                                @rec.PlayerName
                                            </MudButton>
                                        </div>
                                        @if (fit.NeedBonus > 0)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Star"
                                                     Style="color:#F59E0B; font-size:0.75rem; flex-shrink:0;" />
                                        }
                                        @* Draft-value surplus against the pick on the clock, plus
                                           whatever roster need added. The reason line below says
                                           which of the two is doing the work. *@
                                        <MudText Typo="Typo.caption"
                                                 Style="@($"font-family:'JetBrains Mono',monospace; font-weight:700; color:{(fit.Score >= 0 ? "#10B981" : "#F87171")}; min-width:34px; text-align:right; flex-shrink:0; font-size:0.72rem;")">
                                            @(fit.Score >= 0 ? "+" : "")@fit.Score.ToString("F0")
                                        </MudText>
                                    </div>
                                    <div class="d-flex align-center gap-2 mb-2" style="padding-left:40px;">
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary"
                                                 Style="font-size:0.6rem; font-style:italic; flex:1; min-width:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                            @(string.IsNullOrEmpty(fit.Reason) ? "value only" : fit.Reason)
                                        </MudText>
                                        @if (fit.NeedBonus > 0)
                                        {
                                            <MudText Typo="Typo.caption"
                                                     Style="font-family:'JetBrains Mono',monospace; font-size:0.6rem; color:#F59E0B; flex-shrink:0;">
                                                need +@fit.NeedBonus.ToString("F0")
                                            </MudText>
                                        }
                                    </div>
                                }
                            }
                        }
                    }
                    else
                    {
                        @if (_bestAvailable.Count == 0)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">No available players.</MudText>
                        }
                        else
                        {
                            @* BPA header *@
                            <MudText Typo="Typo.caption" Class="mud-text-secondary mb-1"
                                     Style="font-size:0.62rem; letter-spacing:0.06em; text-transform:uppercase;">
                                Best Player Available
                            </MudText>
                            @foreach (var rec in _bestAvailable)
                            {
                                bool isNeed = _rosterNeeds.Any(n => n.Position == rec.Position && n.Level == "NEED");
                                <div class="d-flex align-center gap-2 mb-1">
                                    <MudChip T="string" Size="Size.Small" Color="@GetPositionColor(rec.Position)"
                                             Variant="Variant.Filled"
                                             Style="height:20px; font-size:0.65rem; min-width:32px; flex-shrink:0;">
                                        @rec.Position
                                    </MudChip>
                                    <div Style="flex:1; min-width:0; overflow:hidden;">
                                        <MudButton Variant="Variant.Text" Class="pa-0"
                                                   Style="font-size:0.75rem; font-weight:600; text-transform:none; min-width:0; height:auto; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; display:block; max-width:100%;"
                                                   OnClick="@(() => OpenPlayerCard(rec))">
                                            @rec.FullName
                                        </MudButton>
                                    </div>
                                    @if (isNeed)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Star"
                                                 Style="color:#F59E0B; font-size:0.75rem; flex-shrink:0;" />
                                    }
                                    <MudText Typo="Typo.caption"
                                             Style="font-family:'JetBrains Mono',monospace; color:var(--fc-cyan); min-width:24px; text-align:right; flex-shrink:0; font-size:0.72rem;">
                                        @rec.DynastyScore.ToString("F0")
                                    </MudText>
                                </div>
                            }

                            @* Best Fit — only shown when there are NEED positions with available players *@
                            @if (_bestFit.Count > 0)
                            {
                                <MudDivider Class="my-2" />
                                <MudText Typo="Typo.caption" Class="mud-text-secondary mb-1"
                                         Style="font-size:0.62rem; letter-spacing:0.06em; text-transform:uppercase;">
                                    Best Fit (Roster Need)
                                </MudText>
                                @foreach (var rec in _bestFit)
                                {
                                    <div class="d-flex align-center gap-2 mb-1">
                                        <MudChip T="string" Size="Size.Small" Color="@GetPositionColor(rec.Position)"
                                                 Variant="Variant.Filled"
                                                 Style="height:20px; font-size:0.65rem; min-width:32px; flex-shrink:0;">
                                            @rec.Position
                                        </MudChip>
                                        <div Style="flex:1; min-width:0; overflow:hidden;">
                                            <MudButton Variant="Variant.Text" Class="pa-0"
                                                       Style="font-size:0.75rem; font-weight:600; text-transform:none; min-width:0; height:auto; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; display:block; max-width:100%;"
                                                       OnClick="@(() => OpenPlayerCard(rec))">
                                                @rec.FullName
                                            </MudButton>
                                        </div>
                                        <MudIcon Icon="@Icons.Material.Filled.Star"
                                                 Style="color:#F59E0B; font-size:0.75rem; flex-shrink:0;" />
                                        <MudText Typo="Typo.caption"
                                                 Style="font-family:'JetBrains Mono',monospace; color:var(--fc-cyan); min-width:24px; text-align:right; flex-shrink:0; font-size:0.72rem;">
                                            @rec.DynastyScore.ToString("F0")
                                        </MudText>
                                    </div>
                                }
                            }
                        }
                    }
                </MudPaper>

            </div>
        </MudItem>
    }
</MudGrid>

@* ── MARK DRAFTED DIALOG ─────────────────────────────────────────────── *@
<MudDialog @bind-Visible="_showPickDialog">
    <TitleContent>
        <MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.HowToVote" Class="mr-2" />Record Pick</MudText>
    </TitleContent>
    <DialogContent>
        @if (_pendingPick is not null)
        {
            <MudText Typo="Typo.body1" Class="mb-3">
                <strong>@_pendingPick.FullName</strong> · @_pendingPick.Position · @(_pendingPick.NflTeam ?? "—")
            </MudText>
            <MudGrid Spacing="2">
                <MudItem xs="6">
                    <MudNumericField @bind-Value="_pickRound" Label="Round" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="20" />
                </MudItem>
                <MudItem xs="6">
                    <MudNumericField @bind-Value="_pickSlot" Label="Pick Slot" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="20" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_pickedByTeamName" Label="Picked By (team name)" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Optional" />
                </MudItem>
                <MudItem xs="12">
                    <MudCheckBox @bind-Value="_isMyPick" Label="This is my pick" />
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showPickDialog = false)">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ConfirmPick" Disabled="_recordingPick">
            @if (_recordingPick) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
            Confirm Pick
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<RookiePlayerDto> _allRookies = [];
    private List<RookiePlayerDto> _filtered = [];
    private List<RedraftBoardPlayerDto> _redraftPlayers = [];
    private List<RedraftBoardPlayerDto> _filteredRedraft = [];
    // FIX-PRESEASON-001 (2026-08-27): true when LoadRedraftPlayers had to fall
    // back to live ADP because no Week 1 sim data exists yet.
    private bool _isPreseasonAdpFallback = false;
    private List<LeagueItem> _leagues = [];

    private HashSet<string> _picks = [];
    private HashSet<string> _myPickIds = [];
    private List<MyPickEntry> _myPicksList = [];
    private Dictionary<string, PickDetailEntry> _pickDetails = [];

    private int _totalPicksInDraft = 0;
    private List<RemainingPickEntry> _remainingPicks = [];
    private List<RosterNeedEntry> _rosterNeeds = [];
    private List<RookiePlayerDto> _bestAvailable = [];   // pure BPA by score
    private List<RookiePlayerDto> _bestFit = [];          // best available at NEED positions
    private List<RedraftBoardPlayerDto> _bestAvailableRedraft = [];  // redraft: ADP order
    private List<BestFitEntry> _bestFitRedraft = [];

    // True when every need term came out at zero for every available player —
    // i.e. Best Fit has nothing to say that Best Player Available did not
    // already say. Shown, not hidden. See RecomputeRedraftNeedsAndBestAvailable.
    private bool _bestFitIsBpa = false;

    // True when a position IS short of a required slot but no player at that
    // position is on the board to fill it. Distinct from _bestFitIsBpa: one
    // means "you have no needs", this means "you have a need I cannot fill from
    // here". Conflating them is how the panel came to announce that every
    // starting slot was covered while Paul had no kicker.
    private List<string> _unfillableNeedPositions = [];

    // 2026-09-07: computed once in the recompute rather than called again from
    // the markup. The sidebar was rendering "N starting slots still unfilled"
    // from a fresh CurrentPositionCounts() while the needs list above it came
    // from the last recompute — two answers to the same question, on screen
    // together, disagreeing whenever a sync landed between them.
    private int _unfillableStarterSlots = 0;

    // This league's format. Parsed once; every branch below asks a named
    // question of it rather than comparing LeagueType strings.
    private LeagueFormat _leagueFormat = LeagueFormat.Redraft;
    private Dictionary<string, int>? _liveRosterPositionCounts;
    private bool _rosterNeedsStale = false;

    // 2026-09-07: true when the redraft board has live ADP to order by.
    private bool _hasAdp = false;

    // Starting-lineup slots for THIS league.
    //
    // 2026-09-07 (FAN-100): these are now READ from the league's Sleeper
    // roster_positions and remain editable. The value had been sitting in
    // Postgres since April — League.RosterPositions, written on every import
    // and sync — and had simply never been carried to any client, so the board
    // asked Paul to retype his own starting lineup every draft and had no way
    // at all to express the K and DEF his league requires.
    //
    // The edit boxes stay. A user override beats a stale sync, and the panel
    // says which of the two you are looking at.
    private Dictionary<string, int> _starterSlots = new(StringComparer.OrdinalIgnoreCase)
        { ["QB"] = 1, ["RB"] = 2, ["WR"] = 2, ["TE"] = 1, ["K"] = 0, ["DEF"] = 0 };

    // Where the numbers above came from, so the panel can say so.
    private bool _slotsFromLeague = false;
    private bool _slotsUserEdited = false;

    // Starting slots Sleeper reported that this board does not model (IDP and
    // anything new). Surfaced rather than dropped — a slot we silently ignore
    // understates how many players the roster still owes.
    private List<string> _unsupportedSlots = [];

    // 2026-09-07: flex used to be a single FLEX count against a hardcoded
    // RB/WR/TE eligibility list, which cannot express the leagues people actually
    // play. Paul's has 2 × WR/RB, where a tight end is NOT flex-eligible — the old
    // model credited tight ends with flex value they could never claim, and had no
    // way to represent superflex at all. Sleeper already distinguishes these in
    // roster_positions (FLEX, WRRB_FLEX, REC_FLEX, SUPER_FLEX), so this mirrors
    // those names rather than inventing a parallel vocabulary.
    private record FlexSlotType(string Key, string Label, string Detail, string[] Eligible);

    private static readonly FlexSlotType[] FlexTypes =
    [
        new("FLEX",      "FLEX",  "RB / WR / TE",      ["RB", "WR", "TE"]),
        new("WRRB",      "W/R",   "WR / RB",           ["RB", "WR"]),
        new("RECFLEX",   "W/T",   "WR / TE",           ["WR", "TE"]),
        new("SUPERFLEX", "SFLEX", "QB / RB / WR / TE", ["QB", "RB", "WR", "TE"]),
    ];

    private Dictionary<string, int> _flexSlots = new(StringComparer.OrdinalIgnoreCase)
        { ["FLEX"] = 1, ["WRRB"] = 0, ["RECFLEX"] = 0, ["SUPERFLEX"] = 0 };

    // The slot boxes in the sidebar, in display order. The split between skill
    // positions (which take part in the flex simulation) and mandatory ones
    // (K/DEF, which get urgency instead of gap credit) is defined once, in
    // RosterNeedModel, and read from there rather than restated here.
    private static readonly string[] StarterPositions =
        [.. RosterNeedModel.SkillPositions, .. RosterNeedModel.MandatoryPositions];

    private bool _hideDrafted = false;
    private string? _selectedLeagueId;
    private string? _selectedLeagueName;
    private string? _sessionId;
    private string? _selectedPosition;
    private string _searchText = string.Empty;
    private bool _loading = true;
    private bool _isRedraftMode = false;
    private bool _autoSyncEnabled = false;

    private bool _startingSession = false;
    private bool _recordingPick = false;
    private bool _showPickDialog = false;
    private PendingPickInfo? _pendingPick;
    private int _pickRound = 1;
    private int _pickSlot = 1;
    private string? _pickedByTeamName;
    private bool _isMyPick = false;

    private Timer? _syncTimer;
    private bool _syncing = false;

    protected override async Task OnInitializedAsync()
    {
        LeagueState.OnLeagueChanged += OnLeagueChangedHandler;
        await LoadLeagues();

        if (!string.IsNullOrEmpty(LeagueState.ActiveLeagueId))
        {
            _selectedLeagueId = LeagueState.ActiveLeagueId;
            _selectedLeagueName = _leagues.FirstOrDefault(l => l.LeagueId == _selectedLeagueId)?.LeagueName;
        }

        var league = _leagues.FirstOrDefault(l => l.LeagueId == _selectedLeagueId);
        // 2026-09-07: was `LeagueType != "Dynasty"`, which silently made a
        // KEEPER league redraft here while MyTeam.razor's opposite-polarity
        // `!= "Redraft"` made the same league dynasty there. Both now ask the
        // same named question of a parsed format.
        _leagueFormat = LeagueFormatExtensions.ParseLeagueFormat(league?.LeagueType);
        _isRedraftMode = !_leagueFormat.UsesRookieDraftPool();

        // FAN-100: take the starting lineup from the league before anything is
        // measured against it.
        ApplyLeagueRosterConfiguration(league);

        await LoadCurrentMode();

        // Fix 2026-08-27: session resume is no longer dynasty-gated (see
        // session bar above) — live sync now works for redraft leagues too.
        if (!string.IsNullOrEmpty(_selectedLeagueId))
            await TryResumeSession();
    }

    private void OnLeagueChangedHandler()
    {
        var league = _leagues.FirstOrDefault(l => l.LeagueId == LeagueState.ActiveLeagueId);
        if (league is null) return;
        _selectedLeagueId = league.LeagueId;
        _selectedLeagueName = league.LeagueName;
        _leagueFormat = LeagueFormatExtensions.ParseLeagueFormat(league.LeagueType);
        _isRedraftMode = !_leagueFormat.UsesRookieDraftPool();

        // A different league is a different starting lineup — take its own
        // configuration rather than carrying the last one's over, and drop any
        // manual override with it, since that override was about another league.
        _slotsUserEdited = false;
        ApplyLeagueRosterConfiguration(league, force: true);

        ResetSessionState();
        StopSyncTimer();
        _ = InvokeAsync(async () =>
        {
            await LoadCurrentMode();
            if (!string.IsNullOrEmpty(_selectedLeagueId))
                await TryResumeSession();
            StateHasChanged();
        });
    }

    private void ResetSessionState()
    {
        _sessionId = null;
        _picks = []; _myPickIds = []; _myPicksList = []; _pickDetails = [];
        _hideDrafted = false; _allRookies = []; _filtered = [];
        _redraftPlayers = []; _filteredRedraft = []; _isPreseasonAdpFallback = false;
        _totalPicksInDraft = 0; _remainingPicks = [];
        _rosterNeeds = []; _bestAvailable = []; _bestFit = [];
        _bestAvailableRedraft = []; _bestFitRedraft = []; _bestFitIsBpa = false;
        _unfillableNeedPositions = []; _unfillableStarterSlots = 0;
        _liveRosterPositionCounts = null; _rosterNeedsStale = false;
    }

    public void Dispose()
    {
        LeagueState.OnLeagueChanged -= OnLeagueChangedHandler;
        StopSyncTimer();
    }

    private async Task TryResumeSession()
    {
        try
        {
            var response = await Http.GetAsync($"api/v1/drafttools/sessions/active?leagueId={_selectedLeagueId}");
            if (!response.IsSuccessStatusCode) return;

            var session = await response.Content.ReadFromJsonAsync<DraftSessionDto>();
            if (session is null) return;

            _sessionId = session.Id;

            foreach (var pick in session.Picks)
            {
                _picks.Add(pick.SleeperPlayerId);
                _pickDetails[pick.SleeperPlayerId] = new PickDetailEntry(pick.PlayerName, pick.Round, pick.Slot, pick.PickedByTeamName);
                if (pick.IsMyPick)
                {
                    _myPickIds.Add(pick.SleeperPlayerId);
                    _myPicksList.Add(new MyPickEntry(pick.SleeperPlayerId, pick.PlayerName, pick.Position, pick.NflTeam, pick.Round, pick.Slot));
                }
            }

            if (!string.IsNullOrEmpty(session.SleeperDraftId))
            {
                StartSyncTimer(); // fires immediately — first tick populates Up Next + Needs
                Snackbar.Add($"Draft session resumed · {_picks.Count} picks recorded", Severity.Info);
            }
            else
            {
                if (_isRedraftMode) RecomputeRedraftNeedsAndBestAvailable(); else RecomputeNeedsAndBestAvailable();
                Snackbar.Add("Draft session resumed (manual mode)", Severity.Info);
            }

            StateHasChanged();
        }
        catch { }
    }

    private void StartSyncTimer()
    {
        _autoSyncEnabled = true;
        _syncTimer?.Dispose();
        _syncTimer = new Timer(async _ => await SyncFromSleeper(), null, TimeSpan.Zero, TimeSpan.FromSeconds(30));
    }

    private void StopSyncTimer()
    {
        _autoSyncEnabled = false;
        _syncTimer?.Dispose();
        _syncTimer = null;
    }

    private async Task SyncFromSleeper()
    {
        if (_sessionId is null || _syncing) return;
        _syncing = true;
        try
        {
            var result = await Http.GetFromJsonAsync<SyncResult>($"api/v1/drafttools/sessions/{_sessionId}/sync-sleeper");
            if (result is null) return;

            if (result.TotalPicksInDraft > 0) _totalPicksInDraft = result.TotalPicksInDraft;

            bool changed = false;
            foreach (var pick in result.NewPicks)
            {
                if (!_picks.Add(pick.SleeperPlayerId)) continue;
                _pickDetails[pick.SleeperPlayerId] = new PickDetailEntry(pick.PlayerName, pick.Round, pick.Slot, null);
                if (pick.IsMyPick)
                {
                    _myPickIds.Add(pick.SleeperPlayerId);
                    _myPicksList.Add(new MyPickEntry(pick.SleeperPlayerId, pick.PlayerName, pick.Position, null, pick.Round, pick.Slot));
                }
                changed = true;
            }

            // Up Next — always update from server (it rebuilds from slot_to_roster_id each sync)
            _remainingPicks = result.RemainingPicks
                .Select(r => new RemainingPickEntry(r.Round, r.Slot, r.TeamName, r.SleeperRosterId, r.IsMyPick))
                .ToList();

            if (result.MyRosterChanged)
            {
                _rosterNeedsStale = true;
                Snackbar.Add("Roster trade detected — updating needs.", Severity.Info);
            }

            if (result.LiveRosterPositionCounts is not null)
            {
                _liveRosterPositionCounts = result.LiveRosterPositionCounts;
                _rosterNeedsStale = false;
            }

            if (changed || result.LiveRosterPositionCounts is not null || result.RemainingPicks.Count > 0)
            {
                if (_isRedraftMode) RecomputeRedraftNeedsAndBestAvailable(); else RecomputeNeedsAndBestAvailable();
            }

            // Re-apply the active filter so newly-synced picks actually drop
            // out of (or get marked drafted in) the visible table — not just
            // reflected in the Needs/Best Available panels.
            if (changed)
            {
                if (_isRedraftMode) ApplyRedraftFilter(); else ApplyRookieFilter();
            }

            await InvokeAsync(() =>
            {
                StateHasChanged();
                if (result.NewPicks.Count > 0)
                {
                    foreach (var p in result.NewPicks.Where(p => p.IsMyPick))
                        Snackbar.Add($"Your pick: {p.PlayerName} ({p.Position}) — {p.Round}.{p.Slot:D2}", Severity.Success);
                    var others = result.NewPicks.Where(p => !p.IsMyPick).ToList();
                    if (others.Count == 1)
                        Snackbar.Add($"Picked: {others[0].PlayerName} ({others[0].Position})", Severity.Normal);
                    else if (others.Count > 1)
                        Snackbar.Add($"{others.Count} picks synced", Severity.Normal);
                }
            });

            if (result.DraftComplete)
            {
                StopSyncTimer();
                await InvokeAsync(() => { Snackbar.Add("Draft complete!", Severity.Success); StateHasChanged(); });
            }
        }
        catch { }
        finally { _syncing = false; }
    }

    // Shared by both modes — position-count needs only depend on session/pick
    // state, not on which player pool (dynasty rookies vs redraft board) is
    // loaded, so this stays mode-agnostic.
    // ── Draft Value ───────────────────────────────────────────────────────
    //
    // 2026-09-07. "Josh Allen fell to the sixth round" and "a WR4 fell to the
    // sixth round" are not the same event, and counting picks-fallen scores them
    // identically — which is precisely how the first version of this panel came to
    // recommend Xavier Legette at pick 1 with a +174. A raw `adp - currentPick`
    // rewards a LATE ADP, so the most undraftable player on the board wins.
    //
    // Value is not linear in pick number: the gap between pick 1 and pick 15 is
    // enormous, the gap between 140 and 154 is nearly nothing. So the honest
    // measure is the difference in pick VALUE between where the market says he
    // goes and where you can actually have him.
    //
    //     DraftValue = PickValue(his ADP) − PickValue(the pick on the clock)
    //
    // One function, three behaviours, all wanted:
    //
    //   * falling further is worth convexly more (a whole round beats four picks)
    //   * an equal fall is worth more for a better player (Allen 20→60 scores +36;
    //     a mid-rounder 100→140 scores +9)
    //   * reaching is negative, and a late-ADP player at an early pick is deeply
    //     negative rather than a jackpot
    //
    // The decay constant puts pick 1 at 100 and spans a 12-team first round from
    // roughly 100 to 81. Nothing about it is sacred; the shape is what matters.
    private const double PickValueDecay = 0.0175;

    private static double PickValue(double pickNumber) =>
        100.0 * Math.Exp(-PickValueDecay * Math.Max(0, pickNumber - 1));

    /// <summary>
    /// The pick on the clock. _picks holds every player taken league-wide, so the
    /// next selection is one past it. Pre-draft this is 1, which correctly makes
    /// every Draft Value zero or negative — nothing can fall to you before the
    /// draft has started.
    /// </summary>
    private int NextPickNumber => _picks.Count + 1;

    private double DraftValueFor(RedraftBoardPlayerDto p) =>
        p.Adp.HasValue
            ? PickValue(p.Adp.Value) - PickValue(NextPickNumber)
            : 0d;

    // Thresholds are in value points, not picks. ~15 is about a full round of
    // surplus in the early-middle of a draft; ~6 is a real but ordinary edge.
    private static string DraftValueLabel(double v) =>
        v >= 15 ? "STEAL" : v >= 6 ? "VALUE" : v <= -15 ? "REACH" : string.Empty;

    private static string DraftValueHex(double v) =>
        v >= 15 ? "#10B981" : v >= 6 ? "#34D399" : v <= -15 ? "#F87171" : "#9CA3AF";

    private int GetStarterSlot(string slot) =>
        _starterSlots.TryGetValue(slot, out var v) ? v : 0;

    private void SetStarterSlot(string slot, int value)
    {
        _starterSlots[slot] = Math.Max(0, value);
        _slotsUserEdited = true;
        RecomputeAfterSlotChange();
    }

    private int GetFlexSlot(string key) =>
        _flexSlots.TryGetValue(key, out var v) ? v : 0;

    private void SetFlexSlot(string key, int value)
    {
        _flexSlots[key] = Math.Max(0, value);
        _slotsUserEdited = true;
        RecomputeAfterSlotChange();
    }

    /// <summary>Discards a manual override and re-reads the league's own configuration.</summary>
    private void ResetSlotsToLeague()
    {
        _slotsUserEdited = false;
        ApplyLeagueRosterConfiguration(
            _leagues.FirstOrDefault(l => l.LeagueId == _selectedLeagueId), force: true);
        RecomputeAfterSlotChange();
    }

    private void RecomputeAfterSlotChange()
    {
        if (_isRedraftMode) RecomputeRedraftNeedsAndBestAvailable();
        else RecomputeNeedsAndBestAvailable();
    }

    /// <summary>
    /// The roster these needs are measured against.
    ///
    /// 2026-09-07, two fixes in one. This used to seed the dictionary from
    /// `_liveRosterPositionCounts` and then ADD every draft pick on top:
    ///
    ///     combined[kv.Key] = kv.Value;                      // live roster
    ///     combined[pick.Position] = ...existing + 1;        // ...plus picks
    ///
    /// 1. It summed two overlapping sets. `_liveRosterPositionCounts` comes from
    ///    SyncSleeperPicksQueryHandler, which fetches your LIVE Sleeper roster —
    ///    and during a draft that roster already contains everything you have
    ///    drafted. Every player you picked was counted twice. On Paul's board
    ///    Josh Allen, Kenneth Walker, Puka Nacua and Garrett Wilson each counted
    ///    two, which is why a roster one-deep at tight end reported STRONG.
    ///
    /// 2. It counted a keeper league's carried-over roster as though it were the
    ///    current team. See LeagueFormat.CarriedRosterCountsTowardDraftNeeds —
    ///    that roster held a kicker and a defense Paul was not keeping, so the
    ///    board marked both mandatory slots filled and never surfaced a kicker.
    ///
    /// The two sources are alternatives, never addends. Where the live roster is
    /// authoritative it is used alone (it already includes the picks); otherwise
    /// the draft's own picks are the roster.
    /// </summary>
    private Dictionary<string, int> CurrentPositionCounts()
    {
        if (_leagueFormat.CarriedRosterCountsTowardDraftNeeds()
            && _liveRosterPositionCounts is { Count: > 0 })
        {
            // Already includes this draft's picks — Sleeper updates the roster as
            // picks land. A pick made since the last sync is missing for at most
            // one sync interval, which is a far smaller error than double-counting
            // every player on the roster.
            return new Dictionary<string, int>(
                _liveRosterPositionCounts, StringComparer.OrdinalIgnoreCase);
        }

        var counts = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        foreach (var pick in _myPicksList)
            counts[pick.Position] = counts.TryGetValue(pick.Position, out var c) ? c + 1 : 1;

        return counts;
    }
    // ── Roster need ──────────────────────────────────────────────────────────
    //
    // 2026-09-07: the math moved to FF.Domain.ValueObjects.RosterNeedModel.
    // It lived here, in a .razor file that FF.Tests cannot reference and that
    // has no bUnit harness — so it shipped untested, and what shipped was a
    // single term that silently evaluated to zero for every player from about
    // round six of every draft onward. The model now carries its own tests;
    // this page just supplies the league and the counts.

    /// <summary>
    /// This league's starting lineup, as the domain models it. Built from the
    /// sidebar's slot boxes — which are themselves seeded from the league's real
    /// Sleeper roster_positions — so the user's override and the league's own
    /// settings flow through exactly the same path.
    /// </summary>
    private RosterConfiguration CurrentRosterConfiguration()
    {
        var flex = new List<FlexSlotDefinition>();

        foreach (var t in FlexTypes)
        {
            var n = _flexSlots.TryGetValue(t.Key, out var v) ? Math.Max(0, v) : 0;
            for (var i = 0; i < n; i++)
                flex.Add(new FlexSlotDefinition([.. t.Eligible]));
        }

        return new RosterConfiguration
        {
            QbSlots = GetStarterSlot("QB"),
            RbSlots = GetStarterSlot("RB"),
            WrSlots = GetStarterSlot("WR"),
            TeSlots = GetStarterSlot("TE"),
            KSlots = GetStarterSlot("K"),
            DefSlots = GetStarterSlot("DEF"),
            FlexSlotDefinitions = flex
        };
    }

    private RosterNeedModel NeedModel() => new(CurrentRosterConfiguration());

    /// <summary>
    /// My picks left in this draft. Comes from the live remaining-pick queue, so
    /// it is zero when there is no live session — in which case the urgency term
    /// stays silent rather than inventing a deadline.
    /// </summary>
    private int MyRemainingPicks => _remainingPicks.Count(r => r.IsMyPick);


    // 2026-09-07: this used to fire NEED only at count == 0 and STRONG at fixed
    // counts (WR >= 5 and so on), reading nothing about the league. In a 3-WR
    // league that declared one receiver sufficient. Worse, Best Fit was computed
    // ONLY for NEED positions, so once you owned one of everything — about round
    // 4 — the panel went silent for the rest of the draft, exactly when roster
    // construction starts to matter. Need is now measured against real starting
    // slots and expressed as a gap, not a boolean.
    private List<RosterNeedEntry> ComputeRosterNeeds()
    {
        var counts = CurrentPositionCounts();
        var model = NeedModel();
        var fill = model.FillLineup(counts);

        var rows = new List<RosterNeedEntry>();

        foreach (var pos in new[] { "RB", "WR", "TE", "QB" })
        {
            int total = counts.TryGetValue(pos, out var c) ? c : 0;
            int required = _starterSlots.TryGetValue(pos, out var r) ? r : 0;
            var gap = model.StarterGap(pos, counts);
            var starting = fill.UsedByPosition.TryGetValue(pos, out var u) ? u : 0;
            var behind = total - starting;

            // NEED    = the next player here starts for you.
            // THIN    = the lineup is full but nobody is behind the starters.
            // OK      = covered.
            // STRONG  = two deep behind every slot he could occupy.
            var level = gap >= 1 ? "NEED"
                      : starting > 0 && behind <= 0 ? "THIN"
                      : total >= (required * 2) + 1 ? "STRONG"
                      : "OK";

            var detail = gap >= 1
                ? $"{gap} would start"
                : starting > 0
                    ? $"{starting} starting · {behind} behind"
                    : null;

            rows.Add(new RosterNeedEntry(pos, total, level, detail));
        }

        // 2026-09-07: K and DEF were absent from this list entirely, so a league
        // that requires both showed a fully green Roster Needs panel while two
        // of its ten starting slots sat empty. They only appear when the league
        // actually plays them.
        foreach (var pos in RosterNeedModel.MandatoryPositions)
        {
            int required = _starterSlots.TryGetValue(pos, out var r) ? Math.Max(0, r) : 0;
            if (required == 0) continue;

            int total = counts.TryGetValue(pos, out var c) ? c : 0;
            var short_ = required - total;

            rows.Add(new RosterNeedEntry(
                pos,
                total,
                short_ > 0 ? "REQUIRED" : "OK",
                short_ > 0 ? $"{short_} unfilled" : $"{total}/{required}"));
        }

        return rows;
    }

    private void RecomputeNeedsAndBestAvailable()
    {
        _rosterNeeds = ComputeRosterNeeds();
        var needPositions = _rosterNeeds.Where(n => n.Level == "NEED").Select(n => n.Position).ToHashSet();

        var available = _allRookies.Where(r => !_picks.Contains(r.SleeperPlayerId)).ToList();

        // BPA — pure score, no need boost
        _bestAvailable = available
            .OrderByDescending(r => r.DynastyScore)
            .Take(3)
            .ToList();

        // Best Fit — best player specifically at a NEED position
        // One pick per NEED position, ordered by score within that position
        _bestFit = needPositions.Count == 0
            ? []
            : needPositions
                .Select(pos => available.Where(r => r.Position == pos)
                                        .OrderByDescending(r => r.DynastyScore)
                                        .FirstOrDefault())
                .Where(r => r is not null)
                .Select(r => r!)
                .OrderByDescending(r => r.DynastyScore)
                .Take(3)
                .ToList();

        // Same deadline figure the redraft path computes. Set here too, or the
        // sidebar's "N starting slots still unfilled" silently reads 0 for every
        // dynasty draft — the exact stale-second-source bug this field replaced.
        _unfillableStarterSlots =
            NeedModel().UnfillableStarterSlots(CurrentPositionCounts());
        _unfillableNeedPositions = [];

        _rosterNeedsStale = false;
    }

    // 2026-09-07 rewrite. Two changes.
    //
    // Best Available is now the top of the ADP board rather than the top of a
    // per-game points list — see LoadRedraftPlayers for why points cannot order
    // a draft. Each entry carries its surplus against the pick actually on the
    // clock: a player whose market price is pick 38, still sitting there at pick
    // 52, is +14. That is the instrument the 09-06 keeper analysis ran on, and
    // it is explainable out loud at the table.
    //
    // Best Fit is the same pool re-scored, with roster need as a WEIGHT rather
    // than a filter. The old version partitioned on NEED, which is why one
    // flagged need floated every player at that position above the board's best
    // available (FAN-104) and why the panel produced nothing at all once no
    // position sat at zero.
    private void RecomputeRedraftNeedsAndBestAvailable()
    {
        _rosterNeeds = ComputeRosterNeeds();
        var counts = CurrentPositionCounts();

        var available = _redraftPlayers.Where(r => !_picks.Contains(r.SleeperPlayerId)).ToList();

        _bestAvailableRedraft = available
            .OrderBy(r => r.Rank)
            .Take(3)
            .Select(r => r with { ValueVsPick = DraftValueFor(r) })
            .ToList();

        // Need is scored per POSITION, so assess each one once rather than once
        // per available player — StarterGap runs a lineup simulation per probe
        // and the board is a few hundred rows.
        //
        // Worth knowing rather than treating as magic numbers: because pick value
        // decays, need is a SMALL term early (a 10-pick fall in round one is worth
        // ~15, dwarfing the 8 a starter gap adds) and a LARGE one late (the same
        // fall in round twelve is worth ~2). That is the behaviour you want.
        // Early, take the best player. Late, when everyone left is worth about the
        // same, roster construction is the only thing left to decide on.
        var model = NeedModel();
        var picksLeft = MyRemainingPicks;

        var needByPosition = available
            .Select(r => r.Position)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToDictionary(
                pos => pos,
                pos => model.Assess(pos, counts, picksLeft),
                StringComparer.OrdinalIgnoreCase);

        var scored = available
            .Select(r =>
            {
                var dv = DraftValueFor(r);
                var need = needByPosition[r.Position];
                return new BestFitEntry(
                    r, dv + need.Bonus, dv, need.Bonus, need.Reason);
            })
            .ToList();

        // If nothing anywhere on the board earned a need bonus, Best Fit has
        // nothing to add over BPA. Say so instead of reprinting BPA under a
        // heading that claims otherwise.
        _bestFitIsBpa = scored.Count > 0 && scored.All(x => x.NeedBonus <= 0);

        // 2026-09-07. _bestFitIsBpa alone was not enough, and the gap between
        // what it means and what the panel SAID cost Paul a kicker.
        //
        // It is computed over AVAILABLE PLAYERS, so it can only ever answer
        // "did anything on this board earn a need bonus". When a required slot
        // is empty and no player at that position is on the board, every row
        // scores zero, the flag goes true, and the panel announced "every
        // starting slot is filled and covered" — a claim about the ROSTER,
        // which it had no standing to make.
        //
        // Ask the roster directly instead, and name the positions.
        var availablePositions = needByPosition.Keys.ToHashSet(StringComparer.OrdinalIgnoreCase);

        _unfillableNeedPositions = StarterPositions
            .Where(pos =>
            {
                var required = _starterSlots.TryGetValue(pos, out var r) ? Math.Max(0, r) : 0;
                if (required == 0) return false;
                var owned = counts.TryGetValue(pos, out var c) ? c : 0;
                return owned < required && !availablePositions.Contains(pos);
            })
            .ToList();

        _unfillableStarterSlots = model.UnfillableStarterSlots(counts);

        _bestFitRedraft = scored
            .OrderByDescending(x => x.Score)
            .ThenBy(x => x.Player.Rank)
            .Take(3)
            .Select(x => x with { Player = x.Player with { ValueVsPick = x.Score } })
            .ToList();

        _rosterNeedsStale = false;
    }

    // ── League roster configuration (FAN-100) ────────────────────────────────

    /// <summary>
    /// Loads the starting lineup from the league's Sleeper roster_positions.
    /// A user edit wins over a later sync — the whole point of keeping the boxes
    /// editable is that Paul can correct us, and silently overwriting his
    /// correction on the next league change would be its own quiet bug.
    /// </summary>
    private void ApplyLeagueRosterConfiguration(LeagueItem? league, bool force = false)
    {
        if (league?.RosterPositions is not { Length: > 0 } raw)
        {
            _slotsFromLeague = false;
            _unsupportedSlots = [];
            return;
        }

        if (_slotsUserEdited && !force) return;

        var tokens = raw.Split(',', StringSplitOptions.RemoveEmptyEntries
                                  | StringSplitOptions.TrimEntries);

        int CountOf(params string[] want) =>
            tokens.Count(t => want.Contains(t, StringComparer.OrdinalIgnoreCase));

        _starterSlots = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase)
        {
            ["QB"] = CountOf("QB"),
            ["RB"] = CountOf("RB"),
            ["WR"] = CountOf("WR"),
            ["TE"] = CountOf("TE"),
            ["K"] = CountOf("K"),
            // Sleeper says DEF; some feeds say DST or D. Accept all three so a
            // spelling difference cannot cost the roster a starting slot.
            ["DEF"] = CountOf("DEF", "DST", "D"),
        };

        _flexSlots = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase)
        {
            ["FLEX"] = CountOf("FLEX"),
            ["WRRB"] = CountOf("WRRB_FLEX"),
            ["RECFLEX"] = CountOf("REC_FLEX"),
            ["SUPERFLEX"] = CountOf("SUPER_FLEX"),
        };

        // Anything Sleeper listed as a starting slot that this board cannot
        // model — IDP mostly. Named on screen rather than dropped, because a
        // slot we ignore makes the roster look more complete than it is.
        var known = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
        {
            "QB","RB","WR","TE","K","DEF","DST","D",
            "FLEX","WRRB_FLEX","REC_FLEX","SUPER_FLEX",
            "BN","IR","TAXI"
        };

        _unsupportedSlots = tokens
            .Where(t => !known.Contains(t))
            .GroupBy(t => t, StringComparer.OrdinalIgnoreCase)
            .Select(g => g.Count() > 1 ? $"{g.Key}×{g.Count()}" : g.Key)
            .ToList();

        _slotsFromLeague = true;
    }

