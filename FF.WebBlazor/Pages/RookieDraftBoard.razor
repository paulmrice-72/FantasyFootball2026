    private async Task LoadRookies()
    {
        _loading = true; StateHasChanged();
        try
        {
            var url = string.IsNullOrEmpty(_selectedPosition) ? "api/v1/drafttools/rookies" : $"api/v1/drafttools/rookies?position={_selectedPosition}";
            _allRookies = await Http.GetFromJsonAsync<List<RookiePlayerDto>>(url) ?? [];
            ApplyRookieFilter();
            RecomputeNeedsAndBestAvailable();
        }
        catch { Snackbar.Add("Failed to load rookie pool.", Severity.Error); _allRookies = []; _filtered = []; }
        finally { _loading = false; }
    }

    // Fix 2026-08-27: this used to call api/v1/waiver/available/offseason,
    // which ranks by dynasty TradeValue — the exact bug Paul flagged
    // (Joe Milton, a dynasty-cold-start-shrinkage outlier, showing up in the
    // redraft top 20). Swapped to the same api/v1/projections/simulations
    // endpoint RedraftRankings.razor already uses (redraft-scoring-format
    // weekly production, not career-long dynasty value). Week 1 stands in
    // for "preseason draft baseline" since there's no live week yet.
    // FIX-PRESEASON-001 (2026-08-27): "Week 1 stands in" above turned out to
    // be wrong — Week 1 sim data doesn't exist until this season's own game
    // logs do (CalculateProjectionsCommandHandler needs them), i.e. not until
    // Week 1 is actually played. Added a fallback to live FFC ADP + prior-
    // season per-game average (api/v1/drafttools/redraft-board) for the true
    // preseason window. FAN-96/FAN-100's "wire Consensus ADP" note is now
    // superseded by this — used the already-syncing FFC ADP cache instead of
    // the rookie-only Consensus ADP importer.
    // 2026-09-07: the two sources above were wired as mutually exclusive
    // fallbacks — ADP ran only when the sim query came back EMPTY. Once the
    // 09-06 backfill put 2026 rows in simulation_results, that gate flipped and
    // the whole board silently switched to being ordered by one week's
    // projected points. Per-game points do not order a snake draft: a QB at ~20
    // pts/gm outranks the WR1 at ~15, so a 1-QB league's board inverts. That is
    // the same failure GetDraftPrepQueryHandler diagnosed and fixed on its own
    // side on 08-27 (see its ScoreRank comment) — this page never got it.
    //
    // Both sources are now fetched every time and merged. ADP orders the board
    // because a draft board is a market instrument: it answers "who goes next".
    // Our projection becomes the value signal against that market, which is the
    // instrument that actually held up in the 09-06 keeper analysis.
    private async Task LoadRedraftPlayers()
    {
        _loading = true; StateHasChanged();
        try
        {
            var season = _leagues.FirstOrDefault(l => l.LeagueId == _selectedLeagueId)?.Season
                         ?? DateTime.UtcNow.Year;
            var posParam = string.IsNullOrEmpty(_selectedPosition) ? "" : $"&position={_selectedPosition}";

            // Tolerated individually: one dead endpoint should degrade the
            // board mid-draft, not blank it.
            var simTask = SafeGetAsync<List<RedraftSimDto>>(
                $"api/v1/projections/simulations?season={season}&week=1{posParam}");
            var adpTask = SafeGetAsync<List<RedraftBoardEntryDto>>(
                $"api/v1/drafttools/redraft-board?season={season}{posParam}");
            await Task.WhenAll(simTask, adpTask);

            var simRows = (await simTask) ?? [];
            var adpRows = (await adpTask) ?? [];

            var projBySleeperId = simRows
                .Where(r => !string.IsNullOrEmpty(r.SleeperPlayerId))
                .GroupBy(r => r.SleeperPlayerId)
                .ToDictionary(
                    g => g.Key,
                    g => g.First().Mean > 0m ? g.First().Mean : g.First().Median);

            _hasAdp = adpRows.Count > 0;
            // Header wording only: true when the points column is a prior-season
            // average rather than this season's projection.
            _isPreseasonAdpFallback = simRows.Count == 0;

            // SyncRedraftAdpJob hardcodes a 12-team pull (`GetAdpAsync(season,
            // "ppr", 12, ct)`). In a 10-team league a 12-team ADP is
            // systematically late: the player who goes 24th in a 12-teamer goes
            // about 20th in a 10-teamer, because a pick number is a round times
            // a team count. Ordering is unaffected — the scale is monotonic —
            // but surplus-vs-pick is meaningless without it, so scale here
            // rather than quietly comparing two different rulers.
            var leagueTeams = _leagues.FirstOrDefault(l => l.LeagueId == _selectedLeagueId)?.TotalTeams ?? 12;
            var adpScale = leagueTeams > 0 ? leagueTeams / 12.0 : 1.0;

            if (adpRows.Count > 0)
            {
                _redraftPlayers = adpRows
                    .OrderBy(a => a.Adp)
                    .Select((a, i) => new RedraftBoardPlayerDto(
                        a.SleeperPlayerId, a.PlayerName, a.Position, a.NflTeam,
                        projBySleeperId.TryGetValue(a.SleeperPlayerId, out var p)
                            ? p
                            : a.SeasonAvgPoints ?? 0m,
                        i + 1,
                        Adp: Math.Round(a.Adp * adpScale, 1),
                        AdpRound: leagueTeams > 0
                            ? (int)Math.Ceiling(a.Adp * adpScale / leagueTeams)
                            : a.AdpRound))
                    .ToList();
            }
            else if (simRows.Count > 0)
            {
                // No market data at all. Our own projection is the only thing
                // left, but this ordering IS the QB-heavy one described above —
                // the header says so rather than presenting it as a draft board.
                _redraftPlayers = simRows
                    .Where(r => !string.IsNullOrEmpty(r.SleeperPlayerId))
                    .Select(r => new { r, pts = r.Mean > 0m ? r.Mean : r.Median })
                    .OrderByDescending(x => x.pts)
                    .Select((x, i) => new RedraftBoardPlayerDto(
                        x.r.SleeperPlayerId, x.r.PlayerName, x.r.Position, x.r.NflTeam,
                        x.pts, i + 1))
                    .ToList();
            }
            else
            {
                _redraftPlayers = [];
                Snackbar.Add("No ADP or projection data found — run sync-ffc-adp from the Admin console.", Severity.Warning);
            }

            ApplyRedraftFilter();
            RecomputeRedraftNeedsAndBestAvailable();
        }
        catch { Snackbar.Add("Failed to load redraft rankings.", Severity.Error); _redraftPlayers = []; _filteredRedraft = []; }
        finally { _loading = false; }
    }

    private async Task<T?> SafeGetAsync<T>(string url)
    {
        try { return await Http.GetFromJsonAsync<T>(url); }
        catch { return default; }
    }

    private void ApplyRookieFilter()
    {
        var q = _allRookies.AsEnumerable();
        if (_hideDrafted) q = q.Where(r => !_picks.Contains(r.SleeperPlayerId));
        if (!string.IsNullOrWhiteSpace(_searchText))
            q = q.Where(r => r.FullName.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
                || (r.NflTeam?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false)
                || (r.CollegeTeam?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false));
        _filtered = q.ToList();
    }

    private void ApplyRedraftFilter()
    {
        var q = _redraftPlayers.AsEnumerable();
        if (_hideDrafted) q = q.Where(r => !_picks.Contains(r.SleeperPlayerId));
        if (!string.IsNullOrWhiteSpace(_searchText))
            q = q.Where(r => r.PlayerName.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
                || (r.NflTeam?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false));
        _filteredRedraft = q.ToList();
    }

    private async Task OnPositionChanged(string? position)
    {
        _selectedPosition = position; await LoadCurrentMode();
    }

    private string SearchText
    {
        get => _searchText;
        set { _searchText = value; if (_isRedraftMode) ApplyRedraftFilter(); else ApplyRookieFilter(); }
    }

    private async Task StartSession()
    {
        if (string.IsNullOrEmpty(_selectedLeagueId)) return;
        _startingSession = true; StateHasChanged();
        try
        {
            var response = await Http.PostAsJsonAsync("api/v1/drafttools/sessions",
                new { leagueId = _selectedLeagueId, leagueName = _selectedLeagueName ?? _selectedLeagueId, season = 2026 });

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<SessionStartResponse>();
                _sessionId = result?.SessionId;
                _picks = []; _myPickIds = []; _myPicksList = []; _pickDetails = [];
                _liveRosterPositionCounts = null;

                var session = await Http.GetFromJsonAsync<DraftSessionDto>($"api/v1/drafttools/sessions/{_sessionId}");
                if (session is not null && !string.IsNullOrEmpty(session.SleeperDraftId))
                {
                    StartSyncTimer();
                    Snackbar.Add("Draft session started — auto-syncing from Sleeper!", Severity.Success);
                }
                else
                    Snackbar.Add("Draft session started (manual mode)", Severity.Info);
            }
            else Snackbar.Add("Failed to start session.", Severity.Error);
        }
        catch { Snackbar.Add("Failed to start session.", Severity.Error); }
        finally { _startingSession = false; }
    }

    private void MarkDrafted(RookiePlayerDto player) =>
        MarkDrafted(new PendingPickInfo(player.SleeperPlayerId, player.FullName, player.Position, player.NflTeam));

    private void MarkDrafted(RedraftBoardPlayerDto player) =>
        MarkDrafted(new PendingPickInfo(player.SleeperPlayerId, player.PlayerName, player.Position, player.NflTeam));

    private void MarkDrafted(PendingPickInfo player)
    {
        _pendingPick = player;
        var league = _leagues.FirstOrDefault(l => l.LeagueId == _selectedLeagueId);
        var teamCount = league?.TotalTeams > 0 ? league.TotalTeams : 12;
        var pickNumber = _picks.Count + 1;
        _pickRound = (int)Math.Ceiling((double)pickNumber / teamCount);
        _pickSlot = ((pickNumber - 1) % teamCount) + 1;
        _pickedByTeamName = null; _isMyPick = false;
        _showPickDialog = true;
    }

    private async Task ConfirmPick()
    {
        if (_pendingPick is null || _sessionId is null) return;
        _recordingPick = true;
        try
        {
            var response = await Http.PostAsJsonAsync($"api/v1/drafttools/sessions/{_sessionId}/picks",
                new { sleeperPlayerId = _pendingPick.SleeperPlayerId, playerName = _pendingPick.FullName,
                      position = _pendingPick.Position, nflTeam = _pendingPick.NflTeam,
                      round = _pickRound, slot = _pickSlot, pickedByTeamName = _pickedByTeamName, isMyPick = _isMyPick });

            if (response.IsSuccessStatusCode)
            {
                _picks.Add(_pendingPick.SleeperPlayerId);
                _pickDetails[_pendingPick.SleeperPlayerId] = new PickDetailEntry(_pendingPick.FullName, _pickRound, _pickSlot, _pickedByTeamName);
                if (_isMyPick)
                {
                    _myPickIds.Add(_pendingPick.SleeperPlayerId);
                    _myPicksList.Add(new MyPickEntry(_pendingPick.SleeperPlayerId, _pendingPick.FullName, _pendingPick.Position, _pendingPick.NflTeam, _pickRound, _pickSlot));
                }
                if (_isRedraftMode) { ApplyRedraftFilter(); RecomputeRedraftNeedsAndBestAvailable(); }
                else { ApplyRookieFilter(); RecomputeNeedsAndBestAvailable(); }
                _showPickDialog = false;
                Snackbar.Add($"{_pendingPick.FullName} marked as drafted.", Severity.Success);
            }
            else Snackbar.Add("Failed to record pick.", Severity.Error);
        }
        catch { Snackbar.Add("Failed to record pick.", Severity.Error); }
        finally { _recordingPick = false; }
    }

    private bool IsDrafted(string id) => _picks.Contains(id);
    private bool IsMyPick(string id) => _myPickIds.Contains(id);
    private PickDetailEntry? GetPickDetail(string id) => _pickDetails.TryGetValue(id, out var d) ? d : null;

