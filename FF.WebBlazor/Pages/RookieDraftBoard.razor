@page "/dynasty/rookie-draft"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject LeagueStateService LeagueState
@implements IDisposable

<style>
    /* Drafted rows: fade but keep all pointer events so player card still opens */
    .fc-row-drafted td {
        opacity: 0.45;
    }
    .fc-row-drafted td .mud-button-root {
        pointer-events: auto !important;
        opacity: 1 !important; /* name button stays full opacity — handled inline */
    }
</style>

<PageTitle>Draft Board — FantasyCombine.AI</PageTitle>

<div class="fc-page-header mb-3">
    <MudText Typo="Typo.h5" Class="fc-page-title">
        <MudIcon Icon="@Icons.Material.Filled.SportsFootball" Class="mr-2" Style="vertical-align:middle;" />
        Draft Board
    </MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary">
        @(_isRedraftMode
            ? "Available players ranked by dynasty trade value · Scoring-adjusted"
            : "Dynasty composite scores · Draft capital · FantasyPros rankings")
    </MudText>
</div>

@* ── SESSION BAR ─────────────────────────────────────────────────────── *@
<MudPaper Class="fc-card pa-3 mb-3" Elevation="0">
    <div class="d-flex align-center gap-3 flex-wrap">
        <MudChip T="string" Color="@(_isRedraftMode ? Color.Warning : Color.Primary)"
                 Size="Size.Small" Variant="Variant.Filled">
            @(_isRedraftMode ? "Redraft Mode" : "Dynasty / Rookie Mode")
        </MudChip>

        @if (!_isRedraftMode)
        {
            @if (_sessionId is null)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.PlayArrow"
                           OnClick="StartSession" Size="Size.Medium"
                           Disabled="@(string.IsNullOrEmpty(_selectedLeagueId) || _startingSession)">
                    @if (_startingSession) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                    Start Draft Session
                </MudButton>
            }
            else
            {
                <div class="d-flex align-center gap-2 flex-wrap">
                    <MudIcon Icon="@Icons.Material.Filled.FiberManualRecord" Style="color:#34D399; font-size:0.9rem;" />
                    <MudText Typo="Typo.body2" Style="color:#34D399; font-weight:600;">LIVE</MudText>
                    @if (_totalPicksInDraft > 0)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            Pick @(_picks.Count + 1) of @_totalPicksInDraft
                        </MudText>
                        <MudProgressLinear Value="@(_picks.Count)" Max="@(_totalPicksInDraft)"
                                           Color="Color.Primary" Style="width:80px; height:4px; border-radius:2px;" />
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@_picks.Count picked</MudText>
                    }
                    @if (_autoSyncEnabled)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success"
                                 Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Sync">
                            auto-refresh 30s
                        </MudChip>
                    }
                </div>
            }
        }

        @if (_sessionId is not null && !_isRedraftMode)
        {
            <MudCheckBox Value="_hideDrafted"
                         ValueChanged="@((bool v) => { _hideDrafted = v; ApplyRookieFilter(); })"
                         Label="Hide Drafted" Size="Size.Small" Color="Color.Primary" Class="ml-2" />
        }

        <MudSpacer />

        <MudChipSet T="string" SelectedValueChanged="OnPositionChanged" SelectionMode="SelectionMode.SingleSelection">
            <MudChip T="string" Value="@((string?)null)" Variant="Variant.Filled" Color="@(_selectedPosition is null ? Color.Primary : Color.Default)" Size="Size.Small">All</MudChip>
            <MudChip T="string" Value="@("QB")" Variant="Variant.Filled" Color="@(_selectedPosition == "QB" ? Color.Warning : Color.Default)" Size="Size.Small">QB</MudChip>
            <MudChip T="string" Value="@("RB")" Variant="Variant.Filled" Color="@(_selectedPosition == "RB" ? Color.Success : Color.Default)" Size="Size.Small">RB</MudChip>
            <MudChip T="string" Value="@("WR")" Variant="Variant.Filled" Color="@(_selectedPosition == "WR" ? Color.Primary : Color.Default)" Size="Size.Small">WR</MudChip>
            <MudChip T="string" Value="@("TE")" Variant="Variant.Filled" Color="@(_selectedPosition == "TE" ? Color.Secondary : Color.Default)" Size="Size.Small">TE</MudChip>
        </MudChipSet>

        <MudTextField Value="@SearchText" ValueChanged="@((string v) => SearchText = v)"
                      Placeholder="Search players..."
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined" Margin="Margin.Dense"
                      Clearable="true" Immediate="true" Style="min-width:200px;" />
    </div>
</MudPaper>

@* ── UP NEXT HORIZONTAL TICKER (session active + dynasty only) ────────── *@
@if (_sessionId is not null && !_isRedraftMode)
{
    <MudPaper Class="fc-card pa-2 mb-3" Elevation="0">
        <div class="d-flex align-center gap-2" style="overflow-x:auto; white-space:nowrap; min-height:44px;">
            <MudText Typo="Typo.caption"
                     Style="font-weight:700; letter-spacing:0.08em; text-transform:uppercase; color:var(--mud-palette-text-secondary); flex-shrink:0; padding-right:4px;">
                UP NEXT →
            </MudText>

            @if (_remainingPicks.Count == 0)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="font-style:italic;">
                    @(_totalPicksInDraft > 0 && _picks.Count >= _totalPicksInDraft
                        ? "Draft complete."
                        : "Waiting for Sleeper draft order...")
                </MudText>
            }
            else
            {
                @foreach (var pick in _remainingPicks.Take(8))
                {
                    bool isMe = pick.IsMyPick;
                    <MudLink Href="@($"/league/teams?rosterId={pick.SleeperRosterId}")"
                             Style="text-decoration:none; flex-shrink:0;">
                        <div style="display:inline-flex; flex-direction:column; align-items:center;
                                    padding:4px 10px; border-radius:8px; min-width:80px;
                                    background:@(isMe ? "rgba(99,102,241,0.2)" : "rgba(255,255,255,0.05)");
                                    border:1px solid @(isMe ? "rgba(99,102,241,0.6)" : "rgba(255,255,255,0.08)");">
                            <div style="display:flex; align-items:center; gap:4px;">
                                <span style="font-family:'JetBrains Mono',monospace; font-size:0.8rem; font-weight:700;
                                             color:@(isMe ? "var(--fc-cyan)" : "var(--mud-palette-text-primary)");">
                                    @($"{pick.Round}.{pick.Slot:D2}")
                                </span>
                                @if (isMe)
                                {
                                    <span style="font-size:0.6rem; font-weight:800; color:var(--fc-cyan);
                                                 background:rgba(99,102,241,0.3); border-radius:3px; padding:1px 4px;">
                                        YOU
                                    </span>
                                }
                            </div>
                            <span style="font-size:0.7rem; color:var(--mud-palette-text-secondary);
                                         overflow:hidden; text-overflow:ellipsis; max-width:90px; text-align:center;">
                                @pick.TeamName
                            </span>
                        </div>
                    </MudLink>
                }
                @if (_remainingPicks.Count > 8)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="flex-shrink:0; padding-left:4px;">
                        +@(_remainingPicks.Count - 8) more
                    </MudText>
                }
            }
        </div>
    </MudPaper>
}

@* ── BOARD + RIGHT RAIL ───────────────────────────────────────────────── *@
<MudGrid Spacing="3">

    @* ── MAIN BOARD ──────────────────────────────────────────────────── *@
    <MudItem xs="12" md="@(_sessionId is not null && !_isRedraftMode ? 9 : 12)">
        <MudPaper Class="fc-card" Elevation="0">
            @if (_loading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (_isRedraftMode)
            {
                @if (_filteredRedraft.Count == 0)
                {
                    <div class="pa-6 d-flex flex-column align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Analytics" Style="color:var(--fc-cyan); font-size:3rem;" Class="mb-2" />
                        <MudText Typo="Typo.body1" Style="font-weight:600;">No players found</MudText>
                    </div>
                }
                else
                {
                    <MudTable Items="@_filteredRedraft" Hover="true" Dense="true"
                              Breakpoint="Breakpoint.Sm" Elevation="0" Class="fc-table">
                        <HeaderContent>
                            <MudTh>Rank</MudTh>
                            <MudTh>Player</MudTh>
                            <MudTh>Pos</MudTh>
                            <MudTh>Team</MudTh>
                            <MudTh>Age</MudTh>
                            <MudTh Style="text-align:right">Dynasty Value</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Rank"><MudText Typo="Typo.body2" Style="color:#9CA3AF;">#@context.Rank</MudText></MudTd>
                            <MudTd DataLabel="Player">
                                <MudText Typo="Typo.body2" Style="font-weight:600; color:var(--fc-cyan);">@context.PlayerName</MudText>
                            </MudTd>
                            <MudTd DataLabel="Pos">
                                <MudChip T="string" Size="Size.Small" Color="@GetPositionColor(context.Position)" Variant="Variant.Filled">@context.Position</MudChip>
                            </MudTd>
                            <MudTd DataLabel="Team"><MudText Typo="Typo.body2">@(context.NflTeam ?? "FA")</MudText></MudTd>
                            <MudTd DataLabel="Age"><MudText Typo="Typo.body2">@context.Age</MudText></MudTd>
                            <MudTd DataLabel="Dynasty Value" Style="text-align:right; font-family:'JetBrains Mono',monospace; color:var(--fc-cyan);">@context.TradeValue.ToString("F1")</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            }
            else
            {
                @if (_filtered is null || _filtered.Count == 0)
                {
                    <div class="pa-6 d-flex flex-column align-center">
                        <MudIcon Icon="@Icons.Material.Filled.SportsFootball" Style="color:var(--fc-cyan); font-size:3rem;" Class="mb-2" />
                        <MudText Typo="Typo.body1" Style="font-weight:600;">No rookies found</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            @(_allRookies.Count == 0 ? "Rookie pool loads after NFL draft." : "Try adjusting filters.")
                        </MudText>
                    </div>
                }
                else
                {
                    <MudTable Items="@_filtered" Hover="true" Dense="true"
                              Breakpoint="Breakpoint.Sm" Elevation="0" Class="fc-table"
                              RowClassFunc="@RowClass">
                        <HeaderContent>
                            <MudTh><MudTableSortLabel SortBy="new Func<RookiePlayerDto, object>(x => x.ScoreRank)">Rank</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortBy="new Func<RookiePlayerDto, object>(x => x.FullName)">Player</MudTableSortLabel></MudTh>
                            <MudTh>Pos</MudTh>
                            <MudTh>Team</MudTh>
                            <MudTh><MudTableSortLabel SortBy="new Func<RookiePlayerDto, object>(x => (object)(x.Age ?? 99))">Age</MudTableSortLabel></MudTh>
                            <MudTh>Pick</MudTh>
                            <MudTh><MudTableSortLabel SortBy="new Func<RookiePlayerDto, object>(x => x.DynastyScore)"><MudTooltip Text="Composite dynasty score.">Score ⓘ</MudTooltip></MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortBy="new Func<RookiePlayerDto, object>(x => (object)(x.FantasyProsRank ?? 999))" InitialDirection="SortDirection.Ascending">FP Rank</MudTableSortLabel></MudTh>
                            <MudTh>Status</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Rank">
                                <MudText Typo="Typo.body2" Style="font-family:'JetBrains Mono',monospace; color:#9CA3AF;">#@context.ScoreRank</MudText>
                            </MudTd>
                            <MudTd DataLabel="Player">
                                <MudButton Variant="Variant.Text" Class="pa-0"
                                           Style="@($"font-weight:600; text-transform:none; min-width:0; {(IsDrafted(context.SleeperPlayerId) ? "opacity:0.55;" : "")}")"
                                           OnClick="@(() => OpenPlayerCard(context))">
                                    @context.FullName
                                </MudButton>
                                @if (IsDrafted(context.SleeperPlayerId))
                                {
                                    var detail = GetPickDetail(context.SleeperPlayerId);
                                    <MudText Typo="Typo.caption" Style="display:block; font-style:italic; opacity:0.55;">
                                        @if (detail is not null)
                                        {
                                            @(string.IsNullOrEmpty(detail.PickedByTeamName)
                                                ? $"Drafted · {detail.Round}.{detail.Slot:D2}"
                                                : $"Drafted by {detail.PickedByTeamName} · {detail.Round}.{detail.Slot:D2}")
                                        }
                                        else
                                        {
                                            @("Drafted")
                                        }
                                    </MudText>
                                }
                                else if (!string.IsNullOrEmpty(context.CollegeTeam))
                                {
                                    <MudText Typo="Typo.caption" Style="display:block; color:#9CA3AF;">
                                        @context.CollegeTeam
                                    </MudText>
                                }
                            </MudTd>
                            <MudTd DataLabel="Pos">
                                <MudChip T="string" Size="Size.Small" Color="@GetPositionColor(context.Position)" Variant="Variant.Filled">@context.Position</MudChip>
                            </MudTd>
                            <MudTd DataLabel="Team"><MudText Typo="Typo.body2">@(context.NflTeam ?? "—")</MudText></MudTd>
                            <MudTd DataLabel="Age"><MudText Typo="Typo.body2">@(context.Age.HasValue ? context.Age.ToString() : "—")</MudText></MudTd>
                            <MudTd DataLabel="Pick">
                                @if (context.DraftRound.HasValue && context.DraftPick.HasValue)
                                {
                                    <MudText Typo="Typo.body2">R@(context.DraftRound) P@(context.DraftPick)</MudText>
                                }
                                else { <MudText Typo="Typo.body2" Class="mud-text-secondary">—</MudText> }
                            </MudTd>
                            <MudTd DataLabel="Score">
                                <div class="d-flex align-center gap-2">
                                    <MudProgressLinear Value="@context.DynastyScore" Max="100"
                                                       Color="@GetScoreColor(context.DynastyScore)"
                                                       Style="width:60px; height:6px; border-radius:3px;" />
                                    <MudText Typo="Typo.body2" Style="font-weight:600; min-width:36px;">@context.DynastyScore.ToString("F1")</MudText>
                                </div>
                            </MudTd>
                            <MudTd DataLabel="FP Rank">
                                <MudText Typo="Typo.body2">@(context.FantasyProsRank.HasValue ? $"#{context.FantasyProsRank}" : "—")</MudText>
                            </MudTd>
                            <MudTd DataLabel="Status">
                                @if (IsDrafted(context.SleeperPlayerId))
                                {
                                    @if (IsMyPick(context.SleeperPlayerId))
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" Style="font-weight:700;">MY PICK</MudChip>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.caption" Style="opacity:0.4;">—</MudText>
                                    }
                                }
                                else if (_sessionId is not null)
                                {
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.HowToVote"
                                               OnClick="@(() => MarkDrafted(context))"
                                               Style="font-size:0.72rem; font-weight:700; height:28px;">
                                        DRAFT
                                    </MudButton>
                                }
                                else { <MudText Typo="Typo.caption" Class="mud-text-secondary">—</MudText> }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            }
        </MudPaper>
    </MudItem>

    @* ── RIGHT RAIL: ROSTER NEEDS + MY PICKS + BEST PICK ─────────────── *@
    @if (_sessionId is not null && !_isRedraftMode)
    {
        <MudItem xs="12" md="3">
            <div style="position:sticky; top:80px; display:flex; flex-direction:column; gap:12px;">

                @* ROSTER NEEDS *@
                <MudPaper Class="fc-card pa-3" Elevation="0">
                    <div class="d-flex align-center justify-space-between mb-2">
                        <MudText Typo="Typo.subtitle2"
                                 Style="font-weight:700; letter-spacing:0.05em; text-transform:uppercase; color:var(--fc-cyan); font-size:0.7rem;">
                            ROSTER NEEDS
                        </MudText>
                        <MudTooltip Text="Current dynasty roster + picks in this draft">
                            <MudIcon Icon="@Icons.Material.Filled.Info" Style="font-size:0.85rem; color:var(--mud-palette-text-secondary);" />
                        </MudTooltip>
                    </div>
                    @if (_rosterNeeds.Count == 0)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Syncing...</MudText>
                    }
                    else
                    {
                        @foreach (var need in _rosterNeeds)
                        {
                            <div class="d-flex align-center gap-2 mb-1">
                                <MudText Typo="Typo.caption" Style="@($"min-width:24px; font-weight:700; color:{GetPositionHex(need.Position)};")">
                                    @need.Position
                                </MudText>
                                <MudProgressLinear Value="@Math.Min(need.TotalCount * 20, 100)"
                                                   Color="@GetNeedColor(need.Level)"
                                                   Style="flex:1; height:6px; border-radius:3px;" />
                                <MudText Typo="Typo.caption"
                                         Style="@($"min-width:44px; font-weight:700; font-size:0.65rem; text-align:right; color:{GetNeedHex(need.Level)};")">
                                    @need.Level
                                </MudText>
                            </div>
                        }
                        @if (_rosterNeedsStale)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1" Style="font-style:italic; font-size:0.65rem;">
                                ⚠ Roster trade detected
                            </MudText>
                        }
                    }
                </MudPaper>

                @* MY PICKS *@
                <MudPaper Class="fc-card pa-3" Elevation="0">
                    <div class="d-flex align-center justify-space-between mb-2">
                        <MudText Typo="Typo.subtitle2"
                                 Style="font-weight:700; letter-spacing:0.05em; text-transform:uppercase; color:var(--fc-cyan); font-size:0.7rem;">
                            MY PICKS
                        </MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @_myPicksList.Count of @_picks.Count
                        </MudText>
                    </div>
                    @if (_myPicksList.Count == 0)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">No picks yet.</MudText>

                        @* Show upcoming MY picks from remaining queue *@
                        @if (_remainingPicks.Where(r => r.IsMyPick).Take(3).ToList() is { Count: > 0 } myUpcoming)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2 mb-1" Style="font-style:italic;">Upcoming:</MudText>
                            @foreach (var upcoming in myUpcoming)
                            {
                                <div class="d-flex align-center gap-2 mb-1">
                                    <MudText Typo="Typo.caption" Style="font-family:'JetBrains Mono',monospace; color:var(--fc-cyan); font-weight:600; min-width:36px;">
                                        @($"{upcoming.Round}.{upcoming.Slot:D2}")
                                    </MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">On the clock — pick incoming...</MudText>
                                </div>
                            }
                        }
                    }
                    else
                    {
                        @foreach (var pick in _myPicksList)
                        {
                            <div class="d-flex align-center gap-2 mb-2">
                                <MudText Typo="Typo.caption"
                                         Style="font-family:'JetBrains Mono',monospace; color:var(--fc-cyan); min-width:36px; font-weight:600;">
                                    @($"{pick.Round}.{pick.Slot:D2}")
                                </MudText>
                                <div style="flex:1; min-width:0;">
                                    @if (_allRookies.FirstOrDefault(r => r.SleeperPlayerId == pick.SleeperPlayerId) is { } cardPlayer)
                                    {
                                        <MudButton Variant="Variant.Text" Class="pa-0"
                                                   Style="font-weight:600; text-transform:none; min-width:0; height:auto; line-height:1.2; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; display:block;"
                                                   OnClick="@(() => OpenPlayerCard(cardPlayer))">
                                            @pick.PlayerName
                                        </MudButton>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.body2" Style="font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@pick.PlayerName</MudText>
                                    }
                                    <MudText Typo="Typo.caption" Style="color:#9CA3AF;">@(pick.NflTeam ?? "FA")</MudText>
                                </div>
                                <MudChip T="string" Size="Size.Small" Color="@GetPositionColor(pick.Position)"
                                         Variant="Variant.Filled" Style="min-width:32px; height:20px; font-size:0.65rem;">
                                    @pick.Position
                                </MudChip>
                            </div>
                        }

                        @* Show next upcoming pick slot after current picks *@
                        @if (_remainingPicks.FirstOrDefault(r => r.IsMyPick) is { } nextMyPick)
                        {
                            <div class="d-flex align-center gap-2 mb-1" style="opacity:0.6;">
                                <MudText Typo="Typo.caption" Style="font-family:'JetBrains Mono',monospace; color:var(--fc-cyan); min-width:36px; font-weight:600;">
                                    @($"{nextMyPick.Round}.{nextMyPick.Slot:D2}")
                                </MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="font-style:italic;">On the clock — pick incoming...</MudText>
                            </div>
                        }
                    }
                </MudPaper>

                @* BEST PICK AI *@
                <MudPaper Class="fc-card pa-3" Elevation="0">
                    <div class="d-flex align-center justify-space-between mb-2">
                        <MudText Typo="Typo.subtitle2"
                                 Style="font-weight:700; letter-spacing:0.05em; text-transform:uppercase; color:var(--fc-cyan); font-size:0.7rem;">
                            BEST PICK (YOU)
                        </MudText>
                        <MudTooltip Text="BPA = best score available. Best Fit = best at a position you need.">
                            <MudIcon Icon="@Icons.Material.Filled.Info" Style="font-size:0.85rem; color:var(--mud-palette-text-secondary);" />
                        </MudTooltip>
                    </div>
                    @if (_bestAvailable.Count == 0)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">No available players.</MudText>
                    }
                    else
                    {
                        @* BPA header *@
                        <MudText Typo="Typo.caption" Class="mud-text-secondary mb-1"
                                 Style="font-size:0.62rem; letter-spacing:0.06em; text-transform:uppercase;">
                            Best Player Available
                        </MudText>
                        @foreach (var rec in _bestAvailable)
                        {
                            bool isNeed = _rosterNeeds.Any(n => n.Position == rec.Position && n.Level == "NEED");
                            <div class="d-flex align-center gap-2 mb-1">
                                <MudChip T="string" Size="Size.Small" Color="@GetPositionColor(rec.Position)"
                                         Variant="Variant.Filled"
                                         Style="height:20px; font-size:0.65rem; min-width:32px; flex-shrink:0;">
                                    @rec.Position
                                </MudChip>
                                <div Style="flex:1; min-width:0; overflow:hidden;">
                                    <MudButton Variant="Variant.Text" Class="pa-0"
                                               Style="font-size:0.75rem; font-weight:600; text-transform:none; min-width:0; height:auto; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; display:block; max-width:100%;"
                                               OnClick="@(() => OpenPlayerCard(rec))">
                                        @rec.FullName
                                    </MudButton>
                                </div>
                                @if (isNeed)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Star"
                                             Style="color:#F59E0B; font-size:0.75rem; flex-shrink:0;" />
                                }
                                <MudText Typo="Typo.caption"
                                         Style="font-family:'JetBrains Mono',monospace; color:var(--fc-cyan); min-width:24px; text-align:right; flex-shrink:0; font-size:0.72rem;">
                                    @rec.DynastyScore.ToString("F0")
                                </MudText>
                            </div>
                        }

                        @* Best Fit — only shown when there are NEED positions with available players *@
                        @if (_bestFit.Count > 0)
                        {
                            <MudDivider Class="my-2" />
                            <MudText Typo="Typo.caption" Class="mud-text-secondary mb-1"
                                     Style="font-size:0.62rem; letter-spacing:0.06em; text-transform:uppercase;">
                                Best Fit (Roster Need)
                            </MudText>
                            @foreach (var rec in _bestFit)
                            {
                                <div class="d-flex align-center gap-2 mb-1">
                                    <MudChip T="string" Size="Size.Small" Color="@GetPositionColor(rec.Position)"
                                             Variant="Variant.Filled"
                                             Style="height:20px; font-size:0.65rem; min-width:32px; flex-shrink:0;">
                                        @rec.Position
                                    </MudChip>
                                    <div Style="flex:1; min-width:0; overflow:hidden;">
                                        <MudButton Variant="Variant.Text" Class="pa-0"
                                                   Style="font-size:0.75rem; font-weight:600; text-transform:none; min-width:0; height:auto; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; display:block; max-width:100%;"
                                                   OnClick="@(() => OpenPlayerCard(rec))">
                                            @rec.FullName
                                        </MudButton>
                                    </div>
                                    <MudIcon Icon="@Icons.Material.Filled.Star"
                                             Style="color:#F59E0B; font-size:0.75rem; flex-shrink:0;" />
                                    <MudText Typo="Typo.caption"
                                             Style="font-family:'JetBrains Mono',monospace; color:var(--fc-cyan); min-width:24px; text-align:right; flex-shrink:0; font-size:0.72rem;">
                                        @rec.DynastyScore.ToString("F0")
                                    </MudText>
                                </div>
                            }
                        }
                    }
                </MudPaper>

            </div>
        </MudItem>
    }
</MudGrid>

@* ── MARK DRAFTED DIALOG ─────────────────────────────────────────────── *@
<MudDialog @bind-Visible="_showPickDialog">
    <TitleContent>
        <MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.HowToVote" Class="mr-2" />Record Pick</MudText>
    </TitleContent>
    <DialogContent>
        @if (_pendingPick is not null)
        {
            <MudText Typo="Typo.body1" Class="mb-3">
                <strong>@_pendingPick.FullName</strong> · @_pendingPick.Position · @(_pendingPick.NflTeam ?? "—")
            </MudText>
            <MudGrid Spacing="2">
                <MudItem xs="6">
                    <MudNumericField @bind-Value="_pickRound" Label="Round" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="20" />
                </MudItem>
                <MudItem xs="6">
                    <MudNumericField @bind-Value="_pickSlot" Label="Pick Slot" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="20" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_pickedByTeamName" Label="Picked By (team name)" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Optional" />
                </MudItem>
                <MudItem xs="12">
                    <MudCheckBox @bind-Value="_isMyPick" Label="This is my pick" />
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showPickDialog = false)">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ConfirmPick" Disabled="_recordingPick">
            @if (_recordingPick) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
            Confirm Pick
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<RookiePlayerDto> _allRookies = [];
    private List<RookiePlayerDto> _filtered = [];
    private List<OffSeasonPlayerDto> _redraftPlayers = [];
    private List<OffSeasonPlayerDto> _filteredRedraft = [];
    private List<LeagueItem> _leagues = [];

    private HashSet<string> _picks = [];
    private HashSet<string> _myPickIds = [];
    private List<MyPickEntry> _myPicksList = [];
    private Dictionary<string, PickDetailEntry> _pickDetails = [];

    private int _totalPicksInDraft = 0;
    private List<RemainingPickEntry> _remainingPicks = [];
    private List<RosterNeedEntry> _rosterNeeds = [];
    private List<RookiePlayerDto> _bestAvailable = [];   // pure BPA by score
    private List<RookiePlayerDto> _bestFit = [];          // best available at NEED positions
    private Dictionary<string, int>? _liveRosterPositionCounts;
    private bool _rosterNeedsStale = false;

    private bool _hideDrafted = false;
    private string? _selectedLeagueId;
    private string? _selectedLeagueName;
    private string? _sessionId;
    private string? _selectedPosition;
    private string _searchText = string.Empty;
    private bool _loading = true;
    private bool _isRedraftMode = false;
    private bool _autoSyncEnabled = false;

    private bool _startingSession = false;
    private bool _recordingPick = false;
    private bool _showPickDialog = false;
    private RookiePlayerDto? _pendingPick;
    private int _pickRound = 1;
    private int _pickSlot = 1;
    private string? _pickedByTeamName;
    private bool _isMyPick = false;

    private Timer? _syncTimer;
    private bool _syncing = false;

    protected override async Task OnInitializedAsync()
    {
        LeagueState.OnLeagueChanged += OnLeagueChangedHandler;
        await LoadLeagues();

        if (!string.IsNullOrEmpty(LeagueState.ActiveLeagueId))
        {
            _selectedLeagueId = LeagueState.ActiveLeagueId;
            _selectedLeagueName = _leagues.FirstOrDefault(l => l.LeagueId == _selectedLeagueId)?.LeagueName;
        }

        var league = _leagues.FirstOrDefault(l => l.LeagueId == _selectedLeagueId);
        _isRedraftMode = league?.LeagueType != "Dynasty";

        await LoadCurrentMode();

        if (!_isRedraftMode && !string.IsNullOrEmpty(_selectedLeagueId))
            await TryResumeSession();
    }

    private void OnLeagueChangedHandler()
    {
        var league = _leagues.FirstOrDefault(l => l.LeagueId == LeagueState.ActiveLeagueId);
        if (league is null) return;
        _selectedLeagueId = league.LeagueId;
        _selectedLeagueName = league.LeagueName;
        _isRedraftMode = league.LeagueType != "Dynasty";
        ResetSessionState();
        StopSyncTimer();
        _ = InvokeAsync(async () =>
        {
            await LoadCurrentMode();
            if (!_isRedraftMode && !string.IsNullOrEmpty(_selectedLeagueId))
                await TryResumeSession();
            StateHasChanged();
        });
    }

    private void ResetSessionState()
    {
        _sessionId = null;
        _picks = []; _myPickIds = []; _myPicksList = []; _pickDetails = [];
        _hideDrafted = false; _allRookies = []; _filtered = [];
        _redraftPlayers = []; _filteredRedraft = [];
        _totalPicksInDraft = 0; _remainingPicks = [];
        _rosterNeeds = []; _bestAvailable = []; _bestFit = [];
        _liveRosterPositionCounts = null; _rosterNeedsStale = false;
    }

    public void Dispose()
    {
        LeagueState.OnLeagueChanged -= OnLeagueChangedHandler;
        StopSyncTimer();
    }

    private async Task TryResumeSession()
    {
        try
        {
            var response = await Http.GetAsync($"api/v1/drafttools/sessions/active?leagueId={_selectedLeagueId}");
            if (!response.IsSuccessStatusCode) return;

            var session = await response.Content.ReadFromJsonAsync<DraftSessionDto>();
            if (session is null) return;

            _sessionId = session.Id;

            foreach (var pick in session.Picks)
            {
                _picks.Add(pick.SleeperPlayerId);
                _pickDetails[pick.SleeperPlayerId] = new PickDetailEntry(pick.PlayerName, pick.Round, pick.Slot, pick.PickedByTeamName);
                if (pick.IsMyPick)
                {
                    _myPickIds.Add(pick.SleeperPlayerId);
                    _myPicksList.Add(new MyPickEntry(pick.SleeperPlayerId, pick.PlayerName, pick.Position, pick.NflTeam, pick.Round, pick.Slot));
                }
            }

            if (!string.IsNullOrEmpty(session.SleeperDraftId))
            {
                StartSyncTimer(); // fires immediately — first tick populates Up Next + Needs
                Snackbar.Add($"Draft session resumed · {_picks.Count} picks recorded", Severity.Info);
            }
            else
            {
                RecomputeNeedsAndBestAvailable();
                Snackbar.Add("Draft session resumed (manual mode)", Severity.Info);
            }

            StateHasChanged();
        }
        catch { }
    }

    private void StartSyncTimer()
    {
        _autoSyncEnabled = true;
        _syncTimer?.Dispose();
        _syncTimer = new Timer(async _ => await SyncFromSleeper(), null, TimeSpan.Zero, TimeSpan.FromSeconds(30));
    }

    private void StopSyncTimer()
    {
        _autoSyncEnabled = false;
        _syncTimer?.Dispose();
        _syncTimer = null;
    }

    private async Task SyncFromSleeper()
    {
        if (_sessionId is null || _syncing) return;
        _syncing = true;
        try
        {
            var result = await Http.GetFromJsonAsync<SyncResult>($"api/v1/drafttools/sessions/{_sessionId}/sync-sleeper");
            if (result is null) return;

            if (result.TotalPicksInDraft > 0) _totalPicksInDraft = result.TotalPicksInDraft;

            bool changed = false;
            foreach (var pick in result.NewPicks)
            {
                if (!_picks.Add(pick.SleeperPlayerId)) continue;
                _pickDetails[pick.SleeperPlayerId] = new PickDetailEntry(pick.PlayerName, pick.Round, pick.Slot, null);
                if (pick.IsMyPick)
                {
                    _myPickIds.Add(pick.SleeperPlayerId);
                    _myPicksList.Add(new MyPickEntry(pick.SleeperPlayerId, pick.PlayerName, pick.Position, null, pick.Round, pick.Slot));
                }
                changed = true;
            }

            // Up Next — always update from server (it rebuilds from slot_to_roster_id each sync)
            _remainingPicks = result.RemainingPicks
                .Select(r => new RemainingPickEntry(r.Round, r.Slot, r.TeamName, r.SleeperRosterId, r.IsMyPick))
                .ToList();

            if (result.MyRosterChanged)
            {
                _rosterNeedsStale = true;
                Snackbar.Add("Roster trade detected — updating needs.", Severity.Info);
            }

            if (result.LiveRosterPositionCounts is not null)
            {
                _liveRosterPositionCounts = result.LiveRosterPositionCounts;
                _rosterNeedsStale = false;
            }

            if (changed || result.LiveRosterPositionCounts is not null || result.RemainingPicks.Count > 0)
                RecomputeNeedsAndBestAvailable();

            await InvokeAsync(() =>
            {
                StateHasChanged();
                if (result.NewPicks.Count > 0)
                {
                    foreach (var p in result.NewPicks.Where(p => p.IsMyPick))
                        Snackbar.Add($"Your pick: {p.PlayerName} ({p.Position}) — {p.Round}.{p.Slot:D2}", Severity.Success);
                    var others = result.NewPicks.Where(p => !p.IsMyPick).ToList();
                    if (others.Count == 1)
                        Snackbar.Add($"Picked: {others[0].PlayerName} ({others[0].Position})", Severity.Normal);
                    else if (others.Count > 1)
                        Snackbar.Add($"{others.Count} picks synced", Severity.Normal);
                }
            });

            if (result.DraftComplete)
            {
                StopSyncTimer();
                await InvokeAsync(() => { Snackbar.Add("Draft complete!", Severity.Success); StateHasChanged(); });
            }
        }
        catch { }
        finally { _syncing = false; }
    }

    private void RecomputeNeedsAndBestAvailable()
    {
        var combined = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        if (_liveRosterPositionCounts is not null)
            foreach (var kv in _liveRosterPositionCounts)
                combined[kv.Key] = kv.Value;

        foreach (var pick in _myPicksList)
            combined[pick.Position] = combined.TryGetValue(pick.Position, out var c) ? c + 1 : 1;

        static string NeedLevel(string pos, int count) => pos switch
        {
            "RB" => count == 0 ? "NEED" : count >= 4 ? "STRONG" : "OK",
            "WR" => count == 0 ? "NEED" : count >= 5 ? "STRONG" : "OK",
            "TE" => count == 0 ? "NEED" : count >= 2 ? "STRONG" : "OK",
            "QB" => count == 0 ? "NEED" : count >= 2 ? "STRONG" : "OK",
            _    => "OK"
        };

        _rosterNeeds = new[] { "RB", "WR", "TE", "QB" }.Select(pos =>
        {
            int total = combined.TryGetValue(pos, out var c) ? c : 0;
            return new RosterNeedEntry(pos, total, NeedLevel(pos, total));
        }).ToList();

        var needPositions = _rosterNeeds.Where(n => n.Level == "NEED").Select(n => n.Position).ToHashSet();

        var available = _allRookies.Where(r => !_picks.Contains(r.SleeperPlayerId)).ToList();

        // BPA — pure score, no need boost
        _bestAvailable = available
            .OrderByDescending(r => r.DynastyScore)
            .Take(3)
            .ToList();

        // Best Fit — best player specifically at a NEED position
        // One pick per NEED position, ordered by score within that position
        _bestFit = needPositions.Count == 0
            ? []
            : needPositions
                .Select(pos => available.Where(r => r.Position == pos)
                                        .OrderByDescending(r => r.DynastyScore)
                                        .FirstOrDefault())
                .Where(r => r is not null)
                .Select(r => r!)
                .OrderByDescending(r => r.DynastyScore)
                .Take(3)
                .ToList();

        _rosterNeedsStale = false;
    }

    private async Task LoadCurrentMode()
    {
        if (_isRedraftMode) await LoadRedraftPlayers(); else await LoadRookies();
    }

    private async Task LoadLeagues()
    {
        try
        {
            var ctx = await Http.GetFromJsonAsync<UserContextResponse>("api/v1/identity/context");
            if (ctx is not null)
            {
                _leagues = ctx.Leagues ?? [];
                if (_leagues.Count > 0 && string.IsNullOrEmpty(_selectedLeagueId))
                {
                    _selectedLeagueId = _leagues[0].LeagueId;
                    _selectedLeagueName = _leagues[0].LeagueName;
                }
            }
        }
        catch { Snackbar.Add("Could not load leagues.", Severity.Warning); }
    }

    private async Task LoadRookies()
    {
        _loading = true; StateHasChanged();
        try
        {
            var url = string.IsNullOrEmpty(_selectedPosition) ? "api/v1/drafttools/rookies" : $"api/v1/drafttools/rookies?position={_selectedPosition}";
            _allRookies = await Http.GetFromJsonAsync<List<RookiePlayerDto>>(url) ?? [];
            ApplyRookieFilter();
            RecomputeNeedsAndBestAvailable();
        }
        catch { Snackbar.Add("Failed to load rookie pool.", Severity.Error); _allRookies = []; _filtered = []; }
        finally { _loading = false; }
    }

    private async Task LoadRedraftPlayers()
    {
        _loading = true; StateHasChanged();
        try
        {
            var posParam = string.IsNullOrEmpty(_selectedPosition) ? "" : $"&position={_selectedPosition}";
            _redraftPlayers = await Http.GetFromJsonAsync<List<OffSeasonPlayerDto>>(
                $"api/v1/waiver/available/offseason?leagueId={_selectedLeagueId}&top=150{posParam}") ?? [];
            ApplyRedraftFilter();
        }
        catch { Snackbar.Add("Failed to load redraft rankings.", Severity.Error); _redraftPlayers = []; _filteredRedraft = []; }
        finally { _loading = false; }
    }

    private void ApplyRookieFilter()
    {
        var q = _allRookies.AsEnumerable();
        if (_hideDrafted) q = q.Where(r => !_picks.Contains(r.SleeperPlayerId));
        if (!string.IsNullOrWhiteSpace(_searchText))
            q = q.Where(r => r.FullName.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
                || (r.NflTeam?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false)
                || (r.CollegeTeam?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false));
        _filtered = q.ToList();
    }

    private void ApplyRedraftFilter()
    {
        var q = _redraftPlayers.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(_searchText))
            q = q.Where(r => r.PlayerName.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
                || (r.NflTeam?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false));
        _filteredRedraft = q.ToList();
    }

    private async Task OnPositionChanged(string? position)
    {
        _selectedPosition = position; await LoadCurrentMode();
    }

    private string SearchText
    {
        get => _searchText;
        set { _searchText = value; if (_isRedraftMode) ApplyRedraftFilter(); else ApplyRookieFilter(); }
    }

    private async Task StartSession()
    {
        if (string.IsNullOrEmpty(_selectedLeagueId)) return;
        _startingSession = true; StateHasChanged();
        try
        {
            var response = await Http.PostAsJsonAsync("api/v1/drafttools/sessions",
                new { leagueId = _selectedLeagueId, leagueName = _selectedLeagueName ?? _selectedLeagueId, season = 2026 });

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<SessionStartResponse>();
                _sessionId = result?.SessionId;
                _picks = []; _myPickIds = []; _myPicksList = []; _pickDetails = [];
                _liveRosterPositionCounts = null;

                var session = await Http.GetFromJsonAsync<DraftSessionDto>($"api/v1/drafttools/sessions/{_sessionId}");
                if (session is not null && !string.IsNullOrEmpty(session.SleeperDraftId))
                {
                    StartSyncTimer();
                    Snackbar.Add("Draft session started — auto-syncing from Sleeper!", Severity.Success);
                }
                else
                    Snackbar.Add("Draft session started (manual mode)", Severity.Info);
            }
            else Snackbar.Add("Failed to start session.", Severity.Error);
        }
        catch { Snackbar.Add("Failed to start session.", Severity.Error); }
        finally { _startingSession = false; }
    }

    private void MarkDrafted(RookiePlayerDto player)
    {
        _pendingPick = player;
        var league = _leagues.FirstOrDefault(l => l.LeagueId == _selectedLeagueId);
        var teamCount = league?.TotalTeams > 0 ? league.TotalTeams : 12;
        var pickNumber = _picks.Count + 1;
        _pickRound = (int)Math.Ceiling((double)pickNumber / teamCount);
        _pickSlot = ((pickNumber - 1) % teamCount) + 1;
        _pickedByTeamName = null; _isMyPick = false;
        _showPickDialog = true;
    }

    private async Task ConfirmPick()
    {
        if (_pendingPick is null || _sessionId is null) return;
        _recordingPick = true;
        try
        {
            var response = await Http.PostAsJsonAsync($"api/v1/drafttools/sessions/{_sessionId}/picks",
                new { sleeperPlayerId = _pendingPick.SleeperPlayerId, playerName = _pendingPick.FullName,
                      position = _pendingPick.Position, nflTeam = _pendingPick.NflTeam,
                      round = _pickRound, slot = _pickSlot, pickedByTeamName = _pickedByTeamName, isMyPick = _isMyPick });

            if (response.IsSuccessStatusCode)
            {
                _picks.Add(_pendingPick.SleeperPlayerId);
                _pickDetails[_pendingPick.SleeperPlayerId] = new PickDetailEntry(_pendingPick.FullName, _pickRound, _pickSlot, _pickedByTeamName);
                if (_isMyPick)
                {
                    _myPickIds.Add(_pendingPick.SleeperPlayerId);
                    _myPicksList.Add(new MyPickEntry(_pendingPick.SleeperPlayerId, _pendingPick.FullName, _pendingPick.Position, _pendingPick.NflTeam, _pickRound, _pickSlot));
                }
                ApplyRookieFilter(); RecomputeNeedsAndBestAvailable();
                _showPickDialog = false;
                Snackbar.Add($"{_pendingPick.FullName} marked as drafted.", Severity.Success);
            }
            else Snackbar.Add("Failed to record pick.", Severity.Error);
        }
        catch { Snackbar.Add("Failed to record pick.", Severity.Error); }
        finally { _recordingPick = false; }
    }

    private bool IsDrafted(string id) => _picks.Contains(id);
    private bool IsMyPick(string id) => _myPickIds.Contains(id);
    private PickDetailEntry? GetPickDetail(string id) => _pickDetails.TryGetValue(id, out var d) ? d : null;

    private async Task OpenPlayerCard(RookiePlayerDto player)
    {
        var cardData = new PlayerCardDialog.PlayerCardData(
            SleeperPlayerId: player.SleeperPlayerId, FullName: player.FullName,
            Position: player.Position, NflTeam: player.NflTeam, Age: player.Age,
            DraftRound: player.DraftRound, DraftPick: player.DraftPick,
            CollegeTeam: player.CollegeTeam, HeadshotUrl: player.HeadshotUrl,
            FantasyProsRank: player.FantasyProsRank, FantasyProsTier: player.FantasyProsTier,
            PffGrade: player.PffGrade, PffRank: player.PffRank, ConsensusAdp: player.ConsensusAdp,
            DynastyScore: player.DynastyScore, DraftCapitalScore: player.DraftCapitalScore,
            PositionalScore: player.PositionalScore, ValuationBlendScore: player.ValuationBlendScore,
            FantasyProsScore: player.FantasyProsScore, PffGradeScore: player.PffGradeScore,
            ConsensusAdpScore: player.ConsensusAdpScore, AgeMultiplier: player.AgeMultiplier,
            AthleticismSignalScore: player.AthleticismSignalScore, AthleticismScore: player.AthleticismScore,
            SpeedScore: player.SpeedScore, FortyYard: player.FortyYard,
            LeagueId: LeagueState.ActiveLeagueId);

        var parameters = new DialogParameters<PlayerCardDialog>
        {
            { x => x.Player, cardData },
            { x => x.DefaultTab, PlayerCardDialog.PlayerCardTab.Overview }
        };
        await DialogService.ShowAsync<PlayerCardDialog>(player.FullName, parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true, BackdropClick = true });
    }

    private string RowClass(RookiePlayerDto row, int _) => IsDrafted(row.SleeperPlayerId) ? "fc-row-drafted" : string.Empty;

    private static Color GetPositionColor(string pos) => pos switch
    {
        "QB" => Color.Warning, "WR" => Color.Primary, "TE" => Color.Secondary, "RB" => Color.Success, _ => Color.Default
    };
    private static string GetPositionHex(string pos) => pos switch
    {
        "QB" => "#F59E0B", "WR" => "#6366F1", "TE" => "#A855F7", "RB" => "#22C55E", _ => "#9CA3AF"
    };
    private static Color GetScoreColor(double score) => score switch
    {
        >= 75 => Color.Success, >= 50 => Color.Primary, >= 25 => Color.Warning, _ => Color.Default
    };
    private static Color GetNeedColor(string level) => level switch
    {
        "NEED" => Color.Error, "STRONG" => Color.Success, _ => Color.Default
    };
    private static string GetNeedHex(string level) => level switch
    {
        "NEED" => "#F87171", "STRONG" => "#22C55E", _ => "#9CA3AF"
    };

    private record RookiePlayerDto(
        string SleeperPlayerId, string FullName, string Position,
        string? NflTeam, int? Age, int? DraftRound, int? DraftPick,
        string? CollegeTeam, string? HeadshotUrl,
        double? CareerValueScore, double? TradeValue, double? DiscountedFutureValue, double? BreakoutScore,
        int? FantasyProsRank, int? FantasyProsPositionRank, string? FantasyProsTier,
        double? PffGrade, int? PffRank, double? ConsensusAdp, int? ConsensusAdpRank, string? AdpSource,
        double DynastyScore, int ScoreRank,
        double DraftCapitalScore, double PositionalScore, double ValuationBlendScore,
        double FantasyProsScore, double PffGradeScore, double ConsensusAdpScore,
        double AgeMultiplier, double AthleticismSignalScore,
        double? AthleticismScore, double? SpeedScore, double? FortyYard, double? BroadJump, string? CombineSchool);

    private record OffSeasonPlayerDto(string SleeperPlayerId, string PlayerName, string Position, string? NflTeam, int Age, double TradeValue, int Rank, string? CollegeTeam);
    private record MyPickEntry(string SleeperPlayerId, string PlayerName, string Position, string? NflTeam, int Round, int Slot);
    private record PickDetailEntry(string PlayerName, int Round, int Slot, string? PickedByTeamName);
    private record RemainingPickEntry(int Round, int Slot, string TeamName, string SleeperRosterId, bool IsMyPick);
    private record RosterNeedEntry(string Position, int TotalCount, string Level);
    private record LeagueItem(string LeagueId, string LeagueName, int Season, string Role, bool IsActive = false, string LeagueType = "Redraft", int TotalTeams = 12);
    private record UserContextResponse(bool IsSleeperLinked, List<LeagueItem>? Leagues, string? ActiveLeagueId);
    private record SessionStartResponse(string SessionId);
    private record DraftSessionDto(string Id, string LeagueId, bool IsActive, string? SleeperDraftId, List<DraftPickDto> Picks);
    private record DraftPickDto(string SleeperPlayerId, string PlayerName, string Position, string? NflTeam, int Round, int Slot, bool IsMyPick, string? PickedByTeamName);
    private record SyncResult(List<SyncedPickDto> NewPicks, int TotalPicksInSession, bool DraftComplete, int TotalPicksInDraft, List<SyncedRemainingPickDto> RemainingPicks, Dictionary<string, int>? LiveRosterPositionCounts, bool MyRosterChanged);
    private record SyncedPickDto(string SleeperPlayerId, string PlayerName, string Position, int Round, int Slot, bool IsMyPick);
