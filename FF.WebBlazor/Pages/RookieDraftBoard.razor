@page "/dynasty/rookie-draft"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject LeagueStateService LeagueState
@implements IDisposable

<PageTitle>Draft Board — FantasyCombine.AI</PageTitle>

@* ── HEADER ──────────────────────────────────────────────────────────── *@
<div class="fc-page-header mb-4">
    <MudText Typo="Typo.h5" Class="fc-page-title">
        <MudIcon Icon="@Icons.Material.Filled.SportsFootball" Class="mr-2" Style="vertical-align:middle;" />
        Draft Board
    </MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary">
        @(_isRedraftMode
            ? "Available players ranked by dynasty trade value · Scoring-adjusted"
            : "Dynasty composite scores · Draft capital · FantasyPros rankings")
    </MudText>
</div>

@* ── SESSION BAR ─────────────────────────────────────────────────────── *@
<MudPaper Class="fc-card pa-3 mb-4" Elevation="0">
    <div class="d-flex align-center gap-3 flex-wrap">
        @* Mode badge *@
        <MudChip T="string"
                 Color="@(_isRedraftMode ? Color.Warning : Color.Primary)"
                 Size="Size.Small"
                 Variant="Variant.Filled">
            @(_isRedraftMode ? "Redraft Mode" : "Dynasty / Rookie Mode")
        </MudChip>

        @* Session controls — dynasty mode only *@
        @if (!_isRedraftMode)
        {
            @if (_sessionId is null)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.PlayArrow"
                           OnClick="StartSession"
                           Size="Size.Medium"
                           Disabled="@(string.IsNullOrEmpty(_selectedLeagueId) || _startingSession)">
                    @if (_startingSession)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    Start Draft Session
                </MudButton>
            }
            else
            {
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.FiberManualRecord" Style="color:#34D399; font-size:0.9rem;" />
                    <MudText Typo="Typo.body2" Style="color:#34D399; font-weight:600;">Session Active</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary ml-2">@_picks.Count picked</MudText>
                    @if (_autoSyncEnabled)
                    {
                        <MudTooltip Text="Auto-syncing picks from Sleeper every 30s">
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Sync">
                                Live
                            </MudChip>
                        </MudTooltip>
                    }
                </div>
            }
        }

        @* Hide Drafted — only when session active *@
        @if (_sessionId is not null && !_isRedraftMode)
        {
            <MudCheckBox Value="_hideDrafted"
                         ValueChanged="@((bool v) => { _hideDrafted = v; ApplyRookieFilter(); })"
                         Label="Hide Drafted"
                         Size="Size.Small"
                         Color="Color.Primary"
                         Class="ml-2" />
        }

        <MudSpacer />

        <MudTextField Value="@SearchText"
                      ValueChanged="@((string v) => SearchText = v)"
                      Placeholder="Search players..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Clearable="true"
                      Immediate="true"
                      Style="min-width:240px;" />
    </div>
</MudPaper>

@* ── POSITION FILTER ─────────────────────────────────────────────────── *@
<MudPaper Class="fc-card pa-3 mb-4" Elevation="0">
    <MudChipSet T="string" SelectedValueChanged="OnPositionChanged" SelectionMode="SelectionMode.SingleSelection">
        <MudChip T="string" Value="@((string?)null)" Variant="Variant.Filled" Color="@(_selectedPosition is null ? Color.Primary : Color.Default)">All</MudChip>
        <MudChip T="string" Value="@("WR")" Variant="Variant.Filled" Color="@(_selectedPosition == "WR" ? Color.Primary : Color.Default)">WR</MudChip>
        <MudChip T="string" Value="@("QB")" Variant="Variant.Filled" Color="@(_selectedPosition == "QB" ? Color.Primary : Color.Default)">QB</MudChip>
        <MudChip T="string" Value="@("TE")" Variant="Variant.Filled" Color="@(_selectedPosition == "TE" ? Color.Primary : Color.Default)">TE</MudChip>
        <MudChip T="string" Value="@("RB")" Variant="Variant.Filled" Color="@(_selectedPosition == "RB" ? Color.Primary : Color.Default)">RB</MudChip>
    </MudChipSet>
</MudPaper>

@* ── BOARD + MY PICKS LAYOUT ────────────────────────────────────────── *@
<MudGrid Spacing="3">
<MudItem xs="12" md="@(_sessionId is not null && !_isRedraftMode ? 9 : 12)">
<MudPaper Class="fc-card" Elevation="0">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_isRedraftMode)
    {
        @* ── REDRAFT TABLE ─────────────────────────────────────────── *@
        @if (_filteredRedraft.Count == 0)
        {
            <div class="pa-6 d-flex flex-column align-center">
                <MudIcon Icon="@Icons.Material.Filled.Analytics" Style="color:var(--fc-cyan); font-size:3rem;" Class="mb-2" />
                <MudText Typo="Typo.body1" Style="font-weight:600;">No players found</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    Try adjusting your position filter or search. Dynasty valuations must be calculated first.
                </MudText>
            </div>
        }
        else
        {
            <MudTable Items="@_filteredRedraft"
                      Hover="true"
                      Dense="true"
                      Breakpoint="Breakpoint.Sm"
                      Elevation="0"
                      Class="fc-table">
                <HeaderContent>
                    <MudTh>Rank</MudTh>
                    <MudTh>Player</MudTh>
                    <MudTh>Pos</MudTh>
                    <MudTh>Team</MudTh>
                    <MudTh>Age</MudTh>
                    <MudTh Style="text-align:right">Dynasty Value</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Rank">
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">#@context.Rank</MudText>
                    </MudTd>
                    <MudTd DataLabel="Player">
                        <MudText Typo="Typo.body2" Style="font-weight:600; color:var(--fc-cyan);">
                            @context.PlayerName
                        </MudText>
                        @if (!string.IsNullOrEmpty(context.CollegeTeam))
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.CollegeTeam</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Pos">
                        <MudChip T="string" Size="Size.Small" Color="@GetPositionColor(context.Position)" Variant="Variant.Filled">
                            @context.Position
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Team">
                        <MudText Typo="Typo.body2">@(context.NflTeam ?? "FA")</MudText>
                    </MudTd>
                    <MudTd DataLabel="Age">
                        <MudText Typo="Typo.body2">@context.Age</MudText>
                    </MudTd>
                    <MudTd DataLabel="Dynasty Value" Style="text-align:right; font-family:'JetBrains Mono',monospace; color:var(--fc-cyan);">
                        @context.TradeValue.ToString("F1")
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    }
    else
    {
        @* ── DYNASTY / ROOKIE TABLE ────────────────────────────────── *@
        @if (_filtered is null || _filtered.Count == 0)
        {
            <div class="pa-6 d-flex flex-column align-center">
                <MudIcon Icon="@Icons.Material.Filled.SportsFootball" Style="color:var(--fc-cyan); font-size:3rem;" Class="mb-2" />
                <MudText Typo="Typo.body1" Style="font-weight:600;">No rookies found</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    @if (_allRookies.Count == 0)
                    {
                        <span>Rookie pool loads after NFL draft (April 24–26).</span>
                    }
                    else
                    {
                        <span>Try adjusting the position filter or search.</span>
                    }
                </MudText>
            </div>
        }
        else
        {
            <MudTable Items="@_filtered"
                      Hover="true"
                      Dense="true"
                      Breakpoint="Breakpoint.Sm"
                      Elevation="0"
                      Class="fc-table"
                      RowClassFunc="@RowClass">
                <HeaderContent>
                    <MudTh>
                        <MudTableSortLabel SortBy="new Func<RookiePlayerDto, object>(x => x.ScoreRank)">
                            <MudTooltip Text="Rank by composite DynastyScore (descending). Stable across re-sorts.">
                                Score Rank ⓘ
                            </MudTooltip>
                        </MudTableSortLabel>
                    </MudTh>
                    <MudTh>
                        <MudTableSortLabel SortBy="new Func<RookiePlayerDto, object>(x => x.FullName)">
                            Player
                        </MudTableSortLabel>
                    </MudTh>
                    <MudTh>Pos</MudTh>
                    <MudTh>Team</MudTh>
                    <MudTh>
                        <MudTableSortLabel SortBy="new Func<RookiePlayerDto, object>(x => (object)(x.Age ?? 99))">
                            Age
                        </MudTableSortLabel>
                    </MudTh>
                    <MudTh>Pick</MudTh>
                    <MudTh>
                        <MudTableSortLabel SortBy="new Func<RookiePlayerDto, object>(x => x.DynastyScore)">
                            <MudTooltip Text="Composite dynasty score — draft capital 35%, positional value 25%, dynasty valuation 30%, FP rank 10%. Click to sort.">
                                Score ⓘ
                            </MudTooltip>
                        </MudTableSortLabel>
                    </MudTh>
                    <MudTh>
                        <MudTableSortLabel SortBy="new Func<RookiePlayerDto, object>(x => (object)(x.FantasyProsRank ?? 999))"
                                          InitialDirection="SortDirection.Ascending">
                            FP Rank
                        </MudTableSortLabel>
                    </MudTh>
                    <MudTh>Action</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Score Rank">
                        <MudText Typo="Typo.body2" Class="mud-text-secondary"
                                 Style="font-family:'JetBrains Mono',monospace;">
                            #@context.ScoreRank
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Player">
                        <MudButton Variant="Variant.Text"
                                   Class="pa-0"
                                   Style="font-weight:600; text-transform:none; min-width:0;"
                                   OnClick="@(() => OpenPlayerCard(context))">
                            @context.FullName
                        </MudButton>
                        @if (!string.IsNullOrEmpty(context.CollegeTeam))
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.CollegeTeam</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Pos">
                        <MudChip T="string" Size="Size.Small" Color="@GetPositionColor(context.Position)" Variant="Variant.Filled">
                            @context.Position
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Team">
                        <MudText Typo="Typo.body2">@(context.NflTeam ?? "—")</MudText>
                    </MudTd>
                    <MudTd DataLabel="Age">
                        <MudText Typo="Typo.body2">@(context.Age.HasValue ? context.Age.ToString() : "—")</MudText>
                    </MudTd>
                    <MudTd DataLabel="Pick">
                        @if (context.DraftRound.HasValue && context.DraftPick.HasValue)
                        {
                            <MudText Typo="Typo.body2">R@(context.DraftRound) P@(context.DraftPick)</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">—</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Score">
                        <div class="d-flex align-center gap-2">
                            <MudProgressLinear Value="@context.DynastyScore"
                                              Max="100"
                                              Color="@GetScoreColor(context.DynastyScore)"
                                              Style="width:60px; height:6px; border-radius:3px;" />
                            <MudText Typo="Typo.body2" Style="font-weight:600; min-width:36px;">
                                @context.DynastyScore.ToString("F1")
                            </MudText>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="FP Rank">
                        <MudText Typo="Typo.body2">
                            @(context.FantasyProsRank.HasValue ? $"#{context.FantasyProsRank}" : "—")
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Action">
                        @if (IsDrafted(context.SleeperPlayerId))
                        {
                            <MudChip T="string" Size="Size.Small"
                                     Color="@(IsMyPick(context.SleeperPlayerId) ? Color.Success : Color.Default)"
                                     Variant="Variant.Outlined">
                                @(IsMyPick(context.SleeperPlayerId) ? "My Pick" : "Drafted")
                            </MudChip>
                        }
                        else if (_sessionId is not null)
                        {
                            <MudTooltip Text="Mark as drafted">
                                <MudIconButton Icon="@Icons.Material.Filled.HowToVote"
                                              Size="Size.Small"
                                              Color="Color.Primary"
                                              OnClick="@(() => MarkDrafted(context))" />
                            </MudTooltip>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Start session</MudText>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    }
</MudPaper>
</MudItem>

    @* ── MY PICKS PANEL ─────────────────────────────────────────────── *@
    @if (_sessionId is not null && !_isRedraftMode)
    {
        <MudItem xs="12" md="3">
            <MudPaper Class="fc-card pa-3" Elevation="0" Style="position:sticky; top:80px;">
                <div class="d-flex align-center justify-space-between mb-3">
                    <MudText Typo="Typo.subtitle2" Style="font-weight:700; letter-spacing:0.05em; text-transform:uppercase; color:var(--fc-cyan);">
                        My Picks
                    </MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @_myPicksList.Count of @_picks.Count
                    </MudText>
                </div>

                @if (_myPicksList.Count == 0)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">No picks recorded yet.</MudText>
                }
                else
                {
                    @foreach (var pick in _myPicksList)
                    {
                        <div class="d-flex align-center gap-2 mb-2">
                            <MudText Typo="Typo.caption"
                                     Style="font-family:'JetBrains Mono',monospace; color:var(--fc-cyan); min-width:36px; font-weight:600;">
                                @($"{pick.Round}.{pick.Slot:D2}")
                            </MudText>
                            <div style="flex:1; min-width:0;">
                                @{
                                    var cardPlayer = _allRookies.FirstOrDefault(r => r.SleeperPlayerId == pick.SleeperPlayerId);
                                }
                                @if (cardPlayer is not null)
                                {
                                    <MudButton Variant="Variant.Text"
                                               Class="pa-0"
                                               Style="font-weight:600; text-transform:none; min-width:0; height:auto; line-height:1.2; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; display:block;"
                                               OnClick="@(() => OpenPlayerCard(cardPlayer))">
                                        @pick.PlayerName
                                    </MudButton>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2" Style="font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                        @pick.PlayerName
                                    </MudText>
                                }
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@(pick.NflTeam ?? "FA")</MudText>
                            </div>
                            <MudChip T="string" Size="Size.Small"
                                     Color="@GetPositionColor(pick.Position)"
                                     Variant="Variant.Filled"
                                     Style="min-width:32px;">
                                @pick.Position
                            </MudChip>
                        </div>
                    }
                }
            </MudPaper>
        </MudItem>
    }
</MudGrid>

@* ── MARK DRAFTED DIALOG ─────────────────────────────────────────────── *@
<MudDialog @bind-Visible="_showPickDialog">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.HowToVote" Class="mr-2" />
            Record Pick
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_pendingPick is not null)
        {
            <MudText Typo="Typo.body1" Class="mb-3">
                <strong>@_pendingPick.FullName</strong> · @_pendingPick.Position · @(_pendingPick.NflTeam ?? "—")
            </MudText>
            <MudGrid Spacing="2">
                <MudItem xs="6">
                    <MudNumericField @bind-Value="_pickRound" Label="Round" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="20" />
                </MudItem>
                <MudItem xs="6">
                    <MudNumericField @bind-Value="_pickSlot" Label="Pick Slot" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="20" />
                </MudItem>
                <MudItem xs="12">
                    <MudCheckBox @bind-Value="_isMyPick" Label="This is my pick" />
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showPickDialog = false)">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ConfirmPick" Disabled="_recordingPick">
            @if (_recordingPick)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Confirm Pick
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    // ── State ───────────────────────────────────────────────────────────
    private List<RookiePlayerDto> _allRookies = [];
    private List<RookiePlayerDto> _filtered = [];
    private List<OffSeasonPlayerDto> _redraftPlayers = [];
    private List<OffSeasonPlayerDto> _filteredRedraft = [];
    private List<LeagueItem> _leagues = [];

    // _picks = all drafted player IDs; _myPickIds = subset that are mine
    private HashSet<string> _picks = [];
    private HashSet<string> _myPickIds = [];
    private List<MyPickEntry> _myPicksList = [];   // ordered list for My Picks panel

    // Draft board filter
    private bool _hideDrafted = false;

    private string? _selectedLeagueId;
    private string? _selectedLeagueName;
    private string? _sessionId;
    private string? _selectedPosition;
    private string _searchText = string.Empty;
    private bool _loading = true;
    private bool _isRedraftMode = false;
    private bool _autoSyncEnabled = false;

    // Session dialog state
    private bool _startingSession = false;
    private bool _recordingPick = false;
    private bool _showPickDialog = false;
    private RookiePlayerDto? _pendingPick;
    private int _pickRound = 1;
    private int _pickSlot = 1;
    private bool _isMyPick = false;

    // Polling timer
    private Timer? _syncTimer;
    private bool _syncing = false;

    // ── Lifecycle ───────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        LeagueState.OnLeagueChanged += OnLeagueChangedHandler;
        await LoadLeagues();

        if (!string.IsNullOrEmpty(LeagueState.ActiveLeagueId))
        {
            _selectedLeagueId = LeagueState.ActiveLeagueId;
            _selectedLeagueName = _leagues.FirstOrDefault(l => l.LeagueId == _selectedLeagueId)?.LeagueName;
        }

        var league = _leagues.FirstOrDefault(l => l.LeagueId == _selectedLeagueId);
        _isRedraftMode = league?.LeagueType != "Dynasty";

        await LoadCurrentMode();

        // Auto-resume any active session for this league
        if (!_isRedraftMode && !string.IsNullOrEmpty(_selectedLeagueId))
            await TryResumeSession();
    }

    private void OnLeagueChangedHandler()
    {
        var league = _leagues.FirstOrDefault(l => l.LeagueId == LeagueState.ActiveLeagueId);
        if (league is null) return;

        _selectedLeagueId = league.LeagueId;
        _selectedLeagueName = league.LeagueName;
        _isRedraftMode = league.LeagueType != "Dynasty";
        _sessionId = null;
        _picks = [];
        _myPickIds = [];
        _myPicksList = [];
        _hideDrafted = false;
        _allRookies = [];
        _filtered = [];
        _redraftPlayers = [];
        _filteredRedraft = [];

        StopSyncTimer();

        _ = InvokeAsync(async () =>
        {
            await LoadCurrentMode();
            if (!_isRedraftMode && !string.IsNullOrEmpty(_selectedLeagueId))
                await TryResumeSession();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        LeagueState.OnLeagueChanged -= OnLeagueChangedHandler;
        StopSyncTimer();
    }

    // ── Auto-resume ─────────────────────────────────────────────────────
    /// <summary>
    /// On page load (or league switch), check if there's an active session.
    /// If so, restore state and start the polling timer.
    /// </summary>
    private async Task TryResumeSession()
    {
        try
        {
            var response = await Http.GetAsync(
                $"api/v1/drafttools/sessions/active?leagueId={_selectedLeagueId}");

            if (!response.IsSuccessStatusCode) return; // 404 = no active session, that's fine

            var session = await response.Content.ReadFromJsonAsync<DraftSessionDto>();
            if (session is null) return;

            _sessionId = session.Id;

            // Restore existing picks into local state
            foreach (var pick in session.Picks)
            {
                _picks.Add(pick.SleeperPlayerId);
                if (pick.IsMyPick)
                {
                    _myPickIds.Add(pick.SleeperPlayerId);
                    _myPicksList.Add(new MyPickEntry(
                        pick.SleeperPlayerId,
                        pick.PlayerName,
                        pick.Position,
                        pick.NflTeam,
                        pick.Round,
                        pick.Slot));
                }
            }

            // Start auto-sync if draft is linked
            if (!string.IsNullOrEmpty(session.SleeperDraftId))
            {
                StartSyncTimer();
                Snackbar.Add($"Draft session resumed · {_picks.Count} picks so far", Severity.Info);
            }
            else
            {
                Snackbar.Add("Draft session resumed (manual mode — no Sleeper draft linked)", Severity.Info);
            }

            StateHasChanged();
        }
        catch
        {
            // Non-fatal — just means no active session
        }
    }

    // ── Polling timer ────────────────────────────────────────────────────
    private void StartSyncTimer()
    {
        _autoSyncEnabled = true;
        _syncTimer?.Dispose();
        // Fire immediately then every 30s
        _syncTimer = new Timer(
            async _ => await SyncFromSleeper(),
            null,
            TimeSpan.Zero,
            TimeSpan.FromSeconds(30));
    }

    private void StopSyncTimer()
    {
        _autoSyncEnabled = false;
        _syncTimer?.Dispose();
        _syncTimer = null;
    }

    private async Task SyncFromSleeper()
    {
        if (_sessionId is null || _syncing) return;
        _syncing = true;
        try
        {
            var response = await Http.GetFromJsonAsync<SyncResult>(
                $"api/v1/drafttools/sessions/{_sessionId}/sync-sleeper");

            if (response is null) return;

            bool changed = false;
            foreach (var pick in response.NewPicks)
            {
                if (_picks.Add(pick.SleeperPlayerId))
                {
                    if (pick.IsMyPick)
                    {
                        _myPickIds.Add(pick.SleeperPlayerId);
                        _myPicksList.Add(new MyPickEntry(
                            pick.SleeperPlayerId,
                            pick.PlayerName,
                            pick.Position,
                            null,
                            pick.Round,
                            pick.Slot));
                    }
                    changed = true;
                }
            }

            if (changed)
            {
                await InvokeAsync(() =>
                {
                    StateHasChanged();
                    // Show a quiet snackbar only for new picks, not every poll
                    if (response.NewPicks.Count > 0)
                    {
                        var myNew = response.NewPicks.Where(p => p.IsMyPick).ToList();
                        var otherNew = response.NewPicks.Where(p => !p.IsMyPick).ToList();

                        foreach (var pick in myNew)
                            Snackbar.Add($"Your pick: {pick.PlayerName} ({pick.Position}) — R{pick.Round} S{pick.Slot}", Severity.Success);

                        if (otherNew.Count == 1)
                            Snackbar.Add($"Picked: {otherNew[0].PlayerName} ({otherNew[0].Position})", Severity.Normal);
                        else if (otherNew.Count > 1)
                            Snackbar.Add($"{otherNew.Count} picks synced from Sleeper", Severity.Normal);
                    }
                });
            }

            // If draft is complete, stop polling
            if (response.DraftComplete)
            {
                StopSyncTimer();
                await InvokeAsync(() =>
                {
                    Snackbar.Add("Draft complete! All picks have been recorded.", Severity.Success);
                    StateHasChanged();
                });
            }
        }
        catch
        {
            // Transient — ignore, will retry next tick
        }
        finally
        {
            _syncing = false;
        }
    }

    // ── Data loading ────────────────────────────────────────────────────
    private async Task LoadCurrentMode()
    {
        if (_isRedraftMode)
            await LoadRedraftPlayers();
        else
            await LoadRookies();
    }

    private async Task LoadLeagues()
    {
        try
        {
            var ctx = await Http.GetFromJsonAsync<UserContextResponse>("api/v1/identity/context");
            if (ctx is not null)
            {
                _leagues = ctx.Leagues ?? [];
                if (_leagues.Count > 0 && string.IsNullOrEmpty(_selectedLeagueId))
                {
                    _selectedLeagueId = _leagues[0].LeagueId;
                    _selectedLeagueName = _leagues[0].LeagueName;
                }
            }
        }
        catch
        {
            Snackbar.Add("Could not load leagues.", Severity.Warning);
        }
    }

    private async Task LoadRookies()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var url = string.IsNullOrEmpty(_selectedPosition)
                ? "api/v1/drafttools/rookies"
                : $"api/v1/drafttools/rookies?position={_selectedPosition}";
            _allRookies = await Http.GetFromJsonAsync<List<RookiePlayerDto>>(url) ?? [];
            ApplyRookieFilter();
        }
        catch
        {
            Snackbar.Add("Failed to load rookie pool.", Severity.Error);
            _allRookies = [];
            _filtered = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadRedraftPlayers()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var posParam = string.IsNullOrEmpty(_selectedPosition) ? "" : $"&position={_selectedPosition}";
            var url = $"api/v1/waiver/available/offseason?leagueId={_selectedLeagueId}&top=150{posParam}";
            _redraftPlayers = await Http.GetFromJsonAsync<List<OffSeasonPlayerDto>>(url) ?? [];
            ApplyRedraftFilter();
        }
        catch
        {
            Snackbar.Add("Failed to load redraft rankings.", Severity.Error);
            _redraftPlayers = [];
            _filteredRedraft = [];
        }
        finally
        {
            _loading = false;
        }
    }

    // ── Filtering ───────────────────────────────────────────────────────
    private void ApplyRookieFilter()
    {
        var query = _allRookies.AsEnumerable();
        if (_hideDrafted)
            query = query.Where(r => !_picks.Contains(r.SleeperPlayerId));
        if (!string.IsNullOrWhiteSpace(_searchText))
            query = query.Where(r =>
                r.FullName.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
                (r.NflTeam?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (r.CollegeTeam?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false));
        _filtered = query.ToList();
    }

    private void ApplyRedraftFilter()
    {
        var query = _redraftPlayers.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(_searchText))
            query = query.Where(r =>
                r.PlayerName.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
                (r.NflTeam?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false));
        _filteredRedraft = query.ToList();
    }

    private async Task OnPositionChanged(string? position)
    {
        _selectedPosition = position;
        await LoadCurrentMode();
    }

    private string SearchText
    {
        get => _searchText;
        set
        {
            _searchText = value;
            if (_isRedraftMode) ApplyRedraftFilter();
            else ApplyRookieFilter();
        }
    }

    // ── Session management ──────────────────────────────────────────────
    private async Task StartSession()
    {
        if (string.IsNullOrEmpty(_selectedLeagueId)) return;
        _startingSession = true;
        StateHasChanged();
        try
        {
            var response = await Http.PostAsJsonAsync(
                "api/v1/drafttools/sessions",
                new { leagueId = _selectedLeagueId, leagueName = _selectedLeagueName ?? _selectedLeagueId, season = 2026 });

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<SessionStartResponse>();
                _sessionId = result?.SessionId;
                _picks = [];
                _myPickIds = [];

                // Load the session back to check if a draft_id was found
                var session = await Http.GetFromJsonAsync<DraftSessionDto>(
                    $"api/v1/drafttools/sessions/{_sessionId}");

                if (session is not null && !string.IsNullOrEmpty(session.SleeperDraftId))
                {
                    StartSyncTimer();
                    Snackbar.Add("Draft session started — auto-syncing picks from Sleeper!", Severity.Success);
                }
                else
                {
                    Snackbar.Add("Draft session started (manual mode — no active Sleeper draft found)", Severity.Info);
                }
            }
            else
            {
                Snackbar.Add("Failed to start session.", Severity.Error);
            }
        }
        catch
        {
            Snackbar.Add("Failed to start session.", Severity.Error);
        }
        finally
        {
            _startingSession = false;
        }
    }

    // ── Manual pick fallback ────────────────────────────────────────────
    private void MarkDrafted(RookiePlayerDto player)
    {
        _pendingPick = player;
        var league = _leagues.FirstOrDefault(l => l.LeagueId == _selectedLeagueId);
        var teamCount = league?.TotalTeams > 0 ? league.TotalTeams : 12;
        var pickNumber = _picks.Count + 1;                          // 1-based absolute pick number
        _pickRound = (int)Math.Ceiling((double)pickNumber / teamCount);
        _pickSlot  = ((pickNumber - 1) % teamCount) + 1;
        _isMyPick = false;
        _showPickDialog = true;
    }

    private async Task ConfirmPick()
    {
        if (_pendingPick is null || _sessionId is null) return;
        _recordingPick = true;
        try
        {
            var response = await Http.PostAsJsonAsync(
                $"api/v1/drafttools/sessions/{_sessionId}/picks",
                new
                {
                    sleeperPlayerId = _pendingPick.SleeperPlayerId,
                    playerName = _pendingPick.FullName,
                    position = _pendingPick.Position,
                    nflTeam = _pendingPick.NflTeam,
                    round = _pickRound,
                    slot = _pickSlot,
                    pickedByTeamName = (string?)null,
                    isMyPick = _isMyPick
                });

            if (response.IsSuccessStatusCode)
            {
                _picks.Add(_pendingPick.SleeperPlayerId);
                if (_isMyPick)
                {
                    _myPickIds.Add(_pendingPick.SleeperPlayerId);
                    _myPicksList.Add(new MyPickEntry(
                        _pendingPick.SleeperPlayerId,
                        _pendingPick.FullName,
                        _pendingPick.Position,
                        _pendingPick.NflTeam,
                        _pickRound,
                        _pickSlot));
                }
                ApplyRookieFilter();
                _showPickDialog = false;
                Snackbar.Add($"{_pendingPick.FullName} marked as drafted.", Severity.Success);
            }
            else
            {
                Snackbar.Add("Failed to record pick.", Severity.Error);
            }
        }
        catch
        {
            Snackbar.Add("Failed to record pick.", Severity.Error);
        }
        finally
        {
            _recordingPick = false;
        }
    }

    private bool IsDrafted(string sleeperPlayerId) => _picks.Contains(sleeperPlayerId);
    private bool IsMyPick(string sleeperPlayerId) => _myPickIds.Contains(sleeperPlayerId);

    private async Task OpenPlayerCard(RookiePlayerDto player)
    {
        var cardData = new PlayerCardDialog.PlayerCardData(
            SleeperPlayerId: player.SleeperPlayerId,
            FullName: player.FullName,
            Position: player.Position,
            NflTeam: player.NflTeam,
            Age: player.Age,
            DraftRound: player.DraftRound,
            DraftPick: player.DraftPick,
            CollegeTeam: player.CollegeTeam,
            HeadshotUrl: player.HeadshotUrl,
            FantasyProsRank: player.FantasyProsRank,
            FantasyProsTier: player.FantasyProsTier,
            PffGrade: player.PffGrade,
            PffRank: player.PffRank,
            ConsensusAdp: player.ConsensusAdp,
            DynastyScore: player.DynastyScore,
            DraftCapitalScore: player.DraftCapitalScore,
            PositionalScore: player.PositionalScore,
            ValuationBlendScore: player.ValuationBlendScore,
            FantasyProsScore: player.FantasyProsScore,
            PffGradeScore: player.PffGradeScore,
            ConsensusAdpScore: player.ConsensusAdpScore,
            AgeMultiplier: player.AgeMultiplier,
            AthleticismSignalScore: player.AthleticismSignalScore,
            AthleticismScore: player.AthleticismScore,
            SpeedScore: player.SpeedScore,
            FortyYard: player.FortyYard,
            LeagueId: LeagueState.ActiveLeagueId);

        var parameters = new DialogParameters<PlayerCardDialog>
        {
            { x => x.Player, cardData },
            { x => x.DefaultTab, PlayerCardDialog.PlayerCardTab.Overview }
        };
