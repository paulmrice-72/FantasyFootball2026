@page "/admin/imports"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@inject NflContextClientService NflContext

<PageTitle>Imports & Triggers — Admin — FantasyCombine.AI</PageTitle>

<div class="fc-page-header mb-4">
    <MudText Typo="Typo.h5" Class="fc-page-title" Style="color: var(--fc-amber);">
        <MudIcon Icon="@Icons.Material.Filled.Upload" Class="mr-2" Style="vertical-align:middle;" />
        Imports &amp; Triggers
    </MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary">
        Upload CSV files and trigger post-draft data jobs — no curl required.
    </MudText>
</div>

@* ── Simulation Pipeline ─────────────────────────────────────── *@
<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.h6" Class="mb-1" Style="color: var(--fc-amber);">
        <MudIcon Icon="@Icons.Material.Filled.Memory" Class="mr-2" Style="vertical-align:middle;" />
        Simulation Pipeline
    </MudText>
    <MudGrid Spacing="3">
        <MudItem xs="12" sm="6" md="3">
            <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.BarChart"
                       OnClick="RunStatsSync" Disabled="_statsBusy">
                Stats Sync
            </MudButton>
            <MudText Typo="Typo.caption" Style="@StatsStatusStyle">@_statsStatus</MudText>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.DirectionsRun"
                       OnClick="RunSnapCountSync" Disabled="_snapBusy">
                Snap Count Sync
            </MudButton>
            <MudText Typo="Typo.caption" Style="@SnapStatusStyle">@_snapStatus</MudText>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.AutoAwesome"
                       OnClick="RunProjections" Disabled="_projBusy">
                Projections &amp; Sims
            </MudButton>
            <MudText Typo="Typo.caption" Style="@ProjStatusStyle">@_projStatus</MudText>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.CloudDownload"
                       OnClick="RunSeedSeasonAverages" Disabled="_seedBusy">
                @if (_seedBusy)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    @("Seeding — this takes ~30s...")
                }
                else
                {
                    @("Seed Season Averages")
                }
            </MudButton>
            <MudText Typo="Typo.caption" Style="@SeedStatusStyle">@_seedStatus</MudText>
        </MudItem>
    </MudGrid>
</MudPaper>

@* ── FantasyPros Rankings ─────────────────────────────────────────────── *@
<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.h6" Class="mb-1" Style="color: var(--fc-amber);">
        <MudIcon Icon="@Icons.Material.Filled.FormatListNumbered" Class="mr-2" Style="vertical-align:middle;" />
        FantasyPros Rookie Rankings
    </MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
        Export the rookie rankings CSV from FantasyPros and upload here. Replaces all existing FP rankings for the target season.
    </MudText>
    <MudGrid Spacing="2" AlignItems="Center">
        <MudItem xs="12" sm="8">
            <MudFileUpload T="IBrowserFile" FilesChanged="@(f => _fpFile = f)" Accept=".csv">
                <ActivatorContent>
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.AttachFile">
                        @(_fpFile is null ? "Choose CSV file" : _fpFile.Name)
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudButton Variant="Variant.Filled" Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.CloudUpload"
                       OnClick="ImportFantasyPros" Disabled="@(_fpFile is null || _fpBusy)">
                @if (_fpBusy)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Import
            </MudButton>
        </MudItem>
    </MudGrid>
    @if (!string.IsNullOrEmpty(_fpStatus))
    {
        <MudAlert Severity="_fpSeverity" Dense="true" Class="mt-3">@_fpStatus</MudAlert>
    }
</MudPaper>
@* ── FantasyPros Dynasty Rankings Import ─────────────────────────────── *@
<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.h6" Class="mb-1">
        <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Class="mr-2" Style="vertical-align:middle;" />
        FantasyPros Dynasty Rankings
    </MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
        Full dynasty overall rankings (all positions). Used by the calibration harness.
        Download from FantasyPros → Dynasty → Overall Rankings → Export CSV.
    </MudText>
    <MudGrid Spacing="2" AlignItems="Center">
        <MudItem xs="12" sm="6" md="4">
            <MudFileUpload T="IBrowserFile" FilesChanged="OnDynastyRankingsFileSelected" Accept=".csv">
                <ActivatorContent>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.UploadFile" FullWidth="true">
                        Select Dynasty CSV
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.CloudUpload"
                       OnClick="ImportDynastyRankings"
                       Disabled="_dynastyImportBusy || _dynastyFile == null">
                @if (_dynastyImportBusy)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    @("Importing...")
                }
                else
                {

                    @("Import Dynasty Rankings")
                }
            </MudButton>
        </MudItem>
    </MudGrid>
    @if (!string.IsNullOrEmpty(_dynastyImportStatus))
    {
        <MudAlert Severity="_dynastyImportSeverity" Dense="true" Class="mt-3">@_dynastyImportStatus</MudAlert>
    }
</MudPaper>
@* ── PFF Draft Grades ─────────────────────────────────────────────────── *@
<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.h6" Class="mb-1" Style="color: var(--fc-amber);">
        <MudIcon Icon="@Icons.Material.Filled.Grade" Class="mr-2" Style="vertical-align:middle;" />
        PFF Draft Grades
    </MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
        Upload the PFF post-draft grades CSV. Run after the NFL Draft completes.
    </MudText>
    <MudGrid Spacing="2" AlignItems="Center">
        <MudItem xs="12" sm="8">
            <MudFileUpload T="IBrowserFile" FilesChanged="@(f => _pffFile = f)" Accept=".csv">
                <ActivatorContent>
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.AttachFile">
                        @(_pffFile is null ? "Choose CSV file" : _pffFile.Name)
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudButton Variant="Variant.Filled" Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.CloudUpload"
                       OnClick="ImportPff" Disabled="@(_pffFile is null || _pffBusy)">
                @if (_pffBusy)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Import
            </MudButton>
        </MudItem>
    </MudGrid>
    @if (!string.IsNullOrEmpty(_pffStatus))
    {
        <MudAlert Severity="_pffSeverity" Dense="true" Class="mt-3">@_pffStatus</MudAlert>
    }
</MudPaper>

@* ── Consensus ADP ────────────────────────────────────────────────────── *@
<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.h6" Class="mb-1" Style="color: var(--fc-amber);">
        <MudIcon Icon="@Icons.Material.Filled.SwapVert" Class="mr-2" Style="vertical-align:middle;" />
        Consensus ADP
    </MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
        Upload a consensus ADP CSV. Source label is stored alongside the data.
    </MudText>
    <MudGrid Spacing="2" AlignItems="Center">
        <MudItem xs="12" sm="5">
            <MudFileUpload T="IBrowserFile" FilesChanged="@(f => _adpFile = f)" Accept=".csv">
                <ActivatorContent>
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.AttachFile">
                        @(_adpFile is null ? "Choose CSV file" : _adpFile.Name)
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudTextField @bind-Value="_adpSource" Label="Source label" Placeholder="e.g. FantasyPros"
                          Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudButton Variant="Variant.Filled" Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.CloudUpload"
                       OnClick="ImportAdp" Disabled="@(_adpFile is null || _adpBusy)">
                @if (_adpBusy)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Import
            </MudButton>
        </MudItem>
    </MudGrid>
    @if (!string.IsNullOrEmpty(_adpStatus))
    {
        <MudAlert Severity="_adpSeverity" Dense="true" Class="mt-3">@_adpStatus</MudAlert>
    }
</MudPaper>
@* ── Calibration Harness ─────────────────────────────────────────────── *@
<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.h6" Class="mb-1" Style="color: var(--fc-amber);">
        <MudIcon Icon="@Icons.Material.Filled.Analytics" Class="mr-2" Style="vertical-align:middle;" />
        Dynasty Ranking Calibration
    </MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
        Compares our dynasty rankings against FantasyPros top-200. Run after any DFV pipeline execution.
        Targets: Spearman ρ ≥ 0.85 · Avg delta ≤ 8.0 · Top-10 overlap ≥ 7/10.
    </MudText>
    <MudGrid Spacing="2" AlignItems="Center">
        <MudItem xs="12" sm="6" md="3">
            <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.BarChart"
                       OnClick="RunCalibration" Disabled="_calibBusy">
                @if (_calibBusy)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    @("Calibrating...")
                }
                else
                {

                    @("Run Calibration")
                }
            </MudButton>
        </MudItem>
    </MudGrid>

    @if (_calibResult is not null)
    {
        <MudGrid Spacing="2" Class="mt-3">
            <MudItem xs="4" sm="4">
                <MudPaper Class="pa-3 text-center" Elevation="0" Style="background: var(--mud-palette-surface);">
                    <MudText Typo="Typo.h5" Style="@RhoColor">@_calibResult.SpearmanRho.ToString("F4")</MudText>
                    <MudText Typo="Typo.caption">Spearman ρ (target ≥ 0.85)</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="4" sm="4">
                <MudPaper Class="pa-3 text-center" Elevation="0" Style="background: var(--mud-palette-surface);">
                    <MudText Typo="Typo.h5" Style="@DeltaColor">@_calibResult.AvgAbsDelta.ToString("F1")</MudText>
                    <MudText Typo="Typo.caption">Avg |Δ rank| (target ≤ 8.0)</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="4" sm="4">
                <MudPaper Class="pa-3 text-center" Elevation="0" Style="background: var(--mud-palette-surface);">
                    <MudText Typo="Typo.h5" Style="@OverlapColor">@_calibResult.Top10Overlap/10</MudText>
                    <MudText Typo="Typo.caption">Top-10 overlap (target ≥ 7)</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">Top-20 Comparison</MudText>
        <MudTable Items="_calibResult.Top20Snapshot" Dense="true" Hover="true" Elevation="0">
            <HeaderContent>
                <MudTh>Our Rank</MudTh>
                <MudTh>Player</MudTh>
                <MudTh>Pos</MudTh>
                <MudTh>Our TV</MudTh>
                <MudTh>FP Rank</MudTh>
                <MudTh>Δ</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.OurRank</MudTd>
                <MudTd>@context.PlayerName</MudTd>
                <MudTd>@context.Position</MudTd>
                <MudTd>@context.OurTradeValue.ToString("F1")</MudTd>
                <MudTd>@context.FpRank</MudTd>
                <MudTd Style="@DeltaRowColor(context.Delta)">@(context.Delta > 0 ? $"+{context.Delta}" : context.Delta.ToString())</MudTd>
            </RowTemplate>
        </MudTable>
    }

    @if (!string.IsNullOrEmpty(_calibStatus))
    {
        <MudAlert Severity="_calibSeverity" Dense="true" Class="mt-3">@_calibStatus</MudAlert>
    }
</MudPaper>
@* ── Writers' Room ──────────────────────────────────────────────────── *@
<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.h6" Class="mb-1" Style="color: var(--fc-amber);">
        <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-2" Style="vertical-align:middle;" />
        Writers' Room
    </MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
        Generate articles for all active writer personas using current season/week context.
    </MudText>
    <MudItem xs="12" sm="6" md="4">
        <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Warning"
                   StartIcon="@Icons.Material.Filled.AutoStories"
                   OnClick="RunArticleGeneration" Disabled="_articlesBusy">
            Generate Articles
