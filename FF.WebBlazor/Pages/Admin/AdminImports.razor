@page "/admin/imports"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@inject NflContextClientService NflContext

<PageTitle>Imports & Triggers — Admin — FantasyCombine.AI</PageTitle>

<div class="fc-page-header mb-4">
    <MudText Typo="Typo.h5" Class="fc-page-title" Style="color: var(--fc-amber);">
        <MudIcon Icon="@Icons.Material.Filled.Upload" Class="mr-2" Style="vertical-align:middle;" />
        Imports &amp; Triggers
    </MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary">
        Upload CSV files and trigger post-draft data jobs — no curl required.
    </MudText>
</div>

@* ── Simulation Pipeline ─────────────────────────────────────── *@
<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.h6" Class="mb-1" Style="color: var(--fc-amber);">
        <MudIcon Icon="@Icons.Material.Filled.Memory" Class="mr-2" Style="vertical-align:middle;" />
        Simulation Pipeline
    </MudText>
    <MudExpansionPanels Class="mb-3" Elevation="0">
        <MudExpansionPanel Text="📖 Reference" Dense="true" Class="fc-ref-panel">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Style="color:var(--fc-amber); font-weight:700; text-transform:uppercase; letter-spacing:.06em;">Stats Sync</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Downloads weekly player stats from nflverse and computes usage metrics. Run every Tuesday in-season. No file needed — auto API pull.</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Style="color:var(--fc-amber); font-weight:700; text-transform:uppercase; letter-spacing:.06em;">Snap Count Sync</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Pulls snap counts from nflverse to update snap% metrics used in breakout detection. Run after Stats Sync each Tuesday.</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Style="color:var(--fc-amber); font-weight:700; text-transform:uppercase; letter-spacing:.06em;">Projections &amp; Sims</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Runs regression projections then Monte Carlo simulations for the current week. Feeds My Matchup, Optimizer, and Waiver Wire. Run after Stats Sync.</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Style="color:var(--fc-amber); font-weight:700; text-transform:uppercase; letter-spacing:.06em;">Seed Season Averages (button)</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Downloads the prior-year season aggregate from nflverse (<code>player_stats_season_{year}.csv</code>) and upserts into simulation_results (Week=0). Only available after nflverse publishes the season file (~March). Use the CSV upload below during the off-season.</MudText>
                </MudItem>
            </MudGrid>
        </MudExpansionPanel>
    </MudExpansionPanels>
    <MudGrid Spacing="3">
        <MudItem xs="12" sm="6" md="3">
            <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.BarChart"
                       OnClick="RunStatsSync" Disabled="_statsBusy">
                Stats Sync
            </MudButton>
            <MudText Typo="Typo.caption" Style="@StatsStatusStyle">@_statsStatus</MudText>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.DirectionsRun"
                       OnClick="RunSnapCountSync" Disabled="_snapBusy">
                Snap Count Sync
            </MudButton>
            <MudText Typo="Typo.caption" Style="@SnapStatusStyle">@_snapStatus</MudText>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.AutoAwesome"
                       OnClick="RunProjections" Disabled="_projBusy">
                Projections &amp; Sims
            </MudButton>
            <MudText Typo="Typo.caption" Style="@ProjStatusStyle">@_projStatus</MudText>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.CloudDownload"
                       OnClick="RunSeedSeasonAverages" Disabled="_seedBusy">
                @if (_seedBusy)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    @("Seeding — this takes ~30s...")
                }
                else
                {
                    @("Seed Season Averages")
                }
            </MudButton>
            <MudText Typo="Typo.caption" Style="@SeedStatusStyle">@_seedStatus</MudText>
        </MudItem>
    </MudGrid>
</MudPaper>

@* ── Season Stats CSV Upload ─────────────────────────────────────────── *@
<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.h6" Class="mb-1" Style="color: var(--fc-amber);">
        <MudIcon Icon="@Icons.Material.Filled.TableChart" Class="mr-2" Style="vertical-align:middle;" />
        Seed Season Averages — CSV Upload
    </MudText>
    <MudExpansionPanels Class="mb-3" Elevation="0">
        <MudExpansionPanel Text="📖 Reference" Dense="true" Class="fc-ref-panel">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Style="color:var(--fc-amber); font-weight:700; text-transform:uppercase; letter-spacing:.06em;">Source</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        <a href="https://github.com/nflverse/nflverse-data/releases/tag/player_stats" target="_blank" style="color:var(--fc-cyan);">nflverse player_stats release</a>
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">File: <code>player_stats_{year}.csv</code> (weekly file, not season aggregate)</MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Style="color:var(--fc-amber); font-weight:700; text-transform:uppercase; letter-spacing:.06em;">When to Run</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Off-season only — when the prior-year season aggregate is not yet published by nflverse (~Nov–Feb). The system aggregates weekly rows to per-game averages and seeds simulation_results (Week=0).</MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Style="color:var(--fc-amber); font-weight:700; text-transform:uppercase; letter-spacing:.06em;">Format</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Standard nflverse weekly CSV — no transformation needed. Max file size: 20MB. System filters to season_type=REG automatically.</MudText>
                </MudItem>
            </MudGrid>
        </MudExpansionPanel>
    </MudExpansionPanels>
    <MudGrid Spacing="2" AlignItems="Center">
        <MudItem xs="12" sm="5" md="4">
            <MudFileUpload T="IBrowserFile" FilesChanged="OnSeasonStatsFileSelected" Accept=".csv">
                <ActivatorContent>
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.UploadFile" FullWidth="true">
                        @(_seasonStatsFile is null ? "Choose CSV file" : _seasonStatsFile.Name)
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
        </MudItem>
        <MudItem xs="6" sm="3" md="2">
            <MudNumericField T="int" @bind-Value="_seasonStatsSeason"
                             Label="Season" Variant="Variant.Outlined"
                             Margin="Margin.Dense" Min="2020" Max="2030" />
        </MudItem>
        <MudItem xs="6" sm="4" md="3">
            <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.CloudUpload"
                       OnClick="ImportSeasonStatsCsv"
                       Disabled="@(_seasonStatsFile is null || _seasonStatsBusy)">
                @if (_seasonStatsBusy)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    @("Importing...")
                }
                else
                {
                    @("Seed from CSV")
                }
            </MudButton>
        </MudItem>
    </MudGrid>
    @if (!string.IsNullOrEmpty(_seasonStatsStatus))
    {
        <MudAlert Severity="_seasonStatsSeverity" Dense="true" Class="mt-3">@_seasonStatsStatus</MudAlert>
    }
</MudPaper>

@* ── FantasyPros Rookie Rankings ─────────────────────────────────────────────── *@
<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.h6" Class="mb-1" Style="color: var(--fc-amber);">
        <MudIcon Icon="@Icons.Material.Filled.FormatListNumbered" Class="mr-2" Style="vertical-align:middle;" />
        FantasyPros Rookie Rankings
    </MudText>
    <MudExpansionPanels Class="mb-3" Elevation="0">
        <MudExpansionPanel Text="📖 Reference" Dense="true" Class="fc-ref-panel">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Style="color:var(--fc-amber); font-weight:700; text-transform:uppercase; letter-spacing:.06em;">Source &amp; Navigation</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        <a href="https://www.fantasypros.com/nfl/rankings/dynasty-rookie-overall.php" target="_blank" style="color:var(--fc-cyan);">FantasyPros → Dynasty → Rookie Rankings</a>
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">Click <strong>Export</strong> (top right of rankings table) → CSV</MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Style="color:var(--fc-amber); font-weight:700; text-transform:uppercase; letter-spacing:.06em;">When to Run</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Immediately post-NFL Draft (late April). Re-run any time FP updates their consensus — typically weekly through August. Feeds rookie floor scoring in DFV pipeline.</MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Style="color:var(--fc-amber); font-weight:700; text-transform:uppercase; letter-spacing:.06em;">Expected Format</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Standard FP ECR export — no transformation needed. Header row: <code>"RK","PLAYER NAME",TEAM,"POS","AGE","BEST","WORST","AVG.","STD.DEV","ECR VS. ADP"</code>. Position suffix (e.g. RB1) stripped automatically.</MudText>
                </MudItem>
            </MudGrid>
        </MudExpansionPanel>
    </MudExpansionPanels>
    <MudGrid Spacing="2" AlignItems="Center">
        <MudItem xs="12" sm="8">
            <MudFileUpload T="IBrowserFile" FilesChanged="@(f => _fpFile = f)" Accept=".csv">
                <ActivatorContent>
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.AttachFile">
                        @(_fpFile is null ? "Choose CSV file" : _fpFile.Name)
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudButton Variant="Variant.Filled" Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.CloudUpload"
                       OnClick="ImportFantasyPros"
                       Disabled="@(_fpFile is null || _fpBusy)">
                @if (_fpBusy)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Import
            </MudButton>
        </MudItem>
    </MudGrid>
    @if (!string.IsNullOrEmpty(_fpStatus))
    {
        <MudAlert Severity="_fpSeverity" Dense="true" Class="mt-3">@_fpStatus</MudAlert>
    }
</MudPaper>

@* ── FantasyPros Dynasty Rankings ─────────────────────────────────────── *@
<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.h6" Class="mb-1">
        <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Class="mr-2" Style="vertical-align:middle;" />
        FantasyPros Dynasty Rankings
    </MudText>
    <MudExpansionPanels Class="mb-3" Elevation="0">
        <MudExpansionPanel Text="📖 Reference" Dense="true" Class="fc-ref-panel">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Style="color:var(--fc-amber); font-weight:700; text-transform:uppercase; letter-spacing:.06em;">Source &amp; Navigation</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        <a href="https://www.fantasypros.com/nfl/rankings/dynasty-overall.php" target="_blank" style="color:var(--fc-cyan);">FantasyPros → Dynasty → Overall Rankings</a>
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">Select <strong>Superflex</strong> from the format dropdown before exporting. Click <strong>Export</strong> → CSV.</MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Style="color:var(--fc-amber); font-weight:700; text-transform:uppercase; letter-spacing:.06em;">When to Run</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Before running the Calibration Harness below. Re-import any time you want a fresh benchmark — FP updates weekly. This is the calibration target, not a scoring input.</MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Style="color:var(--fc-amber); font-weight:700; text-transform:uppercase; letter-spacing:.06em;">Expected Format</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Same ECR export format as rookie rankings. Header: <code>"RK",TIERS,"PLAYER NAME",TEAM,"POS",...`</code>. Covers all positions — not rookies only.</MudText>
                </MudItem>
            </MudGrid>
        </MudExpansionPanel>
    </MudExpansionPanels>
    <MudGrid Spacing="2" AlignItems="Center">
        <MudItem xs="12" sm="6" md="4">
            <MudFileUpload T="IBrowserFile" FilesChanged="OnDynastyRankingsFileSelected" Accept=".csv">
                <ActivatorContent>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.UploadFile"
                               FullWidth="true">
                        Select Dynasty CSV
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.CloudUpload"
                       OnClick="ImportDynastyRankings"
                       Disabled="_dynastyImportBusy || _dynastyFile == null">
                @if (_dynastyImportBusy)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    @("Importing...")
                }
                else
                {
                    @("Import Dynasty Rankings")
                }
            </MudButton>
        </MudItem>
    </MudGrid>
    @if (!string.IsNullOrEmpty(_dynastyImportStatus))
    {
        <MudAlert Severity="_dynastyImportSeverity" Dense="true" Class="mt-3">@_dynastyImportStatus</MudAlert>
    }
</MudPaper>

@* ── PFF Draft Grades ─────────────────────────────────────────────────── *@
<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.h6" Class="mb-1" Style="color: var(--fc-amber);">
        <MudIcon Icon="@Icons.Material.Filled.Grade" Class="mr-2" Style="vertical-align:middle;" />
        PFF Draft Grades
    </MudText>
    <MudExpansionPanels Class="mb-3" Elevation="0">
        <MudExpansionPanel Text="📖 Reference" Dense="true" Class="fc-ref-panel">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Style="color:var(--fc-amber); font-weight:700; text-transform:uppercase; letter-spacing:.06em;">Source</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        <a href="https://www.pff.com/news/nfl-2026-nfl-draft-grades" target="_blank" style="color:var(--fc-cyan);">PFF — NFL Draft Grades article</a>
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">Free article published within 24h of draft end. No CSV download — copy grades into the format below manually or paste into a spreadsheet and export.</MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Style="color:var(--fc-amber); font-weight:700; text-transform:uppercase; letter-spacing:.06em;">When to Run</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Once per year, within a few days of the NFL Draft (late April). PFF grades are stable — re-import only if they update their grades, which is rare. Feeds PFF Grade signal in Dynasty Score breakdown.</MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Style="color:var(--fc-amber); font-weight:700; text-transform:uppercase; letter-spacing:.06em;">Required CSV Format</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Must be manually constructed. Exact header required:</MudText>
                    <code style="font-size:.75rem; color:var(--fc-cyan); display:block; margin-top:4px;">Rank,PlayerName,Position,Team,Grade</code>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">Grade is 0–100 (PFF scale). Example row: <code>1,Travis Hunter,WR,JAC,93.5</code></MudText>
                </MudItem>
            </MudGrid>
        </MudExpansionPanel>
    </MudExpansionPanels>
    <MudGrid Spacing="2" AlignItems="Center">
        <MudItem xs="12" sm="8">
            <MudFileUpload T="IBrowserFile" FilesChanged="@(f => _pffFile = f)" Accept=".csv">
                <ActivatorContent>
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.AttachFile">
                        @(_pffFile is null ? "Choose CSV file" : _pffFile.Name)
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudButton Variant="Variant.Filled" Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.CloudUpload"
                       OnClick="ImportPff"
                       Disabled="@(_pffFile is null || _pffBusy)">
                @if (_pffBusy)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Import
            </MudButton>
        </MudItem>
    </MudGrid>
    @if (!string.IsNullOrEmpty(_pffStatus))
    {
        <MudAlert Severity="_pffSeverity" Dense="true" Class="mt-3">@_pffStatus</MudAlert>
    }
</MudPaper>

@* ── Consensus ADP ────────────────────────────────────────────────────── *@
<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.h6" Class="mb-1" Style="color: var(--fc-amber);">
        <MudIcon Icon="@Icons.Material.Filled.SwapVert" Class="mr-2" Style="vertical-align:middle;" />
        Consensus Rookie ADP
    </MudText>
    <MudExpansionPanels Class="mb-3" Elevation="0">
        <MudExpansionPanel Text="📖 Reference" Dense="true" Class="fc-ref-panel">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Style="color:var(--fc-amber); font-weight:700; text-transform:uppercase; letter-spacing:.06em;">Source &amp; Navigation</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        <a href="https://www.fantasypros.com/nfl/adp/dynasty-rookies.php" target="_blank" style="color:var(--fc-cyan);">FantasyPros → Dynasty → Rookie ADP</a>
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">Click <strong>Export</strong> → CSV. Set Source label to <strong>FantasyPros</strong>.</MudText>
                    <MudText Typo="Typo.caption" Class="mt-2" Style="color:var(--mud-palette-text-secondary);">Note: FFC ADP (redraft) is separate — use the Sync button below. This import is for dynasty rookie ADP only.</MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Style="color:var(--fc-amber); font-weight:700; text-transform:uppercase; letter-spacing:.06em;">When to Run</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Post-draft (late April) then weekly through August as ADP stabilizes. Feeds Consensus ADP signal (15% weight) in Dynasty Score breakdown for rookies.</MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Style="color:var(--fc-amber); font-weight:700; text-transform:uppercase; letter-spacing:.06em;">Required CSV Format</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Exact header required (case-insensitive):</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">The standard FP ADP export works directly — no header renaming needed. Importer accepts both <code>"Player"/"AVG"</code> (FP format) and <code>PlayerName/ADP</code> (custom). AVG is the consensus pick number (1.0 = first overall). Position suffix (RB1, WR2) stripped automatically.</MudText>
                </MudItem>
            </MudGrid>
        </MudExpansionPanel>
    </MudExpansionPanels>
    <MudGrid Spacing="2" AlignItems="Center">
        <MudItem xs="12" sm="5">
            <MudFileUpload T="IBrowserFile" FilesChanged="@(f => _adpFile = f)" Accept=".csv">
                <ActivatorContent>
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.AttachFile">
                        @(_adpFile is null ? "Choose CSV file" : _adpFile.Name)
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudTextField @bind-Value="_adpSource" Label="Source label"
                          Placeholder="e.g. FantasyPros"
                          Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudButton Variant="Variant.Filled" Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.CloudUpload"
                       OnClick="ImportAdp"
                       Disabled="@(_adpFile is null || _adpBusy)">
                @if (_adpBusy)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Import
            </MudButton>
        </MudItem>
    </MudGrid>
    @if (!string.IsNullOrEmpty(_adpStatus))
    {
        <MudAlert Severity="_adpSeverity" Dense="true" Class="mt-3">@_adpStatus</MudAlert>
    }
</MudPaper>

@* ── Calibration Harness ─────────────────────────────────────────────── *@
<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.h6" Class="mb-1" Style="color: var(--fc-amber);">
        <MudIcon Icon="@Icons.Material.Filled.Analytics" Class="mr-2" Style="vertical-align:middle;" />
        Dynasty Ranking Calibration
    </MudText>
    <MudExpansionPanels Class="mb-3" Elevation="0">
        <MudExpansionPanel Text="📖 Reference" Dense="true" Class="fc-ref-panel">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Style="color:var(--fc-amber); font-weight:700; text-transform:uppercase; letter-spacing:.06em;">What It Does</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Compares our dynasty rankings against the FantasyPros Dynasty Overall benchmark. Computes Spearman ρ (rank correlation), average rank delta, and top-10 overlap. Requires FP Dynasty Rankings to be imported first.</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
