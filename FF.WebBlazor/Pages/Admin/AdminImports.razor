    private IBrowserFile? _dynastyFile;
    private bool _dynastyImportBusy;
    private string _dynastyImportStatus = string.Empty;
    private Severity _dynastyImportSeverity = Severity.Info;

    private void OnDynastyRankingsFileSelected(IBrowserFile file) => _dynastyFile = file;

    private async Task ImportDynastyRankings()
    {
        if (_dynastyFile == null) return;
        _dynastyImportBusy = true;
        _dynastyImportStatus = string.Empty;
        try
        {
            using var stream = _dynastyFile.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var csvContent = await reader.ReadToEndAsync();

            var http = HttpFactory.CreateClient("AuthAPI");
            var resp = await http.PostAsJsonAsync(
                "api/v1/admin/import/fantasypros-dynasty",
                new { CsvContent = csvContent, Season = _season });

            if (resp.IsSuccessStatusCode)
            {
                var result = await resp.Content.ReadFromJsonAsync<ImportResult>();
                _dynastyImportSeverity = result?.Unmatched > 50 ? Severity.Warning : Severity.Success;
                _dynastyImportStatus = $"✓ Imported {result?.Imported} players — {result?.Unmatched} unmatched.";
            }
            else
            {
                _dynastyImportStatus = $"Failed ({(int)resp.StatusCode}): {await resp.Content.ReadAsStringAsync()}";
                _dynastyImportSeverity = Severity.Error;
            }
        }
        catch (Exception ex)
        {
            _dynastyImportStatus = $"Error: {ex.Message}";
            _dynastyImportSeverity = Severity.Error;
        }
        finally { _dynastyImportBusy = false; }
    }
