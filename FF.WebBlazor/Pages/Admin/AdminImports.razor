                <MudTd Style="@DeltaRowColor(context.Delta)">@(context.Delta > 0 ? $"+{context.Delta}" : context.Delta.ToString())</MudTd>
            </RowTemplate>
        </MudTable>
    }
    @if (!string.IsNullOrEmpty(_calibStatus))
    {
        <MudAlert Severity="_calibSeverity" Dense="true" Class="mt-3">@_calibStatus</MudAlert>
    }
</MudPaper>

