    // ── Calibration ────────────────────────────────────────────────────────
    private bool _calibBusy;
    private string _calibStatus = string.Empty;
    private Severity _calibSeverity = Severity.Info;
    private CalibrationResultDto? _calibResult;

    private string RhoColor   => _calibResult?.SpearmanRho   >= 0.85 ? "color: var(--mud-palette-success)" : "color: var(--mud-palette-error)";
    private string DeltaColor => _calibResult?.AvgAbsDelta   <= 8.0  ? "color: var(--mud-palette-success)" : "color: var(--mud-palette-error)";
    private string OverlapColor => _calibResult?.Top10Overlap >= 7   ? "color: var(--mud-palette-success)" : "color: var(--mud-palette-error)";
    private static string DeltaRowColor(int delta) => Math.Abs(delta) <= 5 ? "color: inherit"
        : Math.Abs(delta) <= 15 ? "color: var(--mud-palette-warning)" : "color: var(--mud-palette-error)";

    private async Task RunCalibration()
    {
        _calibBusy = true; _calibStatus = string.Empty; _calibResult = null;
        try
        {
            var http = HttpFactory.CreateClient("AuthAPI");
            var resp = await http.PostAsJsonAsync("api/v1/admin/jobs/run-calibration",
                new { Season = _season, ScoringFormat = _scoringFormat });
            if (resp.IsSuccessStatusCode)
            {
                _calibResult = await resp.Content.ReadFromJsonAsync<CalibrationResultDto>();
                _calibSeverity = Severity.Success;
                _calibStatus = $"✓ Calibration complete — {_calibResult?.PlayerCount} players compared.";
            }
            else
            {
                var err = await resp.Content.ReadAsStringAsync();
                _calibStatus = $"Failed ({(int)resp.StatusCode}): {err}";
                _calibSeverity = Severity.Error;
            }
        }
        catch (Exception ex) { _calibStatus = $"Error: {ex.Message}"; _calibSeverity = Severity.Error; }
        finally { _calibBusy = false; }
    }

    // ── FP Dynasty Rankings Import ─────────────────────────────────────────
    private IBrowserFile? _dynastyFile;
    private bool _dynastyImportBusy;
    private string _dynastyImportStatus = string.Empty;
    private Severity _dynastyImportSeverity = Severity.Info;

    private void OnDynastyRankingsFileSelected(IBrowserFile file) => _dynastyFile = file;

    private async Task ImportDynastyRankings()
    {
        if (_dynastyFile == null) return;
        _dynastyImportBusy = true; _dynastyImportStatus = string.Empty;
        try
        {
            var csvContent = await ReadFileAsTextAsync(_dynastyFile);
            var http = HttpFactory.CreateClient("AuthAPI");
            var resp = await http.PostAsJsonAsync("api/v1/admin/import/fantasypros-dynasty",
                new { CsvContent = csvContent, Season = _season });
            if (resp.IsSuccessStatusCode)
            {
                var result = await resp.Content.ReadFromJsonAsync<ImportResult>();
                _dynastyImportSeverity = result?.Unmatched > 50 ? Severity.Warning : Severity.Success;
                _dynastyImportStatus = $"✓ Imported {result?.Imported} players — {result?.Unmatched} unmatched.";
            }
            else
            {
                _dynastyImportStatus = $"Failed ({(int)resp.StatusCode}): {await resp.Content.ReadAsStringAsync()}";
                _dynastyImportSeverity = Severity.Error;
            }
        }
        catch (Exception ex) { _dynastyImportStatus = $"Error: {ex.Message}"; _dynastyImportSeverity = Severity.Error; }
        finally { _dynastyImportBusy = false; }
    }

