@code {
    [Inject] IHttpClientFactory HttpFactory { get; set; } = default!;

    private int _season;
    private int _week;

    // ── Season Stats CSV Upload ────────────────────────────────────────────
    private IBrowserFile? _seasonStatsFile;
    private bool _seasonStatsBusy;
    private string _seasonStatsStatus = string.Empty;
    private Severity _seasonStatsSeverity = Severity.Info;
    private int _seasonStatsSeason = 2025;

    private void OnSeasonStatsFileSelected(IBrowserFile file) => _seasonStatsFile = file;

    private async Task ImportSeasonStatsCsv()
    {
        if (_seasonStatsFile is null) return;
        _seasonStatsBusy = true;
        _seasonStatsStatus = "Reading file...";
        _seasonStatsSeverity = Severity.Info;
        try
        {
            using var stream = _seasonStatsFile.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
            using var reader = new System.IO.StreamReader(stream);
            var csvContent = await reader.ReadToEndAsync();

            _seasonStatsStatus = "Uploading and aggregating — this may take ~30s...";
            var http = HttpFactory.CreateClient("AuthAPI");
            var resp = await http.PostAsJsonAsync(
                "api/v1/admin/import/seed-season-averages-csv",
                new { CsvContent = csvContent, Season = _seasonStatsSeason });

            if (resp.IsSuccessStatusCode)
            {
                var body = await resp.Content.ReadFromJsonAsync<SeedResultDto>();
                _seasonStatsSeverity = Severity.Success;
                _seasonStatsStatus = $"✓ {body?.Seeded ?? 0} players seeded for {_seasonStatsSeason} — {body?.Unmatched ?? 0} unmatched.";
                _seasonStatsFile = null;
            }
            else
            {
                var err = await resp.Content.ReadAsStringAsync();
                _seasonStatsStatus = $"Failed ({(int)resp.StatusCode}): {err}";
                _seasonStatsSeverity = Severity.Error;
            }
        }
        catch (Exception ex)
        {
            _seasonStatsStatus = $"Error: {ex.Message}";
            _seasonStatsSeverity = Severity.Error;
        }
        finally { _seasonStatsBusy = false; }
    }

    protected override async Task OnInitializedAsync()
    {
        (_season, _week) = await NflContext.GetContextAsync();
        _seasonStatsSeason = _season;
    }

    // ── Articles ───────────────────────────────────────────────────────────
    private bool _articlesBusy;
    private string _articlesStatus = string.Empty;
    private bool _articlesOk;
    private string ArticlesStatusStyle => string.IsNullOrEmpty(_articlesStatus) ? "display:none"
        : _articlesOk ? "color: var(--mud-palette-success)" : "color: var(--mud-palette-error)";

    private async Task RunArticleGeneration()
    {
        _articlesBusy = true;
        _articlesStatus = "Generating articles — this takes ~20s...";
        try
        {
            var http = HttpFactory.CreateClient("AuthAPI");
            var resp = await http.PostAsync("api/v1/admin/jobs/run-article-generation", null);
            _articlesOk = resp.IsSuccessStatusCode;
            _articlesStatus = _articlesOk ? "Done ✓ — articles generated" : $"Failed ({(int)resp.StatusCode})";
        }
        catch (Exception ex) { _articlesOk = false; _articlesStatus = ex.Message; }
        finally { _articlesBusy = false; }
    }

    // ── Seed Season Averages ──────────────────────────────────────────────
    private bool _seedBusy;
    private string _seedStatus = string.Empty;
    private bool _seedOk;
    private string SeedStatusStyle => string.IsNullOrEmpty(_seedStatus) ? "display:none"
        : _seedOk ? "color: var(--mud-palette-success)" : "color: var(--mud-palette-error)";

    private async Task RunSeedSeasonAverages()
    {
        _seedBusy = true;
        _seedStatus = "Seeding — downloading nflverse stats, this takes ~30s...";
        try
        {
            var http = HttpFactory.CreateClient("AuthAPI");
            var resp = await http.PostAsync($"api/v1/admin/jobs/seed-season-averages?season={_season}", null);
            _seedOk = resp.IsSuccessStatusCode;
            if (_seedOk)
            {
                var body = await resp.Content.ReadFromJsonAsync<SeedResultDto>();
                _seedStatus = $"Done ✓ — {body?.Seeded ?? 0} seeded, {body?.Unmatched ?? 0} unmatched";
            }
            else _seedStatus = $"Failed ({(int)resp.StatusCode})";
        }
        catch (Exception ex) { _seedOk = false; _seedStatus = ex.Message; }
        finally { _seedBusy = false; }
    }

    // ── Status style helpers ───────────────────────────────────────────────
    private string CombineStatusStyle => string.IsNullOrEmpty(_combineStatus) ? "display:none"
        : _combineOk ? "color: var(--mud-palette-success)" : "color: var(--mud-palette-error)";
    private string PicksStatusStyle => string.IsNullOrEmpty(_picksStatus) ? "display:none"
        : _picksOk ? "color: var(--mud-palette-success)" : "color: var(--mud-palette-error)";
    private string SimsStatusStyle => string.IsNullOrEmpty(_simsStatus) ? "display:none"
        : _simsOk ? "color: var(--mud-palette-success)" : "color: var(--mud-palette-error)";
    private string DfvStatusStyle => string.IsNullOrEmpty(_dfvStatus) ? "display:none"
        : _dfvOk ? "color: var(--mud-palette-success)" : "color: var(--mud-palette-error)";

    // ── Simulation pipeline ────────────────────────────────────────────────
    private bool _statsBusy; private string _statsStatus = string.Empty; private bool _statsOk;
    private bool _snapBusy; private string _snapStatus = string.Empty; private bool _snapOk;
    private bool _projBusy; private string _projStatus = string.Empty; private bool _projOk;

    private string StatsStatusStyle => string.IsNullOrEmpty(_statsStatus) ? "display:none"
        : _statsOk ? "color: var(--mud-palette-success)" : "color: var(--mud-palette-error)";
    private string SnapStatusStyle => string.IsNullOrEmpty(_snapStatus) ? "display:none"
        : _snapOk ? "color: var(--mud-palette-success)" : "color: var(--mud-palette-error)";
    private string ProjStatusStyle => string.IsNullOrEmpty(_projStatus) ? "display:none"
        : _projOk ? "color: var(--mud-palette-success)" : "color: var(--mud-palette-error)";

    // ── War Room Briefs ────────────────────────────────────────────────────
    private bool _briefsBusy;
    private string _briefsStatus = string.Empty;
    private Severity _briefsSeverity = Severity.Info;

    private async Task RunGenerateBriefs()
    {
        _briefsBusy = true; _briefsStatus = string.Empty;
        try
        {
            var http = HttpFactory.CreateClient("AuthAPI");
            var resp = await http.PostAsync($"api/v1/brief/generate-all?season={_season}&week={_week}", null);
            if (resp.IsSuccessStatusCode)
            {
                var body = await resp.Content.ReadFromJsonAsync<BriefGenerateResultDto>();
                _briefsStatus = $"✓ {body?.Generated ?? 0} briefs generated" + (body?.Failed > 0 ? $", {body.Failed} failed." : ".");
                _briefsSeverity = (body?.Failed ?? 0) > 0 ? Severity.Warning : Severity.Success;
            }
            else
            {
                _briefsStatus = $"Failed — {(int)resp.StatusCode} {resp.ReasonPhrase}";
                _briefsSeverity = Severity.Error;
            }
        }
        catch (Exception ex) { _briefsStatus = ex.Message; _briefsSeverity = Severity.Error; }
        finally { _briefsBusy = false; }
    }

    // ── FantasyPros ────────────────────────────────────────────────────────
    private IBrowserFile? _fpFile;
    private bool _fpBusy;
    private string _fpStatus = string.Empty;
    private Severity _fpSeverity = Severity.Info;

    // ── PFF ───────────────────────────────────────────────────────────────
    private IBrowserFile? _pffFile;
    private bool _pffBusy;
    private string _pffStatus = string.Empty;
    private Severity _pffSeverity = Severity.Info;

    // ── ADP ───────────────────────────────────────────────────────────────
    private IBrowserFile? _adpFile;
    private bool _adpBusy;
    private string _adpStatus = string.Empty;
    private Severity _adpSeverity = Severity.Info;
    private string _adpSource = "FantasyPros";

    // ── FFC ADP ────────────────────────────────────────────────────────────
    private bool _ffcAdpBusy;
    private string _ffcAdpStatus = string.Empty;
    private bool _ffcAdpOk;
    private string FfcAdpStatusStyle => string.IsNullOrEmpty(_ffcAdpStatus) ? "display:none"
        : _ffcAdpOk ? "color:var(--mud-palette-success)" : "color:var(--mud-palette-error)";

    private async Task RunFfcAdpSync()
    {
        _ffcAdpBusy = true; _ffcAdpStatus = string.Empty;
        try
        {
            var http = HttpFactory.CreateClient("AuthAPI");
            var resp = await http.PostAsync("api/v1/admin/sync-ffc-adp", null);
            _ffcAdpOk = resp.IsSuccessStatusCode;
            _ffcAdpStatus = _ffcAdpOk ? "FFC ADP sync triggered successfully." : $"Failed: {(int)resp.StatusCode} {resp.ReasonPhrase}";
        }
        catch (Exception ex) { _ffcAdpOk = false; _ffcAdpStatus = $"Error: {ex.Message}"; }
        finally { _ffcAdpBusy = false; }
    }

    // ── Job triggers ───────────────────────────────────────────────────────
    private bool _combineBusy; private string _combineStatus = string.Empty; private bool _combineOk;
    private bool _picksBusy; private string _picksStatus = string.Empty; private bool _picksOk;
    private bool _simsBusy; private string _simsStatus = string.Empty; private bool _simsOk;
    private bool _dfvBusy; private string _dfvStatus = string.Empty; private bool _dfvOk;
    private string _scoringFormat = "Superflex";

    private async Task<string> ReadFileAsTextAsync(IBrowserFile file)
    {
        using var stream = file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
        using var reader = new System.IO.StreamReader(stream);
        return await reader.ReadToEndAsync();
    }

    private async Task ImportFantasyPros()
    {
        if (_fpFile is null) return;
        _fpBusy = true; _fpStatus = string.Empty;
        try
        {
            var csv = await ReadFileAsTextAsync(_fpFile);
            var http = HttpFactory.CreateClient("AuthAPI");
            var resp = await http.PostAsJsonAsync("api/v1/drafttools/fantasyPros/import",
                new { CsvContent = csv, Season = _season });
            if (resp.IsSuccessStatusCode)
            {
                var body = await resp.Content.ReadFromJsonAsync<ImportResultDto>();
                _fpStatus = $"✓ {body?.Imported ?? 0} rows imported for season {_season}. ({body?.Unmatched ?? 0} unmatched)";
                _fpSeverity = Severity.Success;
                _fpFile = null;
            }
            else { _fpStatus = $"Import failed — {(int)resp.StatusCode} {resp.ReasonPhrase}"; _fpSeverity = Severity.Error; }
        }
        catch (Exception ex) { _fpStatus = $"Error: {ex.Message}"; _fpSeverity = Severity.Error; }
        finally { _fpBusy = false; }
    }

    private async Task ImportPff()
    {
        if (_pffFile is null) return;
        _pffBusy = true; _pffStatus = string.Empty;
        try
        {
            var csv = await ReadFileAsTextAsync(_pffFile);
            var http = HttpFactory.CreateClient("AuthAPI");
            var resp = await http.PostAsJsonAsync("api/v1/drafttools/pff/import",
                new { CsvContent = csv, Season = _season });
            if (resp.IsSuccessStatusCode)
            {
                var body = await resp.Content.ReadFromJsonAsync<ImportResultDto>();
                _pffStatus = $"✓ {body?.Imported ?? 0} rows imported for season {_season}. ({body?.Unmatched ?? 0} unmatched)";
                _pffSeverity = Severity.Success;
                _pffFile = null;
            }
            else { _pffStatus = $"Import failed — {(int)resp.StatusCode} {resp.ReasonPhrase}"; _pffSeverity = Severity.Error; }
        }
        catch (Exception ex) { _pffStatus = $"Error: {ex.Message}"; _pffSeverity = Severity.Error; }
        finally { _pffBusy = false; }
    }

