@page "/admin/logs"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Authorization

<PageTitle>Logs — Admin — FantasyCombine.AI</PageTitle>

<div class="fc-page-header mb-4">
    <MudText Typo="Typo.h5" Class="fc-page-title" Style="color: var(--fc-amber);">
        <MudIcon Icon="@Icons.Material.Filled.Terminal" Class="mr-2" Style="vertical-align:middle;" />
        Live Logs
    </MudText>
</div>

<MudPaper Class="fc-card pa-4" Elevation="0">
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
        Seq log viewer — access via SSH tunnel or direct server connection.
    </MudText>
    <MudButton Variant="Variant.Outlined"
               Color="Color.Warning"
               StartIcon="@Icons.Material.Filled.OpenInNew"
               Href="http://157.180.72.158:5341"
               Target="_blank"
               Class="mb-4">
        Open Seq Dashboard
    </MudButton>
    <MudText Typo="Typo.caption" Class="mud-text-secondary">
        Note: Seq is accessible via direct server IP. Use SSH tunnel for secure access.
    </MudText>
</MudPaper>