@page "/admin"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json

<PageTitle>Admin — FantasyCombine.AI</PageTitle>

<div class="fc-page-header mb-4">
    <MudText Typo="Typo.h5" Class="fc-page-title" Style="color: var(--fc-amber);">
        <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Class="mr-2" Style="vertical-align:middle;" />
        Admin Console
    </MudText>
</div>

<MudGrid Spacing="3">
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="fc-admin-stat-card" Elevation="0" @onclick='@(() => Nav.NavigateTo("/admin/users"))'>
            <MudIcon Icon="@Icons.Material.Filled.People" Class="fc-admin-stat-icon" />
            <MudText Typo="Typo.h4" Class="fc-stat fc-amber">Users</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Manage accounts</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="fc-admin-stat-card" Elevation="0" @onclick='@(() => Nav.NavigateTo("/admin/jobs"))'>
            <MudIcon Icon="@Icons.Material.Filled.Schedule" Class="fc-admin-stat-icon" />
            <MudText Typo="Typo.h4" Class="fc-stat fc-amber">Jobs</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Monitor & trigger</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="fc-admin-stat-card" Elevation="0" @onclick='@(() => Nav.NavigateTo("/admin/logs"))'>
            <MudIcon Icon="@Icons.Material.Filled.Terminal" Class="fc-admin-stat-icon" />
            <MudText Typo="Typo.h4" Class="fc-stat fc-amber">Logs</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Live Seq feed</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="fc-admin-stat-card" Elevation="0" @onclick='@(() => Nav.NavigateTo("/admin/imports"))'>
            <MudIcon Icon="@Icons.Material.Filled.Upload" Class="fc-admin-stat-icon" />
            <MudText Typo="Typo.h4" Class="fc-stat fc-amber">Imports</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">CSV uploads & triggers</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

@* ── NFL Context Simulation Control ─────────────────────────────────────── *@
<MudPaper Class="pa-4 mt-4" Elevation="1">
    <MudText Typo="Typo.h6" Class="mb-3" Style="color: var(--fc-amber);">
        <MudIcon Icon="@Icons.Material.Filled.AccessTime" Class="mr-2" Style="vertical-align:middle;" />
        NFL Context — Season / Week Override
    </MudText>
    @if (_contextLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Warning" />
    }
    else if (_context is not null)
    {
        <MudGrid Spacing="2" Class="mb-3">
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Calendar (actual)</MudText>
                <MudText Typo="Typo.body1">
                    Season <strong>@_context.CalendarSeason</strong> — Week <strong>@_context.CalendarWeek</strong>
                </MudText>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Active context</MudText>
                @if (_context.IsOverrideActive)
                {
                    <MudChip T="string" Color="Color.Warning" Size="Size.Small" Class="mr-1">OVERRIDE</MudChip>
                    <MudText Typo="Typo.body1" Style="display:inline">
                        Season <strong>@(_context.OverrideSeason ?? _context.CalendarSeason)</strong> —
                        Week <strong>@(_context.OverrideWeek ?? _context.CalendarWeek)</strong>
                    </MudText>
                }
                else
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Class="mr-1">CALENDAR</MudChip>
                    <MudText Typo="Typo.body1" Style="display:inline">
                        Season <strong>@_context.CalendarSeason</strong> — Week <strong>@_context.CalendarWeek</strong>
                    </MudText>
                }
            </MudItem>
        </MudGrid>
        <MudDivider Class="mb-3" />
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="4">
                <MudNumericField T="int?" @bind-Value="_overrideSeason" Label="Override Season"
                                 Min="2020" Max="2030" Placeholder="@_context.CalendarSeason.ToString()"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudNumericField T="int?" @bind-Value="_overrideWeek" Label="Override Week"
                                 Min="1" Max="18" Placeholder="@_context.CalendarWeek.ToString()"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="4" Class="d-flex gap-2 align-center">
                <MudButton Variant="Variant.Filled" Color="Color.Warning"
                           StartIcon="@Icons.Material.Filled.PlayArrow"
                           OnClick="SetOverride" Disabled="_saving">
                    Set Override
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Clear"
                           OnClick="ClearOverride" Disabled="_saving || !_context.IsOverrideActive">
                    Clear
                </MudButton>
            </MudItem>
        </MudGrid>
        @if (!string.IsNullOrEmpty(_statusMessage))
        {
            <MudAlert Severity="_statusSeverity" Class="mt-3" Dense="true">@_statusMessage</MudAlert>
        }
    }
</MudPaper>

@* ── Platform Settings ───────────────────────────────────────────────────── *@
<MudPaper Class="pa-4 mt-4" Elevation="1">
    <MudText Typo="Typo.h6" Class="mb-3" Style="color: var(--fc-amber);">
        <MudIcon Icon="@Icons.Material.Filled.Tune" Class="mr-2" Style="vertical-align:middle;" />
        Platform Settings
    </MudText>
    @if (_settingsLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Warning" />
    }
    else
    {
        @* ── Registrations toggle ── *@
        <MudGrid Spacing="2" AlignItems="Center">
            <MudItem xs="12" sm="8">
                <MudText Typo="Typo.body1"><strong>Open Registrations</strong></MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    When off, new sign-ups return a &quot;registrations closed&quot; message. Existing logins are unaffected.
                </MudText>
            </MudItem>
            <MudItem xs="12" sm="4" Class="d-flex justify-end align-center">
                <MudSwitch T="bool"
                           @bind-Value="_registrationsEnabled"
                           Color="Color.Success"
                           UnCheckedColor="Color.Error"
                           Disabled="_settingsSaving"
                           Label="@(_registrationsEnabled ? "Open" : "Closed")"
                           @bind-Value:after="SaveRegistrationsEnabled" />
            </MudItem>
        </MudGrid>
        @if (!string.IsNullOrEmpty(_registrationsStatusMessage))
        {
            <MudAlert Severity="_registrationsStatusSeverity" Class="mt-2" Dense="true">
                @_registrationsStatusMessage
            </MudAlert>
        }

        <MudDivider Class="my-3" />

        @* ── AI Jobs toggle ── *@
        <MudGrid Spacing="2" AlignItems="Center">
            <MudItem xs="12" sm="8">
                <MudText Typo="Typo.body1"><strong>AI Jobs Enabled</strong></MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    Controls ArticleGenerationJob (Tuesday) and WarRoomBriefJob (Sunday).
                    Turn off during the off-season to prevent unnecessary API calls.
                </MudText>
            </MudItem>
            <MudItem xs="12" sm="4" Class="d-flex justify-end align-center">
                <MudSwitch T="bool"
                           @bind-Value="_aiJobsEnabled"
                           Color="Color.Warning"
                           UnCheckedColor="Color.Default"
                           Disabled="_settingsSaving"
                           Label="@(_aiJobsEnabled ? "Enabled" : "Disabled")"
                           @bind-Value:after="SaveAiJobsEnabled" />
            </MudItem>
        </MudGrid>
        @if (!string.IsNullOrEmpty(_aiJobsStatusMessage))
        {
            <MudAlert Severity="_aiJobsStatusSeverity" Class="mt-2" Dense="true">
                @_aiJobsStatusMessage
            </MudAlert>
        }

        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-3 d-block">
            Last updated @_settingsUpdatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt") by @_settingsUpdatedBy
        </MudText>
    }
</MudPaper>

@code {
    [Inject] NavigationManager Nav { get; set; } = default!;
    [Inject] IHttpClientFactory HttpFactory { get; set; } = default!;

    // ── NFL Context ────────────────────────────────────────────────────────────
    private NflContextDto? _context;
    private bool _contextLoading = true;
    private bool _saving = false;
    private int? _overrideSeason;
    private int? _overrideWeek;
    private string _statusMessage = string.Empty;
    private Severity _statusSeverity = Severity.Info;

    // ── Platform Settings ──────────────────────────────────────────────────────
    private bool _settingsLoading = true;
    private bool _settingsSaving = false;
    private bool _registrationsEnabled = true;
    private bool _aiJobsEnabled = false;
    private DateTime _settingsUpdatedAt;
    private string _settingsUpdatedBy = string.Empty;

    // Per-toggle status messages — no shared field
    private string _registrationsStatusMessage = string.Empty;
    private Severity _registrationsStatusSeverity = Severity.Info;
    private string _aiJobsStatusMessage = string.Empty;
    private Severity _aiJobsStatusSeverity = Severity.Info;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadContext(), LoadPlatformSettings());
    }

    // ── NFL Context methods ────────────────────────────────────────────────────
    private async Task LoadContext()
    {
        _contextLoading = true;
        try
        {
            var http = HttpFactory.CreateClient("AuthAPI");
            _context = await http.GetFromJsonAsync<NflContextDto>("api/v1/admin/nfl-context");
            if (_context is not null)
            {
                _overrideSeason = _context.OverrideSeason;
                _overrideWeek = _context.OverrideWeek;
            }
        }
        catch
        {
            _statusMessage = "Failed to load NFL context.";
            _statusSeverity = Severity.Error;
        }
        finally { _contextLoading = false; }
    }

    private async Task SetOverride()
    {
        _saving = true;
        _statusMessage = string.Empty;
        try
        {
            var http = HttpFactory.CreateClient("AuthAPI");
            var response = await http.PostAsJsonAsync("api/v1/admin/nfl-context",
                new { Season = _overrideSeason, Week = _overrideWeek });
            if (response.IsSuccessStatusCode)
            {
                _statusMessage = _overrideSeason.HasValue || _overrideWeek.HasValue
                    ? $"Override set: Season {_overrideSeason}, Week {_overrideWeek}"
                    : "Override cleared.";
                _statusSeverity = Severity.Success;
                await LoadContext();
            }
            else
            {
                _statusMessage = "Failed to set override.";
                _statusSeverity = Severity.Error;
            }
        }
        catch
        {
            _statusMessage = "Error contacting API.";
            _statusSeverity = Severity.Error;
        }
        finally { _saving = false; }
    }

    private async Task ClearOverride()
    {
        _saving = true;
        _statusMessage = string.Empty;
        try
        {
            var http = HttpFactory.CreateClient("AuthAPI");
            var response = await http.DeleteAsync("api/v1/admin/nfl-context");
            if (response.IsSuccessStatusCode)
            {
                _statusMessage = "Override cleared — reverting to calendar.";
                _statusSeverity = Severity.Success;
                _overrideSeason = null;
                _overrideWeek = null;
                await LoadContext();
            }
        }
        catch
        {
            _statusMessage = "Error contacting API.";
            _statusSeverity = Severity.Error;
        }
        finally { _saving = false; }
    }

    // ── Platform Settings methods ──────────────────────────────────────────────
    private async Task LoadPlatformSettings()
    {
        _settingsLoading = true;
        try
        {
            var http = HttpFactory.CreateClient("AuthAPI");
            var dto = await http.GetFromJsonAsync<PlatformSettingsDto>("api/v1/admin/platform-settings");
            if (dto is not null)
            {
                _registrationsEnabled = dto.RegistrationsEnabled;
                _aiJobsEnabled = dto.AiJobsEnabled;
                _settingsUpdatedAt = dto.UpdatedAt;
                _settingsUpdatedBy = dto.UpdatedBy;
            }
        }
        catch
        {
            _registrationsStatusMessage = "Failed to load platform settings.";
            _registrationsStatusSeverity = Severity.Error;
        }
        finally { _settingsLoading = false; }
    }

    private async Task SaveRegistrationsEnabled()
    {
        _settingsSaving = true;
        _registrationsStatusMessage = string.Empty;
        try
        {
            var http = HttpFactory.CreateClient("AuthAPI");
            var response = await http.PutAsJsonAsync("api/v1/admin/platform-settings", new
            {
                RegistrationsEnabled = _registrationsEnabled,
                AiJobsEnabled = _aiJobsEnabled
            });
            if (response.IsSuccessStatusCode)
            {
                _registrationsStatusMessage = _registrationsEnabled
                    ? "Registrations opened."
                    : "Registrations closed. New sign-ups are blocked.";
                _registrationsStatusSeverity = _registrationsEnabled ? Severity.Success : Severity.Warning;
                await LoadPlatformSettings();
            }
            else
            {
                _registrationsStatusMessage = "Failed to save settings.";
                _registrationsStatusSeverity = Severity.Error;
            }
        }
        catch
        {
            _registrationsStatusMessage = "Error contacting API.";
            _registrationsStatusSeverity = Severity.Error;
        }
        finally { _settingsSaving = false; }
    }

    private async Task SaveAiJobsEnabled()
    {
        _settingsSaving = true;
        _aiJobsStatusMessage = string.Empty;
        try
        {
            var http = HttpFactory.CreateClient("AuthAPI");
            var response = await http.PutAsJsonAsync("api/v1/admin/platform-settings", new
            {
                RegistrationsEnabled = _registrationsEnabled,
                AiJobsEnabled = _aiJobsEnabled
            });
            if (response.IsSuccessStatusCode)
            {
                _aiJobsStatusMessage = _aiJobsEnabled
                    ? "AI jobs enabled. Article generation and War Room Brief will run on schedule."
                    : "AI jobs disabled. Scheduled AI jobs will be skipped.";
                _aiJobsStatusSeverity = _aiJobsEnabled ? Severity.Success : Severity.Warning;
                await LoadPlatformSettings();
            }
            else
            {
                _aiJobsStatusMessage = "Failed to save settings.";
                _aiJobsStatusSeverity = Severity.Error;
            }
        }
        catch
        {
            _aiJobsStatusMessage = "Error contacting API.";
            _aiJobsStatusSeverity = Severity.Error;
        }
        finally { _settingsSaving = false; }
    }

    // ── DTOs ───────────────────────────────────────────────────────────────────
    private record NflContextDto(
        int CalendarSeason, int CalendarWeek,
        int? OverrideSeason, int? OverrideWeek,
        bool IsOverrideActive, DateTime UpdatedAt, string UpdatedBy);

    private record PlatformSettingsDto(
        bool RegistrationsEnabled,
        bool AiJobsEnabled,
        DateTime UpdatedAt,
        string UpdatedBy);
}