@page "/admin/users"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>Users — Admin — FantasyCombine.AI</PageTitle>

<div class="fc-page-header mb-4">
    <MudText Typo="Typo.h5" Class="fc-page-title" Style="color: var(--fc-amber);">
        <MudIcon Icon="@Icons.Material.Filled.People" Class="mr-2" Style="vertical-align:middle;" />
        User Management
    </MudText>
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Warning" Class="mb-4" />
}
else if (_users.Count == 0)
{
    <MudAlert Severity="Severity.Info">No users found.</MudAlert>
}
else
{
    <MudPaper Class="fc-admin-table-paper" Elevation="0">
        <MudTable Items="@_users" Dense="true" Hover="true" Class="fc-table">
            <HeaderContent>
                <MudTh>Email</MudTh>
                <MudTh>Name</MudTh>
                <MudTh>Sleeper</MudTh>
                <MudTh>Roles</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Email</MudTd>
                <MudTd>@context.FirstName @context.LastName</MudTd>
                <MudTd>
                    @if (context.IsSleeperLinked)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success">Linked</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Default">Not linked</MudChip>
                    }
                </MudTd>
                <MudTd>
                    @foreach (var role in context.Roles)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">@role</MudChip>
                    }
                </MudTd>
                <MudTd>
                    @if (!context.Roles.Contains("Admin"))
                    {
                        <MudButton Size="Size.Small"
                                   Variant="Variant.Outlined"
                                   Color="Color.Warning"
                                   OnClick="@(() => MakeAdmin(context.Email))">
                            Make Admin
                        </MudButton>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@code {
    private List<UserRow> _users = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _users = await Http.GetFromJsonAsync<List<UserRow>>("api/v1/admin/users") ?? [];
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load users: {ex.Message}", Severity.Error);
        }
        finally { _loading = false; }
    }

    private async Task MakeAdmin(string email)
    {
        var resp = await Http.PostAsync($"api/v1/admin/users/{email}/make-admin", null);
        if (resp.IsSuccessStatusCode)
        {
            Snackbar.Add($"{email} is now an Admin.", Severity.Success);
            await OnInitializedAsync();
        }
        else
            Snackbar.Add("Failed to assign Admin role.", Severity.Error);
    }

    private record UserRow(
        string Id, string Email,
        string FirstName, string LastName,
        bool IsSleeperLinked,
        List<string> Roles);
}