@page "/writers-room/writer/{PersonaId}"
@page "/writers-room/writer"
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text.Json.Serialization
@using FF.Domain.Documents
@using FF.Domain.Enums
@using Microsoft.JSInterop
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>@(_writerName == string.Empty ? "Writer Archive" : _writerName) — Writers' Room</PageTitle>

@* ── Back link ── *@
<div class="mb-3">
    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
               Href="/writers-room">
        Writers' Room
    </MudButton>
</div>

<div class="fc-page-header mb-4">
    <MudText Typo="Typo.h5" Class="fc-page-title">
        <MudIcon Icon="@Icons.Material.Filled.Person" Class="mr-2" Style="vertical-align:middle;" />
        @(_writerName == string.Empty ? "Loading..." : _writerName)
    </MudText>
    @if (!string.IsNullOrEmpty(_writerRole))
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">@_writerRole</MudText>
    }
</div>

@* ── Filter bar ── *@
<MudPaper Class="pa-3 mb-4" Elevation="1">
    <MudGrid Spacing="2" AlignItems="Center">
        <MudItem xs="12" sm="3">
            <MudSelect T="string" Value="@PersonaId"
                       ValueChanged="OnWriterChanged"
                       Label="Writer"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="string" Value="@("all")">All Writers</MudSelectItem>
                <MudSelectItem T="string" Value="@("sam-caruso")">Sam Caruso</MudSelectItem>
                <MudSelectItem T="string" Value="@("joseph-reed")">Joseph Reed</MudSelectItem>
                <MudSelectItem T="string" Value="@("diana-park")">Diana Park</MudSelectItem>
                <MudSelectItem T="string" Value="@("marcus-webb")">Marcus Webb</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudSelect T="int?" Value="_filterSeason"
                       ValueChanged="@(v => _filterSeason = v)"
                       Label="Year Published"
                       Variant="Variant.Outlined" Margin="Margin.Dense"
                       Clearable="true" Placeholder="All years">
                <MudSelectItem T="int?" Value="@((int?)2026)">2026</MudSelectItem>
                <MudSelectItem T="int?" Value="@((int?)2025)">2025</MudSelectItem>
                <MudSelectItem T="int?" Value="@((int?)2024)">2024</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudSelect T="int?" Value="_filterMonth"
                       ValueChanged="@(v => _filterMonth = v)"
                       Label="Month"
                       Variant="Variant.Outlined" Margin="Margin.Dense"
                       Clearable="true" Placeholder="All months">
                @foreach (var m in _months)
                {
                    <MudSelectItem T="int?" Value="@((int?)m.Num)">@m.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="3" Class="d-flex align-center">
            <MudButton FullWidth="true" Variant="Variant.Outlined" Color="Color.Primary"
                       OnClick="@(async () => await ApplyFilter())"
                       StartIcon="@Icons.Material.Filled.FilterList">
                Filter
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else if (!string.IsNullOrEmpty(_errorMessage))
{
    <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
}
else if (_articles.Count == 0)
{
    <MudAlert Severity="Severity.Info">No published articles found.</MudAlert>
}
else
{
    @foreach (var article in _articles)
    {
        <MudPaper Class="pa-5 mb-4" Elevation="2" Style="max-width: 820px;">
            <div class="d-flex align-center justify-space-between mb-2">
                <div class="d-flex align-center gap-2">
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">
                        @article.PersonaName
                    </MudChip>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Week @article.Week, @article.Season
                        &nbsp;·&nbsp;
                        @article.GeneratedAt.ToString("MMM d, yyyy")
                    </MudText>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Share"
                               Size="Size.Small"
                               Title="Copy share link"
                               OnClick="@(() => CopyShareLink(article.Id))" />
            </div>
            <MudText Typo="Typo.h5" Class="mb-3" Style="font-weight: 700; line-height: 1.3;">
                @article.Title
            </MudText>
            <div class="writers-room-body">
                @((MarkupString)(article.Body ?? string.Empty))
            </div>
            <MudDivider Class="my-3" />
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                👍 @article.ThumbsUp &nbsp; 👎 @article.ThumbsDown
            </MudText>
        </MudPaper>
    }
}

@code {
    [Parameter] public string PersonaId { get; set; } = string.Empty;
    [Inject] IHttpClientFactory HttpFactory { get; set; } = default!;
    [Inject] IJSRuntime JS { get; set; } = default!;

    private static readonly JsonSerializerOptions _jsonOptions = new()
    {
        Converters = { new JsonStringEnumConverter() },
        PropertyNameCaseInsensitive = true
    };

    private List<ArticleDocument> _articles = [];
    private string _writerName = string.Empty;
    private string _writerRole = string.Empty;
    private int? _filterSeason;
    private int? _filterMonth;
    private bool _loading;
    private string _errorMessage = string.Empty;
    private string _lastPersonaId = string.Empty;

    private readonly List<int> _seasons = [2026, 2025, 2024];
    private readonly List<(int Num, string Name)> _months =
    [
        (1, "January"), (2, "February"), (3, "March"), (4, "April"),
        (5, "May"), (6, "June"), (7, "July"), (8, "August"),
        (9, "September"), (10, "October"), (11, "November"), (12, "December")
    ];

    protected override async Task OnParametersSetAsync()
    {
        var effectiveId = string.IsNullOrEmpty(PersonaId) ? "all" : PersonaId;
        if (effectiveId == _lastPersonaId) return;
        _lastPersonaId = effectiveId;
        PersonaId = effectiveId;
        await LoadAsync();
    }

    private async Task OnWriterChanged(string newPersonaId)
    {
        // Navigate to the new writer's page — OnParametersSetAsync handles the load
        Nav.NavigateTo($"/writers-room/writer/{newPersonaId}");
    }

    private async Task ApplyFilter() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _errorMessage = string.Empty;
        _articles = [];
        StateHasChanged();

        try
        {
            var http = HttpFactory.CreateClient("AuthAPI");

            // "all" is a special sentinel — hit the latest endpoint instead
            string url;
            if (PersonaId == "all")
            {
                url = "api/v1/articles/latest?count=50";
                _writerName = "All Writers";
                _writerRole = string.Empty;
            }
            else
            {
                url = $"api/v1/articles/writer/{PersonaId}";
            }

            var qs = new List<string>();
            if (_filterSeason.HasValue) qs.Add($"season={_filterSeason}");
            if (_filterMonth.HasValue) qs.Add($"month={_filterMonth}");
            if (qs.Count > 0) url += (url.Contains('?') ? "&" : "?") + string.Join("&", qs);

            _articles = await http.GetFromJsonAsync<List<ArticleDocument>>(
                url, _jsonOptions) ?? [];

            if (_articles.Count > 0 && PersonaId != "all")
            {
                _writerName = _articles[0].PersonaName;
                _writerRole = _articles[0].Role;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Could not load articles: {ex.Message}";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task CopyShareLink(string articleId)
    {
        var url = $"{Nav.BaseUri}writers-room/article/{articleId}";
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
        Snackbar.Add("Share link copied!", Severity.Success, config =>
        {
            config.VisibleStateDuration = 2500;
            config.ShowCloseIcon = false;
        });
    }
}