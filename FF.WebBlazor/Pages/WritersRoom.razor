@page "/writers-room"
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text.Json.Serialization
@using FF.Domain.Documents
@using FF.Domain.Enums
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Writers' Room — FantasyCombine.AI</PageTitle>

<div class="fc-page-header mb-4">
    <MudText Typo="Typo.h5" Class="fc-page-title">
        <MudIcon Icon="@Icons.Material.Filled.AutoStories" Class="mr-2" Style="vertical-align:middle;" />
        Writers' Room
    </MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary">
        Weekly analysis from Sam, Joseph, Diana, and Marcus — updated every Tuesday.
    </MudText>
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else if (_articles.Count == 0)
{
    <MudAlert Severity="Severity.Info">No articles published yet. Check back after Tuesday.</MudAlert>
}
else
{
    @foreach (var article in _articles)
    {
        <MudPaper Class="pa-5 mb-5" Elevation="2" Style="max-width: 820px;">

            @* ── Byline ── *@
            <div class="d-flex align-center justify-space-between mb-3">
                <div class="d-flex align-center gap-2">
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">
                        @article.PersonaName
                    </MudChip>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @article.Role &nbsp;·&nbsp; Week @article.Week, @article.Season &nbsp;·&nbsp; @article.GeneratedAt.ToString("MMM d")
                    </MudText>
                </div>
                @* Share button *@
                <MudIconButton Icon="@Icons.Material.Filled.Share"
                               Size="Size.Small"
                               Title="Copy share link"
                               OnClick="@(() => CopyShareLink(article.Id))" />
            </div>

            @* ── Title ── *@
            <MudText Typo="Typo.h5" Class="mb-3" Style="font-weight: 700; line-height: 1.3;">
                @article.Title
            </MudText>

            @* ── Body — rendered as HTML ── *@
            <div class="writers-room-body">
                @((MarkupString)(article.Body ?? string.Empty))
            </div>

            @* ── Ratings ── *@
            <MudDivider Class="my-3" />
        @* Rating bar *@
        <div class="d-flex align-center justify-space-between">
            <div class="d-flex align-center gap-3">
                @if (_isAuthenticated)
                {
                    @if (_myRatings.TryGetValue(article.Id, out var myRating))
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            You rated: @(myRating ? "👍" : "👎")
                        </MudText>
                    }
                    else
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.ThumbUp"
                                       Color="Color.Success" Size="Size.Small"
                                       OnClick="@(() => Rate(article.Id, true))"
                                       Disabled="_rating.Contains(article.Id)" />
                        <MudIconButton Icon="@Icons.Material.Filled.ThumbDown"
                                       Color="Color.Error" Size="Size.Small"
                                       OnClick="@(() => Rate(article.Id, false))"
                                       Disabled="_rating.Contains(article.Id)" />
                    }
                }
                else
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        <MudLink Href="/login">Log in</MudLink> to rate
                    </MudText>
                }
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    👍 @article.ThumbsUp &nbsp; 👎 @article.ThumbsDown
                </MudText>
            </div>
            <MudLink Href="@($"/writers-room/writer/{article.PersonaId}")"
                     Typo="Typo.caption" Color="Color.Primary">
                More from @article.PersonaName →
            </MudLink>
        </div>
        </MudPaper>
    }
}

@code {
    [Inject] IHttpClientFactory HttpFactory { get; set; } = default!;
    [Inject] IJSRuntime JS { get; set; } = default!;

    private static readonly JsonSerializerOptions _jsonOptions = new()
    {
        Converters = { new JsonStringEnumConverter() },
        PropertyNameCaseInsensitive = true
    };

    private List<ArticleDocument> _articles = [];
    private Dictionary<string, bool> _myRatings = [];
    private HashSet<string> _rating = [];
    private string? _copiedId;
    private bool _loading = true;
    private bool _isAuthenticated;

    protected override async Task OnInitializedAsync()
    {
         var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;

        _loading = true;
        try
        {
            var http = HttpFactory.CreateClient("AuthAPI");
            _articles = await http.GetFromJsonAsync<List<ArticleDocument>>(
                "api/v1/articles/latest?count=20", _jsonOptions) ?? [];

            foreach (var article in _articles)
            {
                try
                {
                    var rating = await http.GetFromJsonAsync<MyRatingDto>(
                        $"api/v1/articles/{article.Id}/my-rating", _jsonOptions);
                    if (rating?.HasRated == true && rating.IsThumbsUp.HasValue)
                        _myRatings[article.Id] = rating.IsThumbsUp.Value;
                }
                catch { }
            }
        }
        finally { _loading = false; }
    }

    private async Task Rate(string articleId, bool thumbsUp)
    {
        _rating.Add(articleId);
        try
        {
            var http = HttpFactory.CreateClient("AuthAPI");
            var resp = await http.PostAsJsonAsync(
                $"api/v1/articles/{articleId}/rate", new { IsThumbsUp = thumbsUp });
            if (resp.IsSuccessStatusCode)
            {
                _myRatings[articleId] = thumbsUp;
                var article = _articles.FirstOrDefault(a => a.Id == articleId);
                if (article is not null)
                {
                    if (thumbsUp) article.ThumbsUp++;
                    else article.ThumbsDown++;
                }
            }
        }
        finally { _rating.Remove(articleId); }
    }

    private async Task CopyShareLink(string articleId)
    {
        var url = $"{Nav.BaseUri}writers-room/article/{articleId}";
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
        Snackbar.Add("Share link copied to clipboard!", Severity.Success, config =>
        {
            config.VisibleStateDuration = 2500;
            config.HideTransitionDuration = 500;
            config.ShowCloseIcon = false;
        });
    }
    private record MyRatingDto(bool HasRated, bool? IsThumbsUp);
}