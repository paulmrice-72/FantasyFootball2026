    private async Task OnTabChanged(int index)
    {
        _activeTab = index;
        if (index == 1 && _startSitData is null) await LoadStartSitAsync();
        if (index == 2 && _depthGrades is null) await LoadDepthGradesAsync();
        if (index == 3 && _dynastyGrade is null) await LoadDynastyGradeAsync();
    }

    private async Task LoadStartSitAsync()
    {
        _startSitLoading = true;
        StateHasChanged();
        try
        {
            var leagueId = LeagueState.ActiveLeagueId;
            if (string.IsNullOrEmpty(leagueId)) return;

            var week = GetCurrentNflWeek();
            var season = DateTime.UtcNow.Month >= 3 ? DateTime.UtcNow.Year : DateTime.UtcNow.Year - 1;

            var response = await Http.GetAsync(
                $"api/v1/team/start-sit?sleeperLeagueId={leagueId}&season={season}&week={week}");

            if (response.IsSuccessStatusCode)
                _startSitData = await response.Content.ReadFromJsonAsync<StartSitRecommendationsDto>(_enumJsonOptions);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading Start/Sit: {ex.Message}", Severity.Error);
        }
        finally
        {
            _startSitLoading = false;
        }
    }

