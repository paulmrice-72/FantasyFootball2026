@page "/my-team"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject LeagueStateService LeagueState
@implements IDisposable

<PageTitle>My Team — FantasyCombine.AI</PageTitle>

<div class="fc-page-header mb-4">
    <MudText Typo="Typo.h5" Class="fc-page-title">
        <MudIcon Icon="@Icons.Material.Filled.Groups" Class="mr-2" Style="vertical-align:middle;" />
        My Team
    </MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary">
        @if (_roster is not null)
        {
            <span>@_roster.TeamName · @_roster.Wins–@_roster.Losses</span>
        }
    </MudText>
</div>
@* ── TABS ───────────────────────────────────────────── *@
<MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true"
         Class="fc-tabs mt-2"
         ActivePanelIndexChanged="OnTabChanged">

    <MudTabPanel Text="Roster">
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4 mt-2" />
        }
        else if (_noSleeper)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4 mt-2">
                No Sleeper account linked. <MudLink Href="/settings/sleeper">Link your Sleeper account</MudLink>.
            </MudAlert>
        }
        else if (_noLeague)
        {
            <MudAlert Severity="Severity.Info" Class="mb-4 mt-2">
                No active league found. Import from <MudLink Href="/settings/sleeper">Sleeper settings</MudLink>.
            </MudAlert>
        }
        else if (_roster is null)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4 mt-2">
                Roster not found. Try syncing your league.
            </MudAlert>
        }
        else
        {
            @foreach (var group in _roster.Players
                            .GroupBy(p => p.Position)
                            .OrderBy(g => PositionOrder(g.Key)))
            {
                <MudText Typo="Typo.subtitle1" Class="mb-2 mt-4"
                         Style="color:var(--fc-cyan);font-weight:600;">
                    @group.Key
                </MudText>
                <MudPaper Elevation="0" Class="fc-table-paper mb-2">
                    <MudTable Items="@group.ToList()" Dense="true" Hover="true" Class="fc-table">
                        <HeaderContent>
                            <MudTh>Player</MudTh>
                            <MudTh>Team</MudTh>
                            <MudTh>Age</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh>Proj Pts</MudTh>
                            <MudTh>Bye</MudTh>
                            <MudTh>Role</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <MudText Typo="Typo.body2" Style="font-weight:600;">
                                    @context.PlayerName
                                </MudText>
                            </MudTd>
                            <MudTd><MudText Typo="Typo.body2">@context.NflTeam</MudText></MudTd>
                            <MudTd><MudText Typo="Typo.body2">@(context.Age?.ToString() ?? "—")</MudText></MudTd>
                            <MudTd>
                                @if (!string.IsNullOrEmpty(context.InjuryDesignation))
                                {
                                    <MudChip T="string" Size="Size.Small"
                                             Color="@InjuryColor(context.InjuryDesignation)"
                                             Variant="Variant.Filled">
                                        @context.InjuryDesignation
                                    </MudChip>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Active</MudText>
                                }
                            </MudTd>
                            <MudTd>
                                <MudText Typo="Typo.body2" Class="fc-stat"
                                         Style="font-family:'JetBrains Mono',monospace;">
                                    @(context.MedianProjectedPoints.HasValue
                                        ? context.MedianProjectedPoints.Value.ToString("F1") : "—")
                                </MudText>
                            </MudTd>
                            <MudTd>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">—</MudText>
                            </MudTd>
                            <MudTd>
                                @if (context.IsStarter)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary"
                                             Variant="Variant.Text">Starter</MudChip>
                                }
                                else if (context.IsOnIr)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Error"
                                             Variant="Variant.Text">IR</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default"
                                             Variant="Variant.Text">Bench</MudChip>
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            }

            @* Optimize My Lineup panel — unchanged from TEAM-002 *@
            <MudPaper Class="fc-card pa-4 mt-4" Elevation="0">
                <div class="d-flex align-center mb-3">
                    <MudText Typo="Typo.subtitle2" Class="fc-section-label">OPTIMIZE MY LINEUP</MudText>
                    <MudSpacer />
                    @if (_lineupResult is not null)
                    {
                        <MudChip T="string" Color="Color.Primary" Size="Size.Small" Class="fc-stat">
                            @_lineupResult.TotalProjectedPoints.ToString("F1") pts projected
                        </MudChip>
                    }
                </div>
                <MudGrid Spacing="2" Class="mb-3">
                    <MudItem xs="6" sm="4">
                        <MudSelect T="string" @bind-Value="_optimizerMode" Label="Score Mode"
                                   Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem Value="@("Median")">Median</MudSelectItem>
                            <MudSelectItem Value="@("Floor")">Floor</MudSelectItem>
                            <MudSelectItem Value="@("Ceiling")">Ceiling</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="6" sm="4">
                        <MudSelect T="string" @bind-Value="_optimizerRisk" Label="Risk Profile"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                            <MudSelectItem T="string" Value="@("Safe")">Safe — high floor</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Ceiling")">Ceiling — max upside</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Contrarian")">Contrarian</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="4" Class="d-flex align-end">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.AutoAwesome"
                                   FullWidth="true" Disabled="@_optimizing"
                                   OnClick="@(() => _ = OptimizeMyLineupAsync())"
                                   Style="height:40px;">
                            @if (_optimizing)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true"
                                                     Class="mr-2" Color="Color.Surface" />
                                <span>Optimizing...</span>
                            }
                            else
                            {

                                <span>Optimize My Lineup</span>
                            }
                        </MudButton>
                    </MudItem>
                </MudGrid>
                @if (_optimizerError is not null)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                        @_optimizerError
                    </MudAlert>
                }
                @if (_lineupResult is not null)
                {
                    @foreach (var slotType in new[] { "QB", "RB", "WR", "TE", "FLEX" })
                    {
                        var slots = _lineupResult.Lineup.Where(s => s.SlotType == slotType).ToList();
                        if (!slots.Any()) continue;
                        <div class="fc-slot-group mb-2">
                            <MudText Typo="Typo.overline" Class="fc-slot-label">@slotType</MudText>
                            @foreach (var slot in slots)
                            {
                                <div class="fc-lineup-slot">
                                    <div class="fc-slot-pos-badge @PositionClass(slot.Position)">
                                        @slot.Position
                                    </div>
                                    <div class="fc-slot-info">
                                        <MudText Typo="Typo.body1" Style="font-weight:700;">
                                            @slot.PlayerName
                                        </MudText>
                                    </div>
                                    <div class="fc-slot-pts">
                                        <MudText Typo="Typo.h6" Class="fc-stat fc-cyan">
                                            @slot.ProjectedPoints.ToString("F1")
                                        </MudText>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">proj</MudText>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    <MudDivider Class="my-3" />
                    <div class="d-flex justify-space-between align-center">
                        <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">TOTAL PROJECTED</MudText>
                        <MudText Typo="Typo.h5" Class="fc-stat fc-cyan">
                            @_lineupResult.TotalProjectedPoints.ToString("F1")
                        </MudText>
                    </div>
                }
            </MudPaper>
        }
    </MudTabPanel>

    <MudTabPanel Text="Start / Sit">
        @if (_startSitLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4 mt-2" />
        }
        else if (_startSitData is null)
        {
            <MudAlert Severity="Severity.Info" Class="mt-2">
                No start/sit decisions needed — your roster doesn't have contested positions,
                or simulation data is unavailable.
            </MudAlert>
        }
        else if (_startSitData.Decisions.Count == 0)
        {
            <MudAlert Severity="Severity.Success" Class="mt-2">
                No tough decisions this week — your starters are clear.
            </MudAlert>
        }
        else
        {
            @foreach (var decision in _startSitData.Decisions)
            {
                <MudText Typo="Typo.subtitle2" Class="fc-section-label mb-2 mt-4">
                    @decision.SlotLabel DECISION
                </MudText>
                <MudPaper Elevation="0" Class="fc-card pa-3 mb-3">
                    @foreach (var opt in decision.Options)
                    {
                        <div class="d-flex align-center pa-2 mb-1"
                             style="border-radius:6px; background: var(--mud-palette-surface);">

                            @* Verdict badge *@
                            <div style="min-width:90px;">
                                <MudChip T="string"
                                         Color="@VerdictColor(opt.Verdict)"
                                         Size="Size.Small"
                                         Variant="Variant.Filled">
                                    @VerdictLabel(opt.Verdict)
                                </MudChip>
                            </div>

                            @* Player info *@
                            <div class="flex-grow-1 mx-3">
                                <div class="d-flex align-center gap-2">
                                    <MudText Typo="Typo.body1" Style="font-weight:700;">
                                        @opt.PlayerName
                                    </MudText>
                                    <MudChip T="string" Size="Size.Small"
                                             Class="@PositionClass(opt.Position)"
                                             Variant="Variant.Filled">
                                        @opt.Position
                                    </MudChip>
                                    @if (!string.IsNullOrEmpty(opt.InjuryDesignation))
                                    {
                                        <MudChip T="string" Size="Size.Small"
                                                 Color="@InjuryColor(opt.InjuryDesignation)"
                                                 Variant="Variant.Filled">
                                            @opt.InjuryDesignation
                                        </MudChip>
                                    }
                                </div>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    @opt.Rationale
                                </MudText>
                            </div>

                            @* Stats *@
                            <div class="text-right" style="min-width:140px;">
                                <div class="d-flex gap-3 justify-end">
                                    <div class="text-center">
                                        <MudText Typo="Typo.body2" Class="fc-stat fc-cyan">
                                            @opt.Median.ToString("F1")
                                        </MudText>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">med</MudText>
                                    </div>
                                    <div class="text-center">
                                        <MudText Typo="Typo.body2" Class="fc-stat">
                                            @opt.Floor.ToString("F1")
                                        </MudText>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">flr</MudText>
                                    </div>
                                    <div class="text-center">
                                        <MudText Typo="Typo.body2" Class="fc-stat fc-ceiling">
                                            @opt.Ceiling.ToString("F1")
                                        </MudText>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">ceil</MudText>
                                    </div>
                                </div>
                                <div class="mt-1">
                                    <MudProgressLinear Value="@opt.ConfidenceScore"
                                                       Color="@VerdictColor(opt.Verdict)"
                                                       Size="Size.Small" Rounded="true" />
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        @opt.ConfidenceLabel confidence
                                    </MudText>
                                </div>
                            </div>
                        </div>
                    }
                </MudPaper>
            }
        }
    </MudTabPanel>

</MudTabs>
@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else if (_noSleeper)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        No Sleeper account linked.
        <MudLink Href="/settings/sleeper">Link your Sleeper account</MudLink> to view your roster.
    </MudAlert>
}
else if (_noLeague)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">
        No active league found. Import a league from
        <MudLink Href="/settings/sleeper">Sleeper settings</MudLink>.
    </MudAlert>
}
else if (_roster is null)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        Roster not found for this league. Try syncing your league.
    </MudAlert>
}
else
{
    @* ── POSITION GROUPS ───────────────────────────────── *@
    @foreach (var group in _roster.Players.GroupBy(p => p.Position).OrderBy(g => PositionOrder(g.Key)))
    {
        <MudText Typo="Typo.subtitle1" Class="mb-2 mt-4"
                 Style="color:var(--fc-cyan);font-weight:600;">
            @group.Key
        </MudText>
        <MudPaper Elevation="0" Class="fc-table-paper mb-2">
            <MudTable Items="@group.ToList()" Dense="true" Hover="true" Class="fc-table">
                <HeaderContent>
                    <MudTh>Player</MudTh>
                    <MudTh>Team</MudTh>
                    <MudTh>Age</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Proj Pts</MudTh>
                    <MudTh>Bye</MudTh>
                    <MudTh>Role</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <MudText Typo="Typo.body2" Style="font-weight:600;">
                            @context.PlayerName
                        </MudText>
                    </MudTd>
                    <MudTd>
                        <MudText Typo="Typo.body2">@context.NflTeam</MudText>
                    </MudTd>
                    <MudTd>
                        <MudText Typo="Typo.body2">@(context.Age?.ToString() ?? "—")</MudText>
                    </MudTd>
                    <MudTd>
                        @if (!string.IsNullOrEmpty(context.InjuryDesignation))
                        {
                            <MudChip T="string" Size="Size.Small"
                                     Color="@InjuryColor(context.InjuryDesignation)"
                                     Variant="Variant.Filled">
                                @context.InjuryDesignation
                            </MudChip>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Active</MudText>
                        }
                    </MudTd>
                    <MudTd>
                        <MudText Typo="Typo.body2" Class="fc-stat"
                                 Style="font-family:'JetBrains Mono',monospace;">
                            @(context.MedianProjectedPoints.HasValue
                                ? context.MedianProjectedPoints.Value.ToString("F1")
                                : "—")
                        </MudText>
                    </MudTd>
                    <MudTd>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">—</MudText>
                    </MudTd>
                    <MudTd>
                        @if (context.IsStarter)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary"
                                     Variant="Variant.Text">Starter</MudChip>
                        }
                        else if (context.IsOnIr)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error"
                                     Variant="Variant.Text">IR</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default"
                                     Variant="Variant.Text">Bench</MudChip>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
}
@* ── TEAM-002: OPTIMIZE MY LINEUP ──────────────────────── *@
@if (_roster is not null)
{
    <MudPaper Class="fc-card pa-4 mt-4" Elevation="0">
        <div class="d-flex align-center mb-3">
            <MudText Typo="Typo.subtitle2" Class="fc-section-label">OPTIMIZE MY LINEUP</MudText>
            <MudSpacer />
            @if (_lineupResult is not null)
            {
                <MudChip T="string" Color="Color.Primary" Size="Size.Small" Class="fc-stat">
                    @_lineupResult.TotalProjectedPoints.ToString("F1") pts projected
                </MudChip>
            }
        </div>

        <MudGrid Spacing="2" Class="mb-3">
            <MudItem xs="6" sm="4">
                <MudSelect T="string" @bind-Value="_optimizerMode" Label="Score Mode"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem Value="@("Median")">Median</MudSelectItem>
                    <MudSelectItem Value="@("Floor")">Floor</MudSelectItem>
                    <MudSelectItem Value="@("Ceiling")">Ceiling</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="6" sm="4">
                <MudSelect T="string" @bind-Value="_optimizerRisk" Label="Risk Profile"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                    <MudSelectItem T="string" Value="@("Safe")">Safe — high floor</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Ceiling")">Ceiling — max upside</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Contrarian")">Contrarian</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4" Class="d-flex align-end">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.AutoAwesome"
                           FullWidth="true" Disabled="@_optimizing"
                           OnClick="@(() => _ = OptimizeMyLineupAsync())"
                           Style="height:40px;">
                    @if (_optimizing)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true"
                                             Class="mr-2" Color="Color.Surface" />
                        <span>Optimizing...</span>
                    }
                    else
                    {
                        <span>Optimize My Lineup</span>
                    }
                </MudButton>
            </MudItem>
        </MudGrid>

        @if (_optimizerError is not null)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">@_optimizerError</MudAlert>
        }

        @if (_lineupResult is not null)
        {
            @foreach (var slotType in new[] { "QB", "RB", "WR", "TE", "FLEX" })
            {
                var slots = _lineupResult.Lineup
                    .Where(s => s.SlotType == slotType)
                    .ToList();
                if (!slots.Any()) continue;

                <div class="fc-slot-group mb-2">
                    <MudText Typo="Typo.overline" Class="fc-slot-label">@slotType</MudText>
                    @foreach (var slot in slots)
                    {
                        <div class="fc-lineup-slot">
                            <div class="fc-slot-pos-badge @PositionClass(slot.Position)">
                                @slot.Position
                            </div>
                            <div class="fc-slot-info">
                                <MudText Typo="Typo.body1" Style="font-weight:700;">
                                    @slot.PlayerName
                                </MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    @slot.Position
                                </MudText>
                            </div>
                            <div class="fc-slot-pts">
                                <MudText Typo="Typo.h6" Class="fc-stat fc-cyan">
                                    @slot.ProjectedPoints.ToString("F1")
                                </MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">proj</MudText>
                            </div>
                        </div>
                    }
                </div>
            }

            <MudDivider Class="my-3" />
            <div class="d-flex justify-space-between align-center">
                <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">TOTAL PROJECTED</MudText>
                <MudText Typo="Typo.h5" Class="fc-stat fc-cyan">
                    @_lineupResult.TotalProjectedPoints.ToString("F1")
                </MudText>
            </div>
        }
    </MudPaper>
}
@code {
    private bool _loading = true;
    private bool _noSleeper;
    private bool _noLeague;
    private MyRosterDto? _roster;

    private HttpClient Http => HttpClientFactory.CreateClient("AuthAPI");

    // ── TEAM-002: Lineup Optimizer ─────────────────────────
    private bool _optimizing;
    private string? _optimizerError;
    private OptimizerResult? _lineupResult;
    private string _optimizerMode = "Median";
    private string _optimizerRisk = "";
    // ── TEAM-004: Start/Sit ────────────────────────────────
    private int _activeTab;
    private bool _startSitTabActive;
    private bool _startSitLoading;
    private StartSitRecommendationsDto? _startSitData;

    private async Task OptimizeMyLineupAsync()
    {
        if (_roster is null) return;
        _optimizing = true;
        _optimizerError = null;
        _lineupResult = null;
        StateHasChanged();

        try
        {
            var leagueId = LeagueState.ActiveLeagueId;
            var week = GetCurrentNflWeek();
            var season = DateTime.UtcNow.Month >= 3 ? DateTime.UtcNow.Year : DateTime.UtcNow.Year - 1;
            var riskParam = string.IsNullOrEmpty(_optimizerRisk) ? "" : $"&riskProfile={_optimizerRisk}";
            var url = $"api/v1/team/optimize-lineup?sleeperLeagueId={leagueId}&season={season}&week={week}&mode={_optimizerMode}{riskParam}";

            var response = await Http.PostAsync(url, null);
            if (response.IsSuccessStatusCode)
            {
                _lineupResult = await response.Content.ReadFromJsonAsync<OptimizerResult>();
                Snackbar.Add($"Lineup optimized — {_lineupResult?.TotalProjectedPoints:F1} pts projected.", Severity.Success);
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                _optimizerError = err.Contains("NoRosterData")
                    ? "No simulation data found for your roster. Re-run simulations with SleeperPlayerId stamped."
                    : $"Optimizer error: {err}";
            }
        }
        catch (Exception ex)
        {
            _optimizerError = $"Failed: {ex.Message}";
        }
        finally
        {
            _optimizing = false;
        }
    }

    private static int GetCurrentNflWeek()
    {
        var now = DateTime.UtcNow;
        var season = now.Month >= 3 ? now.Year : now.Year - 1;
        var sept1 = new DateTime(season, 9, 1, 0, 0, 0, DateTimeKind.Utc);
        var daysUntilThursday = ((int)DayOfWeek.Thursday - (int)sept1.DayOfWeek + 7) % 7;
        var seasonStart = sept1.AddDays(daysUntilThursday);
        if (now < seasonStart) return 18;
        var week = (int)((now - seasonStart).TotalDays / 7) + 1;
        return Math.Clamp(week, 1, 18);
    }

    // ── DTOs ────────────────────────────────────────────────
    private record OptimizerResult(
        bool Success,
        List<OptimizedSlot> Lineup,
        decimal TotalProjectedPoints,
        string Mode,
        string? RiskProfile);

    private record OptimizedSlot(
        string PlayerId,
        string PlayerName,
        string Position,
        string SlotType,
        decimal ProjectedPoints,
        decimal? RiskScore);

    private async Task LoadRosterAsync()
    {
        _loading = true;
        _noSleeper = false;
        _noLeague = false;
        _roster = null;

        try
        {
            var leagueId = LeagueState.ActiveLeagueId;

            if (string.IsNullOrEmpty(leagueId))
            {
                // Fall back to context fetch on first load
                var context = await Http.GetFromJsonAsync<UserContextResponse>(
                    "api/v1/identity/context");

                if (context?.IsSleeperLinked != true) { _noSleeper = true; return; }

                leagueId = context.ActiveLeagueId;
                if (string.IsNullOrEmpty(leagueId)) { _noLeague = true; return; }

                LeagueState.ActiveLeagueId = leagueId;
            }

            var response = await Http.GetAsync(
                $"api/v1/team/roster?sleeperLeagueId={leagueId}");

            if (response.IsSuccessStatusCode)
                _roster = await response.Content.ReadFromJsonAsync<MyRosterDto>();
            else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
                _noSleeper = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading roster: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        LeagueState.OnLeagueChanged += OnLeagueChangedHandler;
        await LoadRosterAsync();
    }

    private void OnLeagueChangedHandler()
    {
        _startSitData = null;  // reset so it reloads on next tab visit
        _ = InvokeAsync(async () => { await LoadRosterAsync(); StateHasChanged(); });
    }

    public void Dispose()
    {
        LeagueState.OnLeagueChanged -= OnLeagueChangedHandler;
    }
    private static int PositionOrder(string pos) => pos switch
    {
        "QB" => 0,
        "RB" => 1,
        "WR" => 2,
        "TE" => 3,
        "K" => 4,
        _ => 5
    };

    private static Color InjuryColor(string designation) => designation switch
    {
        "Out" => Color.Error,
        "D" => Color.Error,
        "IR" => Color.Error,
        "Q" => Color.Warning,
        "Doubtful" => Color.Warning,
        _ => Color.Default
    };

