@page "/my-team"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject LeagueStateService LeagueState
@inject NflContextClientService NflContext
@implements IDisposable
@inject IDialogService DialogService

<PageTitle>My Team — FantasyCombine.AI</PageTitle>

<div class="fc-page-header mb-4">
    <MudText Typo="Typo.h5" Class="fc-page-title">
        <MudIcon Icon="@Icons.Material.Filled.Groups" Class="mr-2" Style="vertical-align:middle;" />
        My Team
    </MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary">
        @if (_roster is not null)
        {
            <span>@_roster.TeamName · @_roster.Wins–@_roster.Losses</span>
        }
    </MudText>
</div>
@if (!string.IsNullOrEmpty(_teamName))
{
    <div class="d-flex align-center gap-3 mb-4">
        <div class="fc-league-avatar" style="width:48px;height:48px;border-radius:10px;">
            @if (!string.IsNullOrEmpty(_ownerAvatar))
            {
                <img src="@(OwnerAvatarUrl(_ownerAvatar))"
                     class="fc-league-avatar-img"
                     onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
                <div class="fc-league-avatar-fallback" style="display:none">
                    @(_teamName.Substring(0, Math.Min(2, _teamName.Length)).ToUpper())
                </div>
            }
            else
            {
                <div class="fc-league-avatar-fallback">
                    @(_teamName.Substring(0, Math.Min(2, _teamName.Length)).ToUpper())
                </div>
            }
        </div>
        <div>
            <MudText Typo="Typo.subtitle1" Style="font-weight:700;color:var(--fc-text);">
                @_teamName
            </MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                @_ownerName
            </MudText>
        </div>
    </div>
}
@* ── TABS ───────────────────────────────────────────── *@
<MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true"
         Class="fc-tabs mt-2"
         ActivePanelIndexChanged="OnTabChanged">

    <MudTabPanel Text="Roster">
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4 mt-2" />
        }
        else if (_noSleeper)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4 mt-2">
                No Sleeper account linked. <MudLink Href="/settings/sleeper">Link your Sleeper account</MudLink>.
            </MudAlert>
        }
        else if (_noLeague)
        {
            <MudAlert Severity="Severity.Info" Class="mb-4 mt-2">
                No active league found. Import from <MudLink Href="/settings/sleeper">Sleeper settings</MudLink>.
            </MudAlert>
        }
        else if (_roster is null)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4 mt-2">
                Roster not found. Try syncing your league.
            </MudAlert>
        }
        else
        {
            @foreach (var group in _roster.Players
                                                                .GroupBy(p => p.Position)
                                                                .OrderBy(g => PositionOrder(g.Key)))
            {
                <MudText Typo="Typo.subtitle1" Class="mb-2 mt-4"
                Style="color:var(--fc-cyan);font-weight:600;">
                    @group.Key
                </MudText>
                <MudPaper Elevation="0" Class="fc-table-paper mb-2">
                    <MudTable Items="@group.ToList()" Dense="true" Hover="true" Class="fc-table" Style="table-layout:fixed; width:100%">
                        <HeaderContent>
                            <MudTh Style="width:22%">Player</MudTh>
                            <MudTh Style="width:8%">Team</MudTh>
                            <MudTh Style="width:7%">Age</MudTh>
                            <MudTh Style="width:13%">Status</MudTh>
                            <MudTh Style="width:13%">Proj Pts</MudTh>
                            <MudTh Style="width:10%">Bye</MudTh>
                            <MudTh Style="width:10%">Role</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            @{
                                var rp = context;
                            }
                            <MudTd>
                                <MudButton Variant="Variant.Text"
                                Style="font-weight:600; color:var(--fc-cyan); padding:0; min-width:0; text-transform:none;"
                                OnClick="@(() => _ = OpenPlayerCardAsync(rp))">
                                    @context.PlayerName
                                </MudButton>
                            </MudTd>
                            <MudTd><MudText Typo="Typo.body2">@context.NflTeam</MudText></MudTd>
                            <MudTd><MudText Typo="Typo.body2">@(context.Age?.ToString() ?? "—")</MudText></MudTd>
                            <MudTd>
                                @if (!string.IsNullOrEmpty(context.InjuryDesignation))
                                {
                                    <MudChip T="string" Size="Size.Small"
                                    Color="@InjuryColor(context.InjuryDesignation)"
                                    Variant="Variant.Filled">
                                        @context.InjuryDesignation
                                    </MudChip>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Active</MudText>
                                }
                            </MudTd>
                            <MudTd>
                                <MudText Typo="Typo.body2" Class="fc-stat"
                                Style="font-family:'JetBrains Mono',monospace;">
                                    @(
                                                        context.MedianProjectedPoints.HasValue
                                                                                                        ? context.MedianProjectedPoints.Value.ToString("F1") : "—"
                                                                )
                                                            </MudText>
                                                        </MudTd>
                                                        <MudTd>
                                                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                                                @(context.ByeWeek ?? "—")
                                                            </MudText>
                                                        </MudTd>
                                                        <MudTd>
                                                            @if (context.IsStarter)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">Starter</MudChip>
                                }
                                else if (context.IsOnTaxi)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">Taxi</MudChip>
                                }
                                else if (context.IsOnIr)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Text">IR</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">Bench</MudChip>
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            }
            @* ── Draft Picks ─────────────────────────────────────────────────────── *@
            @if (_roster.OwnedPicks.Count > 0)
            {
                <MudPaper Class="pa-4 mt-4" Elevation="1">
                    <MudText Typo="Typo.subtitle1" Class="mb-3" Style="color: var(--fc-amber);">
                        <MudIcon Icon="@Icons.Material.Filled.ConfirmationNumber" Class="mr-1" Style="vertical-align:middle;" />
                        Draft Picks (@_roster.OwnedPicks.Count total)
                    </MudText>
                    @foreach (var yearGroup in _roster.OwnedPicks
                        .GroupBy(p => p.Season)
                        .OrderBy(g => g.Key))
                    {
                        <div class="mb-3">
                            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-1" Style="font-weight:600; letter-spacing:.04em; text-transform:uppercase; font-size:.7rem;">
                                @yearGroup.Key Draft
                            </MudText>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var pick in yearGroup.OrderBy(p => p.Round))
                                {
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Variant="Variant.Outlined"
                                             Style="@PickChipStyle(pick.Round)">
                                        @yearGroup.Key R@(pick.Round)
                                    </MudChip>
                                }
                            </div>
                        </div>
                    }
                </MudPaper>
            }
            else
            {
                <MudPaper Class="pa-4 mt-4" Elevation="1">
                    <MudText Typo="Typo.subtitle1" Class="mb-2" Style="color: var(--fc-amber);">
                        <MudIcon Icon="@Icons.Material.Filled.ConfirmationNumber" Class="mr-1" Style="vertical-align:middle;" />
                        Draft Picks
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        No future picks — all picks traded away or data not yet synced.
                    </MudText>
                </MudPaper>
            }
            @* Optimize My Lineup panel *@
            <MudPaper Class="fc-card pa-4 mt-4" Elevation="0">
                <div class="d-flex align-center mb-3">
                    <MudText Typo="Typo.subtitle2" Class="fc-section-label">OPTIMIZE MY LINEUP</MudText>
                    <MudSpacer />
                    @if (_lineupResult is not null)
                    {
                        <MudChip T="string" Color="Color.Primary" Size="Size.Small" Class="fc-stat">
                            @_lineupResult.TotalProjectedPoints.ToString("F1") pts projected
                        </MudChip>
                    }
                </div>
                <MudGrid Spacing="2" Class="mb-3">
                    <MudItem xs="6" sm="4">
                        <MudSelect T="string" @bind-Value="_optimizerMode" Label="Score Mode"
                                   Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem Value="@("Median")">Median</MudSelectItem>
                            <MudSelectItem Value="@("Floor")">Floor</MudSelectItem>
                            <MudSelectItem Value="@("Ceiling")">Ceiling</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="6" sm="4">
                        <MudSelect T="string" @bind-Value="_optimizerRisk" Label="Risk Profile"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                            <MudSelectItem T="string" Value="@("Safe")">Safe — high floor</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Ceiling")">Ceiling — max upside</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Contrarian")">Contrarian</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="4" Class="d-flex align-end">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.AutoAwesome"
                                   FullWidth="true" Disabled="@_optimizing"
                                   OnClick="@(() => _ = OptimizeMyLineupAsync())"
                                   Style="height:40px;">
                            @if (_optimizing)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true"
                                                     Class="mr-2" Color="Color.Surface" />
                                <span>Optimizing...</span>
                            }
                            else
                            {
                                <span>Optimize My Lineup</span>
                            }
                        </MudButton>
                    </MudItem>
                </MudGrid>
                @if (_optimizerError is not null)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                        @_optimizerError
                    </MudAlert>
                }
                @if (_lineupResult is not null)
                {
                    @foreach (var slotType in new[] { "QB", "RB", "WR", "TE", "FLEX" })
                    {
                        var slots = _lineupResult.Lineup.Where(s => s.SlotType == slotType).ToList();
                        if (!slots.Any()) continue;
                        <div class="fc-slot-group mb-2">
                            <MudText Typo="Typo.overline" Class="fc-slot-label">@slotType</MudText>
                            @foreach (var slot in slots)
                            {
                                <div class="fc-lineup-slot">
                                    <div class="fc-slot-pos-badge @PositionClass(slot.Position)">
                                        @slot.Position
                                    </div>
                                    <div class="fc-slot-info">
                                        <MudText Typo="Typo.body1" Style="font-weight:700;">
                                            @slot.PlayerName
                                        </MudText>
                                    </div>
                                    <div class="fc-slot-pts">
                                        <MudText Typo="Typo.h6" Class="fc-stat fc-cyan">
                                            @slot.ProjectedPoints.ToString("F1")
                                        </MudText>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">proj</MudText>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    <MudDivider Class="my-3" />
                    <div class="d-flex justify-space-between align-center">
                        <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">TOTAL PROJECTED</MudText>
                        <MudText Typo="Typo.h5" Class="fc-stat fc-cyan">
                            @_lineupResult.TotalProjectedPoints.ToString("F1")
                        </MudText>
                    </div>
                }
            </MudPaper>
        }
    </MudTabPanel>

    <MudTabPanel Text="Start / Sit">
        @if (_startSitLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4 mt-2" />
        }
        else if (_startSitData is null)
        {
            <MudAlert Severity="Severity.Info" Class="mt-2">
                No start/sit decisions needed — your roster doesn't have contested positions,
                or simulation data is unavailable.
            </MudAlert>
        }
        else if (_startSitData.Decisions.Count == 0)
        {
            <MudAlert Severity="Severity.Success" Class="mt-2">
                No tough decisions this week — your starters are clear.
            </MudAlert>
        }
        else
        {
            @foreach (var decision in _startSitData.Decisions)
            {
                <MudText Typo="Typo.subtitle2" Class="fc-section-label mb-2 mt-4">
                    @decision.SlotLabel DECISION
                </MudText>
                <MudPaper Elevation="0" Class="fc-card pa-3 mb-3">
                    @foreach (var opt in decision.Options)
                    {
                        <div class="d-flex align-center pa-2 mb-1"
                             style="border-radius:6px; background: var(--mud-palette-surface);">
                            <div style="min-width:90px;">
                                <MudChip T="string"
                                         Color="@VerdictColor(opt.Verdict)"
                                         Size="Size.Small"
                                         Variant="Variant.Filled">
                                    @VerdictLabel(opt.Verdict)
                                </MudChip>
                            </div>
                            <div class="flex-grow-1 mx-3">
                                <div class="d-flex align-center gap-2">
                                    <MudText Typo="Typo.body1" Style="font-weight:700;">
                                        @opt.PlayerName
                                    </MudText>
                                    <MudChip T="string" Size="Size.Small"
                                             Class="@PositionClass(opt.Position)"
                                             Variant="Variant.Filled">
                                        @opt.Position
                                    </MudChip>
                                    @if (!string.IsNullOrEmpty(opt.InjuryDesignation))
                                    {
                                        <MudChip T="string" Size="Size.Small"
                                                 Color="@InjuryColor(opt.InjuryDesignation)"
                                                 Variant="Variant.Filled">
                                            @opt.InjuryDesignation
                                        </MudChip>
                                    }
                                </div>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    @opt.Rationale
                                </MudText>
                            </div>
                            <div class="text-right" style="min-width:140px;">
                                <div class="d-flex gap-3 justify-end">
                                    <div class="text-center">
                                        <MudText Typo="Typo.body2" Class="fc-stat fc-cyan">
                                            @opt.Median.ToString("F1")
                                        </MudText>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">med</MudText>
                                    </div>
                                    <div class="text-center">
                                        <MudText Typo="Typo.body2" Class="fc-stat">
                                            @opt.Floor.ToString("F1")
                                        </MudText>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">flr</MudText>
                                    </div>
                                    <div class="text-center">
                                        <MudText Typo="Typo.body2" Class="fc-stat fc-ceiling">
                                            @opt.Ceiling.ToString("F1")
                                        </MudText>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">ceil</MudText>
                                    </div>
                                </div>
                                <div class="mt-1">
                                    <MudProgressLinear Value="@opt.ConfidenceScore"
                                                       Color="@VerdictColor(opt.Verdict)"
                                                       Size="Size.Small" Rounded="true" />
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        @opt.ConfidenceLabel confidence
                                    </MudText>
                                </div>
                            </div>
                        </div>
                    }
                </MudPaper>
            }
        }
    </MudTabPanel>

    <MudTabPanel Text="Depth Grades">
        @if (_depthLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4 mt-2" />
        }
        else if (_depthGrades is null)
        {
            <MudAlert Severity="Severity.Info" Class="mt-2">
                Depth grade data unavailable — simulation data may need to be regenerated.
            </MudAlert>
        }
        else
        {
            <MudGrid Spacing="3" Class="mt-2">
                @foreach (var g in _depthGrades.Grades)
                {
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Elevation="0" Class="fc-card pa-4 text-center">
                            <MudText Typo="Typo.h2" Style="@(GradeColor(g.Grade) + "font-weight:800; line-height:1;")">
                                @g.Grade
                            </MudText>
                            <MudText Typo="Typo.subtitle1" Style="color:var(--fc-cyan); font-weight:600;" Class="mt-1">
                                @g.Position
                            </MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                @g.Label
                            </MudText>
                            <MudProgressLinear Value="@g.GradeScore"
                                              Color="@GradeBarColor(g.Grade)"
                                              Rounded="true"
                                              Size="Size.Small"
                                              Class="my-2" />
                            <div class="d-flex justify-space-around mt-2">
                                <div>
                                    <MudText Typo="Typo.body2" Class="fc-stat fc-cyan">
                                        @g.StarterScore.ToString("F1")
                                    </MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">starter pts</MudText>
                                </div>
                                <div>
                                    <MudText Typo="Typo.body2" Class="fc-stat">
                                        @g.HealthyCount / @g.RosteredCount
                                    </MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">healthy</MudText>
                                </div>
                            </div>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2 d-block" Style="font-style:italic;">
                                @g.Summary
                            </MudText>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        }
    </MudTabPanel>

    @* Dynasty Grade — only shown for Dynasty leagues *@
    @if (_isDynastyLeague)
    {
        <MudTabPanel Text="Dynasty Grade">
            @if (_dynastyLoading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4 mt-2" />
            }
            else if (_dynastyGrade is null)
            {
                <MudAlert Severity="Severity.Info" Class="mt-2">
                    Dynasty valuation data unavailable — dynasty valuations may need to be computed.
                </MudAlert>
            }
            else
            {
                <div class="d-flex align-center justify-center mb-4 mt-2">
                    <MudChip T="string" Color="Color.Primary" Size="Size.Large" Variant="Variant.Filled"
                             Style="font-size:1rem; font-weight:700; letter-spacing:0.05em;">
                        @_dynastyGrade.OverallProfile
                    </MudChip>
                </div>
                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="6">
                        <MudPaper Elevation="0" Class="fc-card pa-4 text-center">
                            <MudText Typo="Typo.overline" Class="fc-section-label mb-2 d-block">
                                CONTENTION — WIN NOW
                            </MudText>
                            <MudText Typo="Typo.h1" Style="@(DynastyGradeColor(_dynastyGrade.ContentionGrade) + "font-weight:800; line-height:1;")">
                                @_dynastyGrade.ContentionGrade
                            </MudText>
                            <MudText Typo="Typo.subtitle2" Class="mud-text-secondary mt-1">
                                @_dynastyGrade.ContentionLabel
                            </MudText>
                            <MudProgressLinear Value="@_dynastyGrade.ContentionScore"
                                               Color="@DynastyBarColor(_dynastyGrade.ContentionGrade)"
                                               Rounded="true" Size="Size.Medium" Class="my-3" />
                            <MudText Typo="Typo.body2" Class="fc-stat fc-cyan mb-1">
                                @_dynastyGrade.PrimePlayerCount prime-age player(s)
                            </MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="font-style:italic;">
                                @_dynastyGrade.ContentionSummary
                            </MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudPaper Elevation="0" Class="fc-card pa-4 text-center">
                            <MudText Typo="Typo.overline" Class="fc-section-label mb-2 d-block">
                                LONGEVITY — FUTURE VALUE
                            </MudText>
                            <MudText Typo="Typo.h1" Style="@(DynastyGradeColor(_dynastyGrade.LongevityGrade) + "font-weight:800; line-height:1;")">
                                @_dynastyGrade.LongevityGrade
                            </MudText>
                            <MudText Typo="Typo.subtitle2" Class="mud-text-secondary mt-1">
                                @_dynastyGrade.LongevityLabel
                            </MudText>
                            <MudProgressLinear Value="@_dynastyGrade.LongevityScore"
                                               Color="@DynastyBarColor(_dynastyGrade.LongevityGrade)"
                                               Rounded="true" Size="Size.Medium" Class="my-3" />
                            <MudText Typo="Typo.body2" Class="fc-stat fc-cyan mb-1">
                                @_dynastyGrade.YoungPlayerCount ascending player(s)
                            </MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="font-style:italic;">
                                @_dynastyGrade.LongevitySummary
                            </MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
                <MudPaper Elevation="0" Class="fc-card pa-3 mt-3">
                    <div class="d-flex justify-space-around">
                        <div class="text-center">
                            <MudText Typo="Typo.body2" Class="fc-stat fc-cyan">@_dynastyGrade.RosteredCount</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">rostered</MudText>
                        </div>
                        <div class="text-center">
                            <MudText Typo="Typo.body2" Class="fc-stat">@_dynastyGrade.AvgAge.ToString("F1")</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">avg age</MudText>
                        </div>
                        <div class="text-center">
                            <MudText Typo="Typo.body2" Class="fc-stat">@_dynastyGrade.AvgTradeValue.ToString("F1")</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">avg trade value</MudText>
                        </div>
                    </div>
                </MudPaper>
            }
        </MudTabPanel>
    }

    <!-- ── Draft Prep tab ── -->
    <MudTabPanel Text="Draft Prep">
        @if (_draftPrepLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
        }
        else if (!_draftPrepQueried)
        {
            <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">
                Activate this tab to load your draft prep analysis.
            </MudText>
        }
        else if (_draftPrep is null)
        {
            <MudAlert Severity="Severity.Warning">
                Could not load draft prep. Ensure depth grades are available for your roster.
            </MudAlert>
        }
        else
        {
            <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color: var(--mud-palette-text-secondary);">
                POSITIONAL NEEDS
            </MudText>
            <MudGrid Class="mb-4">
                @foreach (var need in _draftPrep.PositionNeeds)
                {
                    <MudItem xs="6" sm="3">
                        <MudPaper Class="pa-3" Style="background: var(--fc-navy-card); border-radius: 8px;">
                            <div class="d-flex justify-space-between align-center mb-1">
                                <MudText Typo="Typo.h6" Style="font-weight:800;">@need.Position</MudText>
                                <MudChip T="string" Size="Size.Small"
                                         Style="@GetNeedChipStyle(need.NeedLevel)">
                                    @need.NeedLevel
                                </MudChip>
                            </div>
                            <MudText Typo="Typo.h5" Style="@("font-weight:800; " + GradeColor(need.Grade))">
                                @need.Grade
                            </MudText>
                            <MudProgressLinear Value="@need.GradeScore" Max="100"
                                               Color="@GetGradeProgressColor(need.GradeScore)"
                                               Class="mt-1" Style="height:4px;" />
                            <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);" Class="mt-1">
                                @need.Summary
                            </MudText>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>

            <div class="d-flex justify-space-between align-center mb-2">
                <MudText Typo="Typo.subtitle2" Style="color: var(--mud-palette-text-secondary);">
                    ROOKIE TARGETS
                </MudText>
                <MudChipSet T="string" @bind-SelectedValue="_draftPrepPosition"
                            SelectionMode="SelectionMode.SingleSelection">
                    <MudChip T="string" Value="@("")" Default="true">All</MudChip>
                    <MudChip T="string" Value="@("QB")">QB</MudChip>
                    <MudChip T="string" Value="@("RB")">RB</MudChip>
                    <MudChip T="string" Value="@("WR")">WR</MudChip>
                    <MudChip T="string" Value="@("TE")">TE</MudChip>
                </MudChipSet>
            </div>

            @if (_draftPrep.RookieTargets.Count == 0)
            {
                <MudAlert Severity="Severity.Info">
                    No rookie rankings available for @(DateTime.UtcNow.Month >= 3 ? DateTime.UtcNow.Year : DateTime.UtcNow.Year - 1).
                    Import FantasyPros rankings via the Admin panel to populate targets.
                </MudAlert>
            }
            else
            {
                <MudTable Items="@FilteredRookieTargets" Dense="true" Hover="true" Striped="true"
                          Style="background: var(--fc-navy-card); table-layout:fixed; width:100%">
                    <HeaderContent>
                        <MudTh Style="width:7%">Rank</MudTh>
                        <MudTh Style="width:28%">Player</MudTh>
                        <MudTh Style="width:8%">Pos</MudTh>
                        <MudTh Style="width:12%">Team</MudTh>
                        <MudTh Style="width:10%">Tier</MudTh>
                        <MudTh Style="width:12%">Fit</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        @{
                            var rc = context;
                        }
                        <MudTd>
                            <MudText Typo="Typo.body2"
                                     Style="font-family:'JetBrains Mono',monospace; color: var(--mud-palette-text-secondary);">
                                #@context.FantasyProsRank
                            </MudText>
                        </MudTd>
                        <MudTd>
                            <MudText Typo="Typo.body2" Style="font-weight:600; color: var(--fc-cyan);">
                                @context.PlayerName
                            </MudText>
                        </MudTd>
                        <MudTd>
                            <MudChip T="string" Size="Size.Small" Style="@GetDraftPositionStyle(context.Position)">
                                @context.Position
                            </MudChip>
                        </MudTd>
                        <MudTd>@(context.NflTeam ?? "—")</MudTd>
                        <MudTd>
                            <MudText Typo="Typo.body2">@(context.Tier ?? "—")</MudText>
                        </MudTd>
                        <MudTd>
                            <MudChip T="string" Size="Size.Small" Style="@GetFitStyle(context.NeedLevel)">
                                @context.FitLabel
                            </MudChip>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        }
    </MudTabPanel>
</MudTabs>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else if (_noSleeper)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        No Sleeper account linked.
        <MudLink Href="/settings/sleeper">Link your Sleeper account</MudLink> to view your roster.
    </MudAlert>
}
else if (_noLeague)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">
        No active league found. Import a league from
        <MudLink Href="/settings/sleeper">Sleeper settings</MudLink>.
    </MudAlert>
}
else if (_roster is null)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        Roster not found for this league. Try syncing your league.
    </MudAlert>
}

@code {
    private bool _loading = true;
    private bool _noSleeper;
    private bool _noLeague;
    private MyRosterDto? _roster;
    private bool _isDynastyLeague = true;

    private HttpClient Http => HttpClientFactory.CreateClient("AuthAPI");

    private string? _teamName;
    private string? _ownerAvatar;
    private string? _ownerName;

    // Season/week from NflContext — shared across all lazy-load methods
    private int _season;
    private int _week;

    // ── TEAM-002: Lineup Optimizer ─────────────────────────
    private bool _optimizing;
    private string? _optimizerError;
    private OptimizerResult? _lineupResult;
    private string _optimizerMode = "Median";
    private string _optimizerRisk = "";

    // ── TEAM-004: Start/Sit ────────────────────────────────
    private int _activeTab;
    private bool _startSitLoading;
    private StartSitRecommendationsDto? _startSitData;

    // ── TEAM-005: Depth Grades ────────────────────────────
    private bool _depthLoading;
    private PositionalDepthGradesDto? _depthGrades;
    private static readonly System.Text.Json.JsonSerializerOptions _enumJsonOptions = new()
    {
        PropertyNameCaseInsensitive = true,
        Converters = { new System.Text.Json.Serialization.JsonStringEnumConverter() }
    };

    // ── TEAM-006: Dynasty Grade ───────────────────────────
    private bool _dynastyLoading;
    private DynastyTeamGradeDto? _dynastyGrade;

    // ── TEAM-007: Draft Prep ─────────────────────────────
    private bool _draftPrepLoading;
    private bool _draftPrepQueried;
    private DraftPrepDto? _draftPrep;
    private string _draftPrepPosition = string.Empty;

    private int DraftPrepTabIndex => _isDynastyLeague ? 4 : 3;
    private int DynastyGradeTabIndex => 3;

    private static string OwnerAvatarUrl(string? avatar) =>
        string.IsNullOrEmpty(avatar) ? string.Empty :
        avatar.StartsWith("http") ? avatar :
        $"https://sleepercdn.com/avatars/thumbs/{avatar}";

    private async Task OptimizeMyLineupAsync()
    {
        if (_roster is null) return;
        _optimizing = true;
        _optimizerError = null;
        _lineupResult = null;
        StateHasChanged();
        try
        {
            var leagueId = LeagueState.ActiveLeagueId;
            var (season, week) = await NflContext.GetContextAsync();
            var riskParam = string.IsNullOrEmpty(_optimizerRisk) ? "" : $"&riskProfile={_optimizerRisk}";
            var url = $"api/v1/team/optimize-lineup?sleeperLeagueId={leagueId}&season={season}&week={week}&mode={_optimizerMode}{riskParam}";
            var response = await Http.PostAsync(url, null);
            if (response.IsSuccessStatusCode)
            {
                _lineupResult = await response.Content.ReadFromJsonAsync<OptimizerResult>();
                Snackbar.Add($"Lineup optimized — {_lineupResult?.TotalProjectedPoints:F1} pts projected.", Severity.Success);
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                _optimizerError = err.Contains("NoRosterData")
                    ? "No simulation data found for your roster. Re-run simulations with SleeperPlayerId stamped."
                    : $"Optimizer error: {err}";
            }
        }
        catch (Exception ex)
        {
            _optimizerError = $"Failed: {ex.Message}";
        }
        finally
        {
            _optimizing = false;
        }
    }

    private record OptimizerResult(
        bool Success,
        List<OptimizedSlot> Lineup,
        decimal TotalProjectedPoints,
        string Mode,
        string? RiskProfile);

    private record OptimizedSlot(
        string PlayerId,
        string PlayerName,
        string Position,
        string SlotType,
        decimal ProjectedPoints,
        decimal? RiskScore);

    private async Task LoadRosterAsync()
    {
        _loading = true;
        _noSleeper = false;
        _noLeague = false;
        _roster = null;
        try
        {
            var leagueId = LeagueState.ActiveLeagueId;
            if (string.IsNullOrEmpty(leagueId))
            {
                var context = await Http.GetFromJsonAsync<UserContextResponse>("api/v1/identity/context");
                if (context?.IsSleeperLinked != true) { _noSleeper = true; return; }
                leagueId = context.ActiveLeagueId;
                if (string.IsNullOrEmpty(leagueId)) { _noLeague = true; return; }
                LeagueState.ActiveLeagueId = leagueId;
                var activeLeague = context.Leagues?.FirstOrDefault(l => l.LeagueId == leagueId);
                _isDynastyLeague = activeLeague?.LeagueType != "Redraft";
            }
            else
            {
                try
                {
                    var context = await Http.GetFromJsonAsync<UserContextResponse>("api/v1/identity/context");
                    var activeLeague = context?.Leagues?.FirstOrDefault(l => l.LeagueId == leagueId);
                    _isDynastyLeague = activeLeague?.LeagueType != "Redraft";
                }
                catch { }
            }

            var response = await Http.GetAsync($"api/v1/team/roster?sleeperLeagueId={leagueId}");
            if (response.IsSuccessStatusCode)
                _roster = await response.Content.ReadFromJsonAsync<MyRosterDto>();
            else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
                _noSleeper = true;

            _teamName    = _roster?.TeamName;
            _ownerAvatar = _roster?.OwnerAvatar;
            _ownerName   = _roster?.OwnerName;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading roster: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        LeagueState.OnLeagueChanged += OnLeagueChangedHandler;
        await LoadRosterAsync();
    }

    private void OnLeagueChangedHandler()
    {
        _startSitData = null;
        _depthGrades = null;
        _dynastyGrade = null;
        _draftPrep = null;
        _draftPrepQueried = false;
        _season = 0;
        _week = 0;
        _ = InvokeAsync(async () =>
        {
            await LoadRosterAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        LeagueState.OnLeagueChanged -= OnLeagueChangedHandler;
    }

    private static int PositionOrder(string pos) => pos switch
    {
        "QB" => 0, "RB" => 1, "WR" => 2, "TE" => 3, "K" => 4, _ => 5
    };

    private static Color InjuryColor(string designation) => designation switch
    {
        "Out" or "D" or "IR" => Color.Error,
        "Q" or "Doubtful"    => Color.Warning,
        _                    => Color.Default
    };

    private record UserContextResponse(
        bool IsSleeperLinked,
        string? ActiveLeagueId,
        List<LeagueItem>? Leagues);

    private record LeagueItem(
        string LeagueId,
        string LeagueName,
        int Season,
        string Role,
        bool IsActive = false,
        string LeagueType = "Redraft");

    private record MyRosterDto(
        string TeamName,
        string OwnerName,
        string? OwnerAvatar,
        string LeagueId,
        int Wins,
        int Losses,
        int WaiverPosition,
        List<MyRosterPlayerDto> Players,
        List<RosterPickDto> OwnedPicks);    // ← NEW

    private record RosterPickDto(int Season, int Round);  // ← NEW local mirror

    private record MyRosterPlayerDto(
        string SleeperPlayerId,
        string PlayerName,
        string Position,
        string NflTeam,
        int? Age,
        string? InjuryDesignation,
        bool IsStarter,
        bool IsOnIr,
        bool IsOnTaxi,
        double? MedianProjectedPoints,
        string? ByeWeek);

    private static string PositionClass(string pos) => pos switch
    {
        "QB" => "fc-chip-qb", "RB" => "fc-chip-rb",
        "WR" => "fc-chip-wr", "TE" => "fc-chip-te",
        _ => ""
    };

    private async Task OnTabChanged(int index)
    {
        _activeTab = index;
        if (index == 1 && _startSitData is null)
            await LoadStartSitAsync();
        if (index == 2 && _depthGrades is null)
            await LoadDepthGradesAsync();
        if (_isDynastyLeague && index == DynastyGradeTabIndex && _dynastyGrade is null)
            await LoadDynastyGradeAsync();
        if (index == DraftPrepTabIndex && !_draftPrepQueried)
            await LoadDraftPrepAsync();
    }

    // ── Shared NflContext resolver ────────────────────────────────────────────
    private async Task EnsureSeasonAsync()
    {
        if (_season == 0)
            (_season, _week) = await NflContext.GetContextAsync();
    }

    private async Task LoadStartSitAsync()
    {
        _startSitLoading = true;
        StateHasChanged();
        try
        {
            var leagueId = LeagueState.ActiveLeagueId;
            if (string.IsNullOrEmpty(leagueId)) return;
            await EnsureSeasonAsync();
            var response = await Http.GetAsync(
                $"api/v1/team/start-sit?sleeperLeagueId={leagueId}&season={_season}&week={_week}");
            if (response.IsSuccessStatusCode)
                _startSitData = await response.Content.ReadFromJsonAsync<StartSitRecommendationsDto>(_enumJsonOptions);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading Start/Sit: {ex.Message}", Severity.Error);
        }
        finally
        {
            _startSitLoading = false;
        }
    }

    private async Task LoadDepthGradesAsync()
    {
        _depthLoading = true;
        StateHasChanged();
        try
        {
            var leagueId = LeagueState.ActiveLeagueId;
            if (string.IsNullOrEmpty(leagueId)) return;
            await EnsureSeasonAsync();
            var response = await Http.GetAsync(
                $"api/v1/team/depth-grades?sleeperLeagueId={leagueId}&season={_season}");
            if (response.IsSuccessStatusCode)
                _depthGrades = await response.Content.ReadFromJsonAsync<PositionalDepthGradesDto>();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading depth grades: {ex.Message}", Severity.Error);
        }
        finally
        {
            _depthLoading = false;
        }
    }

    private async Task LoadDynastyGradeAsync()
    {
        _dynastyLoading = true;
        StateHasChanged();
        try
        {
            var leagueId = LeagueState.ActiveLeagueId;
            if (string.IsNullOrEmpty(leagueId)) return;
            var response = await Http.GetAsync($"api/v1/team/dynasty-grade?sleeperLeagueId={leagueId}");
            if (response.IsSuccessStatusCode)
                _dynastyGrade = await response.Content.ReadFromJsonAsync<DynastyTeamGradeDto>();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading dynasty grade: {ex.Message}", Severity.Error);
        }
        finally
        {
            _dynastyLoading = false;
        }
    }

    private async Task LoadDraftPrepAsync()
    {
        var leagueId = LeagueState.ActiveLeagueId;
        if (string.IsNullOrEmpty(leagueId)) return;
        _draftPrepLoading = true;
        _draftPrepQueried = true;
        StateHasChanged();
        try
        {
            await EnsureSeasonAsync();
            var rookieSeason = DateTime.UtcNow.Year;
            var url = $"api/v1/team/draft-prep" +
                      $"?sleeperLeagueId={leagueId}" +
                      $"&simSeason={_season}" +
                      $"&rookieSeason={rookieSeason}";
            _draftPrep = await Http.GetFromJsonAsync<DraftPrepDto>(url);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading draft prep: {ex.Message}", Severity.Error);
        }
        finally
        {
            _draftPrepLoading = false;
        }
    }

    private IEnumerable<RookieTargetDto> FilteredRookieTargets =>
        string.IsNullOrEmpty(_draftPrepPosition)
            ? (_draftPrep?.RookieTargets ?? [])
            : (_draftPrep?.RookieTargets ?? []).Where(r => r.Position == _draftPrepPosition);

    private static string GradeColor(string grade) => grade switch
    {
        "A+" or "A" => "color:#00e5c8;",
        "B+" or "B" => "color:#4fc3f7;",
        "C+" or "C" => "color:#ffd54f;",
        "D"         => "color:#ff8a65;",
        _           => "color:#ef5350;"
    };

    private static Color GradeBarColor(string grade) => grade switch
    {
        "A+" or "A" => Color.Success,
        "B+" or "B" => Color.Info,
        "C+" or "C" => Color.Warning,
        _           => Color.Error
    };

    private static string DynastyGradeColor(string grade) => grade switch
    {
        "A+" or "A" => "color:#00e5c8;",
        "B+" or "B" => "color:#4fc3f7;",
        "C+" or "C" => "color:#ffd54f;",
        "D"         => "color:#ff8a65;",
        _           => "color:#ef5350;"
    };

    private static Color DynastyBarColor(string grade) => grade switch
    {
        "A+" or "A" => Color.Success,
        "B+" or "B" => Color.Info,
        "C+" or "C" => Color.Warning,
        _           => Color.Error
    };

    private static string GetFitStyle(string needLevel) => needLevel switch
    {
        "Need"     => "background:#1a3a2a; color:#4ade80;",
        "Strength" => "background:#2a1a1a; color:#f87171;",
        _          => "background:#1a2a3a; color:#60a5fa;"
    };

    private static Color GetGradeProgressColor(int score) => score switch
    {
        >= 65 => Color.Success,
        >= 40 => Color.Warning,
        _     => Color.Error
    };

    private static string GetNeedChipStyle(string needLevel) => needLevel switch
    {
        "Need"     => "background:#1a3a2a; color:#4ade80;",
        "Strength" => "background:#2a1a1a; color:#f87171;",
        _          => "background:#1a1a2a; color:#94a3b8;"
    };

    private static string GetDraftPositionStyle(string position) => position switch
    {
        "QB" => "background:#1a2a3a; color:#60a5fa;",
        "RB" => "background:#2a1a1a; color:#f87171;",
        "WR" => "background:#1a3a2a; color:#4ade80;",
        "TE" => "background:#2a1a2a; color:#c084fc;",
        _    => string.Empty
    };

    private record StartSitRecommendationsDto(int Week, int Season, List<StartSitDecisionDto> Decisions);
    private record StartSitDecisionDto(string Position, string SlotLabel, List<StartSitOptionDto> Options);
    private record StartSitOptionDto(
        string SleeperPlayerId, string PlayerName, string Position, string NflTeam,
        StartSitVerdict Verdict, int ConfidenceScore, string ConfidenceLabel,
        double Median, double Floor, double Ceiling,
        double BoomProbability, double BustProbability,
        string? InjuryDesignation, string Rationale);
    private enum StartSitVerdict { Start, LeanStart, LeanSit, Sit }
    private static Color VerdictColor(StartSitVerdict v) => v switch
    {
        StartSitVerdict.Start      => Color.Success,
        StartSitVerdict.LeanStart  => Color.Info,
        StartSitVerdict.LeanSit    => Color.Warning,
        StartSitVerdict.Sit        => Color.Error,
        _                          => Color.Default
    };
    private static string VerdictLabel(StartSitVerdict v) => v switch
    {
        StartSitVerdict.Start      => "START",
        StartSitVerdict.LeanStart  => "LEAN START",
        StartSitVerdict.LeanSit    => "LEAN SIT",
        StartSitVerdict.Sit        => "SIT",
        _                          => "—"
    };

    private record PositionalDepthGradesDto(List<PositionDepthGradeDto> Grades);
    private record PositionDepthGradeDto(
        string Position, string Grade, int GradeScore, string Label,
        string Summary, int RosteredCount, int HealthyCount,
        double StarterScore, double DepthScore);

    private record DynastyTeamGradeDto(
        string ContentionGrade, int ContentionScore, string ContentionLabel, string ContentionSummary,
        string LongevityGrade, int LongevityScore, string LongevityLabel, string LongevitySummary,
        string OverallProfile, int RosteredCount, int PrimePlayerCount, int YoungPlayerCount,
        double AvgTradeValue, double AvgAge);

    private record DraftPrepDto(List<PositionNeedDto> PositionNeeds, List<RookieTargetDto> RookieTargets);
    private record PositionNeedDto(string Position, string Grade, int GradeScore, string NeedLevel, string Summary);
    private record RookieTargetDto(
        string SleeperPlayerId, string PlayerName, string Position, string? NflTeam,
        int FantasyProsRank, int PositionRank, string? Tier, string NeedLevel, string FitLabel);

    private async Task OpenPlayerCardAsync(MyRosterPlayerDto player)
    {
        var data = new PlayerCardDialog.PlayerCardData(
            SleeperPlayerId: player.SleeperPlayerId,
            FullName: player.PlayerName,
            Position: player.Position,
            NflTeam: player.NflTeam,
            Age: player.Age,
            DraftRound: null, DraftPick: null, CollegeTeam: null,
            HeadshotUrl: $"https://sleepercdn.com/content/nfl/players/thumb/{player.SleeperPlayerId}.jpg",
            FantasyProsRank: null, FantasyProsTier: null,
            PffGrade: null, PffRank: null, ConsensusAdp: null,
            DynastyScore: 0, DraftCapitalScore: 0, PositionalScore: 0,
            ValuationBlendScore: 0, FantasyProsScore: 0, PffGradeScore: 0,
            ConsensusAdpScore: 0, AgeMultiplier: 0, AthleticismSignalScore: 0,
            AthleticismScore: null, SpeedScore: null, FortyYard: null,
            LeagueContextAvailable: true,
            RosteredByTeamName: _roster?.TeamName,
            LeagueId: LeagueState.ActiveLeagueId);

        var parameters = new DialogParameters<PlayerCardDialog>
        {
            { x => x.Player, data },
            { x => x.DefaultTab, PlayerCardDialog.PlayerCardTab.Overview }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<PlayerCardDialog>(player.PlayerName, parameters, options);
    }

    private static string PickChipStyle(int round) => round switch
    {
        1 => "border-color:#22C55E; color:#22C55E;",   // green — 1st rounders
        2 => "border-color:#00C8F0; color:#00C8F0;",   // cyan — 2nd rounders
        3 => "border-color:#F59E0B; color:#F59E0B;",   // amber — 3rd rounders
        _ => "border-color:#6B7280; color:#6B7280;"    // gray — 4th+
    };
}
