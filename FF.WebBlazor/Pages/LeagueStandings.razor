@page "/league/standings"
@attribute [Authorize]
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav
@inject LeagueStateService LeagueState
@inject NflContextClientService NflContext

<PageTitle>League Standings — FantasyCombine.AI</PageTitle>

<div class="fc-page-header mb-4">
    <MudText Typo="Typo.h5" Class="fc-page-title">
        <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Class="mr-2" Style="vertical-align:middle;" />
        League Standings
    </MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary">
        Season @_season · Week @_week
    </MudText>
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else
{
    <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="false" Class="mb-4"
             ActivePanelIndexChanged="OnTabChanged">

        @* ── TAB 0: STANDINGS ──────────────────────────────── *@
        <MudTabPanel Text="Standings" Icon="@Icons.Material.Filled.EmojiEvents">
            @if (_standings is null)
            {
                <MudAlert Severity="Severity.Info" Class="mt-4">
                    No standings data found. Make sure your league is synced.
                </MudAlert>
            }
            else
            {
                @* Playoff picture strip *@
                <MudGrid Spacing="3" Class="mb-6 mt-2">
                    <MudItem xs="6" sm="3">
                        <MudPaper Class="fc-stat-card" Elevation="0">
                            <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Class="fc-stat-card-icon" />
                            <MudText Typo="Typo.h4" Class="fc-stat-card-value fc-cyan">
                                @_standings.Teams.Count(t => t.PlayoffProjection is "In" or "Clinched")
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                @(_seasonFinalized ? "Clinched" : "Projected In")
                            </MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudPaper Class="fc-stat-card" Elevation="0">
                            <MudIcon Icon="@Icons.Material.Filled.SwapVert" Class="fc-stat-card-icon" />
                            <MudText Typo="Typo.h4" Class="fc-stat-card-value" Style="color:#F59E0B;">
                                @_standings.Teams.Count(t => t.PlayoffProjection == "Bubble")
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                @(_seasonFinalized ? "—" : "On the Bubble")
                            </MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudPaper Class="fc-stat-card" Elevation="0">
                            <MudIcon Icon="@Icons.Material.Filled.Cancel" Class="fc-stat-card-icon" />
                            <MudText Typo="Typo.h4" Class="fc-stat-card-value" Style="color:#F87171;">
                                @_standings.Teams.Count(t => t.PlayoffProjection is "Out" or "Eliminated")
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                @(_seasonFinalized ? "Eliminated" : "Projected Out")
                            </MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudPaper Class="fc-stat-card" Elevation="0">
                            <MudIcon Icon="@Icons.Material.Filled.Analytics" Class="fc-stat-card-icon" />
                            <MudText Typo="Typo.h4" Class="fc-stat-card-value fc-boom"
                                     Style="font-size:1rem; line-height:1.3;">
                                @_topProjected
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">Top Projected Week</MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>

                @* Standings table *@
                <MudPaper Class="fc-table-paper" Elevation="0">
                    <MudTable Items="@_standings.Teams" Class="fc-table" Hover="true" Dense="true"
                              Elevation="0" AllowUnsorted="false">
                        <HeaderContent>
                            <MudTh Style="width:40px;">#</MudTh>
                            <MudTh><MudTableSortLabel SortBy="new Func<TeamStandingDto, object>(t => t.TeamName)">Team</MudTableSortLabel></MudTh>
                            <MudTh Style="text-align:center;"><MudTableSortLabel InitialDirection="SortDirection.Descending" SortBy="new Func<TeamStandingDto, object>(t => t.Wins)">W</MudTableSortLabel></MudTh>
                            <MudTh Style="text-align:center;"><MudTableSortLabel SortBy="new Func<TeamStandingDto, object>(t => t.Losses)">L</MudTableSortLabel></MudTh>
                            <MudTh Style="text-align:center; width:40px;">T</MudTh>
                            <MudTh Style="text-align:right;"><MudTableSortLabel SortBy="new Func<TeamStandingDto, object>(t => t.ProjectedPointsThisWeek)">Proj Pts</MudTableSortLabel></MudTh>
                            <MudTh Style="text-align:center;">Waiver</MudTh>
                            <MudTh Style="text-align:center;">Playoff</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <MudText Typo="Typo.body2" Class="font-mono" Style="@RankStyle(context.Rank)">
                                    @context.Rank
                                </MudText>
                            </MudTd>
                            <MudTd>
                                <MudLink Href="@($"/league/teams?rosterId={context.SleeperRosterId}")"
                                         Style="text-decoration:none; color:inherit;">
                                    <MudText Typo="Typo.body2" Style="font-weight:600; cursor:pointer;"
                                             Class="fc-link-hover">@context.TeamName</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.OwnerName</MudText>
                                </MudLink>
                            </MudTd>
                            <MudTd Style="text-align:center;">
                                <MudText Typo="Typo.body2" Class="font-mono fc-cyan">@context.Wins</MudText>
                            </MudTd>
                            <MudTd Style="text-align:center;">
                                <MudText Typo="Typo.body2" Class="font-mono">@context.Losses</MudText>
                            </MudTd>
                            <MudTd Style="text-align:center;">
                                <MudText Typo="Typo.body2" Class="font-mono mud-text-secondary">@context.Ties</MudText>
                            </MudTd>
                            <MudTd Style="text-align:right;">
                                @if (context.ProjectedPointsThisWeek > 0)
                                {
                                    <MudText Typo="Typo.body2" Class="font-mono fc-boom">
                                        @context.ProjectedPointsThisWeek.ToString("F1")
                                    </MudText>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary">—</MudText>
                                }
                            </MudTd>
                            <MudTd Style="text-align:center;">
                                <MudText Typo="Typo.body2" Class="font-mono mud-text-secondary">
                                    @(context.WaiverPosition > 0 ? $"#{context.WaiverPosition}" : "—")
                                </MudText>
                            </MudTd>
                            <MudTd Style="text-align:center;">
                                <MudChip T="string" Size="Size.Small"
                                         Class="@PlayoffChipClass(context.PlayoffProjection)">
                                    @context.PlayoffProjection
                                </MudChip>
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudText Class="mud-text-secondary pa-4">No teams found.</MudText>
                        </NoRecordsContent>
                    </MudTable>
                </MudPaper>

                <div class="mt-3 d-flex align-center gap-3">
                    <div style="width:12px;height:12px;border-radius:2px;background:rgba(0,200,240,0.3);"></div>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @(_seasonFinalized ? "Clinched playoff spot" : "Projected playoff teams")
                    </MudText>
                    @if (!_seasonFinalized)
                    {
                        <div style="width:12px;height:12px;border-radius:2px;background:rgba(245,158,11,0.3);margin-left:12px;"></div>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Bubble teams</MudText>
                    }
                </div>
            }
        </MudTabPanel>

        @* ── TAB 1: ROSTER GRADES ───────────────────────────── *@
        <MudTabPanel Text="Roster Grades" Icon="@Icons.Material.Filled.Grading">
            @if (_gradesLoading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-4" />
            }
            else if (_isDynastyLeague)
            {
                @* ── Dynasty leagues: unchanged from before FAN-107 ── *@
                @if (_grades is null)
                {
                    <MudAlert Severity="Severity.Info" Class="mt-4">
                        No grade data available. Make sure dynasty valuations have been generated.
                    </MudAlert>
                }
                else
                {
                    <MudPaper Class="fc-table-paper mt-2" Elevation="0">
                        <MudTable Items="@_grades.Teams" Class="fc-table" Hover="true" Dense="true"
                                  Elevation="0" T="TeamRosterGradeDto" AllowUnsorted="false">
                            <HeaderContent>
                                <MudTh><MudTableSortLabel SortBy="new Func<TeamRosterGradeDto, object>(t => t.TeamName)">Team</MudTableSortLabel></MudTh>
                                <MudTh Style="text-align:center;"><MudTableSortLabel InitialDirection="SortDirection.Descending" SortBy="new Func<TeamRosterGradeDto, object>(t => t.DepthScore)">Roster Strength</MudTableSortLabel></MudTh>
                                <MudTh Style="text-align:center; width:70px;">Score</MudTh>
                                <MudTh Style="text-align:center;"><MudTableSortLabel SortBy="new Func<TeamRosterGradeDto, object>(t => t.DynastyScore)">Dynasty</MudTableSortLabel></MudTh>
                                <MudTh Style="text-align:center; width:70px;">Score</MudTh>
                                <MudTh Style="text-align:center;"><MudTableSortLabel SortBy="new Func<TeamRosterGradeDto, object>(t => t.TeamProfile)">Profile</MudTableSortLabel></MudTh>
                                <MudTh Style="text-align:center;">
                                    <MudTableSortLabel SortBy="new Func<TeamRosterGradeDto, object>(t => t.DraftCapitalScore)">
                                        Draft Capital
                                    </MudTableSortLabel>
                                </MudTh>
                                <MudTh>Top Assets</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>
                                    <div @onclick="@(() => Nav.NavigateTo($"/league/teams?rosterId={context.SleeperRosterId}"))"
                                            style="cursor:pointer;">
                                        <MudText Typo="Typo.body2" Style="font-weight:600;" Class="fc-link-hover">@context.TeamName</MudText>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.OwnerName</MudText>
                                    </div>
                                </MudTd>
                                <MudTd Style="text-align:center;">
                                    <MudText Typo="Typo.h6" Style="@(GradeStyle(context.DepthGrade) + "font-weight:800;")">
                                        @context.DepthGrade
                                    </MudText>
                                </MudTd>
                                <MudTd Style="text-align:center;">
                                    <MudText Typo="Typo.body2" Class="font-mono mud-text-secondary">
                                        @context.DepthScore.ToString("F1")
                                    </MudText>
                                </MudTd>
                                <MudTd Style="text-align:center;">
                                    <MudText Typo="Typo.h6" Style="@(GradeStyle(context.DynastyGrade) + "font-weight:800;")">
                                        @context.DynastyGrade
                                    </MudText>
                                </MudTd>
                                <MudTd Style="text-align:center;">
                                    <MudText Typo="Typo.body2" Class="font-mono mud-text-secondary">
                                        @context.DynastyScore.ToString("F1")
                                    </MudText>
                                </MudTd>
                                <MudTd Style="text-align:center;">
                                    <MudChip T="string" Size="Size.Small"
                                             Style="@ProfileChipStyle(context.TeamProfile)"
                                             Variant="Variant.Filled">
                                        @context.TeamProfile
                                    </MudChip>
                                </MudTd>
                                <MudTd Style="text-align:center;">
                                    <MudTooltip Text="@($"{context.OwnedPickCount} future picks owned — normalized 0–100 across league")">
                                        <MudText Typo="Typo.body2" Class="font-mono" Style="@DraftCapitalStyle(context.DraftCapitalScore)">
                                            @context.DraftCapitalScore.ToString("F0")
                                        </MudText>
                                    </MudTooltip>
                                </MudTd>
                                <MudTd>
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var asset in context.TopAssets.Take(3))
                                        {
                                            <MudTooltip Text="@($"TV: {asset.TradeValue:F0} · BK: {asset.BreakoutScore:F0} · Age: {asset.Age?.ToString() ?? "—"}")">
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                                         Color="@PositionColor(asset.Position)">
                                                    @asset.PlayerName.Split(' ').Last() (@asset.Position)
                                                </MudChip>
                                            </MudTooltip>
                                        }
                                    </div>
                                </MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <MudText Class="mud-text-secondary pa-4">No teams found.</MudText>
                            </NoRecordsContent>
                        </MudTable>
                    </MudPaper>

                    <MudText Typo="Typo.caption" Class="mud-text-secondary mt-3 d-block">
                        Roster Strength: sim-median production vs. positional baselines.
                        Dynasty: trade value (42.5%) · breakout score (25.5%) · years of prime (17%) · draft capital (15%).
                        Draft Capital: future picks normalized 0–100 across league (R1=16pts, R2=8pts, 15% yearly discount).
                        Profile: Contender · Win-Now · Transitioning · Rebuilding.
                    </MudText>
                }
            }
            else
            {
                @* ── FAN-107: redraft leagues — Depth/Rank only, no dynasty concepts ── *@
                @if (_redraftGrades is null)
                {
                    <MudAlert Severity="Severity.Info" Class="mt-4">
                        No grade data available yet.
                    </MudAlert>
                }
                else
                {
                    <MudPaper Class="fc-table-paper mt-2" Elevation="0">
                        <MudTable Items="@_redraftGrades.Teams" Class="fc-table" Hover="true" Dense="true"
                                  Elevation="0" T="RedraftTeamRosterGradeDto" AllowUnsorted="false">
                            <HeaderContent>
                                <MudTh Style="width:40px;"><MudTableSortLabel SortBy="new Func<RedraftTeamRosterGradeDto, object>(t => t.Rank)">#</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel SortBy="new Func<RedraftTeamRosterGradeDto, object>(t => t.TeamName)">Team</MudTableSortLabel></MudTh>
                                <MudTh Style="text-align:center;"><MudTableSortLabel InitialDirection="SortDirection.Descending" SortBy="new Func<RedraftTeamRosterGradeDto, object>(t => t.DepthScore)">League Rank</MudTableSortLabel></MudTh>
                                <MudTh Style="text-align:center; width:70px;">Score</MudTh>
                                <MudTh Style="text-align:center;">Positions — rank in league</MudTh>
                                <MudTh>Top Assets</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>
                                    <MudText Typo="Typo.body2" Class="font-mono" Style="@RankStyle(context.Rank)">
                                        @context.Rank
                                    </MudText>
                                </MudTd>
                                <MudTd>
                                    <div @onclick="@(() => Nav.NavigateTo($"/league/teams?rosterId={context.SleeperRosterId}"))"
                                            style="cursor:pointer;">
                                        <MudText Typo="Typo.body2" Style="font-weight:600;" Class="fc-link-hover">@context.TeamName</MudText>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.OwnerName</MudText>
                                    </div>
                                </MudTd>
                                @* Placings, not letters. These numbers are a RANK WITHIN THIS LEAGUE,
                                   while My Team -> Depth Grades letters an ABSOLUTE score against fixed
                                   thresholds. Showing both as letters put two different meanings on the
                                   same symbol one tab apart, which is what made "RB A here, RB C there"
                                   look like a bug. A placing cannot be mistaken for a verdict. *@
                                <MudTd Style="text-align:center;">
                                    <MudText Typo="Typo.h6" Class="font-mono"
                                             Style="@(PlacingStyle(context.Rank, _redraftGrades.Teams.Count) + "font-weight:800;")">
                                        #@context.Rank
                                    </MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                                        of @_redraftGrades.Teams.Count
                                    </MudText>
                                </MudTd>
                                <MudTd Style="text-align:center;">
                                    <MudText Typo="Typo.body2" Class="font-mono mud-text-secondary">
                                        @context.DepthScore.ToString("F1")
                                    </MudText>
                                </MudTd>
                                <MudTd Style="text-align:center;">
                                    <div class="d-flex flex-wrap gap-1 justify-center">
                                        @foreach (var pg in context.PositionGrades)
                                        {
                                            <MudTooltip Text="@PositionChipTooltip(pg)">
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                                    <span class="font-mono" style="@PlacingStyle(pg.Placing, pg.TeamCount)">
                                                        @pg.Position&nbsp;#@pg.Placing@(HasUnprojected(pg) ? "*" : "")
                                                    </span>
                                                </MudChip>
                                            </MudTooltip>
                                        }
                                    </div>
                                </MudTd>
                                <MudTd>
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var asset in context.TopAssets.Take(3))
                                        {
                                            <MudTooltip Text="@($"Proj: {asset.SeasonAvgPoints:F1} pts")">
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                                         Color="@PositionColor(asset.Position)">
                                                    @asset.PlayerName.Split(' ').Last() (@asset.Position)
                                                </MudChip>
                                            </MudTooltip>
                                        }
                                    </div>
                                </MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <MudText Class="mud-text-secondary pa-4">No teams found.</MudText>
                            </NoRecordsContent>
                        </MudTable>
                    </MudPaper>

                    <MudText Typo="Typo.caption" Class="mud-text-secondary mt-3 d-block">
                        Every number here is a placing <em>within this league</em>, not a rating.
                        "WR&nbsp;#4" means this league's 4th-best WR room; it says nothing about whether
                        that room is good in the abstract — in a strong league, 4th can be excellent.
                        Score is sim-median starter production against positional baselines, and is what
                        the placings are ordered by. Hover a chip for the starter average behind it.
                        For an absolute read on your own roster, use My&nbsp;Team → Depth&nbsp;Grades,
                        which grades against fixed thresholds and counts your bench.
                    </MudText>
                }
            }
        </MudTabPanel>
    </MudTabs>
}

@code {
    private bool _loading = true;
    private int _season;
    private int _week;
    private LeagueStandingsDto? _standings;
    private string _topProjected = "—";
    private bool _seasonFinalized = false;

    // FAN-107: which Roster Grades table to show. Set from the active
    // league's LeagueType, same convention MyTeam.razor/OpponentTeam.razor
    // already use — anything not explicitly "Redraft" is treated as Dynasty.
    private bool _isDynastyLeague = true;

    protected override async Task OnInitializedAsync()
    {
        LeagueState.OnLeagueChanged += HandleLeagueChanged;
        await LoadAsync();
    }

    private void HandleLeagueChanged()
    {
        _ = InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
    }

    public void Dispose()
    {
        LeagueState.OnLeagueChanged -= HandleLeagueChanged;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _standings = null;
        _topProjected = "—";
        _grades = null;
        _redraftGrades = null;

        var http = HttpClientFactory.CreateClient("AuthAPI");
        (_season, _week) = await NflContext.GetContextAsync();
        _seasonFinalized = _week >= 15 || _season < DateTime.UtcNow.Year;

        var leagueId = LeagueState.ActiveLeagueId;
        if (!string.IsNullOrEmpty(leagueId))
        {
            // FAN-107: resolve league type up front so the Roster Grades tab
            // knows which table/endpoint to use once the user clicks into it.
            try
            {
                var context = await http.GetFromJsonAsync<UserContextResponse>("api/v1/identity/context");
                var activeLeague = context?.Leagues?.FirstOrDefault(l => l.LeagueId == leagueId);
                _isDynastyLeague = activeLeague?.LeagueType != "Redraft";
            }
            catch { }

            try
            {
                _standings = await http.GetFromJsonAsync<LeagueStandingsDto>(
                    $"api/v1/leagues/{leagueId}/standings?season={_season}&week={_week}");

                if (_standings?.Teams is { Count: > 0 })
                {
                    var top = _standings.Teams.MaxBy(t => t.ProjectedPointsThisWeek);
                    _topProjected = top?.TeamName ?? "—";
                }
            }
            catch { }
        }

        _loading = false;
    }

    // ── Helpers ──────────────────────────────────────────────────────
    private static string RankStyle(int rank) => rank switch
    {
        1 => "color:#F59E0B; font-weight:700;",
        2 => "color:#9CA3AF; font-weight:700;",
        3 => "color:#B45309; font-weight:700;",
        _ => ""
    };

    private static string PlayoffChipClass(string projection) => projection switch
    {
        "In" => "fc-chip-playoff-in",
        "Clinched" => "fc-chip-playoff-in",
        "Bubble" => "fc-chip-playoff-bubble",
        _ => "fc-chip-playoff-out"
    };

    private static string ProfileChipStyle(string profile) => profile switch
    {
        "Contender" => "background:#22C55E20; color:#22C55E; border:1px solid #22C55E40;",
        "Win-Now" => "background:#00C8F020; color:#00C8F0; border:1px solid #00C8F040;",
        "Transitioning" => "background:#F59E0B20; color:#F59E0B; border:1px solid #F59E0B40;",
        "Rebuilding" => "background:#F8717120; color:#F87171; border:1px solid #F8717140;",
        _ => ""
    };

    // ── Grades state ──────────────────────────────────────────────────
    private bool _gradesLoading = false;
    private LeagueRosterGradesDto? _grades;
    private RedraftLeagueRosterGradesDto? _redraftGrades;

    private async Task OnTabChanged(int index)
    {
        var needsLoad = _isDynastyLeague ? _grades is null : _redraftGrades is null;
        if (index == 1 && needsLoad && !_gradesLoading)
            await LoadGradesAsync();
    }

    private async Task LoadGradesAsync()
    {
        _gradesLoading = true;
        StateHasChanged();

        var http = HttpClientFactory.CreateClient("AuthAPI");
        var leagueId = LeagueState.ActiveLeagueId;
        if (!string.IsNullOrEmpty(leagueId))
        {
            try
            {
                if (_isDynastyLeague)
                {
                    _grades = await http.GetFromJsonAsync<LeagueRosterGradesDto>(
                        $"api/v1/leagues/{leagueId}/roster-grades?season={_season}");
                }
                else
                {
                    _redraftGrades = await http.GetFromJsonAsync<RedraftLeagueRosterGradesDto>(
                        $"api/v1/leagues/{leagueId}/redraft-roster-grades?season={_season}");
                }
            }
            catch { }
        }

        _gradesLoading = false;
        StateHasChanged();
    }

    // ── Grade helpers ─────────────────────────────────────────────────
    private static string GradeStyle(string grade) => grade switch
    {
        "A" or "A+" or "A-" => "color:#22C55E;",
        "B" or "B+" or "B-" => "color:#00C8F0;",
        "C" or "C+" or "C-" => "color:#F59E0B;",
        "D" => "color:#F87171;",
        _ => "color:#6B7280;"
    };

    private static Color PositionColor(string pos) => pos switch
    {
        "QB" => Color.Warning,
        "WR" => Color.Primary,
        "TE" => Color.Secondary,
        "RB" => Color.Success,
        _ => Color.Default
    };

    private static string DraftCapitalStyle(double score) => score switch
    {
        >= 70 => "color:#22C55E; font-weight:700;",
        >= 40 => "color:#00C8F0;",
        >= 20 => "color:#F59E0B;",
        _ => "color:#6B7280;"
    };
    // ── DTOs ──────────────────────────────────────────────────────────
    private record LeagueStandingsDto(
        string SleeperLeagueId,
        int Season,
        int Week,
