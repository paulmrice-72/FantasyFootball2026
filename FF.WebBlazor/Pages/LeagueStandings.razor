    private static bool HasUnprojected(TeamPositionGradeDto pg) =>
        pg.RosteredCount > 0 && pg.ProjectedCount < pg.RosteredCount;

    /// <summary>
    /// A placing built on an incomplete room is still a placing, but the reader
    /// deserves to know. The asterisk is the cheap version of that; the tooltip
    /// carries the detail.
    /// </summary>
    private static string PositionChipTooltip(TeamPositionGradeDto pg)
    {
        var text = $"{pg.Position}: {Ordinal(pg.Placing)} of {pg.TeamCount} in the league · " +
                   $"starters average {pg.StarterPoints:F1} pts";

        if (HasUnprojected(pg))
        {
            var missing = pg.RosteredCount - pg.ProjectedCount;
            text += $" · {missing} of {pg.RosteredCount} rostered {pg.Position} " +
                    $"{(missing == 1 ? "has" : "have")} no projection, so this placing " +
                    $"rests on {pg.ProjectedCount}";
        }

        return text;
    }

    /// <summary>
    /// Colours a within-league placing by quartile. Deliberately NOT the same
    /// palette as GradeStyle — these two scales must not look interchangeable,
    /// because they are not: this is "where you sit among N teams", GradeStyle is
    /// "how good is this in absolute terms".
    /// </summary>
    private static string PlacingStyle(int placing, int total)
    {
        if (placing <= 0 || total <= 1) return "color:var(--mud-palette-text-secondary);";

        var fraction = (placing - 1) / (double)(total - 1);   // 0 = best, 1 = worst

        return fraction switch
        {
            <= 0.25 => "color:#5eead4;",   // top quarter
            <= 0.50 => "color:#7dd3fc;",
            <= 0.75 => "color:#cbd5e1;",
            _       => "color:#94a3b8;"    // bottom quarter — muted, not alarming
        };
    }

    // 1 -> "1st", 2 -> "2nd", 11 -> "11th"
    private static string Ordinal(int n)
    {
        if (n <= 0) return "\u2014";
        var suffix = (n % 100) is >= 11 and <= 13
            ? "th"
            : (n % 10) switch { 1 => "st", 2 => "nd", 3 => "rd", _ => "th" };
        return $"{n}{suffix}";
    }

