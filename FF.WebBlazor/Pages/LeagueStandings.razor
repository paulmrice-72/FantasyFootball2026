@page "/league/standings"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav
@inject LeagueStateService LeagueState

<PageTitle>League Standings — FantasyCombine.AI</PageTitle>

<div class="fc-page-header mb-4">
    <MudText Typo="Typo.h5" Class="fc-page-title">
        <MudIcon Icon="@Icons.Material.Filled.EmojiEvents"
                 Class="mr-2" Style="vertical-align:middle;" />
        League Standings
    </MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary">
        Season @_season · Week @_week
    </MudText>
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else if (_standings is null)
{
    <MudAlert Severity="Severity.Info">
        No standings data found. Make sure your league is synced.
    </MudAlert>
}
else
{
    @* ── PLAYOFF PICTURE STRIP ─────────────────────────────── *@
    <MudGrid Spacing="3" Class="mb-6">
        <MudItem xs="6" sm="3">
            <MudPaper Class="fc-stat-card" Elevation="0">
                <MudIcon Icon="@Icons.Material.Filled.EmojiEvents"
                         Class="fc-stat-card-icon" />
                <MudText Typo="Typo.h4" Class="fc-stat-card-value fc-cyan">
                    @_standings.Teams.Count(t => t.PlayoffProjection == "In")
                </MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    Projected In
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Class="fc-stat-card" Elevation="0">
                <MudIcon Icon="@Icons.Material.Filled.SwapVert"
                         Class="fc-stat-card-icon" />
                <MudText Typo="Typo.h4" Class="fc-stat-card-value"
                         Style="color:#F59E0B;">
                    @_standings.Teams.Count(t => t.PlayoffProjection == "Bubble")
                </MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    On the Bubble
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Class="fc-stat-card" Elevation="0">
                <MudIcon Icon="@Icons.Material.Filled.Cancel"
                         Class="fc-stat-card-icon" />
                <MudText Typo="Typo.h4" Class="fc-stat-card-value"
                         Style="color:#F87171;">
                    @_standings.Teams.Count(t => t.PlayoffProjection == "Out")
                </MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    Projected Out
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Class="fc-stat-card" Elevation="0">
                <MudIcon Icon="@Icons.Material.Filled.Analytics"
                         Class="fc-stat-card-icon" />
                <MudText Typo="Typo.h4" Class="fc-stat-card-value fc-boom"
                         Style="font-size:1rem; line-height:1.3;">
                    @_topProjected
                </MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    Top Projected Week
                </MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @* ── STANDINGS TABLE ──────────────────────────────────────── *@
    <MudPaper Class="fc-table-paper" Elevation="0">
        <MudTable Items="@_standings.Teams"
                  Class="fc-table"
                  Hover="true"
                  Dense="true"
                  Elevation="0">
            <HeaderContent>
                <MudTh Style="width:40px;">#</MudTh>
                <MudTh>Team</MudTh>
                <MudTh Style="text-align:center;">W</MudTh>
                <MudTh Style="text-align:center;">L</MudTh>
                <MudTh Style="text-align:center; width:40px;">T</MudTh>
                <MudTh Style="text-align:right;">Proj Pts</MudTh>
                <MudTh Style="text-align:center;">Waiver</MudTh>
                <MudTh Style="text-align:center;">Playoff</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudText Typo="Typo.body2" Class="font-mono"
                             Style="@RankStyle(context.Rank)">
                        @context.Rank
                    </MudText>
                </MudTd>
                <MudTd>
                    <div>
                        <MudText Typo="Typo.body2" Style="font-weight:600;">
                            @context.TeamName
                        </MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @context.OwnerName
                        </MudText>
                    </div>
                </MudTd>
                <MudTd Style="text-align:center;">
                    <MudText Typo="Typo.body2" Class="font-mono fc-cyan">
                        @context.Wins
                    </MudText>
                </MudTd>
                <MudTd Style="text-align:center;">
                    <MudText Typo="Typo.body2" Class="font-mono">
                        @context.Losses
                    </MudText>
                </MudTd>
                <MudTd Style="text-align:center;">
                    <MudText Typo="Typo.body2" Class="font-mono mud-text-secondary">
                        @context.Ties
                    </MudText>
                </MudTd>
                <MudTd Style="text-align:right;">
                    @if (context.ProjectedPointsThisWeek > 0)
                    {
                        <MudText Typo="Typo.body2" Class="font-mono fc-boom">
                            @context.ProjectedPointsThisWeek.ToString("F1")
                        </MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            —
                        </MudText>
                    }
                </MudTd>
                <MudTd Style="text-align:center;">
                    <MudText Typo="Typo.body2" Class="font-mono mud-text-secondary">
                        @(context.WaiverPosition > 0 ? $"#{context.WaiverPosition}" : "—")
                    </MudText>
                </MudTd>
                <MudTd Style="text-align:center;">
                    <MudChip T="string"
                             Size="Size.Small"
                             Class="@PlayoffChipClass(context.PlayoffProjection)">
                        @context.PlayoffProjection
                    </MudChip>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="mud-text-secondary pa-4">No teams found.</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>

    @* ── PLAYOFF CUTOFF LINE LEGEND ───────────────────────────── *@
    <div class="mt-3 d-flex align-center gap-3">
        <div style="width:12px; height:12px; border-radius:2px;
        background:rgba(0,200,240,0.3);"></div>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            Projected playoff teams
        </MudText>
        <div style="width:12px; height:12px; border-radius:2px;
        background:rgba(245,158,11,0.3); margin-left:12px;"></div>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            Bubble teams
        </MudText>
    </div>
}

@code {
    private bool _loading = true;
    private int _season;
    private int _week;
    private LeagueStandingsDto? _standings;
    private string _topProjected = "—";

    protected override async Task OnInitializedAsync()
    {
        var http = HttpClientFactory.CreateClient("AuthAPI");

        // Get NFL context for season/week
        try
        {
            var ctx = await http.GetFromJsonAsync<NflContextResponse>(
                "api/v1/admin/nfl-context");
            if (ctx is not null)
            {
                _season = ctx.ActiveSeason;
                _week = ctx.ActiveWeek;
            }
        }
        catch
        {
            _season = DateTime.UtcNow.Month >= 3
                ? DateTime.UtcNow.Year
                : DateTime.UtcNow.Year - 1;
            _week = 18;
        }

        // Load standings for active league
        var leagueId = LeagueState.ActiveLeagueId;
        if (!string.IsNullOrEmpty(leagueId))
        {
            try
            {
                _standings = await http.GetFromJsonAsync<LeagueStandingsDto>(
                    $"api/v1/leagues/{leagueId}/standings?season={_season}&week={_week}");

                if (_standings?.Teams is { Count: > 0 })
                {
                    var top = _standings.Teams
                        .MaxBy(t => t.ProjectedPointsThisWeek);
                    _topProjected = top?.TeamName ?? "—";
                }
            }
            catch { }
        }

        _loading = false;
    }

    // ── Helpers ───────────────────────────────────────────────────
    private static string RankStyle(int rank) => rank switch
    {
        1 => "color:#F59E0B; font-weight:700;",  // gold
        2 => "color:#9CA3AF; font-weight:700;",  // silver
        3 => "color:#B45309; font-weight:700;",  // bronze
        _ => ""
    };

    private static string PlayoffChipClass(string projection) => projection switch
    {
        "In" => "fc-chip-playoff-in",
        "Bubble" => "fc-chip-playoff-bubble",
        _ => "fc-chip-playoff-out"
    };

    // ── DTOs ──────────────────────────────────────────────────────
    private record NflContextResponse(
        int CalendarSeason,
        int CalendarWeek,
        int ActiveSeason,
        int ActiveWeek,
        bool IsOverrideActive);

    private record LeagueStandingsDto(
        string SleeperLeagueId,
        int Season,
        int Week,
        List<TeamStandingDto> Teams);

    private record TeamStandingDto(
        string SleeperRosterId,
        string TeamName,
        string OwnerName,
        int Wins,
        int Losses,
        int Ties,
        int WaiverPosition,
        int Rank,
        decimal ProjectedPointsThisWeek,
        decimal PointsFor,
        decimal PointsAgainst,
        string PlayoffProjection);
}