@page "/writers-room/article/{ArticleId}"
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text.Json.Serialization
@using FF.Domain.Documents
@using FF.Domain.Enums
@using Microsoft.JSInterop
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>@(_article?.Title ?? "Article") — FantasyCombine.AI</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else if (_article is null)
{
    <MudAlert Severity="Severity.Error">Article not found.</MudAlert>
}
else
{
    <MudContainer MaxWidth="MaxWidth.Small" Class="pt-4">
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                   Href="/writers-room" Class="mb-3">
            Writers' Room
        </MudButton>

        <div class="d-flex align-center gap-2 mb-3">
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">
                @_article.PersonaName
            </MudChip>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                @_article.Role &nbsp;·&nbsp; Week @_article.Week, @_article.Season
                &nbsp;·&nbsp; @_article.GeneratedAt.ToString("MMM d, yyyy")
            </MudText>
        </div>

        <MudText Typo="Typo.h4" Class="mb-4" Style="font-weight: 700; line-height: 1.3;">
            @_article.Title
        </MudText>

        <div class="writers-room-body">
            @((MarkupString)(_article.Body ?? string.Empty))
        </div>

        <MudDivider Class="my-4" />

        <div class="d-flex align-center justify-space-between">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                👍 @_article.ThumbsUp &nbsp; 👎 @_article.ThumbsDown
            </MudText>
            <div class="d-flex gap-2">
                <MudButton Variant="Variant.Text" Size="Size.Small"
                           Href="@($"/writers-room/writer/{_article.PersonaId}")">
                    More from @_article.PersonaName
                </MudButton>
            </div>
        </div>
    </MudContainer>
}

@code {
    [Parameter] public string ArticleId { get; set; } = string.Empty;
    [Inject] IHttpClientFactory HttpFactory { get; set; } = default!;
    [Inject] IJSRuntime JS { get; set; } = default!;

    private static readonly JsonSerializerOptions _jsonOptions = new()
    {
        Converters = { new JsonStringEnumConverter() },
        PropertyNameCaseInsensitive = true
    };

    private ArticleDocument? _article;
    private bool _loading = true;
    private bool _copied;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            var http = HttpFactory.CreateClient("AuthAPI");
            _article = await http.GetFromJsonAsync<ArticleDocument>(
                $"api/v1/articles/{ArticleId}", _jsonOptions);
        }
        catch { _article = null; }
        finally { _loading = false; }
    }

    private async Task CopyShareLink(string articleId)
    {
        var url = $"{Nav.BaseUri}writers-room/article/{articleId}";
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
        Snackbar.Add("Share link copied to clipboard!", Severity.Success, config =>
        {
            config.VisibleStateDuration = 2500;
            config.HideTransitionDuration = 500;
            config.ShowCloseIcon = false;
        });
    }
}