@page "/dynasty"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IDialogService DialogService

<PageTitle>Dynasty — FantasyCombine.AI</PageTitle>

@* ── HEADER ─────────────────────────────────────────────── *@
<div class="fc-page-header mb-4">
    <MudText Typo="Typo.h5" Class="fc-page-title">
        <MudIcon Icon="@Icons.Material.Filled.People" Class="mr-2" Style="vertical-align:middle;" />
        Dynasty Rankings
    </MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary">
        Trade values · Breakout signals · Career projections
    </MudText>
</div>

@* ── CONTROLS ────────────────────────────────────────────── *@
<MudPaper Class="fc-controls-bar mb-4 pa-3" Elevation="0">
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="4" md="3">
            <MudTextField @bind-Value="_search"
                          Placeholder="Search player..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          DebounceInterval="200" />
        </MudItem>
        <MudItem xs="6" sm="3" md="2">
            <MudNumericField @bind-Value="_topCount"
                             Label="Show Top"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Min="10" Max="500" />
        </MudItem>
        <MudItem xs="6" sm="2" md="2" Class="d-flex align-end">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       FullWidth="true"
                       Disabled="_loading"
                       OnClick="LoadRankings"
                       Style="height:56px;">
                Load
            </MudButton>
        </MudItem>
        <MudItem xs="12" sm="3" md="5" Class="d-flex align-end justify-end gap-2">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.BarChart"
                       Disabled="_computing"
                       OnClick="RunDfv">
                @(_computing ? "Computing..." : "Recalculate Values")
            </MudButton>
            <MudButton Variant="Variant.Text"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.SwapHoriz"
                       Href="dynasty/trade">
                Trade Analyzer
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@* ── POSITION TABS ───────────────────────────────────────── *@
<MudTabs @bind-ActivePanelIndex="_activeTab"
         Rounded="true"
         Border="true"
         Class="mb-4 fc-tabs"
         PanelClass="pa-0">
    <MudTabPanel Text="All" />
    <MudTabPanel Text="QB" />
    <MudTabPanel Text="RB" />
    <MudTabPanel Text="WR" />
    <MudTabPanel Text="TE" />
</MudTabs>

@* ── LOADING / ERROR / EMPTY ─────────────────────────────── *@
@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" />
}

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}

@if (!_loading && _filtered.Count == 0 && _error is null)
{
    <MudAlert Severity="Severity.Info">
        No dynasty valuations found. Click <strong>Recalculate Values</strong> to build rankings,
        or run <strong>POST /api/v1/dynasty/career-simulations/run</strong> then
        <strong>POST /api/v1/dynasty/breakout/run</strong> then
        <strong>POST /api/v1/dynasty/dfv/calculate</strong> first.
    </MudAlert>
}
else if (_filtered.Count > 0)
{
    @* ── RANKINGS TABLE ──────────────────────────────────── *@
    <MudPaper Elevation="0" Class="fc-table-paper">
        <MudTable Items="@_filtered"
                  Dense="true"
                  Hover="true"
                  Striped="false"
                  FixedHeader="true"
                  Height="calc(100vh - 360px)"
                  SortLabel="Sort"
                  Class="fc-table"
                  OnRowClick="@((TableRowClickEventArgs<DynastyRow> args) => { if (args.Item is not null) _ = OpenPlayerDetail(args.Item); })">
            <HeaderContent>
                <MudTh Style="width:40px;">#</MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<DynastyRow, object>(x => x.PlayerName)">Player</MudTableSortLabel></MudTh>
                <MudTh>Pos</MudTh>
                <MudTh>Team</MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<DynastyRow, object>(x => x.Age)">Age</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel InitialDirection="SortDirection.Descending" SortBy="new Func<DynastyRow, object>(x => x.TradeValue)">Value</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<DynastyRow, object>(x => x.BreakoutScore)">Breakout</MudTableSortLabel></MudTh>
                <MudTh>Signal</MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<DynastyRow, object>(x => x.YearsOfPrime)">Prime Yrs</MudTableSortLabel></MudTh>
                <MudTh>Phase</MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<DynastyRow, object>(x => x.CareerValue)">Career Val</MudTableSortLabel></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="#">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @(_filtered.IndexOf(context) + 1)
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Player">
                    <MudText Typo="Typo.body2" Style="font-weight:600; color: var(--fc-cyan); cursor:pointer;">
                        @context.PlayerName
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Pos">
                    <MudChip T="string" Size="Size.Small" Class="@PositionClass(context.Position)">
                        @context.Position
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Team">
                    <MudText Typo="Typo.body2" Class="@(string.IsNullOrEmpty(context.NflTeam) ? "fc-stat mud-text-secondary" : "fc-stat")">
                        @(string.IsNullOrEmpty(context.NflTeam) ? "FA" : context.NflTeam)
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Age">
                    <MudText Typo="Typo.body2" Class="fc-stat">@context.Age</MudText>
                </MudTd>
                <MudTd DataLabel="Value">
                    <MudText Typo="Typo.body2" Class="fc-stat fc-cyan" Style="font-family:'JetBrains Mono',monospace;">
                        @context.TradeValue.ToString("F1")
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Breakout">
                    <MudProgressLinear Value="@context.BreakoutScore"
                                       Color="@BreakoutColor(context.BreakoutScore)"
                                       Rounded="true"
                                       Size="Size.Small"
                                       Style="min-width:60px;" />
                    <MudText Typo="Typo.caption" Class="fc-stat">
                        @context.BreakoutScore.ToString("F0")
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Signal">
                    @if (context.BreakoutClassification == "Breakout")
                    {
                        <MudChip T="string" Size="Size.Small" Class="fc-chip-boom">🚀 Breakout</MudChip>
                    }
                    else if (context.BreakoutClassification == "Declining")
                    {
                        <MudChip T="string" Size="Size.Small" Class="fc-chip-bust">📉 Declining</MudChip>
                    }
                    else if (context.BreakoutClassification == "OnCurve")
                    {
                        <MudChip T="string" Size="Size.Small" Class="fc-chip-neutral">✓ On Curve</MudChip>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">—</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Prime Yrs">
                    <MudText Typo="Typo.body2" Class="fc-stat">
                        @context.YearsOfPrime.ToString("F0")
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Phase">
                    <MudText Typo="Typo.caption" Class="@PhaseClass(context.CareerPhase)">
                        @context.CareerPhase
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Career Val">
                    <MudText Typo="Typo.body2" Class="fc-stat mud-text-secondary"
                             Style="font-family:'JetBrains Mono',monospace;">
                        @context.CareerValue.ToString("F0")
                    </MudText>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 25, 50, 100, 200 }" />
            </PagerContent>
        </MudTable>
    </MudPaper>
}



@code {
    // ── State ─────────────────────────────────────────────────
    private int _topCount = 100;
    private string _search = string.Empty;
    private int _activeTab = 0;
    private bool _loading;
    private bool _computing;
    private string? _error;

    private List<DynastyRow> _all = [];
    private List<DynastyRow> _filtered = [];

    private static readonly string[] Positions = ["", "QB", "RB", "WR", "TE"];

    // ── Lifecycle ─────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
        => await LoadRankings();

    // ── Data loading ──────────────────────────────────────────
    private async Task LoadRankings()
    {
        _loading = true;
        _error = null;
        _all = [];
        StateHasChanged();

        try
        {
            var position = Positions[_activeTab];
            var posParam = string.IsNullOrEmpty(position) ? "" : $"&position={position}";
            var rows = await Http.GetFromJsonAsync<List<DynastyRow>>(
                $"api/v1/dynasty/valuations?top={_topCount}{posParam}");
            _all = rows ?? [];

            if (_all.Count == 0)
                Snackbar.Add("No dynasty valuations found. Run Recalculate Values first.", Severity.Warning);
        }
        catch (Exception ex)
        {
            _error = $"Failed to load dynasty rankings: {ex.Message}";
        }
        finally
        {
            _loading = false;
            ApplyFilters();
        }
    }

    private async Task RunDfv()
    {
        _computing = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            // Chain: career sims → breakout → DFV
            await Http.PostAsync($"api/v1/dynasty/career-simulations/run?season=2026", null);
            await Http.PostAsync($"api/v1/dynasty/breakout/run?season=2026", null);
            var resp = await Http.PostAsync($"api/v1/dynasty/dfv/calculate?season=2026", null);

            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add("Dynasty values recalculated.", Severity.Success);
                await LoadRankings();
            }
            else
            {
                Snackbar.Add("Recalculation failed — check API logs.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _computing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OpenPlayerDetail(DynastyRow player)
    {
        var data = new PlayerCardDialog.PlayerCardData(
            SleeperPlayerId: player.SleeperPlayerId,
            FullName: player.PlayerName,
            Position: player.Position,
            NflTeam: player.NflTeam,
            Age: player.Age,
            DraftRound: null,
            DraftPick: null,
            CollegeTeam: null,
            HeadshotUrl: $"https://sleepercdn.com/content/nfl/players/thumb/{player.SleeperPlayerId}.jpg",
            FantasyProsRank: null,
            FantasyProsTier: null,
            PffGrade: null,
            PffRank: null,
            ConsensusAdp: null,
            DynastyScore: player.TradeValue,
            DraftCapitalScore: 0,
            PositionalScore: 0,
            ValuationBlendScore: player.CareerValue,
            FantasyProsScore: player.BreakoutScore,
            PffGradeScore: 0,
            ConsensusAdpScore: 0,
            AgeMultiplier: 0);

        var parameters = new DialogParameters<PlayerCardDialog>
    {
        { x => x.Player, data }
    };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseButton = true
        };
        await DialogService.ShowAsync<PlayerCardDialog>(player.PlayerName, parameters, options);
    }

    // ── Filtering ─────────────────────────────────────────────
    private void ApplyFilters()
    {
        var position = Positions[_activeTab];

        _filtered = _all
            .Where(p => string.IsNullOrEmpty(position) || p.Position == position)
            .Where(p => string.IsNullOrEmpty(_search) ||
                        p.PlayerName.Contains(_search, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(p => p.TradeValue)
            .ToList();

        StateHasChanged();
    }

    private int _prevTab;
    private string _prevSearch = string.Empty;

    protected override void OnAfterRender(bool firstRender)
    {
        if (_activeTab != _prevTab || _search != _prevSearch)
        {
            _prevTab = _activeTab;
            _prevSearch = _search;
            ApplyFilters();
        }
    }

    // ── Helpers ───────────────────────────────────────────────
    private static string PositionClass(string pos) => pos switch
    {
        "QB" => "fc-chip-qb",
        "RB" => "fc-chip-rb",
        "WR" => "fc-chip-wr",
        "TE" => "fc-chip-te",
        _ => ""
    };

    private static Color BreakoutColor(double score) => score switch
    {
        >= 65 => Color.Success,
        >= 40 => Color.Warning,
        _ => Color.Default
    };

    private static string PhaseClass(string phase) => phase switch
    {
        "Ascending" => "fc-stat fc-cyan",
        "Prime" => "fc-stat fc-ceiling",
        "Declining" => "fc-stat fc-bust",
        _ => "fc-stat mud-text-secondary"
    };

    // ── DTOs ──────────────────────────────────────────────────
    private record DynastyRow(
        string SleeperPlayerId,
        string PlayerName,
        string Position,
        string NflTeam,
        int Age,
        int? YearsExperience,
        double TradeValue,
        double BreakoutScore,
        string BreakoutClassification,
        List<string> BreakoutSignals,
        double CareerValueScore,
        double YearsOfPrimeRemaining,
        string CareerPhase)
    {
        public double YearsOfPrime => YearsOfPrimeRemaining;
        public double CareerValue => CareerValueScore;
    }

    private record CareerSimResponse(
        string SleeperPlayerId,
        string Position,
        int CurrentAge,
        List<CareerYearRow> YearProjections);

    private record CareerYearRow(
        int Year,
        int AgeAtYear,
        double MedianFppg,
        double FloorFppg,
        double CeilingFppg,
        double InjuryRisk,
        double AgingMultiplier,
        string Phase);
}