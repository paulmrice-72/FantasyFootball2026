@page "/trade"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IDialogService DialogService

<PageTitle>Trade Analyzer — FantasyCombine.AI</PageTitle>

@* ── HEADER ─────────────────────────────────────────────── *@
<div class="fc-page-header mb-4">
    <MudText Typo="Typo.h5" Class="fc-page-title">
        <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Class="mr-2" Style="vertical-align:middle;" />
        Trade Analyzer
    </MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary">
        @if (_mode == TradeMode.Dynasty)
        {
            <span>Dynasty trade value comparison · Powered by DFV model</span>
        }
        else
        {
            <span>Redraft trade value comparison · Powered by weekly projections</span>
        }
    </MudText>
</div>

@* ── MODE TOGGLE ─────────────────────────────────────────── *@
<div class="d-flex align-center mb-4 gap-3">
    <MudText Typo="Typo.body2" Class="mud-text-secondary">Mode:</MudText>
    <MudToggleGroup T="TradeMode" @bind-Value="_mode" SelectionMode="SelectionMode.SingleSelection"
                    Color="Color.Primary" CheckMark="false" Delimiters="false" Rounded="true" Class="fc-mode-toggle">
        <MudToggleItem Value="TradeMode.Dynasty" Text="Dynasty" UnselectedIcon="@Icons.Material.Filled.Timeline" />
        <MudToggleItem Value="TradeMode.Redraft" Text="Redraft" UnselectedIcon="@Icons.Material.Filled.CalendarToday" />
    </MudToggleGroup>
    @if (_mode == TradeMode.Redraft)
    {
        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text"
                 Icon="@Icons.Material.Filled.Info">
            Values = median projected points this week
        </MudChip>
    }
</div>

@* ── TRADE BUILDER ───────────────────────────────────────── *@
<MudGrid Spacing="3" Class="mb-4">

    @* ── MY SIDE ──────────────────────────────────────────── *@
    <MudItem xs="12" md="5">
        <MudPaper Class="pa-4 fc-controls-bar" Elevation="0">
            <MudText Typo="Typo.subtitle1" Class="mb-3" Style="color:var(--fc-cyan);">
                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Class="mr-1" />
                I Give Up
            </MudText>

            <MudAutocomplete T="PlayerSearchResult"
                             @bind-Value="_mySearchResult"
                             SearchFunc="SearchPlayers"
                             Disabled="@(!_playersLoaded)"
                             ToStringFunc="@(p => p?.PlayerName ?? string.Empty)"
                             Label="Add player..."
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Clearable="true"
                             Class="mb-2"
                             AdornmentIcon="@Icons.Material.Filled.PersonAdd"
                             Adornment="Adornment.End"
                             MinCharacters="2"
                             ResetValueOnEmptyText="true"
                             CoerceText="false" />

            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Add"
                       Disabled="@(_mySearchResult is null)"
                       OnClick="AddToMySide" Class="mb-3">
                Add
            </MudButton>

            @* ── PICK SELECTOR ───────────────────────────── *@
            @if (_mode == TradeMode.Dynasty)
            {
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary mb-1">Add Draft Pick</MudText>
                <div class="d-flex gap-2 mb-2">
                    <MudSelect T="int" @bind-Value="_myPickYear" Label="Year" Variant="Variant.Outlined"
                               Margin="Margin.Dense" Style="max-width:120px;">
                        <MudSelectItem Value="2026">2026</MudSelectItem>
                        <MudSelectItem Value="2027">2027</MudSelectItem>
                        <MudSelectItem Value="2028">2028</MudSelectItem>
                    </MudSelect>
                    <MudSelect T="int" @bind-Value="_myPickRound" Label="Round" Variant="Variant.Outlined"
                               Margin="Margin.Dense" Style="max-width:90px;">
                        <MudSelectItem Value="1">1st</MudSelectItem>
                        <MudSelectItem Value="2">2nd</MudSelectItem>
                        <MudSelectItem Value="3">3rd</MudSelectItem>
                    </MudSelect>
                    <MudSelect T="string" @bind-Value="_myPickTier" Label="Tier" Variant="Variant.Outlined"
                               Margin="Margin.Dense" Style="max-width:90px;">
                        <MudSelectItem Value="@("Early")">Early</MudSelectItem>
                        <MudSelectItem Value="@("Mid")">Mid</MudSelectItem>
                        <MudSelectItem Value="@("Late")">Late</MudSelectItem>
                    </MudSelect>
                </div>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddPickToMySide" Class="mb-3">
                    Add Pick
                </MudButton>
            }

            @if (_mySide.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">No players added yet.</MudText>
            }
            else
            {
                @foreach (var player in _mySide)
                {
                    <MudPaper Class="pa-2 mb-2 d-flex align-center justify-space-between" Elevation="1"
                              Style="background:rgba(255,255,255,0.03);">
                        <div>
                            @{ var tp = player; }
                            <MudButton Variant="Variant.Text"
                                       Style="font-weight:600; color:var(--fc-cyan); padding:0; min-width:0; text-transform:none;"
                                       OnClick="@(() => _ = OpenPlayerCardAsync(tp))">
                                @player.PlayerName
                            </MudButton>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                @player.Position · Age @player.Age ·
                                <span style="color:var(--fc-cyan);">
                                    @ValueDisplay(player)
                                </span>
                            </MudText>
                        </div>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                       Color="Color.Error"
                                       OnClick="@(() => RemoveFromMySide(player))" />
                    </MudPaper>
                }
                <MudDivider Class="my-2" />
                <div class="d-flex justify-space-between">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Total Value</MudText>
                    <MudText Typo="Typo.subtitle2" Style="color:var(--fc-cyan);">
                        @_mySide.Sum(p => p.TradeValue).ToString("F1")
                    </MudText>
                </div>
            }
        </MudPaper>
    </MudItem>

    @* ── CENTRE ────────────────────────────────────────────── *@
    <MudItem xs="12" md="2" Class="d-flex flex-column align-center justify-center">
        <MudIcon Icon="@Icons.Material.Filled.SwapHoriz"
                 Style="font-size:2.5rem;color:var(--fc-cyan);opacity:0.4;" Class="mb-3" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Calculate"
                   FullWidth="true"
                   Disabled="@(_analyzing || _mySide.Count == 0 || _theirSide.Count == 0)"
                   OnClick="AnalyzeTrade">
            @(_analyzing ? "Analyzing..." : "Analyze")
        </MudButton>
        @if (_mySide.Count > 0 || _theirSide.Count > 0)
        {
            <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                       Class="mt-2" OnClick="ClearAll">
                Clear
            </MudButton>
        }
    </MudItem>

    @* ── THEIR SIDE ────────────────────────────────────────── *@
    <MudItem xs="12" md="5">
        <MudPaper Class="pa-4 fc-controls-bar" Elevation="0">
            <MudText Typo="Typo.subtitle1" Class="mb-3" Style="color:var(--fc-cyan);">
                <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" Class="mr-1" />
                I Receive
            </MudText>

            <MudAutocomplete T="PlayerSearchResult"
                             @bind-Value="_theirSearchResult"
                             SearchFunc="SearchPlayers"
                             ToStringFunc="@(p => p?.PlayerName ?? string.Empty)"
                             Label="Add player..."
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Clearable="true"
                             Class="mb-2"
                             AdornmentIcon="@Icons.Material.Filled.PersonAdd"
                             Adornment="Adornment.End"
                             MinCharacters="2"
                             ResetValueOnEmptyText="true"
                             CoerceText="false" />

            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Add"
                       Disabled="@(_theirSearchResult is null)"
                       OnClick="AddToTheirSide" Class="mb-3">
                Add
            </MudButton>

            @* ── PICK SELECTOR — FIX: bound to _theirPickYear/Round/Tier ─── *@
            @if (_mode == TradeMode.Dynasty)
            {
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary mb-1">Add Draft Pick</MudText>
                <div class="d-flex gap-2 mb-2">
                    <MudSelect T="int" @bind-Value="_theirPickYear" Label="Year" Variant="Variant.Outlined"
                               Margin="Margin.Dense" Style="max-width:120px;">
                        <MudSelectItem Value="2026">2026</MudSelectItem>
                        <MudSelectItem Value="2027">2027</MudSelectItem>
                        <MudSelectItem Value="2028">2028</MudSelectItem>
                    </MudSelect>
                    <MudSelect T="int" @bind-Value="_theirPickRound" Label="Round" Variant="Variant.Outlined"
                               Margin="Margin.Dense" Style="max-width:90px;">
                        <MudSelectItem Value="1">1st</MudSelectItem>
                        <MudSelectItem Value="2">2nd</MudSelectItem>
                        <MudSelectItem Value="3">3rd</MudSelectItem>
                    </MudSelect>
                    <MudSelect T="string" @bind-Value="_theirPickTier" Label="Tier" Variant="Variant.Outlined"
                               Margin="Margin.Dense" Style="max-width:90px;">
                        <MudSelectItem Value="@("Early")">Early</MudSelectItem>
                        <MudSelectItem Value="@("Mid")">Mid</MudSelectItem>
                        <MudSelectItem Value="@("Late")">Late</MudSelectItem>
                    </MudSelect>
                </div>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddPickToTheirSide" Class="mb-3">
                    Add Pick
                </MudButton>
            }

            @if (_theirSide.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">No players added yet.</MudText>
            }
            else
            {
                @foreach (var player in _theirSide)
                {
                    <MudPaper Class="pa-2 mb-2 d-flex align-center justify-space-between" Elevation="1"
                              Style="background:rgba(255,255,255,0.03);">
                        <div>
                            @{ var tp = player; }
                            <MudButton Variant="Variant.Text"
                                       Style="font-weight:600; color:var(--fc-cyan); padding:0; min-width:0; text-transform:none;"
                                       OnClick="@(() => _ = OpenPlayerCardAsync(tp))">
                                @player.PlayerName
                            </MudButton>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                @player.Position · Age @player.Age ·
                                <span style="color:var(--fc-cyan);">
                                    @ValueDisplay(player)
                                </span>
                            </MudText>
                        </div>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                       Color="Color.Error"
                                       OnClick="@(() => RemoveFromTheirSide(player))" />
                    </MudPaper>
                }
                <MudDivider Class="my-2" />
                <div class="d-flex justify-space-between">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Total Value</MudText>
                    <MudText Typo="Typo.subtitle2" Style="color:var(--fc-cyan);">
                        @_theirSide.Sum(p => p.TradeValue).ToString("F1")
                    </MudText>
                </div>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@* ── LOADING ─────────────────────────────────────────────── *@
@if (_analyzing)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" />
}

@* ── REDRAFT RESULT PANEL ────────────────────────────────── *@
@if (_mode == TradeMode.Redraft && _redraftResult is not null)
{
    var diff = _redraftResult.TheirTotal - _redraftResult.MyTotal;
    var gc = diff > 2 ? "#4CAF50" : diff < -2 ? "#F44336" : "#FFC107";
    var verdict = diff > 2 ? "WIN" : diff < -2 ? "LOSS" : "FAIR";

    <MudPaper Class="pa-4 mb-4" Elevation="2" Style="@("border-left:4px solid " + gc + ";")">
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="3" Class="d-flex flex-column align-center justify-center">
                <MudText Typo="Typo.h2"
                         Style="@("font-weight:900;color:" + gc + ";font-family:'JetBrains Mono',monospace;")">
                    @verdict
                </MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Redraft Verdict</MudText>
            </MudItem>
            <MudItem xs="12" sm="5">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Projected Points Comparison</MudText>
                <div class="d-flex align-center gap-3 mb-1">
                    <MudText Typo="Typo.body2" Style="min-width:80px;">You Give</MudText>
                    <MudProgressLinear Value="@RedraftBarPct(_redraftResult.MyTotal)"
                                       Color="Color.Error" Rounded="true" Size="Size.Medium" Style="flex:1;" />
                    <MudText Typo="Typo.body2" Class="fc-stat"
                             Style="min-width:50px;font-family:'JetBrains Mono',monospace;">
                        @_redraftResult.MyTotal.ToString("F1") pts
                    </MudText>
                </div>
                <div class="d-flex align-center gap-3">
                    <MudText Typo="Typo.body2" Style="min-width:80px;">You Get</MudText>
                    <MudProgressLinear Value="@RedraftBarPct(_redraftResult.TheirTotal)"
                                       Color="Color.Success" Rounded="true" Size="Size.Medium" Style="flex:1;" />
                    <MudText Typo="Typo.body2" Class="fc-stat"
                             Style="min-width:50px;font-family:'JetBrains Mono',monospace;">
                        @_redraftResult.TheirTotal.ToString("F1") pts
                    </MudText>
                </div>
                <MudText Typo="Typo.caption" Class="mt-2" Style="@("color:" + gc + ";")">
                    @(diff >= 0 ? $"You gain {Math.Abs(diff):F1} projected points" : $"You lose {Math.Abs(diff):F1} projected points")
                </MudText>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Player Breakdown</MudText>
                @foreach (var p in _redraftResult.MyPlayers)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @p.PlayerName — <span style="color:#F44336;">@p.MedianProjectedPoints.ToString("F1") pts</span>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@p.ValueLabel</MudChip>
                    </MudText>
                }
                <MudDivider Class="my-1" />
                @foreach (var p in _redraftResult.TheirPlayers)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @p.PlayerName — <span style="color:#4CAF50;">@p.MedianProjectedPoints.ToString("F1") pts</span>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@p.ValueLabel</MudChip>
                    </MudText>
                }
            </MudItem>
        </MudGrid>
    </MudPaper>
}

@* ── DYNASTY RESULT PANEL ────────────────────────────────── *@
@if (_mode == TradeMode.Dynasty && _dynastyResult is not null)
{
    var gc = GradeColor(_dynastyResult.Grade);

    <MudPaper Class="pa-4 mb-4" Elevation="2" Style="@("border-left:4px solid " + gc + ";")">
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="3" Class="d-flex flex-column align-center justify-center">
                <MudText Typo="Typo.h2"
                         Style="@("font-weight:900;color:" + gc + ";font-family:'JetBrains Mono',monospace;")">
                    @_dynastyResult.Grade
                </MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Trade Grade</MudText>
            </MudItem>
            <MudItem xs="12" sm="5">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Value Comparison</MudText>
                <div class="d-flex align-center gap-3 mb-1">
                    <MudText Typo="Typo.body2" Style="min-width:80px;">You Give</MudText>
                    <MudProgressLinear Value="@ValueBarPct(_dynastyResult.MySideValue)"
                                       Color="Color.Error" Rounded="true" Size="Size.Medium" Style="flex:1;" />
                    <MudText Typo="Typo.body2" Class="fc-stat"
                             Style="min-width:40px;font-family:'JetBrains Mono',monospace;">
                        @_dynastyResult.MySideValue.ToString("F1")
                    </MudText>
                </div>
                <div class="d-flex align-center gap-3">
                    <MudText Typo="Typo.body2" Style="min-width:80px;">You Get</MudText>
                    <MudProgressLinear Value="@ValueBarPct(_dynastyResult.TheirSideValue)"
                                       Color="Color.Success" Rounded="true" Size="Size.Medium" Style="flex:1;" />
                    <MudText Typo="Typo.body2" Class="fc-stat"
                             Style="min-width:40px;font-family:'JetBrains Mono',monospace;">
                        @_dynastyResult.TheirSideValue.ToString("F1")
                    </MudText>
                </div>
                <MudText Typo="Typo.caption" Class="mt-2" Style="@("color:" + gc + ";")">
                    @_dynastyResult.Recommendation
                </MudText>
            </MudItem>
            <MudItem xs="12" sm="4">
                @if (_dynastyResult.KeyInsights.Count > 0)
                {
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Key Insights</MudText>
                    @foreach (var insight in _dynastyResult.KeyInsights)
                    {
                        <div class="d-flex align-start mb-1">
                            <MudIcon Icon="@Icons.Material.Filled.Lightbulb" Size="Size.Small"
                                     Style="color:var(--fc-cyan);margin-right:6px;margin-top:2px;" />
                            <MudText Typo="Typo.body2">@insight</MudText>
                        </div>
                    }
                }
            </MudItem>
        </MudGrid>
    </MudPaper>
}

@* ── TRADE HISTORY (Dynasty only) ────────────────────────── *@
@if (_mode == TradeMode.Dynasty && _history.Count > 0)
{
    <MudText Typo="Typo.subtitle1" Class="mb-2">Recent Trades</MudText>
    <MudPaper Elevation="0" Class="fc-table-paper">
        <MudTable Items="@_history" Dense="true" Hover="true" Class="fc-table">
            <HeaderContent>
                <MudTh>Date</MudTh>
                <MudTh>I Gave</MudTh>
                <MudTh>I Got</MudTh>
                <MudTh>My Value</MudTh>
                <MudTh>Their Value</MudTh>
                <MudTh>Grade</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @context.AnalyzedAt.ToLocalTime().ToString("MMM d, h:mm tt")
                    </MudText>
                </MudTd>
                <MudTd>
                    <MudText Typo="Typo.body2">
                        @string.Join(", ", context.MySide.Select(p => p.PlayerName))
                    </MudText>
                </MudTd>
                <MudTd>
                    <MudText Typo="Typo.body2">
                        @string.Join(", ", context.TheirSide.Select(p => p.PlayerName))
                    </MudText>
                </MudTd>
                <MudTd>
                    <MudText Typo="Typo.body2" Class="fc-stat"
                             Style="font-family:'JetBrains Mono',monospace;">
                        @context.MySideValue.ToString("F1")
                    </MudText>
                </MudTd>
                <MudTd>
                    <MudText Typo="Typo.body2" Class="fc-stat"
                             Style="font-family:'JetBrains Mono',monospace;">
                        @context.TheirSideValue.ToString("F1")
                    </MudText>
                </MudTd>
                <MudTd>
                    <MudText Typo="Typo.body2"
                             Style="@("font-weight:900;color:" + GradeColor(context.Grade) + ";font-family:'JetBrains Mono',monospace;")">
                        @context.Grade
                    </MudText>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@code {
    // ── Mode ────────────────────────────────────────────────── 
    private enum TradeMode { Dynasty, Redraft }
    private TradeMode _mode = TradeMode.Dynasty;

    [SupplyParameterFromQuery(Name = "mode")]
    public string? ModeParam { get; set; }

    // ── State ───────────────────────────────────────────────── 
    private List<TradePlayerItem> _mySide = [];
    private List<TradePlayerItem> _theirSide = [];
    private PlayerSearchResult? _mySearchResult;
    private PlayerSearchResult? _theirSearchResult;
    private bool _analyzing;
    private TradeResultModel? _dynastyResult;
    private RedraftResultModel? _redraftResult;
    private List<TradeHistoryItem> _history = [];
    private List<PlayerSearchResult> _allPlayers = [];
    private bool _playersLoaded;

    private HttpClient Http => HttpClientFactory.CreateClient("AuthAPI");

    // ── Pick selector state ──────────────────────────────────── 
    // FIX: each side has its own independent year/round/tier bindings
    private int _myPickYear = 2026;
    private int _myPickRound = 1;
    private string _myPickTier = "Mid";

    private int _theirPickYear = 2026;   // was incorrectly bound to _myPickYear
    private int _theirPickRound = 1;     // was incorrectly bound to _myPickRound
    private string _theirPickTier = "Mid"; // was incorrectly bound to _myPickTier

    // FIX: counter to give each pick a unique slot identity so that
    // two picks with identical Year/Round/Tier can coexist and be 
    // removed individually (e.g. two 2026 Mid 1sts)
    private int _pickSlotCounter = 0;

    private void AddPickToMySide()
    {
        _mySide.Add(new TradePlayerItem(
            string.Empty,
            $"{_myPickYear} {_myPickTier} {OrdinalRound(_myPickRound)}",
            "PICK", 0, 0,
            IsDraftPick: true,
            PickRound: _myPickRound,
            PickTier: _myPickTier,
            PickYear: _myPickYear,
            PickSlot: ++_pickSlotCounter));
        _dynastyResult = null;
        _redraftResult = null;
    }

    private void AddPickToTheirSide()
    {
        _theirSide.Add(new TradePlayerItem(
            string.Empty,
            $"{_theirPickYear} {_theirPickTier} {OrdinalRound(_theirPickRound)}",
            "PICK", 0, 0,
            IsDraftPick: true,
            PickRound: _theirPickRound,
            PickTier: _theirPickTier,
            PickYear: _theirPickYear,
            PickSlot: ++_pickSlotCounter));
        _dynastyResult = null;
        _redraftResult = null;
    }

    private static string OrdinalRound(int round) => round switch
    {
        1 => "1st",
        2 => "2nd",
        3 => "3rd",
        _ => $"{round}th"
    };

    // ── Lifecycle ───────────────────────────────────────────── 
    protected override async Task OnInitializedAsync()
    {
        if (ModeParam?.Equals("redraft", StringComparison.OrdinalIgnoreCase) == true)
            _mode = TradeMode.Redraft;

        await LoadPlayersForSearch();
        await LoadHistory();
    }

    private void SetMode(TradeMode mode)
    {
        _mode = mode;
        ClearAll();
    }

    // ── Data loading ────────────────────────────────────────── 
    private async Task LoadPlayersForSearch()
    {
        try
        {
            var rows = await Http.GetFromJsonAsync<List<PlayerSearchResult>>(
                "api/v1/dynasty/valuations?top=500");
            _allPlayers = rows ?? [];
            _playersLoaded = true;
        }
        catch
        {
            _playersLoaded = false;
        }
    }

    private async Task LoadHistory()
    {
        try
        {
            var history = await Http.GetFromJsonAsync<List<TradeHistoryItem>>(
                "api/v1/trade/history");
            _history = history ?? [];
        }
        catch { /* non-fatal */ }
    }

    // ── Search ──────────────────────────────────────────────── 
    private Task<IEnumerable<PlayerSearchResult>> SearchPlayers(
        string value, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Length < 2)
            return Task.FromResult(Enumerable.Empty<PlayerSearchResult>());

        var results = _allPlayers
            .Where(p => p.PlayerName.Contains(value, StringComparison.OrdinalIgnoreCase))
            .Take(10);

        return Task.FromResult(results);
    }

    // ── Add / Remove ────────────────────────────────────────── 
    private void AddToMySide()
    {
        if (_mySearchResult is null) return;

        if (_mySide.Any(p => p.SleeperPlayerId == _mySearchResult.SleeperPlayerId))
        {
            Snackbar.Add("Player already added.", Severity.Warning);
            return;
        }

        _mySide.Add(new TradePlayerItem(
            _mySearchResult.SleeperPlayerId,
            _mySearchResult.PlayerName,
            _mySearchResult.Position,
            _mySearchResult.Age,
            _mySearchResult.TradeValue));

        _mySearchResult = null;
        _dynastyResult = null;
        _redraftResult = null;
    }

    private void AddToTheirSide()
    {
        if (_theirSearchResult is null) return;

        if (_theirSide.Any(p => p.SleeperPlayerId == _theirSearchResult.SleeperPlayerId))
        {
            Snackbar.Add("Player already added.", Severity.Warning);
            return;
        }

        _theirSide.Add(new TradePlayerItem(
            _theirSearchResult.SleeperPlayerId,
            _theirSearchResult.PlayerName,
            _theirSearchResult.Position,
            _theirSearchResult.Age,
            _theirSearchResult.TradeValue));

        _theirSearchResult = null;
        _dynastyResult = null;
        _redraftResult = null;
    }

    private void RemoveFromMySide(TradePlayerItem player)
    {
        _mySide.Remove(player);
        _dynastyResult = null;
        _redraftResult = null;
    }

    private void RemoveFromTheirSide(TradePlayerItem player)
    {
        _theirSide.Remove(player);
        _dynastyResult = null;
        _redraftResult = null;
    }

    private void ClearAll()
    {
        _mySide.Clear();
        _theirSide.Clear();
        _dynastyResult = null;
        _redraftResult = null;
    }

    // ── Analyze ─────────────────────────────────────────────── 
    private async Task AnalyzeTrade()
    {
        if (_mySide.Count == 0 || _theirSide.Count == 0) return;

        _analyzing = true;
        _dynastyResult = null;
        _redraftResult = null;
        StateHasChanged();

        try
        {
            if (_mode == TradeMode.Dynasty)
                await AnalyzeDynasty();
            else
                await AnalyzeRedraft();
        }
        finally
        {
            _analyzing = false;
            StateHasChanged();
        }
    }

    private async Task AnalyzeDynasty()
    {
        try
        {
            var request = new
            {
                MyPlayerIds = _mySide.Where(p => !p.IsDraftPick).Select(p => p.SleeperPlayerId).ToList(),
                TheirPlayerIds = _theirSide.Where(p => !p.IsDraftPick).Select(p => p.SleeperPlayerId).ToList(),
                MyPicks = _mySide.Where(p => p.IsDraftPick)
                    .Select(p => new { Round = p.PickRound!.Value, Tier = p.PickTier!, Year = p.PickYear!.Value })
                    .ToList(),
                TheirPicks = _theirSide.Where(p => p.IsDraftPick)
                    .Select(p => new { Round = p.PickRound!.Value, Tier = p.PickTier!, Year = p.PickYear!.Value })
                    .ToList(),
                Season = 2026
            };

            var response = await Http.PostAsJsonAsync("api/v1/trade/analyze", request);
            if (response.IsSuccessStatusCode)
            {
                _dynastyResult = await response.Content.ReadFromJsonAsync<TradeResultModel>();
                await LoadHistory();
            }
            else
            {
                Snackbar.Add("Trade analysis failed — check API.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task AnalyzeRedraft()
    {
        try
        {
            var allIds = _mySide.Concat(_theirSide)
                .Select(p => p.SleeperPlayerId)
                .Distinct()
                .ToList();

            var joined = string.Join(",", allIds);
            var dtos = await Http.GetFromJsonAsync<List<RedraftValueDto>>(
                $"api/v1/trade/value/redraft?playerIds={joined}");

            if (dtos is null || dtos.Count == 0)
            {
                Snackbar.Add("No redraft projection data found for these players.", Severity.Warning);
                return;
            }

            var lookup = dtos.ToDictionary(d => d.SleeperPlayerId);

            var myPlayers = _mySide.Select(p =>
                lookup.TryGetValue(p.SleeperPlayerId, out var d)
                    ? d
                    : new RedraftValueDto(p.SleeperPlayerId, p.PlayerName, p.Position, string.Empty, 0, "N/A"))
                .ToList();

            var theirPlayers = _theirSide.Select(p =>
                lookup.TryGetValue(p.SleeperPlayerId, out var d)
                    ? d
                    : new RedraftValueDto(p.SleeperPlayerId, p.PlayerName, p.Position, string.Empty, 0, "N/A"))
                .ToList();

            _redraftResult = new RedraftResultModel(
                myPlayers,
                theirPlayers,
                myPlayers.Sum(p => p.MedianProjectedPoints),
                theirPlayers.Sum(p => p.MedianProjectedPoints));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    // ── Display helpers ─────────────────────────────────────── 
    private string ValueDisplay(TradePlayerItem player)
    {
        if (_mode == TradeMode.Redraft)
        {
            if (_redraftResult is not null)
            {
                var all = _redraftResult.MyPlayers.Concat(_redraftResult.TheirPlayers);
                var match = all.FirstOrDefault(p => p.SleeperPlayerId == player.SleeperPlayerId);
                if (match is not null) return $"{match.MedianProjectedPoints:F1} pts ({match.ValueLabel})";
            }
            return $"Dynasty Val {player.TradeValue:F1}";
        }
        return $"Val {player.TradeValue:F1}";
    }

    private double MaxDynastyValue => Math.Max(
        _dynastyResult?.MySideValue ?? 0,
        _dynastyResult?.TheirSideValue ?? 0);

    private double ValueBarPct(double value) =>
        MaxDynastyValue > 0 ? value / MaxDynastyValue * 100.0 : 0;

    private double MaxRedraftValue => _redraftResult is null
        ? 1
        : Math.Max(_redraftResult.MyTotal, _redraftResult.TheirTotal);

    private double RedraftBarPct(double value) =>
        MaxRedraftValue > 0 ? value / MaxRedraftValue * 100.0 : 0;

    private static string GradeColor(string grade) => grade switch
    {
        "A" => "#00C8F0",
        "B" => "#4CAF50",
        "C" => "#FFC107",
        "D" => "#FF9800",
        "F" => "#F44336",
        _ => "#888888"
    };

