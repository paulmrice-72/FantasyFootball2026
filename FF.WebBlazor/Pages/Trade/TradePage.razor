            NflTeam: null,
            Age: player.Age,
            DraftRound: null,
            DraftPick: null,
            CollegeTeam: null,
            HeadshotUrl: $"https://sleepercdn.com/content/nfl/players/thumb/{player.SleeperPlayerId}.jpg",
            FantasyProsRank: null,
            FantasyProsTier: null,
            PffGrade: null,
            PffRank: null,
            ConsensusAdp: null,
            DynastyScore: player.TradeValue,
            DraftCapitalScore: 0,
            PositionalScore: 0,
            ValuationBlendScore: 0,
            FantasyProsScore: 0,
            PffGradeScore: 0,
