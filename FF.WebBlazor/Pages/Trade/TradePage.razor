        int Age,
        double TradeValue,
        bool IsDraftPick = false,
        int? PickRound = null,
        string? PickTier = null,
        int? PickYear = null,
        int PickSlot = 0);    // ← new: unique slot counter

    private record RedraftValueDto(
        string SleeperPlayerId,
        string PlayerName,
        string Position,
        string Team,
        double MedianProjectedPoints,
        string ValueLabel);

